              </a>
            </div>
          </details>

          <!-- Asset Library Quick Link -->
          <a href="/assets/" class={`header-nav-btn px-3 py-1.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white hover:border-[#FF84BA] dark:hover:border-[#FF84BA] shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 flex items-center gap-1.5 ${isAssets ? 'border-[#FF84BA]/80 text-[#FF84BA] dark:border-[#FF84BA]/80 dark:text-[#FF84BA] font-bold' : 'border-[#E0DBD0] dark:border-[#263346]'}`}>
            <span>✨ Assets</span>
            <span class="text-[10px] font-mono font-bold bg-[#FF84BA]/15 text-[#FF84BA] px-1.5 py-0.2 rounded-full">110+</span>
