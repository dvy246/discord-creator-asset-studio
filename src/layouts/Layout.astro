              aria-label="About, Contact & Legal Information"
              aria-haspopup="true"
            >
              <span>Company</span>
              <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>

            <div
              class="absolute right-0 top-[calc(100%+6px)] z-50 w-64 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white/95 dark:bg-[#141A24]/95 backdrop-blur-xl shadow-xl shadow-[rgba(0,0,0,0.08)] dark:shadow-[rgba(0,0,0,0.4)] p-2 space-y-1"
              role="menu"
            >
              <a href="/about/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">ℹ️</span>
                <div>
                  <div class="font-bold">About Us</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Our mission & independent tooling</div>
                </div>
              </a>
              <a href="/contact/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">✉️</span>
                <div>
                  <div class="font-bold">Contact Us</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Feedback & spec-change reports</div>
                </div>
              </a>
              <div class="border-t border-[#E0DBD0]/60 dark:border-[#263346]/60 my-1 pt-1"></div>
