---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "Discord Asset Studio | Creator Rules & Registry", 
  description = "The ultimate validation registry and toolkit for Discord creator assets. Verify sizes, formats, and rules for banners, icons, emojis, and stickers." 
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<SEOHead title={title} description={description} />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
