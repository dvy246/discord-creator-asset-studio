    <script is:inline>
      (function() {
        var banner = document.getElementById('cookie-consent-banner');
        if (!banner) return;
        var accept = document.getElementById('cookie-consent-accept');
        var decline = document.getElementById('cookie-consent-decline');
        function gtag(){ (window.dataLayer = window.dataLayer || []).push(arguments); }

        var stored;
        try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}

        // Show banner only if no prior decision recorded.
        if (stored !== 'granted' && stored !== 'denied') {
          banner.classList.remove('hidden');
        }

        function decide(granted) {
          try { localStorage.setItem('cookie-consent', granted ? 'granted' : 'denied'); } catch (e) {}
          gtag('consent', 'update', {
            ad_storage: granted ? 'granted' : 'denied',
            ad_user_data: granted ? 'granted' : 'denied',
            ad_personalization: granted ? 'granted' : 'denied',
            analytics_storage: granted ? 'granted' : 'denied'
          });
          banner.classList.add('hidden');
        }

        if (accept) accept.addEventListener('click', function() { decide(true); });
        if (decline) decline.addEventListener('click', function() { decide(false); });
      })();
    </script>

