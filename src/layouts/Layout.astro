---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import { generateOrganizationSchema } from '../utils/seo';
import ThemeToggle from '../components/ThemeToggle.astro';
import PaletteSelector from '../components/PaletteSelector.astro';
import LanguagePicker from '../components/LanguagePicker.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  hasSpanishAlternate?: boolean;
  ogImage?: string;
}

const { 
  title = "Discord Asset Studio | Creator Rules & Registry", 
  description = "Free creator tools to crop, resize, and preview Discord assets. Format banners, emojis, stickers, avatars, and role icons with exact Discord sizes.",
  lang = "en",
  noindex = false,
  canonicalUrl,
  hasSpanishAlternate,
  ogImage,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith('/blog');
const isSizesGuide = currentPath.startsWith('/guides');
const isPfps = currentPath.startsWith('/assets/pfps') || currentPath.startsWith('/pfps');
const isAssets = currentPath.startsWith('/assets');
const isCompany = ['/about', '/contact', '/privacy', '/terms'].some((p) => currentPath.startsWith(p));
const isResources = isBlog || isSizesGuide;
const isTools = (currentPath.startsWith('/tools') || currentPath === '/') && !isAssets && !isResources && !isCompany;

// Shared header nav pill token — one source of truth for every top-level trigger
const NAV_BASE = 'header-nav-btn list-none px-3.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-sm transition-all duration-200 cursor-pointer select-none flex items-center gap-1.5';
const NAV_ON = 'border-[#3368A0]/60 dark:border-[#66A3BF]/60 text-[#3368A0] dark:text-[#66A3BF] font-bold';
const NAV_OFF = 'border-[#E0DBD0] dark:border-[#263346] hover:border-[#3368A0] dark:hover:border-[#66A3BF]';
const navCls = (active: boolean) => `${NAV_BASE} ${active ? NAV_ON : NAV_OFF}`;

// Lang-aware internal link: on an ES page, point nav/footer links at the /es
// equivalent for routes that actually have a Spanish version; every other
// route falls back to English (no ES page exists to link to yet). Keeps the
// user inside their chosen locale instead of bouncing them back to English.
// Kept in sync with SEOHead SPANISH_ROUTES and LanguagePicker ES_ROUTES.
const ES_NAV_ROUTES = new Set([
  '/',
  '/tools/emoji/',
  '/tools/sticker/',
  '/tools/banner/',
  '/tools/avatar/',
  '/tools/role-icon/',
  '/tools/image-compressor/',
  '/tools/image-resizer/',
  '/tools/spoiler/',
  '/tools/colors/',
  '/tools/timestamp/',
  '/tools/emoji-copy-paste/',
  '/tools/server-icon/',
  '/tools/badge-maker/',
  '/tools/gif-compressor/',
  '/tools/fonts/',
  '/tools/colored-text/',
  '/tools/markdown/',
  '/tools/embed-builder/',
  '/tools/snowflake/',
  '/tools/gif-maker/',
  '/tools/permissions-calculator/',
  '/tools/username-generator/',
  '/tools/bio-generator/',
  '/tools/text-formatting/',
  '/guides/discord-sizes/',
]);
const L = (path: string) => (lang === 'es' && ES_NAV_ROUTES.has(path) ? `/es${path}` : path);

// Shared dropdown surface + item tokens
const MENU_SURFACE = 'absolute top-[calc(100%+8px)] z-50 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white/95 dark:bg-[#141A24]/95 backdrop-blur-xl shadow-xl shadow-[rgba(0,0,0,0.10)] dark:shadow-[rgba(0,0,0,0.45)] p-2';
const MENU_LABEL = 'px-2.5 pt-1.5 pb-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7]';
const MENU_ITEM = 'group/item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors';
const MENU_CHEV = 'w-3.5 h-3.5 opacity-50 transition-transform duration-200 group-open:rotate-180';
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Resource hints: warm up the analytics origins so TLS/connection setup overlaps the async gtag fetch (shaves connection latency off first beacon). dns-prefetch is the graceful fallback for engines that ignore preconnect. -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <!-- Google tag (gtag.js) with Consent Mode v2 — analytics denied until user consents (GDPR / PECR) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6N2NB5MZQ8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Default: deny all storage before any tag fires. Must run before gtag('config').
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
      // Restore a previously granted choice so consenting users are tracked immediately.
      try {
        if (localStorage.getItem('cookie-consent') === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          });
        }
      } catch (e) {}
      gtag('js', new Date());
      gtag('config', 'G-6N2NB5MZQ8');
    </script>
    <SEOHead 
      title={title} 
      description={description} 
      noindex={noindex} 
      canonicalUrl={canonicalUrl} 
      hasSpanishAlternate={hasSpanishAlternate}
      ogImage={ogImage}
    />
    <!-- Site-wide Organization entity (grounds brand + independence for AI/answer engines) -->
    <script type="application/ld+json" set:html={generateOrganizationSchema()} />
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        const storedPalette = localStorage.getItem('site-palette');
        if (storedPalette === 'default') {
          document.documentElement.removeAttribute('data-palette');
        } else if (storedPalette) {
          document.documentElement.setAttribute('data-palette', storedPalette);
        } else {
          document.documentElement.setAttribute('data-palette', 'electric');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2EFE7] text-[#192538] transition-colors duration-200">
    <!-- Top Navigation: Single-line, restrained, <80px height -->
    <header class="border-b border-[#E0DBD0] bg-[#FAF8F5]/90 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
      <div class="max-w-7xl mx-auto h-16 px-4 sm:px-6 flex items-center justify-between">
        <!-- Logo -->
        <a href={L("/")} class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-[#192538] hover:opacity-90 transition-opacity shrink-0">
          <img src="/favicon.svg" alt="Discord Creator Asset Studio" class="w-8 h-8 rounded-[8px] shadow-xs hover:scale-105 transition-transform" width="32" height="32" />
          <span class="whitespace-nowrap">Asset Studio</span>
          <span class="text-[10px] leading-none px-2 py-1 rounded-full bg-[#C8DFDB]/60 text-[#3368A0] border border-[#66A3BF]/30 font-semibold hidden xl:inline-block whitespace-nowrap">
            Client-Side
          </span>
        </a>

        <!-- Desktop Navigation: 4 uniform dropdowns — Tools · Assets · Resources · Company -->
        <nav class="header-primary-nav hidden lg:flex items-center gap-1.5 text-xs font-semibold">
          <!-- Tools: 2-column mega menu -->
          <details class="relative group" id="tools-dropdown">
            <summary class={navCls(isTools)} aria-label="All Discord creator tools" aria-haspopup="true">
              <span>Tools</span>
              <svg class={MENU_CHEV} fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class={`${MENU_SURFACE} left-0 w-[30rem]`} role="menu">
              <div class="grid grid-cols-2 gap-x-1">
                <div>
                  <div class={MENU_LABEL}>Visual &amp; Profile</div>
                  <a href={L("/tools/banner/")} class={MENU_ITEM}>
                    <span class="text-sm">🖼️</span>
                    <div><div class="font-bold">Banner Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Server & profile safe zones</div></div>
                  </a>
                  <a href={L("/tools/avatar/")} class={MENU_ITEM}>
                    <span class="text-sm">👤</span>
                    <div><div class="font-bold">Avatar Cropper</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">512×512 circular mask</div></div>
                  </a>
                  <a href={L("/tools/server-icon/")} class={MENU_ITEM}>
                    <span class="text-sm">🏰</span>
                    <div><div class="font-bold">Server Icon Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">512×512 rounded-square icon</div></div>
                  </a>
                  <a href={L("/tools/badge-maker/")} class={MENU_ITEM}>
                    <span class="text-sm">🔰</span>
                    <div><div class="font-bold">Logo & Badge Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Text & emoji server badges</div></div>
                  </a>
                  <a href={L('/tools/gif-maker/')} class={MENU_ITEM}>
                    <span class="text-sm">🎞️</span>
                    <div><div class="font-bold">GIF Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Video to GIF under 10MB</div></div>
                  </a>
                  <a href={L("/tools/gif-compressor/")} class={MENU_ITEM}>
                    <span class="text-sm">🗜️</span>
                    <div><div class="font-bold">GIF Compressor</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Shrink animated GIFs to fit</div></div>
                  </a>
                  <a href={L("/tools/snowflake/")} class={MENU_ITEM}>
                    <span class="text-sm">🔍</span>
                    <div><div class="font-bold">Snowflake Decoder</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">ID to date, worker & process</div></div>
                  </a>
                  <a href={L("/tools/permissions-calculator/")} class={MENU_ITEM}>
                    <span class="text-sm">🔐</span>
                    <div><div class="font-bold">Permission Calculator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Role & bot permission integers</div></div>
                  </a>
                  <a href={L("/tools/username-generator/")} class={MENU_ITEM}>
                    <span class="text-sm">🎲</span>
                    <div><div class="font-bold">Username Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Ideas & 3–4 letter handles</div></div>
                  </a>
                  <a href={L("/tools/bio-generator/")} class={MENU_ITEM}>
                    <span class="text-sm">📝</span>
                    <div><div class="font-bold">Bio Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Templates & copy-paste ideas</div></div>
                  </a>
                  <a href={L("/tools/text-formatting/")} class={MENU_ITEM}>
                    <span class="text-sm">🔠</span>
                    <div><div class="font-bold">Text Formatting Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Bold, spoiler, headers & code</div></div>
                  </a>
                  <a href={L("/tools/colors/")} class={MENU_ITEM}>
                    <span class="text-sm">🎨</span>
                    <div><div class="font-bold">Color & Hex Codes</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Background & blurple palette</div></div>
                  </a>
                  <a href={L("/tools/emoji-copy-paste/")} class={MENU_ITEM}>
                    <span class="text-sm">📋</span>
                    <div><div class="font-bold">Emoji Copy & Paste</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Unicode emoji & kaomoji board</div></div>
                  </a>
                </div>
                <div>
                  <div class={MENU_LABEL}>Server &amp; Chat Assets</div>
                  <a href={L("/tools/emoji/")} class={MENU_ITEM}>
                    <span class="text-sm">😀</span>
                    <div><div class="font-bold">Emoji Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">128×128 · 32px preview</div></div>
                  </a>
                  <a href={L("/tools/sticker/")} class={MENU_ITEM}>
                    <span class="text-sm">🏷️</span>
                    <div><div class="font-bold">Sticker Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Photo to 320×320 sticker</div></div>
                  </a>
                  <a href={L("/tools/role-icon/")} class={MENU_ITEM}>
                    <span class="text-sm">🛡️</span>
                    <div><div class="font-bold">Role Icon Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">64×64 server badges</div></div>
                  </a>
                  <a href={L("/tools/image-compressor/")} class={MENU_ITEM}>
                    <span class="text-sm">🗜️</span>
                    <div><div class="font-bold">Image Compressor</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Shrink files under 10 MB</div></div>
                  </a>
                  <a href={L("/tools/image-resizer/")} class={MENU_ITEM}>
                    <span class="text-sm">📐</span>
                    <div><div class="font-bold">Image Resizer</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Exact avatar, banner & emoji sizes</div></div>
                  </a>
                  <a href={L("/tools/spoiler/")} class={MENU_ITEM}>
                    <span class="text-sm">🙈</span>
                    <div><div class="font-bold">Spoiler Maker</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Hide text & blur image spoilers</div></div>
                  </a>
                  <a href={L("/tools/timestamp/")} class={MENU_ITEM}>
                    <span class="text-sm">🕒</span>
                    <div><div class="font-bold">Timestamp Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Dynamic &lt;t:&gt; time codes</div></div>
                  </a>
                  <a href={L("/tools/fonts/")} class={MENU_ITEM}>
                    <span class="text-sm">🔤</span>
                    <div><div class="font-bold">Font Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Fancy Unicode text styles</div></div>
                  </a>
                  <a href={L("/tools/colored-text/")} class={MENU_ITEM}>
                    <span class="text-sm">🌈</span>
                    <div><div class="font-bold">Colored Text Generator</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">ANSI colors, bold & underline</div></div>
                  </a>
                  <a href={L("/tools/markdown/")} class={MENU_ITEM}>
                    <span class="text-sm">📝</span>
                    <div><div class="font-bold">Markdown Previewer</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Live formatting preview</div></div>
                  </a>
                  <a href={L("/tools/embed-builder/")} class={MENU_ITEM}>
                    <span class="text-sm">📋</span>
                    <div><div class="font-bold">Embed Builder</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Webhook JSON + live preview</div></div>
                  </a>
                </div>
              </div>
            </div>
          </details>

          <!-- Assets: Library + PFPs + 2D icons -->
          <details class="relative group" id="assets-dropdown">
            <summary class={navCls(isAssets)} aria-label="Free Discord asset library" aria-haspopup="true">
              <span>Assets</span>
              <span class="text-[10px] font-mono font-bold bg-[#FF84BA]/15 text-[#FF84BA] px-1.5 py-0.5 rounded-full">110+</span>
              <svg class={MENU_CHEV} fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class={`${MENU_SURFACE} left-0 w-72`} role="menu">
              <div class={MENU_LABEL}>Free Asset Library</div>
              <a href="/assets/" class={MENU_ITEM}>
                <span class="text-sm">✨</span>
                <div><div class="font-bold">Animated Banners & Themes</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">110+ matching banner & PFP sets</div></div>
              </a>
              <a href="/assets/pfps/" class={MENU_ITEM}>
                <span class="text-sm">👤</span>
                <div><div class="font-bold">Discord PFPs</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">50+ profile picture presets</div></div>
              </a>
              <a href="/assets/icons-2d/" class={MENU_ITEM}>
                <span class="text-sm">🎨</span>
                <div><div class="font-bold">2D Role &amp; Server Icons</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Crisp badge icon presets</div></div>
              </a>
            </div>
          </details>

          <!-- Resources: guides + blog merged -->
          <details class="relative group" id="resources-dropdown">
            <summary class={navCls(isResources)} aria-label="Guides, specs and blog" aria-haspopup="true">
              <span>Resources</span>
              <svg class={MENU_CHEV} fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class={`${MENU_SURFACE} left-0 w-[30rem]`} role="menu">
              <div class="grid grid-cols-2 gap-x-1">
                <div>
                  <div class={MENU_LABEL}>Specs &amp; Guides</div>
                  <a href={L("/guides/discord-sizes/")} class={MENU_ITEM}>
                    <span class="text-sm">📏</span>
                    <div><div class="font-bold">Discord Size Guide</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Every asset dimension & limit</div></div>
                  </a>
                  <a href="/guides/discord-gif-guide/" class={MENU_ITEM}>
                    <span class="text-sm">🎞️</span>
                    <div><div class="font-bold">Discord GIF Guide</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Make GIFs under 10MB</div></div>
                  </a>
                  <a href="/blog/" class={MENU_ITEM}>
                    <span class="text-sm">📖</span>
                    <div><div class="font-bold">All Articles</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Tutorials & design ideas</div></div>
                  </a>
                </div>
                <div>
                  <div class={MENU_LABEL}>Popular Tutorials</div>
                  <a href="/blog/how-to-make-discord-stickers/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                    <span>🏷️</span><span class="truncate">How to Make Stickers</span>
                  </a>
                  <a href="/blog/discord-banner-ideas-templates/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                    <span>🖼️</span><span class="truncate">Banner Ideas & Templates</span>
                  </a>
                  <a href="/blog/discord-pfp-ideas-anime-avatars/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                    <span>👤</span><span class="truncate">Anime PFP & Avatars</span>
                  </a>
                  <a href="/blog/how-to-change-discord-server-banner/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                    <span>⚡</span><span class="truncate">Change Server Banner</span>
                  </a>
                </div>
              </div>
            </div>
          </details>

          <!-- Company: about, contact, legal -->
          <details class="relative group" id="company-dropdown">
            <summary class={navCls(isCompany)} aria-label="About, contact and legal" aria-haspopup="true">
              <span>Company</span>
              <svg class={MENU_CHEV} fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class={`${MENU_SURFACE} right-0 w-64`} role="menu">
              <a href="/about/" class={MENU_ITEM}>
                <span class="text-sm">ℹ️</span>
                <div><div class="font-bold">About Us</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Our mission & independent tooling</div></div>
              </a>
              <a href="/contact/" class={MENU_ITEM}>
                <span class="text-sm">✉️</span>
                <div><div class="font-bold">Contact Us</div><div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Feedback & spec-change reports</div></div>
              </a>
              <div class="border-t border-[#E0DBD0]/60 dark:border-[#263346]/60 my-1 pt-1"></div>
              <a href="/privacy/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
