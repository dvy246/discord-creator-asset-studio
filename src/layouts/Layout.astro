---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PaletteSelector from '../components/PaletteSelector.astro';
import LanguagePicker from '../components/LanguagePicker.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  canonicalUrl?: string;
  hasSpanishAlternate?: boolean;
  ogImage?: string;
}

const { 
  title = "Discord Asset Studio | Creator Rules & Registry", 
  description = "Free creator tools to crop, resize, and preview Discord assets. Format banners, emojis, stickers, avatars, and role icons with exact Discord sizes.",
  lang = "en",
  noindex = false,
  canonicalUrl,
  hasSpanishAlternate,
  ogImage,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith('/blog');
const isSizesGuide = currentPath.startsWith('/guides/discord-sizes');
const isPfps = currentPath.startsWith('/assets/pfps') || currentPath.startsWith('/pfps');
const isAssets = currentPath.startsWith('/assets') && !isPfps;
const isCompany = ['/about', '/contact', '/privacy', '/terms'].some((p) => currentPath.startsWith(p));
const isTools = (currentPath.startsWith('/tools') || currentPath === '/') && !isBlog && !isSizesGuide && !isAssets && !isPfps && !isCompany;
---
<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead 
      title={title} 
      description={description} 
      noindex={noindex} 
      canonicalUrl={canonicalUrl} 
      hasSpanishAlternate={hasSpanishAlternate}
      ogImage={ogImage}
    />
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        const storedPalette = localStorage.getItem('site-palette');
        if (storedPalette === 'default') {
          document.documentElement.removeAttribute('data-palette');
        } else if (storedPalette) {
          document.documentElement.setAttribute('data-palette', storedPalette);
        } else {
          document.documentElement.setAttribute('data-palette', 'electric');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#F2EFE7] text-[#192538] transition-colors duration-200">
    <!-- Top Navigation: Single-line, restrained, <80px height -->
    <header class="border-b border-[#E0DBD0] bg-[#FAF8F5]/90 backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
      <div class="max-w-7xl mx-auto h-16 px-4 sm:px-6 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-[#192538] hover:opacity-90 transition-opacity">
          <img src="/favicon.svg" alt="Discord Creator Asset Studio" class="w-8 h-8 rounded-[8px] shadow-xs hover:scale-105 transition-transform" width="32" height="32" />
          <span>Asset Studio</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-[#C8DFDB]/60 text-[#3368A0] border border-[#66A3BF]/30 font-semibold hidden sm:inline-block">
            Client-Side
          </span>
        </a>

        <!-- Desktop Navigation Links: Organized, Accessible, Zero-Clutter -->
        <nav class="hidden md:flex items-center gap-2 text-xs font-semibold">
          <!-- Tools Dropdown Menu -->
          <details class="relative group" id="tools-dropdown">
            <summary
              class={`header-nav-btn list-none px-3 py-1.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white hover:border-[#3368A0] dark:hover:border-[#66A3BF] shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 cursor-pointer select-none flex items-center gap-1.5 ${isTools ? 'border-[#3368A0]/60 dark:border-[#66A3BF]/60 text-[#3368A0] dark:text-[#66A3BF]' : 'border-[#E0DBD0] dark:border-[#263346]'}`}
              aria-label="All Tools & Utilities"
              aria-haspopup="true"
            >
              <span>All Tools</span>
              <span class="text-[10px] font-mono font-bold bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] px-1.5 py-0.5 rounded">8</span>
              <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            
            <div
              class="absolute left-0 top-[calc(100%+6px)] z-50 w-72 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white/95 dark:bg-[#141A24]/95 backdrop-blur-xl shadow-xl shadow-[rgba(0,0,0,0.08)] dark:shadow-[rgba(0,0,0,0.4)] p-2 space-y-1"
              role="menu"
            >
              <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7]">
                Visual & Profile
              </div>
              <a href="/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">📐</span>
                <div>
                  <div class="font-bold">Image Resizer</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Format, crop & compress Discord images</div>
                </div>
              </a>
              <a href="/tools/banner/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">🖼️</span>
                <div>
                  <div class="font-bold">Banner Studio</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Profile & server banners with safe zones</div>
                </div>
              </a>
              <a href="/tools/gif-maker/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">🎞️</span>
                <div>
                  <div class="font-bold">GIF Maker</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Video to GIF with 10MB auto-compression</div>
