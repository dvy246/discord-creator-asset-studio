            class="px-4 py-2 rounded-[8px] text-xs font-semibold border border-[#E0DBD0] dark:border-[#263346] text-[#475569] dark:text-[#CBD5E1] hover:bg-white dark:hover:bg-[#1E2738] transition-colors focus:outline-none focus:ring-2 focus:ring-[#3368A0]"
          >
            Decline
          </button>
          <button
            id="cookie-consent-accept"
            type="button"
            class="btn-primary px-5 py-2 rounded-[8px] text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#3368A0]"
          >
