                Server & Chat Assets
              </div>
              <a href="/tools/emoji/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">😀</span>
                <div>
                  <div class="font-bold">Emoji Maker</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">128×128 with 32px chat preview</div>
                </div>
              </a>
              <a href="/tools/sticker/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">🏷️</span>
                <div>
                  <div class="font-bold">Sticker Studio</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Photo to sticker & 320×320 sizing</div>
                </div>
              </a>
              <a href="/tools/role-icon/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">🛡️</span>
                <div>
                  <div class="font-bold">Role Icon Resizer</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">64×64 server badge formatting</div>
