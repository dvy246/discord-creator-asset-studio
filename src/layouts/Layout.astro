          <!-- Discord PFPs Quick Link -->
          <a href="/assets/pfps/" class={`header-nav-btn px-3 py-1.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white hover:border-[#FFDF82] dark:hover:border-[#FFDF82] shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 flex items-center gap-1.5 ${isPfps ? 'border-[#FFDF82]/80 text-[#FFDF82] dark:border-[#FFDF82]/80 dark:text-[#FFDF82] font-bold' : 'border-[#E0DBD0] dark:border-[#263346]'}`}>
            <span>👤 PFPs</span>
            <span class="text-[10px] font-mono font-bold bg-[#FFDF82]/20 text-[#FFDF82] px-1.5 py-0.2 rounded-full">50+</span>
          </a>

          <!-- Guides Direct Quick Link -->
          <a href="/guides/discord-sizes/" class={`header-nav-btn px-3 py-1.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white hover:border-[#3368A0] dark:hover:border-[#66A3BF] shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 ${isSizesGuide ? 'border-[#3368A0]/60 dark:border-[#66A3BF]/60 text-[#3368A0] dark:text-[#66A3BF]' : 'border-[#E0DBD0] dark:border-[#263346]'}`}>
            Size Guide
          </a>

          <!-- Blog Dropdown Menu Navbar -->
          <details class="relative group" id="blog-dropdown">
            <summary
              class={`header-nav-btn list-none px-3 py-1.5 rounded-lg border bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white hover:border-[#3368A0] dark:hover:border-[#66A3BF] shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 cursor-pointer select-none flex items-center gap-1.5 ${isBlog ? 'border-[#3368A0]/60 dark:border-[#66A3BF]/60 text-[#3368A0] dark:text-[#66A3BF]' : 'border-[#E0DBD0] dark:border-[#263346]'}`}
              aria-label="Blog & Guides Navigation"
              aria-haspopup="true"
            >
              <span>Blog</span>
              <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            
            <div
              class="absolute left-0 top-[calc(100%+6px)] z-50 w-72 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white/95 dark:bg-[#141A24]/95 backdrop-blur-xl shadow-xl shadow-[rgba(0,0,0,0.08)] dark:shadow-[rgba(0,0,0,0.4)] p-2 space-y-1"
              role="menu"
            >
              <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7]">
                Blog Hub
              </div>
              <a href="/blog/" class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span class="text-sm">📖</span>
                <div>
                  <div class="font-bold">All Articles & Guides</div>
                  <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] font-normal">Tutorials, specs, and design ideas</div>
                </div>
              </a>

              <div class="border-t border-[#E0DBD0]/60 dark:border-[#263346]/60 my-1 pt-1"></div>
              <div class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7]">
                Tutorials & Specs
              </div>
              <a href="/blog/how-to-make-discord-stickers/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span>🏷️</span>
                <span class="truncate">How to Make Stickers</span>
              </a>
              <a href="/blog/discord-banner-ideas-templates/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span>🖼️</span>
                <span class="truncate">Banner Ideas & Templates</span>
              </a>
              <a href="/blog/discord-pfp-ideas-anime-avatars/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span>👤</span>
                <span class="truncate">Anime PFP & Avatars</span>
              </a>
              <a href="/blog/how-to-put-spoiler-on-discord-image/" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs text-[#192538] dark:text-[#CBD5E1] hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors">
                <span>👁️</span>
