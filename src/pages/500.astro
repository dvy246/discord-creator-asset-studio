---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Processing Error | Discord Asset Studio" description="An unexpected client-side error occurred while processing your Discord asset." noindex={true}>
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-[12px] bg-red-100 dark:bg-red-950/40 border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 text-2xl font-black mb-6 shadow-sm">
      500
    </div>
    <h1 class="text-3xl font-extrabold text-[#192538] tracking-tight mb-4">Local Execution Error</h1>
    <p class="text-[#475569] text-base leading-relaxed mb-8 max-w-lg mx-auto">
      An unhandled exception occurred in the browser execution thread. Because no media is sent to a server, resetting your canvas or reloading the tool will clear memory.
    </p>

    <div class="flex items-center justify-center gap-4">
      <button onclick="window.location.reload()" class="btn-secondary px-6 py-2.5 rounded-[8px] text-sm font-semibold">
        Reload Page
      </button>
      <a href="/" class="btn-primary px-6 py-2.5 rounded-[8px] text-sm font-semibold">
        Return Home
      </a>
    </div>
  </div>
</Layout>
