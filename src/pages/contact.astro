---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact & Feedback | Discord Asset Studio" description="Get in touch with the Discord Asset Studio engineering team for rule updates, bug reports, and feedback.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-10">
      <span class="text-xs font-semibold text-[#3b82f6] uppercase tracking-wider">Creator Feedback</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 mb-4">Contact & Issue Reporting</h1>
      <p class="text-[#9da6b8] text-base leading-relaxed">
        Did Discord update an asset limit? Did you encounter a compression artifact or rendering error? Let us know.
      </p>
    </div>

    <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 sm:p-8">
      <form onsubmit="event.preventDefault(); alert('Thank you for your feedback! Our maintainers will review the rule update.');" class="space-y-6">
        <div>
          <label for="topic" class="block text-xs font-semibold uppercase tracking-wider text-[#9da6b8] mb-2">Inquiry Category</label>
          <select id="topic" class="w-full bg-[#1c2028] border border-[#2b313e] rounded-[8px] px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-[#3b82f6]">
            <option value="rule">Rule Specification Discrepancy (Discord update)</option>
            <option value="bug">Client-Side Compression or Canvas Bug</option>
            <option value="feature">Feature Request or New Asset Type</option>
            <option value="general">General Feedback</option>
          </select>
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#9da6b8] mb-2">Your Email</label>
          <input type="email" id="email" required placeholder="creator@example.com" class="w-full bg-[#1c2028] border border-[#2b313e] rounded-[8px] px-3.5 py-2.5 text-sm text-white placeholder-[#6b7385] focus:outline-none focus:border-[#3b82f6]" />
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-[#9da6b8] mb-2">Details & Reproduction Steps</label>
          <textarea id="message" rows="5" required placeholder="Include the asset type, detected vs expected behavior, and Discord official link if reporting a specification change..." class="w-full bg-[#1c2028] border border-[#2b313e] rounded-[8px] px-3.5 py-2.5 text-sm text-white placeholder-[#6b7385] focus:outline-none focus:border-[#3b82f6]"></textarea>
        </div>

        <button type="submit" class="w-full sm:w-auto px-8 py-3 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors">
          Submit Report
        </button>
      </form>
    </div>

    <div class="mt-8 text-center text-xs text-[#6b7385]">
      You can also open an issue on our GitHub repository: <a href="https://github.com/dvy246/discord-creator-asset-studio" target="_blank" rel="noopener noreferrer" class="text-[#3b82f6] underline">dvy246/discord-creator-asset-studio</a>
    </div>
  </div>
</Layout>
