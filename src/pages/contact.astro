---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
---

<Layout title="Contact & Feedback | Discord Asset Studio" description="Get in touch with the Discord Asset Studio team for rule updates, bug reports, and creator feedback.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-10">
      <span class="text-xs font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Creator Feedback</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight mt-2 mb-4">
        Contact & Issue <span class="relative inline-block sketch-trigger"><span class="relative z-10">Reporting</span><SketchUnderline color="#66A3BF" /></span>
      </h1>
      <p class="text-[#475569] text-base leading-relaxed">
        Did Discord change an asset specification? Did you encounter a compression or canvas rendering issue? Let us know.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="card-panel rounded-[12px] p-5 text-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-[#3368A0] dark:text-[#66A3BF] mb-1">Direct Support</div>
        <a href="mailto:support@discordassets.studio" class="font-semibold text-[#192538] dark:text-white hover:underline break-all">
          support@discordassets.studio
        </a>
        <p class="text-xs text-[#6B7A90] mt-1">Average response time: &lt; 24 hours</p>
      </div>

      <div class="card-panel rounded-[12px] p-5 text-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-[#3368A0] dark:text-[#66A3BF] mb-1">Official Reference</div>
        <a href="https://support.discord.com" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#192538] dark:text-white hover:underline">
          Discord Help Center &rarr;
        </a>
        <p class="text-xs text-[#6B7A90] mt-1">Direct official documentation</p>
      </div>

      <div class="card-panel rounded-[12px] p-5 text-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-[#3368A0] dark:text-[#66A3BF] mb-1">Specification Hub</div>
        <a href="/guides/discord-sizes/" class="font-semibold text-[#192538] dark:text-white hover:underline">
          Dimension Cheat Sheet &rarr;
        </a>
        <p class="text-xs text-[#6B7A90] mt-1">2026 Verified rule parameters</p>
      </div>
    </div>

    <div class="card-panel rounded-[14px] p-6 sm:p-8">
      <form onsubmit="event.preventDefault(); document.getElementById('contact-status').classList.remove('hidden'); this.reset();" class="space-y-6">
        <div id="contact-status" class="hidden p-4 rounded-[8px] bg-[#C8DFDB]/40 border border-[#0D9488]/30 text-xs text-[#192538] dark:text-white">
          Thank you for your report! Our engineering team reviews Discord specification updates and bug tickets within 24 hours. You may also email us directly at <a href="mailto:support@discordassets.studio" class="underline font-bold">support@discordassets.studio</a>.
        </div>

        <div>
          <label for="topic" class="block text-xs font-bold uppercase tracking-wider text-[#475569] mb-2">Inquiry Category</label>
          <select id="topic" class="w-full bg-[#FAF8F5] border border-[#E0DBD0] rounded-[8px] px-3.5 py-2.5 text-sm text-[#192538] focus:outline-none focus:border-[#3368A0]">
            <option value="rule">Rule Specification Discrepancy (Discord update)</option>
            <option value="bug">Client-Side Compression or Canvas Bug</option>
            <option value="feature">Feature Request or New Asset Type</option>
            <option value="general">General Feedback</option>
          </select>
        </div>

        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-[#475569] mb-2">Your Email</label>
          <input type="email" id="email" required placeholder="creator@example.com" class="w-full bg-[#FAF8F5] border border-[#E0DBD0] rounded-[8px] px-3.5 py-2.5 text-sm text-[#192538] placeholder-[#6B7A90] focus:outline-none focus:border-[#3368A0]" />
        </div>

        <div>
          <label for="message" class="block text-xs font-bold uppercase tracking-wider text-[#475569] mb-2">Details & Reproduction Steps</label>
          <textarea id="message" rows="5" required placeholder="Include the asset type, detected vs expected behavior, and Discord official link if reporting a specification change..." class="w-full bg-[#FAF8F5] border border-[#E0DBD0] rounded-[8px] px-3.5 py-2.5 text-sm text-[#192538] placeholder-[#6B7A90] focus:outline-none focus:border-[#3368A0]"></textarea>
        </div>

        <button type="submit" class="btn-primary w-full sm:w-auto px-8 py-3 rounded-[8px] text-sm font-semibold">
          Submit Report
        </button>
      </form>
    </div>
  </div>
</Layout>
