---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import StickerWorkspace from '../../components/tools/StickerWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Sticker Maker | Exact 320x320 Resize | Asset Studio";
const pageDescription = "Format custom stickers with our Discord sticker maker. Resize PNG, APNG, and GIF assets to exact 320x320 pixels under 512 KiB. 100% private in-browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/sticker/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Sticker Maker & Resizer",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Sticker Studio", url: pageUrl }
]);

const faqItems = [
  { q: "What size does a Discord sticker need to be?", a: "Every custom Discord sticker must be exactly 320×320 pixels — a perfect square. Anything even slightly off, like 319×320, or larger, like 640×640, triggers an 'invalid asset' error. In chat, Discord scales the sticker down to roughly 160×160, so make sure your key detail still reads clearly at that smaller display size." },
  { q: "How do I add custom stickers to my Discord server?", a: "Open your server, go to Server Settings → Stickers, and click Upload. Drop in a 320×320 PNG (or APNG for animation) under 512 KiB, then give the sticker a name and a related emoji. You'll need the Manage Expressions permission, and your server must have a free sticker slot available." },
  { q: "Why won't my Discord sticker upload or why do I see an invalid asset error?", a: "The three usual culprits are wrong dimensions, oversized files, and the wrong format. The image must be exactly 320×320 pixels, stay under 512 KiB, and be a PNG or APNG — GIFs are rejected. Also confirm your server still has an open sticker slot. This tool checks size and dimensions before you upload." },
  { q: "How many sticker slots does a Discord server have?", a: "A server starts with 5 custom sticker slots. Server Boost expands the cap by tier: Boost Level 1 raises it to 15 slots, Level 2 to 30, and Level 3 to 60. If the server loses boosts and drops a level, stickers over the new limit are disabled until it regains that tier." },
  { q: "Can I use a GIF for a Discord sticker, or does it have to be PNG or APNG?", a: "Static stickers use PNG and animated stickers use APNG; standard GIFs are not accepted. APNG carries full 24-bit color and smooth transparency, so it looks far cleaner than a 256-color GIF. A transparent background is recommended for a die-cut look. Lottie (.json) stickers exist too, but only for select partnered or verified servers." }
];

const dossier = {
  eyebrow: "Sticker Technical Blueprint",
  heading: "Custom stickers sized to Discord's",
  highlight: "exact 320×320 spec",
  intro: "Custom stickers follow tighter rules than emojis: a strict 320×320 square, a 512 KiB file ceiling, PNG or APNG only, and a slot count that grows with Server Boost. Here is how each requirement fits together before you upload.",
  steps: [
    "The Exact 320×320 Square",
    "PNG & APNG Formats",
    "The 512 KiB File Cap",
    "Sticker Slots & Server Boost"
  ],
  cards: [
    {
      kicker: "GEOMETRIC REQUIREMENT // 01",
      badge: "STRICT 320×320 PX",
      badgeTone: "emerald" as const,
      title: "Exactly 320×320 pixels, no exceptions",
      body: [
        "Discord emojis can be any rectangular shape, but custom stickers are strict: every sticker must measure exactly 320×320 pixels. If your image is even a pixel off — say 319×320 — or oversized at 640×640, Discord rejects the upload with an 'invalid asset' error before it ever reaches your server.",
        "In desktop and mobile chat, Discord scales that square down to roughly 160×160, so fine detail needs to read at half size. Our resizer lets you pan, zoom, and frame a photo or illustration, then exports a pixel-perfect 320×320 PNG — no cropping surprises and no manual canvas math."
      ]
    },
    {
      kicker: "FORMAT ARCHITECTURE // 02",
      badge: "PNG / APNG",
      badgeTone: "blue" as const,
      title: "PNG for static, APNG for animated",
      body: [
        "Static stickers upload as PNG; animated stickers must be APNG (Animated PNG). A transparent background is strongly recommended so your art reads as a die-cut shape instead of sitting inside a visible box. Standard GIF files are not accepted for custom stickers — Discord blocks them at upload.",
        "GIF is capped at 256 colors with hard-edged transparency, which leaves jagged fringes; APNG carries full 24-bit color and smooth alpha across every frame, so gradients and soft edges stay clean. Lottie (.json) vector stickers also exist, but only a limited set of partnered or verified servers can use them."
      ]
    },
    {
      kicker: "BINARY CAP // 03",
      badge: "512 KIB MAX",
      badgeTone: "amber" as const,
      title: "Staying under the 512 KiB limit",
      body: [
        "Every sticker also has to clear Discord's file-size ceiling: keep the exported file under 512 KiB — exactly 524,288 bytes. That sounds generous, but high-detail photographs and multi-frame APNG animations climb past the cap quickly, and an oversized file is rejected just like a wrong dimension.",
        "The built-in compressor strips hidden bloat — camera EXIF tags, color profiles, and editor metadata — then optimizes the PNG so it slips under 512 KiB without visibly touching your pixels. Because everything runs in your browser, nothing is uploaded to a server while you experiment."
      ],
      footer: "Lossless cleanup: strips metadata to keep pixels sharp while landing under 512 KiB."
    },
    {
      kicker: "SLOT ECONOMY // 04",
      badge: "5 → 60 SLOTS",
      badgeTone: "purple" as const,
      title: "Sticker slots scale with Server Boost",
      body: [
        "A new server ships with 5 custom sticker slots. Server Boost raises that cap in tiers: Level 1 lifts you to 15 slots, Level 2 to 30, and Level 3 to 60. If a server loses boosts and drops a tier, stickers beyond the new limit are disabled until you re-boost.",
        "To add one, open Server Settings → Stickers, click Upload, drop in your 320×320 PNG or APNG, and give it a name plus a related emoji. You'll need the Manage Expressions permission. Frame and export your file here first so it clears every check before you ever open that panel."
      ],
      footer: "Zero server uploads · In-browser 320×320 canvas alignment."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/sticker.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Sticker Studio</span>
      </div>
        <a href="/es/tools/sticker/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold" hreflang="es">🌐 Español</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Sticker</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] mt-1">Photo-to-Sticker Studio • Pan & Zoom framing • Die-Cut Vinyl Borders • Exact 320×320 under 512 KiB</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-[#161F2E] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-[#263346] text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <StickerWorkspace lang="en" />

    <!-- Sticky-scroll technical dossier (shared component) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (shared component, single source of truth with JSON-LD) -->
    <ToolFaq items={faqItems} />

  </div>
</Layout>
