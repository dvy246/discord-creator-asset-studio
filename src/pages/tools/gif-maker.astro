---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../utils/seo';

const pageTitle = "Discord GIF Maker | Compress Under 10MB Nitro | Studio";
const pageDescription = "Free Discord GIF maker to convert videos, crop animated banners, and optimize animated avatars under Discord's strict 10MB Nitro limit.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/gif-maker/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord GIF Maker & Video Converter",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "GIF Maker", url: pageUrl }
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the maximum file size for Discord animated GIFs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord sets a 10.0 MB limit for animated profile banners and user avatars (with Discord Nitro). Animated emojis must stay under 256 KiB, and animated stickers must stay under 512 KiB using the APNG format."
      }
    },
    {
      "@type": "Question",
      "name": "How long can a Discord animated banner or avatar be?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While Discord lets you upload any length under 10MB, the desktop and mobile apps pause banner animations after about 5 seconds unless someone hovers over them. Making a clean 2 to 4-second loop looks best."
      }
    },
    {
      "@type": "Question",
      "name": "Why does my Discord GIF look pixelated or slow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High-resolution animations get huge fast. If your GIF goes over 10MB, you either have to compress it heavily or shorten it. Dropping the frame rate from 30 FPS down to 15 or 20 FPS cuts the file size in half while keeping the animation smooth."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need Discord Nitro to use animated GIFs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Animated profile pictures, animated banners, and using animated custom emojis across different servers all require an active Discord Nitro or Nitro Basic subscription."
      }
    },
    {
      "@type": "Question",
      "name": "How do I make a Discord GIF from a video?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Drop an MP4 or WebM clip into the tool, pick the target size (profile banner, server banner, avatar, or emoji), and choose a frame rate. Trimming a video to Discord GIF format works best when you keep the clip to a 2 to 4 second loop and drop to 15 FPS so the exported file lands under the 10MB limit."
      }
    },
    {
      "@type": "Question",
      "name": "Can I turn a Twitter or Tenor GIF into a Discord GIF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Save the source GIF, then load it here as a Discord GIF converter to re-frame it to the exact avatar, emoji, or banner dimensions. A Twitter GIF to Discord GIF conversion usually just needs a size crop and a light compression pass to fit under Discord's caps."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 relative z-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">GIF Maker</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord GIF Maker</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">& Converter</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Convert MP4, WebM, or clips to optimized Discord animated GIFs under the strict 10MB Nitro ceiling.</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          10MB Nitro Calibrated
        </div>
      </div>
    </div>

    <!-- Main Tool Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <!-- Left Column: Media Uploader & Interactive Canvas (8 cols) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Aesthetic Video Dropzone -->
        <div id="dropzone" class="border-2 border-dashed border-[#C8DFDB] dark:border-white/20 hover:border-[#3368A0] dark:hover:border-[#66A3BF] rounded-[14px] bg-white/60 dark:bg-black/40 backdrop-blur-md p-10 text-center transition-all cursor-pointer relative shadow-sm group">
          <input type="file" id="fileInput" accept="video/mp4,video/webm,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
          <div class="space-y-4 pointer-events-none">
            <div class="w-14 h-14 rounded-[14px] bg-[#C8DFDB]/50 dark:bg-white/10 text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center mx-auto text-2xl font-bold group-hover:scale-110 transition-transform">
              🎞️
            </div>
            <div>
              <p class="text-base font-bold text-[#192538] dark:text-white">Choose video or GIF</p>
              <p class="text-xs text-[#6B7A90] dark:text-gray-400 mt-1">MP4, WebM, or animated GIF · Auto-framed to Discord dimensions</p>
            </div>
          </div>
        </div>

        <!-- Editor & Preview Panel -->
        <div id="editorPanel" class="card-panel rounded-[14px] p-6 backdrop-blur-xl bg-white/80 dark:bg-[#141A24]/90 border border-[#E0DBD0] dark:border-[#263346] shadow-md hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] dark:border-[#263346] mb-6">
            <h2 class="text-sm font-bold text-[#192538] dark:text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
              Timeline & Video Preview
            </h2>
            <button id="resetBtn" class="btn-secondary text-xs px-2.5 py-1 rounded-[6px] cursor-pointer">
              Choose Another File
            </button>
          </div>

          <!-- Video Surface -->
          <div class="relative bg-black/90 rounded-[12px] overflow-hidden mb-6 flex items-center justify-center aspect-video shadow-inner">
            <video id="previewVideo" class="max-w-full max-h-full object-contain" loop muted playsinline autoplay></video>
            
            <!-- Safe Zone Mask Overlay -->
            <div id="gifSafeZone" class="absolute inset-0 pointer-events-none hidden flex flex-col justify-between p-4">
              <div class="bg-black/70 backdrop-blur-md px-3 py-1 rounded text-[10px] font-mono text-white/80 w-fit">Top 48px Header Zone</div>
              <div class="w-16 h-16 rounded-full border-2 border-white/60 bg-black/60 backdrop-blur-md flex items-center justify-center text-[9px] font-bold text-white/80">Avatar</div>
            </div>
          </div>

          <!-- Parameter Controls -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div>
              <label for="targetPreset" class="text-xs text-[#6B7A90] dark:text-gray-400 font-bold uppercase block mb-1.5">Asset Target</label>
              <select id="targetPreset" class="w-full bg-[#FAF8F5] dark:bg-black/50 border border-[#E0DBD0] dark:border-white/20 rounded-lg px-3 py-2 text-xs text-[#192538] dark:text-white focus:outline-none focus:border-[#3368A0]">
                <option value="profileBanner">Profile Banner (600×240)</option>
                <option value="serverBanner">Server Banner (960×540)</option>
                <option value="avatar">Avatar / PFP (512×512)</option>
                <option value="emoji">Animated Emoji (128×128)</option>
              </select>
            </div>

            <div>
              <label for="fpsSelect" class="text-xs text-[#6B7A90] dark:text-gray-400 font-bold uppercase block mb-1.5">Frame Rate</label>
              <select id="fpsSelect" class="w-full bg-[#FAF8F5] dark:bg-black/50 border border-[#E0DBD0] dark:border-white/20 rounded-lg px-3 py-2 text-xs text-[#192538] dark:text-white focus:outline-none focus:border-[#3368A0]">
                <option value="15">15 FPS (Recommended - Best Quality/Size)</option>
                <option value="30">30 FPS (Ultra Smooth - High File Size)</option>
                <option value="12">12 FPS (Anime / Lo-Fi Aesthetic)</option>
              </select>
            </div>

            <div>
              <label for="qualitySelect" class="text-xs text-[#6B7A90] dark:text-gray-400 font-bold uppercase block mb-1.5">Compression</label>
              <select id="qualitySelect" class="w-full bg-[#FAF8F5] dark:bg-black/50 border border-[#E0DBD0] dark:border-white/20 rounded-lg px-3 py-2 text-xs text-[#192538] dark:text-white focus:outline-none focus:border-[#3368A0]">
                <option value="high">Fit Under 10.0 MB (Nitro)</option>
                <option value="medium">Aggressive (Fit Under 5.0 MB)</option>
                <option value="emoji">Emoji Limit (Fit Under 256 KiB)</option>
              </select>
            </div>
          </div>

          <!-- Safe Zone Toggle -->
          <div class="flex items-center gap-2 mb-6">
            <input type="checkbox" id="toggleSafeZone" class="rounded border-[#D8D3C8] text-[#3368A0] cursor-pointer" />
            <label for="toggleSafeZone" class="text-xs text-[#475569] dark:text-gray-300 font-medium cursor-pointer">
              Show Discord UI Profile Safe Zone Mask
            </label>
          </div>

          <!-- Export Action -->
          <button id="convertBtn" class="btn-primary w-full py-3.5 rounded-[10px] text-sm font-semibold flex items-center justify-center gap-2 shadow-sm cursor-pointer">
            <span id="convertSpinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
            <span id="convertText">Process & Download Discord GIF</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Validation & Spec Receipts (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="card-panel rounded-[14px] p-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
            <h3 class="text-xs font-bold text-[#192538] dark:text-white uppercase tracking-wider">Discord GIF Specs</h3>
            <span class="text-[11px] font-mono uppercase bg-[#C8DFDB]/60 text-[#0D9488] border border-[#0D9488]/30 px-2 py-0.5 rounded font-bold">10MB Max</span>
          </div>

          <div class="space-y-3 font-mono text-xs">
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Nitro Banner:</span>
              <span class="font-bold text-[#192538] dark:text-white">600×240 (5:2)</span>
            </div>
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Nitro Avatar:</span>
              <span class="font-bold text-[#192538] dark:text-white">512×512 (1:1)</span>
            </div>
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Anim. Emoji:</span>
              <span class="font-bold text-[#192538] dark:text-white">128×128 (≤256KB)</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-[#6B7A90]">Anim. Sticker:</span>
              <span class="font-bold text-[#192538] dark:text-white">320×320 (≤512KB APNG)</span>
            </div>
          </div>
        </div>

        <div class="card-panel rounded-[14px] p-6">
          <h3 class="text-xs font-bold text-[#192538] dark:text-white uppercase tracking-wider mb-2">Quick Tips</h3>
          <p class="text-xs text-[#475569] dark:text-[#94A3B8] leading-relaxed mb-3">
            Discord loops profile GIFs automatically. Aim for a seamless <strong>2 to 4 second</strong> loop to keep the animation smooth without hitting the 10MB file limit.
          </p>
          <div class="pt-2 border-t border-[#E0DBD0] dark:border-[#263346]">
            <a href="/guides/discord-gif-guide/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline text-xs font-medium flex items-center gap-1">
              <span>📖</span> Read Complete Discord GIF Guide →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Technical Dossier: Compression & Format Guidance -->
    <section class="border-t border-[#E0DBD0] dark:border-[#263346] pt-12 mb-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="card-panel rounded-[16px] p-6 sm:p-8">
          <span class="text-[11px] font-mono font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Compression // 01</span>
          <h2 class="text-lg sm:text-xl font-extrabold text-[#192538] dark:text-white mt-2 mb-3">
            How a Discord GIF Compressor Fits the 10MB Limit
          </h2>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] leading-relaxed mb-3">
            A raw screen recording is almost never small enough to upload. The trick a Discord GIF compressor
            uses is trimming three things at once: the clip length, the frame rate, and the pixel dimensions.
            Cutting from 30 FPS to 15 FPS alone roughly halves the Discord GIF size, and cropping to the exact
            target (a 512×512 avatar or a 600×240 banner) removes wasted pixels that eat into your budget.
          </p>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] leading-relaxed">
            Discord Nitro raises the ceiling to 10.0 MB, but a clean 2 to 4-second loop usually lands far under
            that. If you are targeting an animated emoji instead, the same clip has to squeeze under 256 KiB, so
            drop the dimensions to 128×128 and keep the loop short.
          </p>
        </div>
        <div class="card-panel rounded-[16px] p-6 sm:p-8">
          <span class="text-[11px] font-mono font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Formats // 02</span>
          <h2 class="text-lg sm:text-xl font-extrabold text-[#192538] dark:text-white mt-2 mb-3">
            Discord GIF Banners, PFPs, and Emoji Sizes
          </h2>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] leading-relaxed mb-3">
            Each Discord surface expects a different shape. An animated Discord GIF banner for a profile uses a
            wide 600×240 (5:2) frame, while a server banner is a 960×540 (16:9) widescreen. A Discord GIF PFP is
            a 1:1 square exported at 512×512 and masked into a circle, so keep faces and logos centered away from
            the corners that get clipped.
          </p>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] leading-relaxed">
            Whether you are converting a video to a Discord GIF or re-sizing one you already have, matching these
            dimensions before upload stops Discord from stretching or cropping your animation in unexpected ways.
            When you need a still frame instead, the <a href="/tools/banner/" class="text-[#3368A0] dark:text-[#66A3BF] font-semibold hover:underline">Banner Studio</a>
            and <a href="/tools/avatar/" class="text-[#3368A0] dark:text-[#66A3BF] font-semibold hover:underline">Avatar Cropper</a> cover the static formats.
          </p>
        </div>
      </div>
    </section>

    <!-- Comprehensive Technical FAQ -->
    <section class="border-t border-[#E0DBD0] dark:border-[#263346] pt-12">
      <h2 class="text-xl font-bold text-[#192538] dark:text-white tracking-tight mb-6">Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqSchema.mainEntity.map((item) => (
          <div class="card-panel p-5 rounded-[12px]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.name}</h3>
            <p class="text-xs text-[#475569] dark:text-[#94A3B8] leading-relaxed">{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <script>
    import { GIFEncoder, quantize, applyPalette } from 'gifenc';

    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const dropzone = document.getElementById('dropzone');
    const editorPanel = document.getElementById('editorPanel');
    const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;
    const resetBtn = document.getElementById('resetBtn');
    const toggleSafeZone = document.getElementById('toggleSafeZone') as HTMLInputElement;
    const gifSafeZone = document.getElementById('gifSafeZone');
    const convertBtn = document.getElementById('convertBtn');
    const convertSpinner = document.getElementById('convertSpinner');
    const convertText = document.getElementById('convertText');

    let currentFile: File | null = null;
    let currentObjectUrl: string | null = null;

    function cleanup() {
      if (currentObjectUrl) {
        URL.revokeObjectURL(currentObjectUrl);
        currentObjectUrl = null;
      }
    }

    fileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      handleFile(file);
    });

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-[#3368A0]');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-[#3368A0]');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-[#3368A0]');
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });

    function handleFile(file: File) {
      cleanup();
      currentFile = file;
      currentObjectUrl = URL.createObjectURL(file);
      if (previewVideo) {
        previewVideo.src = currentObjectUrl;
        previewVideo.play().catch(() => {});
      }
      dropzone?.classList.add('hidden');
      editorPanel?.classList.remove('hidden');
    }

    resetBtn?.addEventListener('click', () => {
      cleanup();
      currentFile = null;
      if (fileInput) fileInput.value = '';
      editorPanel?.classList.add('hidden');
      dropzone?.classList.remove('hidden');
    });

    toggleSafeZone?.addEventListener('change', () => {
      if (toggleSafeZone.checked) {
        gifSafeZone?.classList.remove('hidden');
      } else {
        gifSafeZone?.classList.add('hidden');
      }
    });

    const PRESETS: Record<string, { w: number; h: number }> = {
      profileBanner: { w: 600, h: 240 },
      serverBanner: { w: 960, h: 540 },
      avatar: { w: 512, h: 512 },
      emoji: { w: 128, h: 128 }
    };
    const QUALITY: Record<string, { maxBytes: number; colors: number }> = {
      high: { maxBytes: 10 * 1024 * 1024, colors: 256 },
      medium: { maxBytes: 5 * 1024 * 1024, colors: 128 },
      emoji: { maxBytes: 262144, colors: 64 }
    };
    const MAX_SECONDS = 6;

    const targetPreset = document.getElementById('targetPreset') as HTMLSelectElement;
    const fpsSelect = document.getElementById('fpsSelect') as HTMLSelectElement;
    const qualitySelect = document.getElementById('qualitySelect') as HTMLSelectElement;

    function coverRect(sw: number, sh: number, w: number, h: number) {
      const scale = Math.max(w / sw, h / sh);
      const dw = sw * scale, dh = sh * scale;
      return { dx: (w - dw) / 2, dy: (h - dh) / 2, dw, dh };
    }

    function seek(video: HTMLVideoElement, time: number): Promise<void> {
      return new Promise((resolve) => {
        const onSeeked = () => { video.removeEventListener('seeked', onSeeked); resolve(); };
        video.addEventListener('seeked', onSeeked);
        video.currentTime = time;
      });
    }

    async function encodeFromVideo(w: number, h: number, fps: number, colors: number): Promise<Uint8Array> {
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d', { willReadFrequently: true }) as CanvasRenderingContext2D;
      const enc = GIFEncoder();
      const duration = Math.min(previewVideo.duration || MAX_SECONDS, MAX_SECONDS);
      const frameCount = Math.max(1, Math.round(duration * fps));
      const delay = Math.round(1000 / fps);
      const wasPlaying = !previewVideo.paused;
      previewVideo.pause();
      for (let i = 0; i < frameCount; i++) {
        await seek(previewVideo, (i / fps));
        const r = coverRect(previewVideo.videoWidth, previewVideo.videoHeight, w, h);
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(previewVideo, r.dx, r.dy, r.dw, r.dh);
        const { data } = ctx.getImageData(0, 0, w, h);
        const palette = quantize(data, colors);
        const index = applyPalette(data, palette);
        enc.writeFrame(index, w, h, { palette, delay });
      }
      enc.finish();
      if (wasPlaying) previewVideo.play().catch(() => {});
      return enc.bytes();
    }

    async function encodeFromGif(w: number, h: number, colors: number): Promise<Uint8Array> {
      if (!currentFile) throw new Error('no file');
      const buf = await currentFile.arrayBuffer();
      const decoder = new (window as any).ImageDecoder({ data: buf, type: 'image/gif' });
      await decoder.tracks.ready;
      const frameCount = decoder.tracks.selectedTrack.frameCount;
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d', { willReadFrequently: true }) as CanvasRenderingContext2D;
      const enc = GIFEncoder();
      for (let i = 0; i < frameCount; i++) {
        const { image } = await decoder.decode({ frameIndex: i });
        const delay = image.duration ? Math.max(20, Math.round(image.duration / 1000)) : 100;
        const r = coverRect(image.displayWidth, image.displayHeight, w, h);
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(image, r.dx, r.dy, r.dw, r.dh);
        image.close();
        const { data } = ctx.getImageData(0, 0, w, h);
        const palette = quantize(data, colors, { format: 'rgba4444' });
        const index = applyPalette(data, palette, 'rgba4444');
        enc.writeFrame(index, w, h, { palette, delay, transparent: true });
      }
      enc.finish();
      decoder.close();
      return enc.bytes();
    }

    convertBtn?.addEventListener('click', async () => {
      if (!currentFile) return;
      const preset = PRESETS[targetPreset?.value || 'profileBanner'] || PRESETS.profileBanner;
      const fps = parseInt(fpsSelect?.value || '15', 10);
      const q = QUALITY[qualitySelect?.value || 'high'] || QUALITY.high;

      convertSpinner?.classList.remove('hidden');
      if (convertBtn instanceof HTMLButtonElement) convertBtn.disabled = true;
      if (convertText) convertText.innerText = 'Encoding GIF…';

      try {
        const isGif = currentFile.type === 'image/gif';
        if (!isGif && typeof (window as any).ImageDecoder === 'undefined' && !previewVideo.videoWidth) {
          // video path uses <video>, no ImageDecoder needed; guard only affects gif
        }
        if (isGif && typeof (window as any).ImageDecoder === 'undefined') {
          alert('Your browser cannot decode GIF frames. Try the latest Chrome, Edge, or Firefox.');
          return;
        }
        const bytes = isGif
          ? await encodeFromGif(preset.w, preset.h, q.colors)
          : await encodeFromVideo(preset.w, preset.h, fps, q.colors);

        const blob = new Blob([bytes], { type: 'image/gif' });
        const sizeMB = (blob.size / (1024 * 1024)).toFixed(2);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `discord-gif-${preset.w}x${preset.h}-${Date.now()}.gif`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        if (convertText) {
          const overCap = blob.size > q.maxBytes;
          convertText.innerText = overCap
            ? `Downloaded ${sizeMB} MB — over target, try lower FPS or Emoji compression`
            : `Downloaded ${sizeMB} MB — within target ✓`;
          setTimeout(() => { if (convertText) convertText.innerText = 'Process & Download Discord GIF'; }, 4000);
        }
      } catch (e) {
        console.error(e);
        alert('Could not process this file. Make sure it is a valid video or animated GIF.');
        if (convertText) convertText.innerText = 'Process & Download Discord GIF';
      } finally {
        convertSpinner?.classList.add('hidden');
        if (convertBtn instanceof HTMLButtonElement) convertBtn.disabled = false;
      }
    });
  </script>
</Layout>
