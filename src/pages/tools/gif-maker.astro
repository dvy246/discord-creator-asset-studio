---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import GifMakerWorkspace from '../../components/tools/GifMakerWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord GIF Maker | Compress Under 10MB Nitro | Studio";
const pageDescription = "Free Discord GIF maker to convert videos, crop animated banners, and optimize animated avatars under Discord's strict 10MB Nitro limit.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/gif-maker/";
const esUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/gif-maker/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord GIF Maker & Video Converter",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "GIF Maker", url: pageUrl }
]);

const faqItems = [
  { q: "What is the maximum file size for a Discord animated GIF avatar or banner?", a: "Discord caps animated profile banners and avatars at 10.0 MB with Nitro. Animated custom emojis must stay under 256 KiB and animated stickers under 512 KiB as APNG. This maker targets whichever cap your chosen asset uses so the export fits on the first try." },
  { q: "How do I make a Discord GIF from an MP4 or WebM video?", a: "Drop an MP4 or WebM clip into the tool, pick the asset target (profile banner, server banner, avatar, or emoji), and choose a frame rate. Keeping the clip to a 2 to 4 second loop at 15 FPS lands the exported GIF comfortably under Discord's 10MB limit." },
  { q: "Why does my Discord GIF look pixelated, blurry, or slow?", a: "High-resolution animations balloon in size fast. When a GIF crosses 10MB it must be compressed hard, which crushes colors and detail. Dropping from 30 FPS to 15 FPS roughly halves the file size while keeping motion smooth, so lower the frame rate before cutting quality." },
  { q: "Do I need Discord Nitro to upload an animated GIF avatar?", a: "Yes. Animated profile pictures, animated banners, and using animated custom emoji across different servers all require an active Discord Nitro or Nitro Basic subscription. Static PNG and JPG avatars work on every account without Nitro." },
  { q: "Can I convert a Twitter, Tenor, or Giphy GIF into a Discord GIF?", a: "Yes. Save the source GIF, then load it here to re-frame it to the exact avatar, emoji, or banner dimensions. A Tenor or Twitter GIF usually only needs a size crop and a light compression pass to fit under Discord's caps, all done in your browser." }
];

const dossier = {
  eyebrow: "GIF Technical Blueprint",
  heading: "Animated GIFs that fit under the",
  highlight: "10MB Nitro cap",
  intro: "A raw screen recording is almost never small enough for Discord. The trick is trimming length, frame rate, and pixel dimensions together, then matching each surface's exact shape. Here is how the compression math, formats, and Nitro rules line up.",
  steps: [
    "Compression Math",
    "Per-Surface Dimensions",
    "Frame Rate & Loop Length",
    "Nitro & Format Limits"
  ],
  cards: [
    {
      kicker: "COMPRESSION MATH // 01",
      badge: "FIT UNDER 10MB",
      badgeTone: "emerald" as const,
      title: "How a Discord GIF compressor hits the 10MB limit",
      body: [
        "A raw clip is rarely small enough to upload straight to Discord. The fix is trimming three things at once: the clip length, the frame rate, and the pixel dimensions. Cutting from 30 FPS to 15 FPS alone roughly halves the exported GIF, and cropping to the exact target — a 512×512 avatar or a 600×240 banner — removes wasted pixels that eat into your byte budget.",
        "Discord Nitro raises the ceiling to 10.0 MB, but a clean 2 to 4-second loop usually lands far under it. If you are targeting an animated emoji instead, the same clip has to squeeze under 256 KiB, so drop the dimensions to 128×128 and keep the loop short and simple."
      ],
      footer: "Everything encodes in your browser with gifenc — no upload, no queue, no watermark."
    },
    {
      kicker: "SURFACE GEOMETRY // 02",
      badge: "5:2 / 16:9 / 1:1",
      badgeTone: "blue" as const,
      title: "Banner, avatar, and emoji sizes decoded",
      body: [
        "Each Discord surface expects a different shape. An animated profile banner uses a wide 600×240 (5:2) frame, while a server banner is a 960×540 (16:9) widescreen. A GIF PFP is a 1:1 square exported at 512×512 and masked into a circle, so keep faces and logos centered away from the corners that get clipped.",
        "Whether you are converting a video or re-sizing a GIF you already have, matching these dimensions before upload stops Discord from stretching or cropping the animation in unexpected ways. The maker auto-frames your source to the target with a center-cover crop so the important subject stays in view."
      ]
    },
    {
      kicker: "MOTION TUNING // 03",
      badge: "2-4 SEC LOOP",
      badgeTone: "amber" as const,
      title: "Frame rate and loop length that read well",
      body: [
        "Discord loops profile GIFs automatically and pauses banner animations after about 5 seconds unless someone hovers. That makes a seamless 2 to 4-second loop the sweet spot: long enough to feel alive, short enough to stay tiny. Longer clips mostly add file size, not impact.",
        "Frame rate is the biggest lever on size after length. 15 FPS looks smooth for most motion and is the recommended default; 30 FPS doubles the bytes for diminishing returns; 12 FPS suits lo-fi or anime edits where a slight stutter fits the aesthetic. Pick the lowest rate that still reads as smooth for your clip."
      ],
      footer: "Loops pause after ~5s without a hover — front-load the motion that matters."
    },
    {
      kicker: "PERMISSION PROTOCOLS // 04",
      badge: "NITRO REQUIRED",
      badgeTone: "purple" as const,
      title: "Nitro, emoji caps, and sticker formats",
      body: [
        "Animated avatars, animated banners, and animated custom emoji used across servers all require Nitro or Nitro Basic. Before you export, confirm the account or server has the right tier so the upload is not silently rejected or shown as a static frame to other members.",
        "Format caps differ by asset: animated emoji must fit 128×128 under 256 KiB, and animated stickers use APNG at 320×320 under 512 KiB rather than GIF. The maker's Compression presets map directly to these ceilings, so choosing 'Emoji Limit' quantizes colors and frames hard enough to clear the 256 KiB bar."
      ],
      footer: "Compression presets map 1:1 to Discord's 10MB / 256 KiB / 512 KiB ceilings."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/gif-maker.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 relative z-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">GIF Maker</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord GIF Maker</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">& Converter</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Convert MP4, WebM, or clips to optimized Discord animated GIFs under the strict 10MB Nitro ceiling.</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          10MB Nitro Calibrated
        </div>
      </div>
    </div>

    <!-- Interactive tool (shared EN + ES workspace component) -->
    <GifMakerWorkspace lang="en" />

    <!-- Sticky-scroll technical dossier (shared component) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (shared component, single source of truth with JSON-LD) -->
    <ToolFaq items={faqItems} />
  </div>
</Layout>
