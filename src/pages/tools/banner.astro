---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Discord Banner Maker & Safe Zone Validator | 2026" 
  description="Resize and validate Discord profile and server banners with official top 48px safe zone overlays. 100% private in-browser tool."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs text-[#9da6b8] mb-2 font-mono">
        <a href="/" class="hover:text-white transition-colors">Studio</a>
        <span>/</span>
        <span class="text-white">Banner Studio</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Discord Banner Studio</h1>
          <p class="text-xs sm:text-sm text-[#9da6b8] mt-1">Profile Banners (680x240 & 600x240) • Server Banners (960x540 / 1920x1080) with top 48px safe zone guide</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#15181e] px-3 py-1.5 rounded-[8px] border border-[#2b313e] text-[#10b981]">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          Zero Server Uploads
        </div>
      </div>
    </div>

    <!-- Banner Preset Selector -->
    <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-4 mb-8 flex flex-wrap items-center gap-3">
      <span class="text-xs font-semibold text-[#9da6b8] uppercase tracking-wider mr-2">Preset Mode:</span>
      <button id="presetServerBanner" class="text-xs px-3 py-1.5 rounded-[6px] bg-[#3b82f6] text-white font-medium transition-colors">
        Server Banner (960 × 540)
      </button>
      <button id="presetGlobalProfile" class="text-xs px-3 py-1.5 rounded-[6px] bg-[#1c2028] text-[#9da6b8] hover:text-white font-medium transition-colors">
        Global Profile Banner (680 × 240)
      </button>
      <button id="presetServerProfile" class="text-xs px-3 py-1.5 rounded-[6px] bg-[#1c2028] text-[#9da6b8] hover:text-white font-medium transition-colors">
        Per-Server Profile Banner (600 × 240)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Upload & Canvas -->
      <div class="lg:col-span-8 space-y-6">
        <div id="dropzone" class="border-2 border-dashed border-[#2b313e] hover:border-[#3b82f6] rounded-[12px] bg-[#15181e] p-8 text-center transition-all cursor-pointer relative">
          <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
          <div class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-[10px] bg-[#1c2028] text-[#3b82f6] flex items-center justify-center mx-auto text-xl font-bold">
              🖼️
            </div>
            <p class="text-sm font-semibold text-white">Select banner artwork</p>
            <p class="text-xs text-[#6b7385]">PNG, JPG, or GIF (Auto-cropped to active preset aspect ratio)</p>
          </div>
        </div>

        <div id="editorPanel" class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white" id="editorTitle">Canvas Surface</h2>
            <div class="flex items-center gap-3">
              <label class="flex items-center gap-1.5 text-xs text-[#9da6b8] cursor-pointer">
                <input type="checkbox" id="safeZoneToggle" checked class="rounded bg-[#1c2028] border-[#2b313e] text-[#3b82f6]" />
                Show Top 48px Safe Zone
              </label>
              <button id="resetBtn" class="text-xs px-2.5 py-1 rounded-[6px] bg-[#1c2028] hover:bg-[#242934] border border-[#2b313e] text-[#9da6b8] hover:text-white">
                Reset
              </button>
            </div>
          </div>

          <!-- Canvas container with safe zone guide overlay -->
          <div class="relative bg-[#0d0f12] rounded-[8px] border border-[#2b313e] overflow-hidden mb-6 flex items-center justify-center p-4">
            <div class="relative">
              <canvas id="mainCanvas" class="max-w-full h-auto shadow-sm rounded-[4px] bg-[repeating-conic-gradient(#1c2028_0%_25%,#15181e_0%_50%)] [background-size:16px_16px]"></canvas>
              
              <!-- Safe zone overlay bar -->
              <div id="safeZoneOverlay" class="absolute top-0 left-0 right-0 h-[10%] bg-[#ef4444]/30 border-b border-[#ef4444] pointer-events-none flex items-center justify-center">
                <span class="text-[10px] font-mono text-white bg-[#0d0f12]/80 px-2 py-0.5 rounded">
                  Top 48px Header Overlay Zone (Keep text below)
                </span>
              </div>
            </div>
          </div>

          <button id="exportBtn" class="w-full py-3 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors shadow-sm">
            Export Formatted Banner
          </button>
        </div>
      </div>

      <!-- Right Column: Receipt & Requirements -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">Validation Receipt</h2>
            <span id="receiptBadge" class="text-[10px] font-mono uppercase bg-[#242934] text-[#9da6b8] px-2 py-0.5 rounded">
              Awaiting Media
            </span>
          </div>

          <div class="space-y-3 text-xs font-mono">
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Preset Mode:</span>
              <span id="statPreset" class="text-white">Server Banner</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Target Size:</span>
              <span id="statTarget" class="text-white">960 × 540 px</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Platform Gate:</span>
              <span id="statGate" class="text-[#f59e0b]">Boost Level 2</span>
            </div>

            <div class="pt-2 border-t border-[#2b313e] text-[11px] text-[#6b7385] font-sans">
              <strong>Official Guidance:</strong> Server Banners require Boost Level 2 (static) or Level 3 (animated). Discord overlays channel navigation over the top 48px.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const editorPanel = document.getElementById('editorPanel');
    const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const resetBtn = document.getElementById('resetBtn');
    const exportBtn = document.getElementById('exportBtn');
    const safeZoneToggle = document.getElementById('safeZoneToggle') as HTMLInputElement;
    const safeZoneOverlay = document.getElementById('safeZoneOverlay');

    const presetServerBanner = document.getElementById('presetServerBanner');
    const presetGlobalProfile = document.getElementById('presetGlobalProfile');
    const presetServerProfile = document.getElementById('presetServerProfile');

    const statPreset = document.getElementById('statPreset');
    const statTarget = document.getElementById('statTarget');
    const statGate = document.getElementById('statGate');
    const receiptBadge = document.getElementById('receiptBadge');

    let currentMode = 'server'; // 'server', 'global', 'profile'
    let currentImage: HTMLImageElement | null = null;
    let currentBlob: Blob | null = null;
    let currentObjectUrl: string | null = null;

    const PRESETS = {
      server: { w: 960, h: 540, name: 'Server Banner', gate: 'Boost Level 2', safeZone: true },
      global: { w: 680, h: 240, name: 'Global Profile Banner', gate: 'Discord Nitro', safeZone: false },
      profile: { w: 600, h: 240, name: 'Per-Server Profile Banner', gate: 'Discord Nitro', safeZone: false }
    };

    function updatePresetButtons() {
      [presetServerBanner, presetGlobalProfile, presetServerProfile].forEach(b => {
        b?.classList.remove('bg-[#3b82f6]', 'text-white');
        b?.classList.add('bg-[#1c2028]', 'text-[#9da6b8]');
      });

      if (currentMode === 'server') {
        presetServerBanner?.classList.add('bg-[#3b82f6]', 'text-white');
        presetServerBanner?.classList.remove('bg-[#1c2028]', 'text-[#9da6b8]');
      } else if (currentMode === 'global') {
        presetGlobalProfile?.classList.add('bg-[#3b82f6]', 'text-white');
        presetGlobalProfile?.classList.remove('bg-[#1c2028]', 'text-[#9da6b8]');
      } else {
        presetServerProfile?.classList.add('bg-[#3b82f6]', 'text-white');
        presetServerProfile?.classList.remove('bg-[#1c2028]', 'text-[#9da6b8]');
      }

      const p = PRESETS[currentMode as keyof typeof PRESETS];
      statPreset!.innerText = p.name;
      statTarget!.innerText = `${p.w} × ${p.h} px`;
      statGate!.innerText = p.gate;

      if (!p.safeZone) {
        safeZoneOverlay?.classList.add('hidden');
      } else if (safeZoneToggle.checked) {
        safeZoneOverlay?.classList.remove('hidden');
      }
    }

    presetServerBanner?.addEventListener('click', () => { currentMode = 'server'; updatePresetButtons(); if (currentImage) renderBanner(); });
    presetGlobalProfile?.addEventListener('click', () => { currentMode = 'global'; updatePresetButtons(); if (currentImage) renderBanner(); });
    presetServerProfile?.addEventListener('click', () => { currentMode = 'profile'; updatePresetButtons(); if (currentImage) renderBanner(); });

    safeZoneToggle?.addEventListener('change', () => {
      if (currentMode === 'server' && safeZoneToggle.checked) {
        safeZoneOverlay?.classList.remove('hidden');
      } else {
        safeZoneOverlay?.classList.add('hidden');
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            currentImage = img;
            renderBanner();
          };
          img.src = event.target?.result as string;
        };
        reader.readAsDataURL(file);
      }
    });

    function renderBanner() {
      if (!currentImage) return;
      const ctx = mainCanvas.getContext('2d');
      if (!ctx) return;

      const p = PRESETS[currentMode as keyof typeof PRESETS];
      mainCanvas.width = p.w;
      mainCanvas.height = p.h;

      // Crop to cover aspect ratio
      const imgAspect = currentImage.width / currentImage.height;
      const targetAspect = p.w / p.h;
      let sx = 0, sy = 0, sw = currentImage.width, sh = currentImage.height;

      if (imgAspect > targetAspect) {
        sw = currentImage.height * targetAspect;
        sx = (currentImage.width - sw) / 2;
      } else {
        sh = currentImage.width / targetAspect;
        sy = (currentImage.height - sh) / 2;
      }

      ctx.drawImage(currentImage, sx, sy, sw, sh, 0, 0, p.w, p.h);
      editorPanel?.classList.remove('hidden');
      receiptBadge!.innerText = 'Compliant';
      receiptBadge!.className = 'text-[10px] font-mono uppercase bg-[#10b981]/10 text-[#10b981] px-2 py-0.5 rounded';

      mainCanvas.toBlob((blob) => {
        if (blob) {
          currentBlob = blob;
          if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
          currentObjectUrl = URL.createObjectURL(blob);
        }
      }, 'image/png');
    }

    resetBtn?.addEventListener('click', () => {
      currentImage = null;
      currentBlob = null;
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      editorPanel?.classList.add('hidden');
      receiptBadge!.innerText = 'Awaiting Media';
      receiptBadge!.className = 'text-[10px] font-mono uppercase bg-[#242934] text-[#9da6b8] px-2 py-0.5 rounded';
      fileInput.value = '';
    });

    exportBtn?.addEventListener('click', () => {
      if (!currentBlob || !currentObjectUrl) return;
      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = `discord-${currentMode}-banner-${PRESETS[currentMode as keyof typeof PRESETS].w}x${PRESETS[currentMode as keyof typeof PRESETS].h}.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
  </script>
</Layout>
