---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import BannerWorkspace from '../../components/tools/BannerWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Banner Maker | Crop to Safe Zones | Asset Studio";
const pageDescription = "Free Discord banner maker for server banners and profile cards. Crop to 960x540 and 680x240 with top 48px safe zone overlays. 100% private in your browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/banner/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Banner Maker & Safe Zone Validator",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Banner Studio", url: pageUrl }
]);

const faqItems = [
  { q: "What size is a Discord banner and what are the exact Discord banner dimensions?", a: "The minimum Discord server banner size is 960x540 pixels (a widescreen 16:9 Discord banner aspect ratio). For crisp text on high-DPI Retina screens, we recommend exporting at 1920x1080. For personal profiles, Discord banner dimensions are 680x240 pixels for global profiles and 600x240 for server-specific profile cards." },
  { q: "How to change Discord server banner?", a: "To change your Discord server banner: open Discord, head to Server Settings > Overview > Server Banner Background, and upload your graphic. Static banners require Server Boost Level 2 (7 boosts), while an animated Discord banner gif requires Server Boost Level 3 (14 boosts)." },
  { q: "Why is the top 48px safe zone critical on Discord server banners?", a: "On desktop and browser apps, Discord places your server name, dropdown menu, and boost badges right over the top 48 pixels of the banner. If you place text, logos, or faces in this top strip, the buttons will cover them up. Our safe zone overlay helps you keep key elements below this line." },
  { q: "Can I use this as a Discord server banner maker for animated banners?", a: "Yes. You can use our tool as a Discord server banner maker for both animated banner discord graphics (GIFs) and static images up to 10.0 MB. Our live canvas preview shows both 16:9 server headers and panoramic 5:2 profile formats." },
  { q: "Is there a Discord banner template or resizer built in?", a: "Yes. Each preset acts as a fixed Discord banner template — pick Server (960x540) or profile banner Discord sizes (680x240 and 600x240) and the canvas locks to that exact ratio. As a Discord banner resizer, it crops and scales any uploaded artwork to fit the chosen template without stretching, then exports at the correct resolution." }
];

const dossier = {
  eyebrow: "Banner Technical Blueprint",
  heading: "Designing clean",
  highlight: "Discord banners",
  intro: "Server banners and user profile cards use completely different shapes. On desktop, Discord also puts menus over the top edge. Here is how to keep your art and text looking sharp everywhere.",
  steps: [
    "Server vs Profile Ratios",
    "The Top 48px Header Safe Zone",
    "Crisp Retina Resolution",
    "Server Boosts & Nitro Perks"
  ],
  cards: [
    {
      kicker: "RATIO MATHEMATICS // 01",
      badge: "16:9 VS 5:2 RATIOS",
      badgeTone: "emerald" as const,
      title: "Server Banners (16:9) vs User Profiles (5:2)",
      body: [
        "A common mistake is using the exact same crop for both server headers and profile banners. They use very different shapes. Discord server banners use a widescreen 16:9 Discord banner aspect ratio (at least 960×540 px), stretching across the top of your server channels.",
        "Profile banners, on the other hand, are wide and slim. Global profiles use 680×240 pixels, while per-server profile cards display at 600×240 pixels (roughly 5:2). If you paste a 16:9 server banner into your profile, Discord cuts off almost 40% of the top and bottom, which easily slices off character heads or text. This Discord banner maker gives you the exact canvas preset for both styles so you never have to guess."
      ]
    },
    {
      kicker: "INTERFACE OVERLAY // 02",
      badge: "TOP 48PX OCCLUSION",
      badgeTone: "blue" as const,
      title: "The 48px Header Safe Zone: Protecting Typography",
      body: [
        "On desktop apps and web browsers, Discord places your server name, dropdown menu, and boost badges right over the top edge of your banner. It adds a subtle dark shadow behind that text to keep it readable.",
        "This UI covers roughly the top 48 pixels (or 96 pixels on high-res Retina screens). If you put your server title, logo, or a character's face in that top strip, the Discord buttons will cover it. We show a red safe-zone overlay while you edit so you can place your important graphics where nothing blocks them."
      ],
      footer: "Active overlay prevents UI collision with Discord's server navigation elements."
    },
    {
      kicker: "RESOLUTION CRAFT // 03",
      badge: "1920 × 1080 RETINA",
      badgeTone: "amber" as const,
      title: "Retina 2x Scaling & Background Contrast Grading",
      body: [
        "Discord's official minimum spec is 960×540 pixels. That worked well years ago, but on modern MacBook Retina screens, 1440p monitors, and smartphones, a 960px image gets stretched and can look soft or blurry.",
        "We recommend exporting at 1920×1080 pixels (the exact same 16:9 shape). At 1080p, your artwork stays crystal clear on high-DPI displays. Because Discord allows files up to 10.0 MB, a clean 1080p PNG or GIF will upload easily without losing sharpness."
      ],
      footer: "Export a 1920×1080 master (16:9) — crisp on Retina, still under Discord's 10 MB cap."
    },
    {
      kicker: "PERMISSION PROTOCOLS // 04",
      badge: "BOOST LEVEL 2 & 3",
      badgeTone: "purple" as const,
      title: "Server Boost Tiers & Nitro Gating Verification",
      body: [
        "Before you export your artwork, make sure your server has unlocked the right perks. Static server banners unlock at Server Boost Level 2 (which needs 7 server boosts). Animated GIF server banners require Server Boost Level 3 (14 boosts). If your server ever loses boosts and drops below that tier, Discord hides the banner until you reach that level again.",
        "For user profiles, static banner uploads need Nitro Basic or standard Nitro, while animated banners need full Discord Nitro. Everything runs right in your browser, so you can test and crop your designs before uploading to Discord."
      ],
      footer: "Zero server uploads • in-browser 16:9 & 5:2 geometric alignment."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/banner.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Banner Studio</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Banner</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Profile Banners (680×240 & 600×240) • Server Banners (960×540 / 1920×1080) with top 48px safe zone overlay</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Zero Server Uploads
        </div>
      </div>
    </div>

    <BannerWorkspace lang="en" />

    <ToolDossier {...dossier} />

    <ToolFaq items={faqItems} />

  </div>
</Layout>
