---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
---

<Layout 
  title="Discord Banner Maker & Safe Zone Validator | 2026" 
  description="Resize and validate Discord profile and server banners with official top 48px safe zone overlays. 100% private in-browser tool."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs text-[#6B7A90] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] font-semibold">Banner Studio</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            Discord Banner <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Studio</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">Profile Banners (680x240 & 600x240) • Server Banners (960x540 / 1920x1080) with top 48px safe zone guide</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Zero Server Uploads
        </div>
      </div>
    </div>

    <!-- Banner Preset Selector -->
    <div class="card-panel rounded-[14px] p-4 mb-8 flex flex-wrap items-center gap-3">
      <span class="text-xs font-bold text-[#192538] uppercase tracking-wider mr-2">Preset Mode:</span>
      <button id="presetServerBanner" class="btn-primary text-xs px-3.5 py-2 rounded-[8px]">
        Server Banner (960 × 540)
      </button>
      <button id="presetGlobalProfile" class="btn-secondary text-xs px-3.5 py-2 rounded-[8px]">
        Global Profile Banner (680 × 240)
      </button>
      <button id="presetServerProfile" class="btn-secondary text-xs px-3.5 py-2 rounded-[8px]">
        Per-Server Profile Banner (600 × 240)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Upload & Canvas -->
      <div class="lg:col-span-8 space-y-6">
        <div id="dropzone" class="border-2 border-dashed border-[#C8DFDB] hover:border-[#3368A0] rounded-[14px] bg-[#FFFFFF] p-8 text-center transition-all cursor-pointer relative shadow-xs">
          <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
          <div class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-[12px] bg-[#C8DFDB]/50 text-[#3368A0] flex items-center justify-center mx-auto text-xl font-bold">
              🖼️
            </div>
            <p class="text-sm font-bold text-[#192538]">Select banner artwork</p>
            <p class="text-xs text-[#6B7A90]">PNG, JPG, or GIF (Auto-cropped to active preset aspect ratio)</p>
          </div>
        </div>

        <div id="editorPanel" class="card-panel rounded-[14px] p-6 hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] mb-4">
            <h2 class="text-sm font-bold text-[#192538]" id="editorTitle">Canvas Surface</h2>
            <div class="flex items-center gap-3">
              <label class="flex items-center gap-1.5 text-xs text-[#475569] font-medium cursor-pointer">
                <input type="checkbox" id="safeZoneToggle" checked class="rounded border-[#D8D3C8] text-[#3368A0]" />
                Show Top 48px Safe Zone
              </label>
              <button id="resetBtn" class="btn-secondary text-xs px-2.5 py-1 rounded-[6px]">
                Reset
              </button>
            </div>
          </div>

          <div class="relative bg-[#FAF8F5] rounded-[10px] border border-[#E0DBD0] overflow-hidden mb-6 flex items-center justify-center p-4">
            <div class="relative">
              <canvas id="mainCanvas" class="max-w-full h-auto shadow-sm rounded-[6px] bg-[repeating-conic-gradient(#EAE6DC_0%_25%,#FFFFFF_0%_50%)] [background-size:16px_16px]"></canvas>
              
              <div id="safeZoneOverlay" class="absolute top-0 left-0 right-0 h-[10%] bg-[#DC2626]/20 border-b-2 border-[#DC2626] pointer-events-none flex items-center justify-center">
                <span class="text-[10px] font-mono font-bold text-white bg-[#192538]/85 px-2.5 py-0.5 rounded shadow-xs">
                  Top 48px Header Overlay Zone (Keep text below)
                </span>
              </div>
            </div>
          </div>

          <button id="exportBtn" class="btn-primary w-full py-3.5 rounded-[10px] text-sm font-semibold flex items-center justify-center shadow-sm">
            Export Formatted Banner
          </button>
        </div>
      </div>

      <!-- Right Column: Receipt & Requirements -->
      <div class="lg:col-span-4 space-y-6">
        <div class="card-panel rounded-[14px] p-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] mb-4">
            <h2 class="text-sm font-bold text-[#192538]">Validation Receipt</h2>
            <span id="receiptBadge" class="text-[11px] font-mono uppercase bg-[#FAF8F5] text-[#6B7A90] border border-[#E0DBD0] px-2.5 py-0.5 rounded">
              Awaiting Media
            </span>
          </div>

          <div class="space-y-3 text-xs font-mono">
            <div class="flex items-center justify-between p-2.5 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Preset Mode:</span>
              <span id="statPreset" class="text-[#192538] font-bold">Server Banner</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Target Size:</span>
              <span id="statTarget" class="text-[#3368A0] font-bold">960 × 540 px</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Platform Gate:</span>
              <span id="statGate" class="text-[#D97706] font-bold">Boost Level 2</span>
            </div>

            <div class="pt-2 border-t border-[#E0DBD0] text-[11px] text-[#6B7A90] font-sans leading-relaxed">
              <strong>Official Guidance:</strong> Server Banners require Boost Level 2 (static) or Level 3 (animated). Discord overlays channel navigation over the top 48px.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const editorPanel = document.getElementById('editorPanel');
    const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const resetBtn = document.getElementById('resetBtn');
    const exportBtn = document.getElementById('exportBtn');
    const safeZoneToggle = document.getElementById('safeZoneToggle') as HTMLInputElement;
    const safeZoneOverlay = document.getElementById('safeZoneOverlay');

    const presetServerBanner = document.getElementById('presetServerBanner');
    const presetGlobalProfile = document.getElementById('presetGlobalProfile');
    const presetServerProfile = document.getElementById('presetServerProfile');

    const statPreset = document.getElementById('statPreset');
    const statTarget = document.getElementById('statTarget');
    const statGate = document.getElementById('statGate');
    const receiptBadge = document.getElementById('receiptBadge');

    let currentMode = 'server';
    let currentImage: HTMLImageElement | null = null;
    let currentBlob: Blob | null = null;
    let currentObjectUrl: string | null = null;

    const PRESETS = {
      server: { w: 960, h: 540, name: 'Server Banner', gate: 'Boost Level 2', safeZone: true },
      global: { w: 680, h: 240, name: 'Global Profile Banner', gate: 'Discord Nitro', safeZone: false },
      profile: { w: 600, h: 240, name: 'Per-Server Profile Banner', gate: 'Discord Nitro', safeZone: false }
    };

    function updatePresetButtons() {
      [presetServerBanner, presetGlobalProfile, presetServerProfile].forEach(b => {
        b?.classList.remove('btn-primary');
        b?.classList.add('btn-secondary');
      });

      if (currentMode === 'server') {
        presetServerBanner?.classList.add('btn-primary');
        presetServerBanner?.classList.remove('btn-secondary');
      } else if (currentMode === 'global') {
        presetGlobalProfile?.classList.add('btn-primary');
        presetGlobalProfile?.classList.remove('btn-secondary');
      } else {
        presetServerProfile?.classList.add('btn-primary');
        presetServerProfile?.classList.remove('btn-secondary');
      }

      const p = PRESETS[currentMode as keyof typeof PRESETS];
      statPreset!.innerText = p.name;
      statTarget!.innerText = `${p.w} × ${p.h} px`;
      statGate!.innerText = p.gate;

      if (!p.safeZone) {
        safeZoneOverlay?.classList.add('hidden');
      } else if (safeZoneToggle.checked) {
        safeZoneOverlay?.classList.remove('hidden');
      }
    }

    presetServerBanner?.addEventListener('click', () => { currentMode = 'server'; updatePresetButtons(); if (currentImage) renderBanner(); });
    presetGlobalProfile?.addEventListener('click', () => { currentMode = 'global'; updatePresetButtons(); if (currentImage) renderBanner(); });
    presetServerProfile?.addEventListener('click', () => { currentMode = 'profile'; updatePresetButtons(); if (currentImage) renderBanner(); });

    safeZoneToggle?.addEventListener('change', () => {
      if (currentMode === 'server' && safeZoneToggle.checked) {
        safeZoneOverlay?.classList.remove('hidden');
      } else {
        safeZoneOverlay?.classList.add('hidden');
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            currentImage = img;
            renderBanner();
          };
          img.src = event.target?.result as string;
        };
        reader.readAsDataURL(file);
      }
    });

    function renderBanner() {
      if (!currentImage) return;
      const ctx = mainCanvas.getContext('2d');
      if (!ctx) return;

      const p = PRESETS[currentMode as keyof typeof PRESETS];
      mainCanvas.width = p.w;
      mainCanvas.height = p.h;

      const imgAspect = currentImage.width / currentImage.height;
      const targetAspect = p.w / p.h;
      let sx = 0, sy = 0, sw = currentImage.width, sh = currentImage.height;

      if (imgAspect > targetAspect) {
        sw = currentImage.height * targetAspect;
        sx = (currentImage.width - sw) / 2;
      } else {
        sh = currentImage.width / targetAspect;
        sy = (currentImage.height - sh) / 2;
      }

      ctx.drawImage(currentImage, sx, sy, sw, sh, 0, 0, p.w, p.h);
      editorPanel?.classList.remove('hidden');
      receiptBadge!.innerText = 'Compliant';
      receiptBadge!.className = 'text-[11px] font-mono uppercase bg-[#C8DFDB]/60 text-[#0D9488] border border-[#0D9488]/30 px-2.5 py-0.5 rounded font-bold';

      mainCanvas.toBlob((blob) => {
        if (blob) {
          currentBlob = blob;
          if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
          currentObjectUrl = URL.createObjectURL(blob);
        }
      }, 'image/png');
    }

    resetBtn?.addEventListener('click', () => {
      currentImage = null;
      currentBlob = null;
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      editorPanel?.classList.add('hidden');
      receiptBadge!.innerText = 'Awaiting Media';
      receiptBadge!.className = 'text-[11px] font-mono uppercase bg-[#FAF8F5] text-[#6B7A90] border border-[#E0DBD0] px-2.5 py-0.5 rounded';
      fileInput.value = '';
    });

    exportBtn?.addEventListener('click', () => {
      if (!currentBlob || !currentObjectUrl) return;
      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = `discord-${currentMode}-banner-${PRESETS[currentMode as keyof typeof PRESETS].w}x${PRESETS[currentMode as keyof typeof PRESETS].h}.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
  </script>
</Layout>
