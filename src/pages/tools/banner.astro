---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import SketchCircle from '../../components/SketchCircle.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../utils/seo';
import BannerWorkspace from '../../components/tools/BannerWorkspace.astro';

const pageTitle = "Discord Banner Maker | Crop to Safe Zones | Asset Studio";
const pageDescription = "Free Discord banner maker for server banners and profile cards. Crop to 960x540 and 680x240 with top 48px safe zone overlays. 100% private in your browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/banner/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Banner Maker & Safe Zone Validator",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Banner Studio", url: pageUrl }
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What size is a Discord banner and what are the exact Discord banner dimensions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The minimum Discord server banner size is 960x540 pixels (a widescreen 16:9 Discord banner aspect ratio). For crisp text on high-DPI Retina screens, we recommend exporting at 1920x1080. For personal profiles, Discord banner dimensions are 680x240 pixels for global profiles and 600x240 for server-specific profile cards."
      }
    },
    {
      "@type": "Question",
      "name": "How to change Discord server banner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To change your Discord server banner: open Discord, head to Server Settings > Overview > Server Banner Background, and upload your graphic. Static banners require Server Boost Level 2 (7 boosts), while an animated Discord banner gif requires Server Boost Level 3 (14 boosts)."
      }
    },
    {
      "@type": "Question",
      "name": "Why is the top 48px safe zone critical on Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On desktop and browser apps, Discord places your server name, dropdown menu, and boost badges right over the top 48 pixels of the banner. If you place text, logos, or faces in this top strip, the buttons will cover them up. Our safe zone overlay helps you keep key elements below this line."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use this as a Discord server banner maker for animated banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can use our tool as a Discord server banner maker for both animated banner discord graphics (GIFs) and static images up to 10.0 MB. Our live canvas preview shows both 16:9 server headers and panoramic 5:2 profile formats."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a Discord banner template or resizer built in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Each preset acts as a fixed Discord banner template — pick Server (960x540) or profile banner Discord sizes (680x240 and 600x240) and the canvas locks to that exact ratio. As a Discord banner resizer, it crops and scales any uploaded artwork to fit the chosen template without stretching, then exports at the correct resolution."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/banner.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Banner Studio</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Banner</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">Profile Banners (680×240 & 600×240) • Server Banners (960×540 / 1920×1080) with top 48px safe zone overlay</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Zero Server Uploads
        </div>
      </div>
    </div>

    <BannerWorkspace lang="en" />

    <!-- Text-Locking Sticky Stacking Technical Dossier (600+ Words) -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Left Column: Pinned Progress Timeline (5 cols) -->
        <div class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30">
            <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
            <span>Banner Technical Blueprint</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight leading-[1.15]">
            Designing clean <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Discord banners</span><SketchUnderline color="#66A3BF" /></span> that fit.
          </h2>

          <p class="text-[#475569] text-sm sm:text-base leading-relaxed">
            Server banners and user profile cards use completely different shapes. On desktop, Discord also puts menus over the top edge. Here is how to keep your art and text looking sharp everywhere.
          </p>

          <!-- Step Timeline -->
          <div class="relative pl-6 space-y-5 select-none pt-2">
            <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-[#E0DBD0] dark:bg-[#263346]"></div>
            <div id="scroll-progress-line" class="absolute left-2.5 top-2 w-0.5 bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 ease-out" style="height: 0%;"></div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#3368A0] dark:text-[#66A3BF] font-bold" data-step="1">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-current bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 scale-110">1</span>
              <span class="text-xs sm:text-sm">01 / Server vs Profile Ratios</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="2">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">2</span>
              <span class="text-xs sm:text-sm">02 / The Top 48px Header Safe Zone</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="3">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">3</span>
              <span class="text-xs sm:text-sm">03 / Crisp Retina Resolution</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="4">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">4</span>
              <span class="text-xs sm:text-sm">04 / Server Boosts & Nitro Perks</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Stacking Sticky Dossier Cards (7 cols) -->
        <div class="lg:col-span-7 relative pb-16 space-y-12">
          
          <!-- Card 1 -->
          <div class="sticky-step-wrapper sticky top-24 z-10 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-lg border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">RATIO MATHEMATICS // 01</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">16:9 VS 5:2 RATIOS</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Server Banners (16:9) vs User Profiles (5:2)
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                A common mistake is using the exact same crop for both server headers and profile banners. They use very different shapes. Discord server banners use a widescreen 16:9 Discord banner aspect ratio (at least 960×540 px), stretching across the top of your server channels.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Profile banners, on the other hand, are wide and slim. Global profiles use 680×240 pixels, while per-server profile cards display at 600×240 pixels (roughly 5:2). If you paste a 16:9 server banner into your profile, Discord cuts off almost 40% of the top and bottom, which easily slices off character heads or text. This Discord banner maker gives you the exact canvas preset for both styles so you never have to guess.
              </p>
              <div class="grid grid-cols-2 gap-3 text-xs font-mono">
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Server Banner Ratio:</span>
                  <span class="font-bold text-[#192538] dark:text-white">16:9 (960×540 min)</span>
                </div>
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Profile Banner Ratio:</span>
                  <span class="font-bold text-[#192538] dark:text-white">~5:2 (680×240 / 600×240)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="sticky-step-wrapper sticky top-28 z-20 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">INTERFACE OVERLAY // 02</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#3368A0]/10 text-[#3368A0] dark:text-[#66A3BF] font-bold">TOP 48PX OCCLUSION</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                The 48px Header Safe Zone: Protecting Typography
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                On desktop apps and web browsers, Discord places your server name, dropdown menu, and boost badges right over the top edge of your banner. It adds a subtle dark shadow behind that text to keep it readable.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                This UI covers roughly the top 48 pixels (or 96 pixels on high-res Retina screens). If you put your server title, logo, or a character's face in that top strip, the Discord buttons will cover it. We show a red safe-zone overlay while you edit so you can place your important graphics where nothing blocks them.
              </p>
              <div class="p-3.5 rounded-[10px] bg-[#C8DFDB]/30 dark:bg-[#1F2E45] border border-[#66A3BF]/30 text-xs text-[#192538] dark:text-[#CBD5E1] flex items-center gap-2">
                <span class="text-[#0D9488] font-bold">✓ Safe Zone Protection:</span>
                <span>Active overlay prevents UI collision with Discord's server navigation elements.</span>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="sticky-step-wrapper sticky top-32 z-30 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">RESOLUTION CRAFT // 03</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold">1920 × 1080 RETINA</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Retina 2x Scaling & Background Contrast Grading
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Discord's official minimum spec is 960×540 pixels. That worked well years ago, but on modern MacBook Retina screens, 1440p monitors, and smartphones, a 960px image gets stretched and can look soft or blurry.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                We recommend exporting at 1920×1080 pixels (the exact same 16:9 shape). At 1080p, your artwork stays crystal clear on high-DPI displays. Because Discord allows files up to 10.0 MB, a clean 1080p PNG or GIF will upload easily without losing sharpness.
              </p>
              <div class="p-4 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] font-mono text-xs flex items-center justify-between">
                <div>
                  <span class="text-[#6B7A90]">Recommended Master:</span>
                  <span class="text-[#0D9488] font-bold ml-1">1920 × 1080 px (16:9 Retina)</span>
                </div>
                <span class="text-[#3368A0] dark:text-[#66A3BF] font-semibold">10 MB Cap</span>
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="sticky-step-wrapper sticky top-36 z-40">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">PERMISSION PROTOCOLS // 04</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-300 font-bold">BOOST LEVEL 2 & 3</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Server Boost Tiers & Nitro Gating Verification
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Before you export your artwork, make sure your server has unlocked the right perks. Static server banners unlock at Server Boost Level 2 (which needs 7 server boosts). Animated GIF server banners require Server Boost Level 3 (14 boosts). If your server ever loses boosts and drops below that tier, Discord hides the banner until you reach that level again.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                For user profiles, static banner uploads need Nitro Basic or standard Nitro, while animated banners need full Discord Nitro. Everything runs right in your browser, so you can test and crop your designs before uploading to Discord.
              </p>
              <div class="flex items-center gap-2 text-xs font-mono text-[#0D9488]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Zero Server Uploads • In-Browser 16:9 & 5:2 Geometric Alignment</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Comprehensive FAQ Accordion Section -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mb-8 text-center">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          {faqSchema.mainEntity.map((item) => (
            <div class="card-panel p-6 rounded-[14px]">
              <h3 class="text-base font-bold text-[#192538] mb-2">{item.name}</h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">{item.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

  <script>
    // Sticky Scroll Stacking & Observer Script
    function setupScrollLocking() {
      const cardWrappers = document.querySelectorAll<HTMLElement>('.sticky-step-wrapper');
      const stepIndicators = document.querySelectorAll<HTMLElement>('.scroll-step-indicator');
      const progressBar = document.getElementById('scroll-progress-line');

      if (!cardWrappers.length) return;

      function updateCardStack() {
        let activeIndex = 0;

        cardWrappers.forEach((wrapper, index) => {
          const rect = wrapper.getBoundingClientRect();
          const stickyTop = parseInt(window.getComputedStyle(wrapper).top, 10) || (96 + index * 16);
          const isLocked = rect.top <= stickyTop + 8;

          if (isLocked) {
            activeIndex = index;
          }

          const nextCard = cardWrappers[index + 1];
          if (nextCard) {
            const nextRect = nextCard.getBoundingClientRect();
            const nextStickyTop = parseInt(window.getComputedStyle(nextCard).top, 10) || (96 + (index + 1) * 16);
            const transitionDist = 180;
            
            if (nextRect.top < nextStickyTop + transitionDist) {
              const progress = Math.max(0, Math.min(1, (nextStickyTop + transitionDist - nextRect.top) / transitionDist));
              wrapper.style.transform = `scale(${1 - progress * 0.035})`;
              wrapper.style.filter = `brightness(${1 - progress * 0.08})`;
            } else {
              wrapper.style.transform = 'scale(1)';
              wrapper.style.filter = 'brightness(1)';
            }
          }
        });

        stepIndicators.forEach((ind, i) => {
          const dot = ind.querySelector('.step-dot');
          if (i <= activeIndex) {
            ind.classList.add('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.remove('text-[#6B7A90]', 'opacity-70');
            dot?.classList.add('border-current', 'scale-110');
            dot?.classList.remove('border-[#D0C9BD]', 'dark:border-[#35435C]');
          } else {
            ind.classList.remove('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.add('text-[#6B7A90]', 'opacity-70');
            dot?.classList.remove('border-current', 'scale-110');
            dot?.classList.add('border-[#D0C9BD]', 'dark:border-[#35435C]');
          }
        });

        if (progressBar) {
          const pct = (activeIndex / (cardWrappers.length - 1)) * 100;
          progressBar.style.height = `${pct}%`;
        }
      }

      window.addEventListener('scroll', updateCardStack, { passive: true });
      updateCardStack();
    }

    setupScrollLocking();
    document.addEventListener('astro:after-swap', setupScrollLocking);
  </script>
</Layout>
