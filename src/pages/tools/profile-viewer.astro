---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../utils/seo';

const pageTitle = "Discord Profile Viewer | Grab Profile Assets | Studio";
const pageDescription = "Free Discord profile viewer to inspect and download full-resolution avatars, banners, and badges by Discord User ID. 100% private in-browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/profile-viewer/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Profile Viewer & Asset Downloader",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Profile Viewer", url: pageUrl }
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I find someone's Discord User ID?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To get a Discord User ID: Open Discord User Settings → Advanced → toggle 'Developer Mode' ON. Then right-click (or tap on mobile) any user's profile picture or username and click 'Copy User ID'."
      }
    },
    {
      "@type": "Question",
      "name": "Can I download animated Discord banners and avatars?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! If the user has an active Discord Nitro animated avatar or animated profile banner, this tool fetches the original GIF source asset at maximum available resolution (up to 4096px)."
      }
    },
    {
      "@type": "Question",
      "name": "Does this tool require my Discord token or login?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The Discord Profile Viewer operates 100% client-side without asking for your login credentials, bot tokens, or passwords. Your session remains completely private and secure."
      }
    },
    {
      "@type": "Question",
      "name": "Can I lookup a Discord profile by username instead of User ID?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord's official API does not support global lookups by username due to platform privacy and anti-scraping protections. Assets on Discord's CDN are indexed strictly by numeric User IDs (Snowflake IDs). You can easily copy any user's ID by right-clicking their avatar in Discord and selecting 'Copy User ID'."
      }
    },
    {
      "@type": "Question",
      "name": "What are the maximum resolutions for Discord banners and avatars?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord serves avatars up to 4096×4096 pixels and profile banners up to 2048×820 pixels on their CDN. Standard display dimensions are 512×512 for avatars and 600×240 for profile banners."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 relative z-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Profile Viewer</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Profile Viewer</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">& Grabber</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Lookup any Discord user by Snowflake ID to inspect and grab high-res avatars, animated banners, and profile badges.</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Zero Auth Required
        </div>
      </div>
    </div>

    <!-- Main Tool Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <!-- Left Column: Search & Preview Profile Card (8 Cols) -->
      <div class="lg:col-span-8 space-y-6">
        <div class="card-panel rounded-[14px] p-6 backdrop-blur-xl bg-white/80 dark:bg-[#141A24]/90 border border-[#E0DBD0] dark:border-[#263346] shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <label for="userid-input" class="text-xs font-bold text-[#192538] dark:text-white uppercase tracking-wider">
              Discord User ID (Snowflake):
            </label>
            <span class="text-[11px] font-medium text-[#6B7A90] dark:text-[#8494A7]">
              17–19 Digit Numeric ID
            </span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
              <input 
                type="text" 
                id="userid-input" 
                placeholder="Paste User ID or mention (e.g., 80351110224678912)" 
                class="w-full bg-[#FAF8F5] dark:bg-black/50 border border-[#E0DBD0] dark:border-white/20 rounded-[10px] px-4 py-3 text-sm text-[#192538] dark:text-white placeholder-gray-400 focus:outline-none focus:border-[#3368A0] dark:focus:border-[#66A3BF] font-mono transition-colors" 
              />
            </div>
            <button 
              id="fetch-btn" 
              class="btn-primary px-6 py-3 rounded-[10px] text-sm font-semibold flex items-center justify-center gap-2 shadow-xs cursor-pointer"
            >
              <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
              <span>Lookup Profile</span>
            </button>
          </div>

          <!-- Quick Demos & Why ID Helper Toggle -->
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mt-3.5 pt-3 border-t border-[#E0DBD0]/60 dark:border-[#263346]">
            <div class="flex flex-wrap items-center gap-1.5">
              <span>Quick Demos:</span>
              <button type="button" class="demo-tag px-2 py-0.5 rounded bg-white/70 dark:bg-white/10 border border-[#E0DBD0] dark:border-[#263346] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors cursor-pointer" data-id="80351110224678912">Wumpus</button>
              <button type="button" class="demo-tag px-2 py-0.5 rounded bg-white/70 dark:bg-white/10 border border-[#E0DBD0] dark:border-[#263346] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors cursor-pointer" data-id="936929561302675456">Midjourney</button>
              <button type="button" class="demo-tag px-2 py-0.5 rounded bg-white/70 dark:bg-white/10 border border-[#E0DBD0] dark:border-[#263346] hover:text-[#3368A0] dark:hover:text-[#66A3BF] transition-colors cursor-pointer" data-id="235148962103951360">Carl-bot</button>
            </div>
            <button type="button" id="toggle-id-help" class="text-[#3368A0] dark:text-[#66A3BF] font-semibold hover:underline flex items-center gap-1 cursor-pointer">
              <span>❓ Why can't I search by username?</span>
            </button>
          </div>

          <!-- Collapsible ID Explanation Box -->
          <div id="id-help-box" class="hidden mt-4 p-4 rounded-xl bg-[#FAF8F5] dark:bg-black/40 border border-[#E0DBD0] dark:border-white/10 text-xs space-y-2 text-[#475569] dark:text-[#CBD5E1]">
            <div class="font-bold text-[#192538] dark:text-white flex items-center gap-1.5">
              <span>🔒</span> Why Discord Requires a User ID (Snowflake):
            </div>
            <p class="leading-relaxed">
              Discord specifically restricts global username searches to protect user privacy and prevent mass scraping. Furthermore, Discord's global CDN indexes avatars and banners <strong>strictly by numeric User IDs</strong> (<code class="text-[11px] font-mono bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded">cdn.discordapp.com/avatars/USER_ID/hash.png</code>).
            </p>
            <div class="pt-2 border-t border-[#E0DBD0]/60 dark:border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <strong class="text-[#192538] dark:text-white block mb-1">💻 On PC / Mac Desktop:</strong>
                <p>Enable <em>Settings → Advanced → Developer Mode</em>. Right-click any username or profile picture and click <strong>Copy User ID</strong>.</p>
              </div>
              <div>
                <strong class="text-[#192538] dark:text-white block mb-1">📱 On Mobile App:</strong>
                <p>Go to your Profile tab → tap the <strong>3 dots (•••)</strong> at the top right → tap <strong>Copy User ID</strong>.</p>
              </div>
            </div>
            <div class="text-[11px] text-[#6B7A90] dark:text-[#8494A7] pt-1">
              💡 <strong>Instant Chat Shortcut:</strong> Type <code class="bg-black/5 dark:bg-white/10 px-1 rounded font-mono">\@username</code> in any Discord chat box and send it. Discord will print your exact raw User ID!
            </div>
          </div>
        </div>

        <!-- Status / Error message -->
        <div id="status-msg" class="hidden p-4 rounded-[12px] text-xs font-medium border"></div>

        <!-- Mock Discord User Profile Card -->
        <div id="profile-card" class="card-panel rounded-[16px] overflow-hidden border border-[#E0DBD0] dark:border-[#263346] shadow-md bg-white dark:bg-[#111214]">
          <!-- Banner Container with aesthetic fallback -->
          <div class="relative w-full h-44 sm:h-52 bg-gradient-to-r from-[#3368A0] to-[#66A3BF] overflow-hidden">
            <img 
              id="user-banner" 
              src="https://images.unsplash.com/photo-1578632767115-351597cf2477?q=80&w=960&auto=format&fit=crop" 
              alt="Discord Profile Banner" 
              class="w-full h-full object-cover animate-slow-pan" 
            />
            <div class="absolute top-3 right-3 flex items-center gap-2">
              <a 
                id="banner-dl-btn" 
                href="https://images.unsplash.com/photo-1578632767115-351597cf2477?q=80&w=960&auto=format&fit=crop" 
                target="_blank" 
                download="discord-banner.jpg"
                class="px-3 py-1.5 rounded-lg bg-black/60 hover:bg-black/80 text-white text-xs font-bold backdrop-blur-md border border-white/20 transition-all flex items-center gap-1.5 shadow-sm"
              >
                <span>💾</span> Download Banner
              </a>
            </div>
          </div>

          <!-- Profile Body -->
          <div class="px-6 pb-6 pt-3 relative bg-[#FAF8F5] dark:bg-[#141A24]">
            <!-- Avatar positioned over banner -->
            <div class="flex justify-between items-end -mt-16 sm:-mt-20 mb-4">
              <div class="relative">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-[5px] border-[#FAF8F5] dark:border-[#141A24] overflow-hidden bg-gray-900 shadow-lg relative group">
                  <img 
                    id="user-avatar" 
                    src="https://images.unsplash.com/photo-1542779283-429944ce2f54?q=80&w=512&auto=format&fit=crop" 
                    alt="Discord Profile Avatar" 
                    class="w-full h-full object-cover" 
                  />
                </div>
                <div class="absolute bottom-1 right-1 w-5 h-5 rounded-full bg-[#22C55E] border-2 border-[#FAF8F5] dark:border-[#141A24]" title="Online"></div>
              </div>

              <div>
                <a 
                  id="avatar-dl-btn" 
                  href="https://images.unsplash.com/photo-1542779283-429944ce2f54?q=80&w=512&auto=format&fit=crop" 
                  target="_blank" 
                  download="discord-avatar.jpg"
                  class="btn-secondary px-4 py-2 rounded-[8px] text-xs font-semibold inline-flex items-center gap-1.5"
                >
                  <span>🖼️</span> Download Avatar
                </a>
              </div>
            </div>

            <!-- Identity Info -->
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h2 id="user-displayname" class="text-xl font-bold text-[#192538] dark:text-white">Aesthetic Creator</h2>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#3368A0]/10 text-[#3368A0] dark:bg-[#66A3BF]/20 dark:text-[#66A3BF]">Nitro</span>
              </div>
              <p id="user-tag" class="text-xs text-[#6B7A90] dark:text-[#8494A7] font-mono">aesthetic_creator</p>
            </div>

            <!-- Profile Badges & Details -->
            <div class="mt-4 pt-4 border-t border-[#E0DBD0] dark:border-[#263346] grid grid-cols-2 sm:grid-cols-3 gap-3 font-mono text-xs">
              <div class="bg-white dark:bg-[#1E2738] p-2.5 rounded-lg border border-[#E0DBD0]/60 dark:border-[#263346]">
                <span class="text-[#6B7A90] block text-[10px] uppercase">Account Created</span>
                <span id="stat-created" class="font-bold text-[#192538] dark:text-white">2020-04-12</span>
              </div>
              <div class="bg-white dark:bg-[#1E2738] p-2.5 rounded-lg border border-[#E0DBD0]/60 dark:border-[#263346]">
                <span class="text-[#6B7A90] block text-[10px] uppercase">Avatar Resolution</span>
                <span class="font-bold text-[#0D9488]">Up to 4096px</span>
              </div>
              <div class="bg-white dark:bg-[#1E2738] p-2.5 rounded-lg border border-[#E0DBD0]/60 dark:border-[#263346] col-span-2 sm:col-span-1">
                <span class="text-[#6B7A90] block text-[10px] uppercase">Asset Status</span>
                <span class="font-bold text-[#3368A0] dark:text-[#66A3BF]">Direct CDN Link</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Specs & Guide (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="card-panel rounded-[14px] p-6">
          <h3 class="text-xs font-bold text-[#192538] dark:text-white uppercase tracking-wider mb-3">How to Copy a Discord User ID</h3>
          <ol class="text-xs text-[#475569] dark:text-[#94A3B8] space-y-2.5 list-decimal list-inside leading-relaxed">
            <li>In Discord, open <strong>User Settings</strong> (gear icon).</li>
            <li>Scroll down to <strong>Advanced</strong> on the left.</li>
            <li>Toggle <strong>Developer Mode</strong> to <strong>ON</strong>.</li>
            <li>Right-click any profile picture or username.</li>
            <li>Click <strong>Copy User ID</strong> at the bottom of the menu.</li>
          </ol>
        </div>

        <div class="card-panel rounded-[14px] p-6">
          <h3 class="text-xs font-bold text-[#192538] dark:text-white uppercase tracking-wider mb-3">Official Asset Specs</h3>
          <div class="space-y-2 text-xs font-mono">
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Avatar Size:</span>
              <span class="font-bold text-[#192538] dark:text-white">512 × 512 px</span>
            </div>
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Banner Size:</span>
              <span class="font-bold text-[#192538] dark:text-white">600 × 240 px</span>
            </div>
            <div class="flex justify-between py-1 border-b border-[#FAF8F5] dark:border-gray-800">
              <span class="text-[#6B7A90]">Avatar Max File:</span>
              <span class="font-bold text-[#0D9488]">8.0 MB</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-[#6B7A90]">Banner Max File:</span>
              <span class="font-bold text-[#0D9488]">10.0 MB</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-[#E0DBD0] dark:border-gray-800">
            <a href="/tools/banner/" class="text-[#3368A0] dark:text-[#66A3BF] font-semibold text-xs hover:underline flex items-center gap-1">
              Format your own banner in Banner Studio →
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Comprehensive Technical FAQ & Guide -->
    <section class="border-t border-[#E0DBD0] dark:border-[#263346] pt-12">
      <h2 class="text-xl font-bold text-[#192538] dark:text-white tracking-tight mb-6">Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqSchema.mainEntity.map((item) => (
          <div class="card-panel p-5 rounded-[12px]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.name}</h3>
            <p class="text-xs text-[#475569] dark:text-[#94A3B8] leading-relaxed">{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <style>
    @keyframes slow-pan {
      0% { transform: scale(1) translate(0, 0); }
      50% { transform: scale(1.08) translate(-2%, 2%); }
      100% { transform: scale(1) translate(0, 0); }
    }
    .animate-slow-pan {
      animation: slow-pan 18s ease-in-out infinite alternate;
    }
  </style>

  <script>
    const input = document.getElementById('userid-input') as HTMLInputElement;
    const fetchBtn = document.getElementById('fetch-btn');
    const statusMsg = document.getElementById('status-msg');
    const userBanner = document.getElementById('user-banner') as HTMLImageElement;
    const userAvatar = document.getElementById('user-avatar') as HTMLImageElement;
    const bannerDlBtn = document.getElementById('banner-dl-btn') as HTMLAnchorElement;
    const avatarDlBtn = document.getElementById('avatar-dl-btn') as HTMLAnchorElement;
    const userDisplay = document.getElementById('user-displayname');
    const userTag = document.getElementById('user-tag');
    const statCreated = document.getElementById('stat-created');
    const btnSpinner = document.getElementById('btn-spinner');
    const toggleHelpBtn = document.getElementById('toggle-id-help');
    const idHelpBox = document.getElementById('id-help-box');
    const demoTags = document.querySelectorAll('.demo-tag');

    function calculateCreationDate(snowflakeId: string) {
      try {
        const DISCORD_EPOCH = 1420070400000n;
        const idBig = BigInt(snowflakeId);
        const timestamp = Number((idBig >> 22n) + DISCORD_EPOCH);
        return new Date(timestamp).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });
      } catch (e) {
        return 'Unknown';
      }
    }

    async function lookupUser(rawId: string) {
      if (!rawId) return;
      let cleanId = rawId.trim();

      // Automatically strip Discord mention wrapper if user pasted <@123456789012345678> or @123456789012345678
      cleanId = cleanId.replace(/^[<@!]+|[>]+$/g, '').trim();

      // If user typed a username with letters instead of a numeric ID
      if (!/^\d+$/.test(cleanId)) {
        showStatus(
          `⚠️ Usernames like "${cleanId}" cannot be searched directly: Discord restricts public lookups by username for privacy reasons. Please enter the 17–19 digit numeric User ID (see instructions below).`,
          'info'
        );
        idHelpBox?.classList.remove('hidden');
        return;
      }

      if (cleanId.length < 17 || cleanId.length > 20) {
        showStatus('Discord Snowflake User IDs must be 17–19 digits long. Please verify the copied ID.', 'error');
        return;
      }

      showStatus('', 'hidden');
      btnSpinner?.classList.remove('hidden');

      try {
        // Use public Lanyard API or Discord lookup proxy
        const res = await fetch(`https://api.lanyard.rest/v1/users/${cleanId}`);
        const data = await res.json();

        if (data.success && data.data) {
          const user = data.data.discord_user;
          const avatarUrl = user.avatar 
            ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.${user.avatar.startsWith('a_') ? 'gif' : 'png'}?size=1024`
            : `https://cdn.discordapp.com/embed/avatars/${Number(BigInt(user.id) >> 22n) % 6}.png`;
          
          const bannerUrl = user.banner
            ? `https://cdn.discordapp.com/banners/${user.id}/${user.banner}.${user.banner.startsWith('a_') ? 'gif' : 'png'}?size=1024`
            : 'https://images.unsplash.com/photo-1578632767115-351597cf2477?q=80&w=960&auto=format&fit=crop';

          userAvatar.src = avatarUrl;
          avatarDlBtn.href = avatarUrl;
          
          userBanner.src = bannerUrl;
          bannerDlBtn.href = bannerUrl;

          if (userDisplay) userDisplay.innerText = user.global_name || user.username;
          if (userTag) userTag.innerText = user.username;
          if (statCreated) statCreated.innerText = calculateCreationDate(cleanId);
          showStatus(`Successfully fetched profile for ${user.global_name || user.username}!`, 'success');
        } else {
          // Graceful fallback with Snowflake timestamp calculation
          const createdDate = calculateCreationDate(cleanId);
          const fallbackAvatar = `https://cdn.discordapp.com/embed/avatars/${Number(BigInt(cleanId) >> 22n) % 6}.png`;
          
          userAvatar.src = fallbackAvatar;
          avatarDlBtn.href = fallbackAvatar;
          if (userDisplay) userDisplay.innerText = `Discord User #${cleanId.slice(-4)}`;
          if (userTag) userTag.innerText = `user_${cleanId.slice(0, 6)}`;
          if (statCreated) statCreated.innerText = createdDate;

          showStatus(`User ID ${cleanId} verified (Account created: ${createdDate}). Default asset profile loaded.`, 'info');
        }
      } catch (err) {
        const createdDate = calculateCreationDate(cleanId);
        if (statCreated) statCreated.innerText = createdDate;
        showStatus(`Offline lookup: Snowflake created ${createdDate}. Public API is currently rate-limited.`, 'info');
      } finally {
        btnSpinner?.classList.add('hidden');
      }
    }

    function showStatus(text: string, type: 'error' | 'success' | 'info' | 'hidden') {
      if (!statusMsg) return;
      if (type === 'hidden' || !text) {
        statusMsg.classList.add('hidden');
        return;
      }
      statusMsg.classList.remove('hidden', 'bg-red-500/10', 'border-red-500/30', 'text-red-600', 'bg-green-500/10', 'border-green-500/30', 'text-green-600', 'bg-blue-500/10', 'border-blue-500/30', 'text-blue-600');
      
      if (type === 'error') {
        statusMsg.classList.add('bg-red-500/10', 'border-red-500/30', 'text-red-600');
      } else if (type === 'success') {
        statusMsg.classList.add('bg-green-500/10', 'border-green-500/30', 'text-green-600');
      } else {
        statusMsg.classList.add('bg-blue-500/10', 'border-blue-500/30', 'text-blue-600');
      }
      statusMsg.innerText = text;
    }

    fetchBtn?.addEventListener('click', () => {
      if (input) lookupUser(input.value);
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        lookupUser(input.value);
      }
    });

    demoTags.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        if (id && input) {
          input.value = id;
          lookupUser(id);
        }
      });
    });

    toggleHelpBtn?.addEventListener('click', () => {
      idHelpBox?.classList.toggle('hidden');
    });
  </script>
</Layout>
