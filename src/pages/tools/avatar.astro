---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import AvatarWorkspace from '../../components/tools/AvatarWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Avatar | Live Circle Mask Preview | Asset Studio";
const pageDescription = "Crop and preview your Discord avatar with a live circular mask. Format square 512x512 profile pictures and server icons. 100% private in-browser tool.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/avatar/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Avatar Maker & PFP Cropper",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Avatar Studio", url: pageUrl }
]);

const faqItems = [
  { q: "What size should a Discord avatar be?", a: "Export your avatar as a square 512×512 pixel image, or 1024×1024 for extra-crisp Retina displays. Discord downscales it to every size it needs, from tiny chat thumbnails to large profile popouts. The technical minimum is around 128×128, but that looks soft, so 512 is the practical sweet spot." },
  { q: "Why is my Discord profile picture blurry?", a: "Blurriness usually means the source image was too small. If you upload something near 128×128, high-density Retina screens enlarge it and the pixels smear. Re-export the same artwork at 512×512 or 1024×1024 from a square 1:1 canvas, keep the subject centered, and it will stay sharp everywhere Discord shows it." },
  { q: "What file formats and maximum size does Discord allow for avatars?", a: "Discord accepts PNG, JPG, WEBP, and GIF for avatars, with an upload limit of 8 MB. PNG is best for logos and flat art, JPG for photos, and WEBP for a smaller file at similar quality. Animated GIFs are supported too, but only for Nitro subscribers." },
  { q: "How do I make an animated Discord avatar?", a: "Animated avatars use the GIF format and require a Discord Nitro subscription to play in chat and profile popouts. Keep the file under the 8 MB limit and build it on a square 1:1 canvas with the motion centered, since the circular crop still clips the corners." },
  { q: "Why do the corners of my Discord avatar get cut off?", a: "Your upload is square, but Discord displays it inside a circle, so the four corners are always clipped. Anything near an edge — text, a logo, part of a face — can disappear. Keep the important part of your image centered, and use the live circle preview to check the framing before exporting." }
];

const dossier = {
  eyebrow: "Avatar Technical Blueprint",
  heading: "Design a Discord avatar that stays",
  highlight: "crisp and centered",
  intro: "Discord avatars are authored as a square but displayed as a circle, then downscaled to a dozen sizes across chat, member lists, and profile popouts. Here is how the source dimensions, resolution, circular crop, and format rules fit together.",
  steps: [
    "The Square 1:1 Source",
    "512px & Retina Detail",
    "The Circular Crop",
    "Formats & Nitro GIFs"
  ],
  cards: [
    {
      kicker: "CANVAS BLUEPRINT // 01",
      badge: "1:1 SQUARE",
      badgeTone: "emerald" as const,
      title: "Start from a square 1:1 source",
      body: [
        "Every Discord avatar begins life as a perfect square, even though it is shown inside a circle. Author your artwork on a 1:1 canvas so nothing is stretched when Discord fits it to the circular frame, and so what you see while editing matches what actually uploads.",
        "Export at 512×512 pixels as your baseline, or 1024×1024 when you want extra sharpness on high-density screens. Discord will downscale from there. The technical floor is roughly 128×128, but images that small look soft the moment they are enlarged, so start bigger and let Discord shrink it."
      ]
    },
    {
      kicker: "RESOLUTION CRAFT // 02",
      badge: "512 → 1024 PX",
      badgeTone: "blue" as const,
      title: "Why 512×512 or larger stays crisp",
      body: [
        "Discord renders your avatar at many sizes: a small thumbnail beside each message, an even smaller mark in the member list, and a large version in profile popouts. On Retina and other high-density displays, every one of those is drawn at two or three times the pixel density you might expect.",
        "Uploading at 512×512 — or 1024×1024 for the sharpest result — gives Discord enough detail to scale down cleanly at each of those sizes. Start from something near the 128×128 minimum and the browser has to invent pixels when it scales up, which is exactly what produces a blurry, mushy profile picture."
      ]
    },
    {
      kicker: "CIRCLE GEOMETRY // 03",
      badge: "CORNERS CLIPPED",
      badgeTone: "amber" as const,
      title: "The circular mask clips your corners",
      body: [
        "Discord always masks your square upload into a circle, which means the four corners of the image are simply never shown. Any detail that lives near an edge — a signature, an initial, the top of a character's head — can be quietly trimmed away once the crop is applied.",
        "The fix is composition: keep your focal point centered and leave a little breathing room around the edges. The live circular preview in this tool shows exactly what survives the crop before you export, so you can nudge the framing until nothing important touches the corners."
      ],
      footer: "Keep the subject centered — the corners fall outside the circle and disappear."
    },
    {
      kicker: "FORMAT & NITRO // 04",
      badge: "GIF NEEDS NITRO",
      badgeTone: "purple" as const,
      title: "PNG, JPG, WEBP, and animated GIF",
      body: [
        "Discord accepts PNG, JPG, WEBP, and GIF avatars up to 8 MB. Reach for PNG on logos and flat, high-contrast art, JPG for photographic portraits, and WEBP when you want a smaller file at comparable quality. Any of them masks cleanly into the circle as long as the source is square.",
        "Animated avatars use GIF and require a Discord Nitro subscription to play; without Nitro the first frame is shown as a static image. Keep animations under the 8 MB cap and centered. Everything in this tool runs entirely in your browser — no uploads, no account, and nothing leaves your device."
      ],
      footer: "100% in-browser — your image is cropped locally and never uploaded."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/avatar.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Avatar Studio</span>
      </div>
        <a href="/es/tools/avatar/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold" hreflang="es">🌐 Español</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Avatar</mark> & PFP <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Cropper</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">512 × 512 px authoring standard • Circular mask preview • 8 MB maximum size</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          In-Browser Processing
        </div>
      </div>
    </div>

    <!-- Asset Library Quick Callout -->
    <div class="mb-8 p-3.5 sm:p-4 rounded-2xl bg-gradient-to-r from-[#FF84BA]/10 via-[#FFDF82]/10 to-[#99C2FF]/10 dark:from-[#FF84BA]/15 dark:via-[#FFDF82]/15 dark:to-[#99C2FF]/15 border border-[#FF84BA]/30 dark:border-[#FF84BA]/40 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3">
        <span class="text-2xl">✨</span>
        <div>
          <div class="text-xs sm:text-sm font-bold text-[#192538] dark:text-[#FFEFE3] flex items-center gap-2">
            <span>Need an Avatar & Matching Banner Set?</span>
            <span class="text-[10px] font-mono font-extrabold px-1.5 py-0.2 rounded-full bg-[#FF84BA] text-black">110+ Free</span>
          </div>
          <p class="text-xs text-[#6B7A90] dark:text-[#99C2FF]">
            Browse 110+ curated avatar sets with smart circular focal zooming, anime, gaming, and cyberpunk aesthetics.
          </p>
        </div>
      </div>
      <a href="/assets/" class="shrink-0 btn-primary text-xs px-4 py-2 rounded-xl flex items-center gap-1.5 shadow-xs hover:shadow-md transition-all font-bold">
        <span>Browse Presets</span>
        <span>→</span>
      </a>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <AvatarWorkspace lang="en" />

    <!-- Sticky-scroll technical dossier (shared component) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (shared component, single source of truth with JSON-LD) -->
    <ToolFaq items={faqItems} />

  </div>
</Layout>



