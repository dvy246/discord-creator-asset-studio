---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Discord Avatar Maker & PFP Cropper | 512x512" 
  description="Crop, resize, and preview Discord avatars with a live circular mask. 512x512 square authoring with 100% private in-browser processing."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs text-[#9da6b8] mb-2 font-mono">
        <a href="/" class="hover:text-white transition-colors">Studio</a>
        <span>/</span>
        <span class="text-white">Avatar Studio</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Discord Avatar & PFP Studio</h1>
          <p class="text-xs sm:text-sm text-[#9da6b8] mt-1">512 × 512 px authoring standard • Circular mask preview • 8 MB maximum size</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#15181e] px-3 py-1.5 rounded-[8px] border border-[#2b313e] text-[#10b981]">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          In-Browser Processing
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div id="dropzone" class="border-2 border-dashed border-[#2b313e] hover:border-[#3b82f6] rounded-[12px] bg-[#15181e] p-8 text-center transition-all cursor-pointer relative">
          <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
          <div class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-[10px] bg-[#1c2028] text-[#3b82f6] flex items-center justify-center mx-auto text-xl font-bold">
              👤
            </div>
            <p class="text-sm font-semibold text-white">Select profile picture artwork</p>
            <p class="text-xs text-[#6b7385]">PNG, JPG, or GIF (Centered on 512x512 canvas)</p>
          </div>
        </div>

        <div id="editorPanel" class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">512 × 512 Canvas</h2>
            <button id="resetBtn" class="text-xs px-2.5 py-1 rounded-[6px] bg-[#1c2028] hover:bg-[#242934] border border-[#2b313e] text-[#9da6b8] hover:text-white">
              Reset
            </button>
          </div>

          <div class="flex items-center justify-center p-6 bg-[#0d0f12] rounded-[8px] border border-[#2b313e] overflow-hidden mb-6">
            <canvas id="mainCanvas" width="512" height="512" class="max-w-[256px] max-h-[256px] shadow-sm rounded-[8px] bg-[repeating-conic-gradient(#1c2028_0%_25%,#15181e_0%_50%)] [background-size:16px_16px]"></canvas>
          </div>

          <button id="exportBtn" class="w-full py-3 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors shadow-sm">
            Export Verified Avatar (512x512)
          </button>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <!-- Live Circular Mask Preview -->
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <h2 class="text-sm font-semibold text-white pb-3 border-b border-[#2b313e] mb-4">Discord Circular Mask Preview</h2>
          <div class="p-6 rounded-[8px] bg-[#313338] flex flex-col items-center justify-center">
            <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-[#5865f2] bg-[#1e1f22] flex items-center justify-center relative shadow-lg">
              <img id="circlePreviewImg" class="w-full h-full object-cover hidden" alt="Avatar Circle Mask Preview" />
              <span id="circlePlaceholder" class="text-xs text-[#949ba4] font-mono">Circle</span>
            </div>
            <span class="text-xs font-semibold text-white mt-3">Display Viewport</span>
            <span class="text-[10px] text-[#949ba4]">Discord renders avatars in circles across desktop & mobile</span>
          </div>
        </div>

        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <h2 class="text-sm font-semibold text-white pb-3 border-b border-[#2b313e] mb-4">Specification Receipt</h2>
          <div class="space-y-3 text-xs font-mono">
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Dimensions:</span>
              <span id="statDimensions" class="text-white">-- × --</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Max Size:</span>
              <span class="text-[#10b981]">8 MB</span>
            </div>
            <div class="pt-2 border-t border-[#2b313e] text-[11px] text-[#6b7385] font-sans">
              <strong>Requirement:</strong> Static avatars are free. Animated avatars (.gif) require an active Discord Nitro subscription.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const editorPanel = document.getElementById('editorPanel');
    const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const resetBtn = document.getElementById('resetBtn');
    const exportBtn = document.getElementById('exportBtn');
    const circlePreviewImg = document.getElementById('circlePreviewImg') as HTMLImageElement;
    const circlePlaceholder = document.getElementById('circlePlaceholder');
    const statDimensions = document.getElementById('statDimensions');

    let currentBlob: Blob | null = null;
    let currentObjectUrl: string | null = null;

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const ctx = mainCanvas.getContext('2d');
            if (!ctx) return;

            mainCanvas.width = 512;
            mainCanvas.height = 512;
            ctx.clearRect(0, 0, 512, 512);

            // Center square crop
            const size = Math.min(img.width, img.height);
            const sx = (img.width - size) / 2;
            const sy = (img.height - size) / 2;

            ctx.drawImage(img, sx, sy, size, size, 0, 0, 512, 512);
            editorPanel?.classList.remove('hidden');

            mainCanvas.toBlob((blob) => {
              if (blob) {
                currentBlob = blob;
                if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = URL.createObjectURL(blob);
                circlePreviewImg.src = currentObjectUrl;
                circlePreviewImg.classList.remove('hidden');
                circlePlaceholder?.classList.add('hidden');
                statDimensions!.innerText = `${img.width}×${img.height} → 512×512`;
              }
            }, 'image/png');
          };
          img.src = event.target?.result as string;
        };
        reader.readAsDataURL(file);
      }
    });

    resetBtn?.addEventListener('click', () => {
      currentBlob = null;
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      editorPanel?.classList.add('hidden');
      circlePreviewImg?.classList.add('hidden');
      circlePlaceholder?.classList.remove('hidden');
      statDimensions!.innerText = '-- × --';
      fileInput.value = '';
    });

    exportBtn?.addEventListener('click', () => {
      if (!currentBlob || !currentObjectUrl) return;
      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = 'discord-avatar-512x512.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
  </script>
</Layout>
