---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import ImageResizerWorkspace from '../../components/tools/ImageResizerWorkspace.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../utils/seo';

const pageTitle = "Discord Image Resizer | Exact Discord Sizes";
const pageDescription = "Free Discord image resizer: scale any picture to exact avatar 512x512, sticker 320x320, emoji 128x128, or 960x540 banner sizes. In-browser, zero uploads.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/image-resizer/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Image Resizer",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Image Resizer", url: pageUrl }
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the exact Discord image sizes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord expects specific pixel dimensions per asset: avatars and server icons are 512×512, custom emojis up to 128×128, stickers exactly 320×320, role icons exactly 64×64, server banners 960×540, and profile banners 680×240. This Discord image resizer includes one-click presets for each so you never have to remember the numbers."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Fit, Fill, and Stretch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fit (contain) scales the whole image inside the target and leaves transparent padding — nothing is cropped. Fill (cover) scales up until the image covers the whole frame and crops the overflow — best for avatars and banners. Stretch forces the exact dimensions and can distort the image, so use it only when the aspect ratios already match."
      }
    },
    {
      "@type": "Question",
      "name": "Does resizing upload my image to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The resizer draws your image onto an HTML canvas at the target size and exports it entirely inside your browser. Nothing is uploaded, stored, or logged, so it is safe for private or unreleased artwork."
      }
    },
    {
      "@type": "Question",
      "name": "Which format should I export for Discord?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use PNG when you need transparency (avatars, stickers, role icons). Use WebP for the smallest file when transparency is optional. Use JPEG only for full-frame photos with no transparency, since it fills the background white. After resizing, run the file through the image compressor if it needs to fit a byte limit."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/image-resizer.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Image Resizer</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Image</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Resizer</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] mt-1">One-click presets for avatar, sticker, emoji, role icon & banner sizes • Fit, fill or stretch • 100% in-browser</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-[#161F2E] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-[#263346] text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <ImageResizerWorkspace lang="en" />

    <!-- Sticky Stacking Technical Dossier (600+ Words) -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

        <div class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30">
            <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
            <span>Resize Blueprint</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight leading-[1.15]">
            Hit every <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">exact Discord size</span><SketchUnderline color="#66A3BF" /></span> in one click.
          </h2>

          <p class="text-[#475569] text-sm sm:text-base leading-relaxed">
            Discord validates several assets by exact pixel dimensions. An avatar that is 500×500 or a sticker that is 319×320 gets rejected. Presets take the guesswork out and export the precise size Discord wants.
          </p>

          <div class="relative pl-6 space-y-5 select-none pt-2">
            <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-[#E0DBD0] dark:bg-[#263346]"></div>
            <div id="scroll-progress-line" class="absolute left-2.5 top-2 w-0.5 bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 ease-out" style="height: 0%;"></div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#3368A0] dark:text-[#66A3BF] font-bold" data-step="1">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-current bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 scale-110">1</span>
              <span class="text-xs sm:text-sm">01 / One Preset per Discord Asset</span>
            </div>
            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="2">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">2</span>
              <span class="text-xs sm:text-sm">02 / Fit vs. Fill vs. Stretch</span>
            </div>
            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="3">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">3</span>
              <span class="text-xs sm:text-sm">03 / Resize Then Compress</span>
            </div>
            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="4">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">4</span>
              <span class="text-xs sm:text-sm">04 / Private, In-Browser Processing</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 relative pb-16 space-y-12">

          <div class="sticky-step-wrapper sticky top-24 z-10 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-lg border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">EXACT DIMENSIONS // 01</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">6 PRESETS</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                A Preset for Every Discord Asset
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Avatars and server icons are 512×512, custom emojis up to 128×128, stickers exactly 320×320, role icons exactly 64×64, server banners 960×540, and profile banners 680×240. Pick the preset and the resizer sets the canvas to those exact pixels — no manual math, no off-by-one rejections.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Need a size that isn't listed? Switch to Custom and type any width and height up to 4096 px.
              </p>
              <div class="p-4 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] font-mono text-xs flex items-center justify-between">
                <div>
                  <span class="text-[#6B7A90]">Avatar / icon:</span>
                  <span class="text-[#0D9488] font-bold ml-1">512 × 512 px</span>
                </div>
                <span class="text-[#3368A0] dark:text-[#66A3BF] font-semibold">Sticker: 320 × 320</span>
              </div>
            </div>
          </div>

          <div class="sticky-step-wrapper sticky top-28 z-20 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">FIT LOGIC // 02</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#3368A0]/10 text-[#3368A0] dark:text-[#66A3BF] font-bold">3 MODES</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Fit, Fill, and Stretch Explained
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Fit scales the whole image inside the target and adds transparent padding, so nothing is cropped — ideal for logos and art that must stay complete. Fill scales up until the frame is fully covered and crops the overflow — the right choice for avatars and banners where edge-to-edge coverage matters.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Stretch forces the exact dimensions regardless of aspect ratio, which can squash or elongate the image. Reach for it only when the source already matches the target ratio.
              </p>
              <div class="grid grid-cols-3 gap-3 text-xs font-mono">
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Fit:</span>
                  <span class="font-bold text-[#192538] dark:text-white">No crop</span>
                </div>
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Fill:</span>
                  <span class="font-bold text-[#192538] dark:text-white">Crops edges</span>
                </div>
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Stretch:</span>
                  <span class="font-bold text-[#192538] dark:text-white">May distort</span>
                </div>
              </div>
            </div>
          </div>

          <div class="sticky-step-wrapper sticky top-32 z-30 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">WORKFLOW // 03</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold">SIZE THEN BYTES</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Resize First, Then Compress
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Dimensions and file size are two separate checks. This tool fixes the dimensions; if the exported file also needs to slip under a byte limit — 256 KiB for emojis and role icons, 512 KiB for stickers, 10 MB for chat uploads — send it through the image compressor afterward.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Doing it in that order keeps the result as sharp as possible: resize to the exact pixels first, then shave bytes only as much as the limit demands.
              </p>
              <div class="p-3.5 rounded-[10px] bg-[#C8DFDB]/30 dark:bg-[#1F2E45] border border-[#66A3BF]/30 text-xs text-[#192538] dark:text-[#CBD5E1] flex items-center gap-2">
                <span class="text-[#0D9488] font-bold">✓ Pair the tools:</span>
                <span>Resizer sets dimensions, compressor trims bytes — both fully in-browser.</span>
              </div>
            </div>
          </div>

          <div class="sticky-step-wrapper sticky top-36 z-40">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">PRIVACY BY DESIGN // 04</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-300 font-bold">ZERO UPLOADS</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Everything Runs in Your Browser
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                The resizer uses the browser's canvas API to redraw your image at the target size and export it locally. Your file is never sent to a server, never stored, and never logged.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                That makes it safe for private screenshots, work assets, and unreleased branding. Close the tab and nothing remains.
              </p>
              <div class="flex items-center gap-2 text-xs font-mono text-[#0D9488]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>No server uploads • In-browser canvas resizing</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mb-8 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((item) => (
            <div class="card-panel p-6 rounded-[14px]">
              <h3 class="text-base font-bold text-[#192538] mb-2">{item.name}</h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">{item.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

  <script>
    function setupScrollLocking() {
      const cardWrappers = document.querySelectorAll<HTMLElement>('.sticky-step-wrapper');
      const stepIndicators = document.querySelectorAll<HTMLElement>('.scroll-step-indicator');
      const progressBar = document.getElementById('scroll-progress-line');
      if (!cardWrappers.length) return;

      function updateCardStack() {
        let activeIndex = 0;
        cardWrappers.forEach((wrapper, index) => {
          const rect = wrapper.getBoundingClientRect();
          const stickyTop = parseInt(window.getComputedStyle(wrapper).top, 10) || (96 + index * 16);
          const isLocked = rect.top <= stickyTop + 8;
          if (isLocked) activeIndex = index;

          const nextCard = cardWrappers[index + 1];
          if (nextCard) {
            const nextRect = nextCard.getBoundingClientRect();
            const nextStickyTop = parseInt(window.getComputedStyle(nextCard).top, 10) || (96 + (index + 1) * 16);
            const transitionDist = 180;
            if (nextRect.top < nextStickyTop + transitionDist) {
              const progress = Math.max(0, Math.min(1, (nextStickyTop + transitionDist - nextRect.top) / transitionDist));
              wrapper.style.transform = `scale(${1 - progress * 0.035})`;
              wrapper.style.filter = `brightness(${1 - progress * 0.08})`;
            } else {
              wrapper.style.transform = 'scale(1)';
              wrapper.style.filter = 'brightness(1)';
            }
          }
        });

        stepIndicators.forEach((ind, i) => {
          const dot = ind.querySelector('.step-dot');
          if (i <= activeIndex) {
            ind.classList.add('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.remove('text-[#6B7A90]', 'opacity-70');
            dot?.classList.add('border-current', 'scale-110');
            dot?.classList.remove('border-[#D0C9BD]', 'dark:border-[#35435C]');
          } else {
            ind.classList.remove('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.add('text-[#6B7A90]', 'opacity-70');
            dot?.classList.remove('border-current', 'scale-110');
            dot?.classList.add('border-[#D0C9BD]', 'dark:border-[#35435C]');
          }
        });

        if (progressBar) {
          const pct = (activeIndex / (cardWrappers.length - 1)) * 100;
          progressBar.style.height = `${pct}%`;
        }
      }

      window.addEventListener('scroll', updateCardStack, { passive: true });
      updateCardStack();
    }

    setupScrollLocking();
    document.addEventListener('astro:after-swap', setupScrollLocking);
  </script>
</Layout>
