---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import ColorWorkspace from '../../components/tools/ColorWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Background Color Hex Codes and Palette";
const pageDescription = "Discord background color hex codes: dark theme #313338, blurple #5865F2, status colors and more. Click to copy HEX, RGB, HSL, plus a custom color picker.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/colors/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Color Palette & Hex Picker",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Color & Hex Tool", url: pageUrl }
]);

const faqItems = [
  { q: "What color is the Discord background?", a: "In the current dark theme, Discord's primary chat background is #313338, with a slightly darker sidebar at #2B2D31 and the darkest channel rail at #1E1F22. The light theme uses #FFFFFF for the main area and #F2F3F5 for side panels. You can copy any of these hex codes from the palette above." },
  { q: "What is the Discord blurple hex code?", a: "Discord's brand blurple is #5865F2. The older, lighter blurple used before the 2021 rebrand is #7289DA, and a darker shade often used for pressed button states is #4752C4. Copy any of them from the brand swatches above in HEX, RGB, or HSL." },
  { q: "What are the Discord status colors?", a: "Online is green #23A55A, Idle is amber #F0B232, Do Not Disturb is red #F23F43, Streaming is purple #593695, and Offline or Invisible is grey #80848E. These appear on the small presence dot over a user's avatar, and each copies with one click." },
  { q: "How do I match a color to Discord's dark and light theme?", a: "Use the custom picker above to sample any color and read its exact HEX, RGB, and HSL values, then preview it against both #313338 dark and #FFFFFF light. Checking both themes ensures banners, emojis, and role icons stay readable no matter which mode a member uses." },
  { q: "What color should I use for a Discord role or embed accent?", a: "Role colors and embed side-bars take a single hex value, so pick one with enough contrast against the #313338 dark background — brand blurple #5865F2 or a saturated mid-tone reads clearly, while very dark or very light values wash out. Sample and copy any hex from the picker above." }
];

const dossier = {
  eyebrow: "Discord Color Blueprint",
  heading: "The exact hex codes behind",
  highlight: "Discord's interface",
  intro: "Discord's UI is built on a small, fixed set of hex values — the dark and light theme greys, brand blurple, and the presence dots. Knowing the exact codes lets your art, roles, and embeds sit flush with the native interface.",
  steps: [
    "Dark Theme Backgrounds",
    "Light Theme Contrast",
    "Brand Blurple",
    "Status Colors & Conversion"
  ],
  cards: [
    {
      kicker: "SURFACE HIERARCHY // 01",
      badge: "#313338 DARK",
      badgeTone: "emerald" as const,
      title: "The three greys of the dark theme",
      body: [
        "The most-searched Discord color question has a precise answer. In the dark theme most people use, the main chat area is #313338. The channel and member sidebars sit one shade darker at #2B2D31, and the far-left server rail is darkest at #1E1F22.",
        "This three-step hierarchy is why depth reads cleanly in the app. If you design a transparent PNG emoji, sticker, or role icon, previewing it against #313338 tells you exactly how it will look in most servers — dark art that would vanish on that surface becomes obvious before you upload."
      ]
    },
    {
      kicker: "THEME CONTRAST // 02",
      badge: "#FFFFFF LIGHT",
      badgeTone: "blue" as const,
      title: "Why you design for both themes at once",
      body: [
        "The light theme flips the hierarchy: the main area becomes #FFFFFF with side panels at #F2F3F5. Because a single asset is shown on both themes, an emoji or icon that looks perfect on dark can disappear on white — a light glyph on a transparent background is the classic failure.",
        "It pays to check that fine details and edges hold up on white as well as on the dark #313338 background. A subtle outline, a white die-cut border, or a shape with its own fill keeps art readable everywhere, no matter which theme the viewer has chosen."
      ]
    },
    {
      kicker: "BRAND SIGNATURE // 03",
      badge: "#5865F2 BLURPLE",
      badgeTone: "amber" as const,
      title: "Blurple, old and new",
      body: [
        "Discord's signature brand color is blurple #5865F2, adopted in the 2021 rebrand; the earlier, lighter blurple was #7289DA, and a darker #4752C4 is common for pressed button states. Matching these keeps custom graphics and embed accents consistent with the native UI.",
        "Blurple is also a safe, high-contrast choice for role colors and buttons because it was tuned to read on both themes. Copy the exact value rather than eyeballing it — a near-miss blurple looks off the moment it sits next to Discord's own chrome."
      ],
      footer: "Brand blurple #5865F2 (was #7289DA) — copy the exact value, don't eyeball it."
    },
    {
      kicker: "PRESENCE & OUTPUT // 04",
      badge: "HEX / RGB / HSL",
      badgeTone: "purple" as const,
      title: "Status dots and the custom picker",
      body: [
        "Presence dots use a fixed set: online green #23A55A, idle amber #F0B232, do-not-disturb red #F23F43, streaming purple #593695, and offline grey #80848E. Matching these values keeps status-themed graphics and role colors consistent with what members already recognize.",
        "Every swatch above copies its hex code with one click, and the custom picker converts any color to HEX, RGB, and HSL for your design tool. Sample a color once here and paste the exact value into Figma, Photoshop, or your CSS without a second conversion step."
      ],
      footer: "One click copies HEX, RGB & HSL — sample once, paste anywhere."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/colors.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Color & Hex Tool</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Background Color</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">& Hex Palette</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] mt-1">Copy dark-theme, light-theme, blurple & status hex codes • Custom HEX / RGB / HSL picker</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-[#161F2E] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-[#263346] text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Reference Values
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <ColorWorkspace lang="en" />

    <ToolDossier {...dossier} />

    <ToolFaq items={faqItems} />

  </div>
</Layout>
