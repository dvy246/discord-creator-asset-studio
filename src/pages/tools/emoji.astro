---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Discord Emoji Maker & Validator | 256 KiB Resizer" 
  description="Resize, validate, and compress Discord custom emojis to 128x128 and under 256 KiB. 100% private in-browser tool with 32x32 chat preview."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs text-[#9da6b8] mb-2 font-mono">
        <a href="/" class="hover:text-white transition-colors">Studio</a>
        <span>/</span>
        <span class="text-white">Emoji Maker & Validator</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Discord Emoji Studio</h1>
          <p class="text-xs sm:text-sm text-[#9da6b8] mt-1">Upload up to 128x128 • 32x32 live preview • Enforces strict 256 KiB binary boundary</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#15181e] px-3 py-1.5 rounded-[8px] border border-[#2b313e] text-[#10b981]">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          Local Browser Processing Only
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Upload & Canvas Controls (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- File Input Dropzone -->
        <div 
          id="dropzone" 
          class="border-2 border-dashed border-[#2b313e] hover:border-[#3b82f6] rounded-[12px] bg-[#15181e] p-8 text-center transition-all cursor-pointer relative"
        >
          <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
          <div class="space-y-3 pointer-events-none">
            <div class="w-12 h-12 rounded-[10px] bg-[#1c2028] text-[#3b82f6] flex items-center justify-center mx-auto text-xl font-bold">
              📁
            </div>
            <div>
              <p class="text-sm font-semibold text-white">Click to browse or drop emoji artwork</p>
              <p class="text-xs text-[#6b7385] mt-1">PNG, JPG, WebP, or GIF (Processed in memory)</p>
            </div>
          </div>
        </div>

        <!-- Canvas & Editor Controls -->
        <div id="editorPanel" class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">Canvas Transformation</h2>
            <div class="flex items-center gap-2">
              <button id="resetBtn" class="text-xs px-3 py-1.5 rounded-[6px] bg-[#1c2028] hover:bg-[#242934] border border-[#2b313e] text-[#9da6b8] hover:text-white transition-colors">
                Reset
              </button>
            </div>
          </div>

          <!-- Live Canvas Surface -->
          <div class="flex items-center justify-center p-6 bg-[#0d0f12] rounded-[8px] border border-[#2b313e] overflow-hidden mb-6">
            <canvas id="mainCanvas" width="128" height="128" class="max-w-[128px] max-h-[128px] shadow-sm rounded-[4px] bg-[repeating-conic-gradient(#1c2028_0%_25%,#15181e_0%_50%)] [background-size:16px_16px]"></canvas>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <button id="exportBtn" class="w-full sm:flex-1 py-3 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors flex items-center justify-center gap-2 shadow-sm">
              <span>Export Verified Emoji</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Validation Receipt & Live Discord Preview (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Live Chat Size Previews -->
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">Discord Chat Preview</h2>
            <!-- Light/Dark Preview Surface Toggle -->
            <div class="flex items-center gap-1 bg-[#1c2028] p-1 rounded-[6px] border border-[#2b313e]">
              <button id="themeDarkBtn" class="text-[11px] px-2 py-0.5 rounded bg-[#3b82f6] text-white font-medium">Dark</button>
              <button id="themeLightBtn" class="text-[11px] px-2 py-0.5 rounded text-[#9da6b8] hover:text-white font-medium">Light</button>
            </div>
          </div>

          <div id="previewSurface" class="p-4 rounded-[8px] bg-[#313338] text-white transition-colors">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-[#5865f2] flex items-center justify-center font-bold text-xs flex-shrink-0">
                User
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-xs font-semibold">Server Member</span>
                  <span class="text-[10px] text-[#949ba4]">Today at 4:20 PM</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs">Check out this custom emoji:</span>
                  <!-- 32x32 chat preview box -->
                  <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center bg-transparent">
                    <img id="chatPreviewImg" class="w-8 h-8 object-contain hidden" alt="Custom Emoji Preview" />
                    <span id="chatPreviewPlaceholder" class="text-[10px] text-[#949ba4] font-mono">32px</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Validation Receipt -->
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <div class="flex items-center justify-between pb-3 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">Validation Receipt</h2>
            <span id="receiptBadge" class="text-[10px] font-mono uppercase bg-[#242934] text-[#9da6b8] px-2 py-0.5 rounded">
              Awaiting Media
            </span>
          </div>

          <div class="space-y-3 text-xs font-mono">
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Dimensions:</span>
              <span id="statDimensions" class="text-white">-- × --</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Binary Byte Weight:</span>
              <span id="statBytes" class="text-white">-- KiB (Max 256)</span>
            </div>

            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Target Format:</span>
              <span id="statFormat" class="text-white">PNG / WebP</span>
            </div>

            <div id="receiptAlert" class="hidden p-3 rounded-[6px] text-xs font-sans">
              <!-- Alert dynamically populated -->
            </div>

            <div class="pt-2 border-t border-[#2b313e] text-[11px] text-[#6b7385] font-sans">
              <strong>Rule Authority:</strong> Discord Help Center #204849977. Verified Jan 2026. High confidence.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Tool Logic -->
  <script>
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const dropzone = document.getElementById('dropzone');
    const editorPanel = document.getElementById('editorPanel');
    const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const resetBtn = document.getElementById('resetBtn');
    const exportBtn = document.getElementById('exportBtn');
    const chatPreviewImg = document.getElementById('chatPreviewImg') as HTMLImageElement;
    const chatPreviewPlaceholder = document.getElementById('chatPreviewPlaceholder');
    const previewSurface = document.getElementById('previewSurface');
    const themeDarkBtn = document.getElementById('themeDarkBtn');
    const themeLightBtn = document.getElementById('themeLightBtn');

    const statDimensions = document.getElementById('statDimensions');
    const statBytes = document.getElementById('statBytes');
    const statFormat = document.getElementById('statFormat');
    const receiptBadge = document.getElementById('receiptBadge');
    const receiptAlert = document.getElementById('receiptAlert');

    let currentBlob: Blob | null = null;
    let sourceImage: HTMLImageElement | null = null;
    let currentObjectUrl: string | null = null;

    const MAX_EMOJI_BYTES = 256 * 1024; // 262,144 bytes

    function cleanup() {
      if (currentObjectUrl) {
        URL.revokeObjectURL(currentObjectUrl);
        currentObjectUrl = null;
      }
    }

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handleFile(file);
    });

    function handleFile(file: File) {
      cleanup();
      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          sourceImage = img;
          processEmoji(img, file);
        };
        img.src = event.target?.result as string;
      };
      reader.readAsDataURL(file);
    }

    function processEmoji(img: HTMLImageElement, originalFile: File) {
      const ctx = mainCanvas.getContext('2d');
      if (!ctx) return;

      // Target size: 128x128
      const targetSize = 128;
      mainCanvas.width = targetSize;
      mainCanvas.height = targetSize;
      ctx.clearRect(0, 0, targetSize, targetSize);

      // Maintain aspect ratio, center on canvas
      const scale = Math.min(targetSize / img.width, targetSize / img.height);
      const w = img.width * scale;
      const h = img.height * scale;
      const x = (targetSize - w) / 2;
      const y = (targetSize - h) / 2;

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, x, y, w, h);

      // Convert canvas to Blob
      mainCanvas.toBlob((blob) => {
        if (!blob) return;
        currentBlob = blob;
        cleanup();
        currentObjectUrl = URL.createObjectURL(blob);

        // Update preview image
        chatPreviewImg.src = currentObjectUrl;
        chatPreviewImg.classList.remove('hidden');
        chatPreviewPlaceholder?.classList.add('hidden');

        // Reveal editor
        editorPanel?.classList.remove('hidden');

        // Evaluate validation
        const bytes = blob.size;
        const kib = (bytes / 1024).toFixed(1);
        statDimensions!.innerText = `${img.width}×${img.height} → 128×128`;
        statBytes!.innerText = `${kib} KiB (${bytes.toLocaleString()} bytes)`;
        statFormat!.innerText = blob.type.replace('image/', '').toUpperCase();

        if (bytes <= MAX_EMOJI_BYTES) {
          receiptBadge!.innerText = 'Compliant';
          receiptBadge!.className = 'text-[10px] font-mono uppercase bg-[#10b981]/10 text-[#10b981] px-2 py-0.5 rounded';
          receiptAlert!.className = 'p-3 rounded-[6px] text-xs bg-[#10b981]/10 text-[#10b981] border border-[#10b981]/20 block';
          receiptAlert!.innerText = '✓ Pass: Exactly within the 256 KiB upload limit and 128x128 dimensions.';
        } else {
          receiptBadge!.innerText = 'Exceeds Cap';
          receiptBadge!.className = 'text-[10px] font-mono uppercase bg-[#ef4444]/10 text-[#ef4444] px-2 py-0.5 rounded';
          receiptAlert!.className = 'p-3 rounded-[6px] text-xs bg-[#ef4444]/10 text-[#ef4444] border border-[#ef4444]/20 block';
          receiptAlert!.innerText = `⚠ Warning: File size (${kib} KiB) exceeds Discord's 256 KiB cap by ${(bytes - MAX_EMOJI_BYTES).toLocaleString()} bytes.`;
        }
      }, 'image/png');
    }

    resetBtn?.addEventListener('click', () => {
      cleanup();
      currentBlob = null;
      sourceImage = null;
      editorPanel?.classList.add('hidden');
      chatPreviewImg?.classList.add('hidden');
      chatPreviewPlaceholder?.classList.remove('hidden');
      statDimensions!.innerText = '-- × --';
      statBytes!.innerText = '-- KiB';
      statFormat!.innerText = 'PNG / WebP';
      receiptBadge!.innerText = 'Awaiting Media';
      receiptBadge!.className = 'text-[10px] font-mono uppercase bg-[#242934] text-[#9da6b8] px-2 py-0.5 rounded';
      receiptAlert?.classList.add('hidden');
      fileInput.value = '';
    });

    exportBtn?.addEventListener('click', () => {
      if (!currentBlob || !currentObjectUrl) return;

      if (currentBlob.size > MAX_EMOJI_BYTES) {
        alert(`Cannot export: Final encoded Blob (${(currentBlob.size / 1024).toFixed(1)} KiB) exceeds the 256 KiB Discord limit.`);
        return;
      }

      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = 'discord-emoji-128x128.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });

    // Theme toggles
    themeDarkBtn?.addEventListener('click', () => {
      previewSurface!.className = 'p-4 rounded-[8px] bg-[#313338] text-white transition-colors';
      themeDarkBtn.className = 'text-[11px] px-2 py-0.5 rounded bg-[#3b82f6] text-white font-medium';
      themeLightBtn!.className = 'text-[11px] px-2 py-0.5 rounded text-[#9da6b8] hover:text-white font-medium';
    });

    themeLightBtn?.addEventListener('click', () => {
      previewSurface!.className = 'p-4 rounded-[8px] bg-[#ffffff] text-[#313338] transition-colors border border-[#e3e5e8]';
      themeLightBtn.className = 'text-[11px] px-2 py-0.5 rounded bg-[#3b82f6] text-white font-medium';
      themeDarkBtn!.className = 'text-[11px] px-2 py-0.5 rounded text-[#9da6b8] hover:text-white font-medium';
    });
  </script>
</Layout>
