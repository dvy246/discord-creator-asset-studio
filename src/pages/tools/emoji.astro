---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import SketchCircle from '../../components/SketchCircle.astro';
import EmojiWorkspace from '../../components/tools/EmojiWorkspace.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../utils/seo';

const pageTitle = "Discord Emoji Maker | Compress to 256KB | Asset Studio";
const pageDescription = "Resize and compress custom emojis with our Discord emoji maker. Format PNG, GIF, and animated assets under 256 KiB with instant 32x32 chat preview.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/emoji/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Emoji Maker & Validator",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Emoji Studio", url: pageUrl }
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does Discord reject custom emojis that measure under 256 KB on desktop?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB, which is exactly 262,144 bytes. Operating systems like Windows and macOS count 1 KB as 1,000 bytes. So an emoji showing as 256 KB on your computer might actually be 263,000 bytes, which Discord rejects. Discord Asset Studio checks the exact byte count so your upload works without errors."
      }
    },
    {
      "@type": "Question",
      "name": "What is the official Discord emoji size, and why author at 128x128 when chat displays 32x32?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The recommended Discord emoji size is 128x128 pixels with a 256 KiB file limit. While Discord shows inline chat emojis at 32x32 pixels, making them at 128x128 keeps them looking sharp on high-resolution phone screens and desktop monitors. Our Discord emoji resizer scales your image to 128x128 automatically."
      }
    },
    {
      "@type": "Question",
      "name": "How does transparent background handling work for custom emojis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Custom emojis look best when saved as PNG files with transparent backgrounds. If an emoji is saved with a white or gray background box, it will show an ugly square outline in Discord's dark mode. Saving with a clean alpha channel ensures your emoji looks great on both dark (#313338) and light (#FFFFFF) themes."
      }
    },
    {
      "@type": "Question",
      "name": "What image formats can be used for static and animated Discord emojis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Static custom emojis can be PNG, JPG, or WebP. For an animated Discord animated emoji, you must use GIF format under the same 256 KiB limit. When creating Discord gif emojis, keeping your animation to 20–25 FPS and reducing colors helps the file stay under 256 KiB."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Discord emoji size limit and animated emoji size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The emoji size limit is 256 KiB for both static and animated emojis, and the recommended dimensions are 128x128 pixels. The animated emoji size is the tightest constraint most people hit, since a GIF at full frame rate blows past 256 KiB quickly. Trimming frames and colors is usually enough to fit."
      }
    },
    {
      "@type": "Question",
      "name": "How do I add a custom emoji so others can copy and paste it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Upload your finished 128x128 image under Server Settings > Emoji. Once it is added, anyone in that server can use it with its :shortcode:, and members with Nitro can copy and paste it across other servers too. This maker only formats the image; the upload happens inside Discord."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/emoji.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Emoji Studio</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Emoji</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">128×128 authoring canvas • 32×32 live chat preview • Strict 256 KiB binary ceiling</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing Only
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component) -->
    <EmojiWorkspace lang="en" />

    <!-- Cross-link guide box (kept in-page: links differ per locale) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <div class="lg:col-span-7"></div>
      <div class="lg:col-span-5">
        <div class="card-panel rounded-[14px] p-6">
          <h3 class="text-xs font-bold text-[#192538] uppercase tracking-wider mb-2">Technical Guides</h3>
          <p class="text-xs text-[#475569] leading-relaxed mb-3">
            Compare emoji limits with stickers and banners, or learn palette quantization techniques for animated GIF emojis.
          </p>
          <div class="pt-2 border-t border-[#E0DBD0] dark:border-[#263346] flex flex-col gap-1.5 text-xs font-medium">
            <a href="/guides/discord-sizes/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline flex items-center gap-1">
              <span>📖</span> Discord Asset Sizes Cheat Sheet
            </a>
            <a href="/guides/discord-gif-guide/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline flex items-center gap-1">
              <span>✨</span> Animated Emoji 256 KiB GIF Guide
            </a>
            <a href="/blog/how-to-make-discord-stickers/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline flex items-center gap-1">
              <span>🏷️</span> How to Make Custom Discord Stickers
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Text-Locking Sticky Stacking Technical Dossier (600+ Words) -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Left Column: Pinned Progress Timeline (5 cols) -->
        <div class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30">
            <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
            <span>Emoji Guide</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight leading-[1.15]">
            Create clean, <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">crisp</span><SketchUnderline color="#66A3BF" /></span> Discord emojis.
          </h2>

          <p class="text-[#475569] text-sm sm:text-base leading-relaxed">
            From the strict 256 KiB file limit to how emojis look inside 32px chat, here is how to make sure your custom emojis look great on every device.
          </p>

          <!-- Step Timeline -->
          <div class="relative pl-6 space-y-5 select-none pt-2">
            <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-[#E0DBD0] dark:bg-[#263346]"></div>
            <div id="scroll-progress-line" class="absolute left-2.5 top-2 w-0.5 bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 ease-out" style="height: 0%;"></div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#3368A0] dark:text-[#66A3BF] font-bold" data-step="1">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-current bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 scale-110">1</span>
              <span class="text-xs sm:text-sm">01 / The 256 KiB File Cap</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="2">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">2</span>
              <span class="text-xs sm:text-sm">02 / 32px Chat Scaling</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="3">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">3</span>
              <span class="text-xs sm:text-sm">03 / Clean Transparent Edges</span>
            </div>

            <div class="scroll-step-indicator flex items-center gap-3.5 text-[#6B7A90] opacity-70" data-step="4">
              <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10">4</span>
              <span class="text-xs sm:text-sm">04 / 100% In-Browser Privacy</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Stacking Sticky Dossier Cards (7 cols) -->
        <div class="lg:col-span-7 relative pb-16 space-y-12">
          
          <!-- Card 1 -->
          <div class="sticky-step-wrapper sticky top-24 z-10 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-lg border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">GUIDE // 01</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">262,144 BYTES MAX</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                The 256 KiB Limit vs Decimal Kilobytes
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                The most common reason Discord rejects an emoji is file size math. Operating systems like Windows and macOS calculate file sizes in decimal units: 1 kilobyte (KB) equals 1,000 bytes. Discord, however, counts in binary kibibytes (KiB), where 1 KiB equals 1,024 bytes.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                That sets Discord's hard ceiling at exactly 262,144 bytes. An image showing as "256 KB" on your desktop might actually contain 262,800 bytes. Discord checks the raw byte length and rejects the file right away. Our studio checks the exact byte count before you export, so you never get that generic upload failure.
              </p>
              <div class="p-4 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] font-mono text-xs flex items-center justify-between">
                <div>
                  <span class="text-[#6B7A90]">Real Upload Ceiling:</span>
                  <span class="text-[#0D9488] font-bold ml-1">262,144 Bytes (256 KiB)</span>
                </div>
                <span class="text-[#3368A0] dark:text-[#66A3BF] font-semibold">Strict API Limit</span>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="sticky-step-wrapper sticky top-28 z-20 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">DESIGN TIPS // 02</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#3368A0]/10 text-[#3368A0] dark:text-[#66A3BF] font-bold">128px → 32px CHAT</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Why 32px Chat Scaling Matters
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                You can upload emojis up to 128x128 pixels, but Discord shrinks them to 32x32 pixels in normal chat (and 48x48 pixels when sent as a standalone jumbo emote). When an image shrinks that much, 75% of its pixel grid is condensed by the app's rendering engine. Using a dedicated Discord emoji resizer lets you preview chat readability beforehand.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Tiny details, thin 1-pixel outlines, and faint color gradients that look great full-size can easily become blurry smudges in fast chat. Sticking to the standard 128x128 Discord emoji size with bold silhouettes and solid contrast ensures your emotes stay readable and fun.
              </p>
              <div class="grid grid-cols-2 gap-3 text-xs font-mono">
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Inline Chat Size:</span>
                  <span class="font-bold text-[#192538] dark:text-white">32 × 32 px</span>
                </div>
                <div class="p-3 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
                  <span class="text-[#6B7A90] block text-[10px]">Jumbo Message Size:</span>
                  <span class="font-bold text-[#192538] dark:text-white">48 × 48 px</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="sticky-step-wrapper sticky top-32 z-30 mb-16">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">CLEAN EDGES // 03</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold">TRANSPARENT ALPHA</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Avoid White Halos on Dark Mode
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Discord users switch between dark mode (#313338), light mode (#FFFFFF), and custom Nitro themes. An emoji created with a solid square background or feathered semi-transparent edges blended against white will produce an unsightly white halo ring when posted in dark mode chats.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Discord Asset Studio preserves full 32-bit RGBA transparency. Our export isolates transparent pixel edges, avoids color bleeding, and lets you preview your emoji against both light and dark backgrounds so it looks crisp wherever it is posted.
              </p>
              <div class="p-3.5 rounded-[10px] bg-[#C8DFDB]/30 dark:bg-[#1F2E45] border border-[#66A3BF]/30 text-xs text-[#192538] dark:text-[#CBD5E1] flex items-center gap-2">
                <span class="text-[#0D9488] font-bold">✓ Dual-Theme Verified:</span>
                <span>Tested for both #313338 Dark and #FFFFFF Light backgrounds.</span>
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="sticky-step-wrapper sticky top-36 z-40">
            <div class="card-panel p-6 sm:p-8 rounded-[18px] shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
              <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
                <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">PRIVACY FIRST // 04</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-300 font-bold">LOCAL BROWSER ONLY</span>
              </div>
              <h3 class="text-lg sm:text-xl font-extrabold text-[#192538] mb-3">
                Zero Cloud Uploads & Total Privacy
              </h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                Many online converters send your original artwork to third-party cloud servers. If you are preparing unreleased branding, community emotes, or private illustrations, that introduces unnecessary privacy risks. Discord Asset Studio runs 100% in your local browser memory.
              </p>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                When you drop an image here, your browser creates a local temporary URL. The file bytes remain on your computer or phone. We calculate dimensions, scale the image, and export the final PNG without sending a single byte across the internet.
              </p>
              <div class="flex items-center gap-2 text-xs font-mono text-[#0D9488]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Zero Cloud Storage • Zero File Tracking • Private by Design</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- How-To Steps: capture "how to make discord emoji" intent -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] dark:text-white tracking-tight mb-3 text-center">
          How to Make a Discord Emoji
        </h2>
        <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed text-center max-w-2xl mx-auto mb-8">
          Turn any image into a server-ready custom emoji in under a minute. Formatting happens here in your browser; the final upload happens inside Discord's Server Settings.
        </p>
        <ol class="space-y-4">
          <li class="card-panel p-5 rounded-[14px] flex gap-4 items-start">
            <span class="shrink-0 w-8 h-8 rounded-full bg-[#3368A0]/10 dark:bg-[#66A3BF]/20 text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center font-mono font-bold text-sm">1</span>
            <div>
              <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-1">Upload your image</h3>
              <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">Drop a PNG, JPG, WebP, or GIF into the canvas above. Bold, high-contrast art with a clear silhouette reads best once it shrinks to 32×32 in chat.</p>
            </div>
          </li>
          <li class="card-panel p-5 rounded-[14px] flex gap-4 items-start">
            <span class="shrink-0 w-8 h-8 rounded-full bg-[#3368A0]/10 dark:bg-[#66A3BF]/20 text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center font-mono font-bold text-sm">2</span>
            <div>
              <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-1">Resize to 128×128 and check the byte count</h3>
              <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">The studio scales to the recommended 128×128 canvas and shows the exact encoded size. Keep it under the 256 KiB (262,144-byte) ceiling — for animated GIF emojis, drop to 20–25 FPS and fewer colors to fit.</p>
            </div>
          </li>
          <li class="card-panel p-5 rounded-[14px] flex gap-4 items-start">
            <span class="shrink-0 w-8 h-8 rounded-full bg-[#3368A0]/10 dark:bg-[#66A3BF]/20 text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center font-mono font-bold text-sm">3</span>
            <div>
              <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-1">Preview on dark and light, then export</h3>
              <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">Confirm the transparent edges look clean on both themes so there is no white halo, then download the final PNG or GIF.</p>
            </div>
          </li>
          <li class="card-panel p-5 rounded-[14px] flex gap-4 items-start">
            <span class="shrink-0 w-8 h-8 rounded-full bg-[#3368A0]/10 dark:bg-[#66A3BF]/20 text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center font-mono font-bold text-sm">4</span>
            <div>
              <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-1">Add it in Discord Server Settings</h3>
              <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">In Discord, open <strong>Server Settings &gt; Emoji &gt; Upload Emoji</strong>, pick your exported file, and give it a <code>:shortcode:</code>. You need the <strong>Manage Emojis and Stickers</strong> permission. Once saved, everyone in the server can use it.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Comprehensive FAQ Accordion Section -->
    <section class="py-16 border-t border-[#E0DBD0] dark:border-[#263346]">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mb-8 text-center">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          {faqSchema.mainEntity.map((item) => (
            <div class="card-panel p-6 rounded-[14px]">
              <h3 class="text-base font-bold text-[#192538] mb-2">{item.name}</h3>
              <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">{item.acceptedAnswer.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

  <!-- Sticky Scroll Tracking Script (tool logic lives in EmojiWorkspace.astro) -->
  <script>
    // Sticky Scroll Stacking & Observer Script
    function setupScrollLocking() {
      const cardWrappers = document.querySelectorAll<HTMLElement>('.sticky-step-wrapper');
      const stepIndicators = document.querySelectorAll<HTMLElement>('.scroll-step-indicator');
      const progressBar = document.getElementById('scroll-progress-line');

      if (!cardWrappers.length) return;

      function updateCardStack() {
        let activeIndex = 0;

        cardWrappers.forEach((wrapper, index) => {
          const rect = wrapper.getBoundingClientRect();
          const stickyTop = parseInt(window.getComputedStyle(wrapper).top, 10) || (96 + index * 16);
          const isLocked = rect.top <= stickyTop + 8;

          if (isLocked) {
            activeIndex = index;
          }

          // Smoothly scale previous locked cards as next card arrives
          const nextCard = cardWrappers[index + 1];
          if (nextCard) {
            const nextRect = nextCard.getBoundingClientRect();
            const nextStickyTop = parseInt(window.getComputedStyle(nextCard).top, 10) || (96 + (index + 1) * 16);
            const transitionDist = 180;
            
            if (nextRect.top < nextStickyTop + transitionDist) {
              const progress = Math.max(0, Math.min(1, (nextStickyTop + transitionDist - nextRect.top) / transitionDist));
              wrapper.style.transform = `scale(${1 - progress * 0.035})`;
              wrapper.style.filter = `brightness(${1 - progress * 0.08})`;
            } else {
              wrapper.style.transform = 'scale(1)';
              wrapper.style.filter = 'brightness(1)';
            }
          }
        });

        stepIndicators.forEach((ind, i) => {
          const dot = ind.querySelector('.step-dot');
          if (i <= activeIndex) {
            ind.classList.add('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.remove('text-[#6B7A90]', 'opacity-70');
            dot?.classList.add('border-current', 'scale-110');
            dot?.classList.remove('border-[#D0C9BD]', 'dark:border-[#35435C]');
          } else {
            ind.classList.remove('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.add('text-[#6B7A90]', 'opacity-70');
            dot?.classList.remove('border-current', 'scale-110');
            dot?.classList.add('border-[#D0C9BD]', 'dark:border-[#35435C]');
          }
        });

        if (progressBar) {
          const pct = (activeIndex / (cardWrappers.length - 1)) * 100;
          progressBar.style.height = `${pct}%`;
        }
      }

      window.addEventListener('scroll', updateCardStack, { passive: true });
      updateCardStack();
    }

    setupScrollLocking();
    document.addEventListener('astro:after-swap', setupScrollLocking);
  </script>
</Layout>
