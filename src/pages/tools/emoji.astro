---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import EmojiWorkspace from '../../components/tools/EmojiWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Emoji Maker | Compress to 256KB | Asset Studio";
const pageDescription = "Resize and compress custom emojis with our Discord emoji maker. Format PNG, GIF, and animated assets under 256 KiB with instant 32x32 chat preview.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/emoji/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Emoji Maker & Validator",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Emoji Studio", url: pageUrl }
]);

const faqItems = [
  { q: "What size should a Discord emoji be, and why upload at 128×128 if chat shows 32px?", a: "Upload custom emoji at 128×128 pixels, a 1:1 square. Discord downscales them to roughly 32×32 in chat and about 48×48 when sent alone, but authoring at the full 128×128 keeps them crisp on high-density phone and desktop screens. Keep the file under 256 KiB. This maker resizes to 128×128 automatically." },
  { q: "Why is my Discord emoji blurry or pixelated in chat?", a: "Chat shrinks your 128×128 upload to about 32 pixels, so thin outlines, small text, and fine gradients collapse into mush. Design with a bold silhouette, solid colors, and a stroke of at least 2 pixels at 128px scale. A clean transparent background also stops white halos in dark mode." },
  { q: "How many emoji slots does a Discord server have?", a: "Every server starts with 50 custom emoji slots. Server Boosting raises that cap: Level 1 unlocks 100 slots, Level 2 unlocks 150, and Level 3 unlocks 250. If a server loses boosts and drops a tier, emoji beyond the new limit are disabled until you free up slots or re-boost." },
  { q: "Do animated emoji need Discord Nitro?", a: "Animated emoji must be GIF files under the same 256 KiB limit. Per Discord's rules, posting an animated emoji requires Nitro, and using any custom emoji outside the server that owns it also requires Nitro. Static custom emoji, by contrast, work for everyone inside their home server with no subscription." },
  { q: "Why does Discord reject an emoji that shows under 256 KB on my computer?", a: "Your operating system reports size in decimal kilobytes (1 KB = 1,000 bytes), but Discord enforces binary kibibytes (1 KiB = 1,024 bytes), a hard ceiling of 262,144 bytes. A file listed as '256 KB' can hold 262,800 bytes and be refused. This studio checks the exact byte count before you export." }
];

const dossier = {
  eyebrow: "Emoji Technical Blueprint",
  heading: "Custom emoji that stay sharp at",
  highlight: "32 pixels",
  intro: "A custom emoji is authored at 128×128 but lives at about 32 pixels in chat, under a strict 256 KiB cap. Here is how the size limit, downscaling, transparency, and Discord's slot and Nitro rules fit together.",
  steps: [
    "The 256 KiB File Cap",
    "128px → 32px Chat Scaling",
    "Transparent Edges & Formats",
    "Slots, Nitro & Naming"
  ],
  cards: [
    {
      kicker: "FILE SIZE MATH // 01",
      badge: "262,144 BYTES",
      badgeTone: "emerald" as const,
      title: "The 256 KiB ceiling vs decimal kilobytes",
      body: [
        "The most common reason Discord rejects a custom emoji is a file-size mismatch. Windows and macOS report sizes in decimal kilobytes, where 1 KB equals 1,000 bytes, but Discord measures in binary kibibytes, where 1 KiB equals 1,024 bytes. That sets a hard ceiling of exactly 262,144 bytes.",
        "An image your desktop labels '256 KB' can actually contain 262,800 bytes, and Discord checks the raw byte length and refuses it instantly. This studio measures the encoded size before you export, so you fix an oversize file here instead of guessing after a failed upload."
      ],
      footer: "Real upload ceiling: 262,144 bytes — checked before you export."
    },
    {
      kicker: "DISPLAY SCALING // 02",
      badge: "128px → 32px",
      badgeTone: "blue" as const,
      title: "Why emoji are authored at 128px but seen at 32px",
      body: [
        "You upload at 128×128 pixels, yet Discord renders inline emoji at roughly 32×32 in chat, and about 48×48 when one is sent on its own as a jumbo emote. Shrinking that far throws away around three-quarters of your pixel grid, so anything delicate is lost.",
        "Thin one-pixel outlines, small lettering, and soft gradients that look sharp at full size turn into blurry smudges once chat compresses them. Favor a bold silhouette, solid fills, and strong contrast so the emote still reads at a glance. The live 32px preview here shows exactly how it will land before you commit."
      ]
    },
    {
      kicker: "CLEAN EDGES // 03",
      badge: "PNG · GIF · TRANSPARENT",
      badgeTone: "amber" as const,
      title: "Transparent PNGs and choosing the right format",
      body: [
        "Static emoji can be PNG, JPG, or GIF, but a transparent PNG is the safest choice. Discord members read chat in dark mode (#313338), light mode, and custom themes, so an emoji baked onto a solid or semi-transparent box shows an ugly halo ring on darker backgrounds.",
        "Keeping a clean 32-bit alpha channel lets the same emote sit naturally on any theme. For motion, use a GIF and keep it lean — trimming frames and reducing the color palette is usually what pulls an animation back under the 256 KiB cap. This tool previews your art on both light and dark before export."
      ],
      footer: "Dual-theme check: no white halo on #313338 dark or light backgrounds."
    },
    {
      kicker: "SLOTS & PERMISSIONS // 04",
      badge: "50 → 250 SLOTS",
      badgeTone: "purple" as const,
      title: "Slots, Nitro rules, and emoji names",
      body: [
        "Before you export, know where the emote will live. A server starts with 50 emoji slots and Boosting raises the cap to 100, 150, or 250 at Levels 1, 2, and 3. Names must be 2–32 characters using only letters, numbers, and underscores, and you need the Manage Expressions permission to add one.",
        "Nitro governs usage, not upload: members need Nitro to post animated emoji and to use any custom emoji outside its home server. Everything here runs entirely in your browser — your image never leaves your device — so you can size, preview, and export privately, then add the file inside Discord's Server Settings."
      ],
      footer: "100% in-browser · nothing uploaded until you add it in Discord."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/emoji.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Emoji Studio</span>
      </div>
        <a href="/es/tools/emoji/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold" hreflang="es">🌐 Español</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Emoji</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">128×128 authoring canvas • 32×32 live chat preview • Strict 256 KiB binary ceiling</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing Only
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component) -->
    <EmojiWorkspace lang="en" />

    <!-- Sticky-scroll technical dossier (shared component) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (shared component, single source of truth with JSON-LD) -->
    <ToolFaq items={faqItems} />

  </div>
</Layout>
