---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import EmojiCopyPasteWorkspace from '../../components/tools/EmojiCopyPasteWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Emoji Copy Paste Board | Unicode";
const pageDescription = "Discord emoji copy paste board: click any Unicode emoji or kaomoji to copy it, then paste into chat. Smileys, hearts, symbols, animals and more. No uploads.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/emoji-copy-paste/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Emoji Copy Paste Board",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Emoji Copy & Paste", url: pageUrl }
]);

const faqItems = [
  { q: "How do I copy and paste emojis in Discord?", a: "Click any emoji on this board to copy it to your clipboard, then paste it into the Discord message box with Ctrl+V on Windows or Cmd+V on Mac. These are standard Unicode emoji, so they render on desktop, web, and mobile with no upload and no Nitro. Stack several clicks to build a full reaction." },
  { q: "What's the difference between Unicode and custom Discord emojis?", a: "Unicode emoji are built into every device and free for anyone to type or paste anywhere, including nicknames. Custom Discord emoji are images uploaded to one specific server, capped at 128×128 pixels and 256 KiB, limited by that server's slots, and usable elsewhere only with Nitro. Use this board for quick reactions; use the Emoji Maker to build a custom server emoji." },
  { q: "Can I use emojis in Discord without Nitro?", a: "Yes. Every Unicode emoji on this board is completely free and works on any account, in any server or DM, and even in usernames and nicknames. Nitro is only needed to reuse another server's custom emoji or to post custom animated emoji — never for the standard Unicode emoji you copy here." },
  { q: "What are kaomoji (Japanese text faces)?", a: "Kaomoji are Japanese-style text faces built from Unicode characters rather than images, like the shrug ¯\\_(ツ)_/¯ or the table flip (╯°□°）╯︵ ┻━┻. Because they are plain text, they paste and render anywhere in Discord — messages, nicknames, and your About Me — with no Nitro or server support. This board keeps the most popular ones ready to copy." },
  { q: "How do I type the shrug emoji ¯\\_(ツ)_/¯ in Discord?", a: "The shrug ¯\\_(ツ)_/¯ is not one emoji but a kaomoji — a string of Unicode characters — so it is easiest to copy it whole. Click it on this board and paste with Ctrl+V or Cmd+V; the whole face lands intact, no Nitro or custom upload needed. It works in messages, nicknames, and your About Me." }
];

const dossier = {
  eyebrow: "Emoji Copy & Paste Playbook",
  heading: "From one click to",
  highlight: "emoji that paste anywhere",
  intro: "Every glyph here is a standard Unicode emoji or kaomoji, copied with a single click and pasted anywhere in Discord. Here is how the copy mechanic, the Unicode-versus-custom tradeoff, text faces, and the no-Nitro, all-local promise fit together — no account required.",
  steps: [
    "Copy Mechanics",
    "Unicode vs Custom",
    "Kaomoji & Text Faces",
    "Free, No Nitro"
  ],
  cards: [
    {
      kicker: "COPY MECHANICS // 01",
      badge: "CLICK TO COPY",
      badgeTone: "emerald" as const,
      title: "One click lands any emoji on your clipboard",
      body: [
        "Every glyph on this board is a standard Unicode emoji, so a single click copies it straight to your clipboard — no dialog, no download, and no sign-in. Paste it into a Discord message with Ctrl+V on Windows or Cmd+V on macOS and it appears instantly, exactly as you saw it here. The same copied character drops just as cleanly into a channel post, a direct message, a thread reply, or the search bar. Because the copy fires the moment you click, you can grab several emoji in a row and build a whole reaction string one tap at a time before switching back to Discord.",
        "Unicode emoji render everywhere because they belong to the character set already built into Windows, macOS, Android, and iOS. Discord just draws the version your device ships, so a face or heart you copy here looks right to every friend reading the channel, whatever platform they are on. Nothing is uploaded and nothing is attached, which means these emoji never touch a server's limited custom-emoji slots — you are typing a character, not sending an image. That keeps the message lightweight and makes it show up identically on desktop, web, and phone, with no waiting for an image to load."
      ]
    },
    {
      kicker: "UNICODE VS CUSTOM // 02",
      badge: "128×128 · 256 KiB",
      badgeTone: "blue" as const,
      title: "How Unicode emoji differ from custom uploads",
      body: [
        "A custom Discord emoji is an image you upload to one specific server, and it lives under strict limits: each file must be 128×128 pixels or smaller and weigh no more than 256 KiB, and every server has a fixed number of emoji slots to fill. Once uploaded, that emoji works only inside the server where it was installed — members browsing from other servers cannot see it or type it by name. Custom emoji are great for branding a community with a logo or an inside joke, but each one costs a slot, needs managing, and stays tied to the single place you added it.",
        "The Unicode emoji on this board sidestep all of that. They belong to no server, occupy no slots, and are free for every account, so you can drop them into any server or DM the instant you paste. Crucially, they never require Nitro. Reusing one server's custom emoji in a different server is a Nitro-only perk, but a Unicode smiley or heart behaves the same everywhere with no subscription. Unicode emoji also reach places custom ones cannot — straight into your username, your nickname, or your About Me — because they are plain text characters rather than server-scoped image attachments."
      ]
    },
    {
      kicker: "KAOMOJI & TEXT FACES // 03",
      badge: "PLAIN TEXT",
      badgeTone: "amber" as const,
      title: "Japanese text faces built from Unicode",
      body: [
        "Kaomoji are the Japanese-style text faces assembled entirely from Unicode characters — the shrug ¯\\_(ツ)_/¯, the table flip (╯°□°）╯︵ ┻━┻, and dozens of moods in between. Nothing here is an image: each face is punctuation, brackets, and symbols strung together into an expression, which is exactly why they have traveled across every chat app for years. This board keeps the most-used faces a single click away, so you never have to hunt down the right run of characters or memorize an unbalanced string of parentheses, arrows, and katakana just to flip a table.",
        "Because a kaomoji is only text, it pastes cleanly into places a picture emoji or custom upload cannot reach. Drop one into a channel message, a thread, a server nickname, your global display name, or your About Me, and it renders as the same characters for everyone — no Nitro, no server support, and no rendering surprises. A single Ctrl+V or Cmd+V places the whole face at once, so a table flip arrives intact instead of a scrambled half-string. Use the filter box to jump straight to the face you want and copy it in one tap, all in your browser."
      ],
      footer: "Every kaomoji is plain Unicode text — it pastes intact into messages, nicknames, and your About Me."
    },
    {
      kicker: "FREE, NO NITRO // 04",
      badge: "100% LOCAL",
      badgeTone: "purple" as const,
      title: "Free, private, and entirely in your browser",
      body: [
        "This board asks for nothing: no login, no Nitro subscription, and no upload step. Every emoji and kaomoji is already loaded in the page, and clicking one copies it through your browser's own clipboard — the character never leaves your device, and nothing you copy is logged or sent to a server. Because the work is entirely local, the board stays fast and keeps working even on a shaky connection, and there is no history for anyone to mine later. Copy as many emoji as you like, as often as you like, without ever creating an account or bumping into a rate limit.",
        "Unicode emoji cover reactions and text faces, but sometimes you want a branded image emoji for your own server — a logo, a mascot, or an inside joke. That is a different job, and the Emoji Maker at /tools/emoji/ handles it: it resizes your artwork to the exact 128×128 pixel, 256 KiB limit Discord requires, so the upload is accepted on the first try. Reach for this copy-and-paste board when you need a quick, universal reaction that works for everyone, and switch to the Emoji Maker when you want to add a custom emoji slot to a server you manage."
      ],
      footer: "Need a custom image emoji? The Emoji Maker at /tools/emoji/ resizes art to Discord's 128×128, 256 KiB limit."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/emoji-copy-paste.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Emoji Copy & Paste</span>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Emoji Copy Paste</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Board</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-[#94A3B8] mt-1">One-click copy for Unicode emojis & kaomoji • Works without Nitro • Paste anywhere</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-[#161F2E] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-[#263346] text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <EmojiCopyPasteWorkspace lang="en" />

    <ToolDossier {...dossier} />

    <ToolFaq items={faqItems} />

  </div>
</Layout>
