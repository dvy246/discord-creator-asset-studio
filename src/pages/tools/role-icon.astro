---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import RoleIconWorkspace from '../../components/tools/RoleIconWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Role Icon Maker | Exact 64x64 Resize | Asset Studio";
const pageDescription = "Create server badges with our Discord role icon maker. Resize PNG and JPEG graphics to exact 64x64 pixels under 256 KB. 100% private in your browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/role-icon/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Role Icon Maker & Resizer",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Role Icon Studio", url: pageUrl }
]);

const faqItems = [
  { q: "What size is a Discord role icon?", a: "Role icons should be uploaded as a 64×64 pixel square and kept under 256 KB. Discord then shrinks them to roughly 16–20 pixels beside usernames, so starting from a clean 64×64 file keeps the badge crisp on high-resolution screens while staying within the size limit." },
  { q: "How do I add an icon to a Discord role?", a: "Open Server Settings → Roles, select the role you want, and go to its Display tab. From there you can upload a custom 64×64 image or pick a standard emoji as the icon, then save. The badge appears next to every member who holds that role." },
  { q: "Do you need boosts for role icons?", a: "Yes. Custom role icons require the server to reach Server Boost Level 2, which takes seven boosts from members. If the server later drops below Level 2, your saved icons are hidden from chat until the boost level is restored. You also need the Manage Roles permission." },
  { q: "Can a Discord role icon be an animated GIF?", a: "No. Discord only supports static images for role icons, so PNG and JPG files work but animated GIFs and APNGs do not. A transparent PNG usually looks best because the icon sits cleanly beside a username without a visible background box." },
  { q: "Why does my Discord role icon look blurry or get rejected?", a: "Blur usually comes from too much detail: at 16–20 pixels, thin lines and small text smear together, so bold, simple silhouettes read best. Rejections are typically caused by the wrong dimensions — it must resize to 64×64 — or by exceeding the 256 KB file cap." }
];

const dossier = {
  eyebrow: "Role Icon Technical Blueprint",
  heading: "Designing role icons that read clearly at",
  highlight: "16 pixels",
  intro: "Role icons are the smallest graphics anywhere in Discord. You upload them at 64×64 pixels, but Discord shrinks them to roughly 16–20 pixels next to usernames. Here is how the size rules, downscaling, silhouette theory, and Boost requirements fit together so your badges stay recognizable at a glance.",
  steps: [
    "The Exact 64×64 Size",
    "16px Chat Downscaling",
    "Bold Silhouettes & Contrast",
    "Boost Level 2 & Permissions"
  ],
  cards: [
    {
      kicker: "SPECIFICATION METRIC // 01",
      badge: "64 × 64 PIXELS",
      badgeTone: "emerald" as const,
      title: "The exact 64×64 pixel rule",
      body: [
        "Discord recommends uploading role icons as a 64×64 pixel square with a clean 1:1 ratio. Unlike banners or emoji that allow varied shapes, a role icon needs to sit inside that tidy square, so odd dimensions like 63×64 get stretched or awkwardly cropped when Discord processes them.",
        "The file cap is 256 KB — plenty of room for a sharp PNG or JPG at this size. A transparent PNG looks best because the icon floats cleanly beside a username with no visible box. This maker centers and resizes your artwork onto an exact 64×64 canvas in your browser, so you export without upload errors."
      ]
    },
    {
      kicker: "OPTICAL DOWNSCALING // 02",
      badge: "16px CHAT DISPLAY",
      badgeTone: "blue" as const,
      title: "How small a role icon really appears",
      body: [
        "Even though you upload at 64×64 pixels, Discord displays role icons at roughly 16×16 pixels beside names in chat and about 20×20 pixels in the member list. That is close to a 4:1 reduction from the file you upload, so every pixel of detail gets compressed into a tiny footprint.",
        "At that scale, small text, thin lines, fine shading, and intricate crests blur into an indistinct smudge. The trick is to design for the display size, not the upload size. Preview your icon next to a mock username at true chat scale before committing it, and simplify anything that turns muddy."
      ]
    },
    {
      kicker: "GRAPHIC READABILITY // 03",
      badge: "SILHOUETTE THEORY",
      badgeTone: "amber" as const,
      title: "Bold silhouettes and high-contrast shapes",
      body: [
        "The best role icons behave like road signs: you recognize the shape instantly. A single bold silhouette — a crown for admins, a shield for moderators, a star for boosters, a controller for gamers, or a paint palette for artists — reads far better than a detailed illustration. Solid one-color shapes survive the shrink; gradients and fine emblems do not.",
        "Contrast matters just as much. Because the icon sits right next to a colored role name, an all-gold badge can vanish beside gold text. Clean white elements or a faint outline help the shape pop on both dark and light themes, keeping it legible whatever color the role uses."
      ],
      footer: "Simple, high-contrast silhouettes stay legible on both dark and light themes."
    },
    {
      kicker: "SERVER REQUIREMENTS // 04",
      badge: "BOOST LEVEL 2",
      badgeTone: "purple" as const,
      title: "Boost Level 2 and how to set an icon",
      body: [
        "Custom role icons unlock only once a server reaches Server Boost Level 2, which takes seven boosts from members. If the server ever drops below Level 2, your uploaded icons stay saved in settings but Discord hides them from chat until the boost level recovers. You also need the Manage Roles permission to attach one.",
        "To set it, open Server Settings → Roles, pick a role, and use its Display tab. You can upload a custom image or choose a standard emoji as the icon. Discord supports static PNG and JPG here — not animated GIFs. Everything on this page is processed in your browser, so nothing is ever uploaded to a server."
      ],
      footer: "Set it in Server Settings → Roles → Display · zero uploads, all in-browser."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/role-icon.png">
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Role Icon Studio</span>
      </div>
        <a href="/es/tools/role-icon/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold" hreflang="es">🌐 Español</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Role Icon</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Maker</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] mt-1">Exact 64 × 64 px • 256 KB max • Boost Level 2 & Manage Roles required</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] text-[#3368A0] font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Processing
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component) -->
    <RoleIconWorkspace lang="en" />

    <!-- Sticky-scroll technical dossier (shared component) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (shared component, single source of truth with JSON-LD) -->
    <ToolFaq items={faqItems} />

  </div>
</Layout>
