---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Discord Role Icon Maker & Resizer | 64x64" 
  description="Format, validate, and resize Discord custom role icons to exact 64x64 dimensions and under 256 KB. Zero server uploads."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs text-[#9da6b8] mb-2 font-mono">
        <a href="/" class="hover:text-white transition-colors">Studio</a>
        <span>/</span>
        <span class="text-white">Role Icon Studio</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Discord Role Icon Studio</h1>
          <p class="text-xs sm:text-sm text-[#9da6b8] mt-1">Exactly 64 × 64 px • 256 KB max • Boost Level 2 & Manage Roles required</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#15181e] px-3 py-1.5 rounded-[8px] border border-[#2b313e] text-[#10b981]">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          Local Processing
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div id="dropzone" class="border-2 border-dashed border-[#2b313e] hover:border-[#3b82f6] rounded-[12px] bg-[#15181e] p-8 text-center transition-all cursor-pointer relative">
          <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
          <div class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-[10px] bg-[#1c2028] text-[#3b82f6] flex items-center justify-center mx-auto text-xl font-bold">
              🛡️
            </div>
            <p class="text-sm font-semibold text-white">Select badge or role icon artwork</p>
            <p class="text-xs text-[#6b7385]">PNG, JPG, or WebP (Rescaled to exact 64x64)</p>
          </div>
        </div>

        <div id="editorPanel" class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#2b313e] mb-4">
            <h2 class="text-sm font-semibold text-white">64 × 64 Icon Surface</h2>
            <button id="resetBtn" class="text-xs px-2.5 py-1 rounded-[6px] bg-[#1c2028] hover:bg-[#242934] border border-[#2b313e] text-[#9da6b8] hover:text-white">
              Reset
            </button>
          </div>

          <div class="flex items-center justify-center p-6 bg-[#0d0f12] rounded-[8px] border border-[#2b313e] overflow-hidden mb-6">
            <canvas id="mainCanvas" width="64" height="64" class="w-16 h-16 shadow-sm rounded-[4px] bg-[repeating-conic-gradient(#1c2028_0%_25%,#15181e_0%_50%)] [background-size:8px_8px]"></canvas>
          </div>

          <button id="exportBtn" class="w-full py-3 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors shadow-sm">
            Export Role Icon (64x64)
          </button>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <!-- Live Role Badge Chat Preview -->
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <h2 class="text-sm font-semibold text-white pb-3 border-b border-[#2b313e] mb-4">Chat Nameplate Preview</h2>
          <div class="p-4 rounded-[8px] bg-[#313338] text-white">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-[#f59e0b]">Guild Master</span>
              <!-- 16px or 20px role badge display -->
              <div class="w-4 h-4 flex items-center justify-center">
                <img id="roleBadgeImg" class="w-4 h-4 object-contain hidden" alt="Role Icon Badge Preview" />
                <span id="badgePlaceholder" class="w-3 h-3 rounded-full bg-[#f59e0b]/40"></span>
              </div>
              <span class="text-[10px] bg-[#2b2d31] text-[#949ba4] px-1.5 py-0.5 rounded font-mono">ADMIN</span>
            </div>
            <p class="text-xs text-[#dbdee1] mt-2">Example message demonstrating the role icon beside username.</p>
          </div>
        </div>

        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6">
          <h2 class="text-sm font-semibold text-white pb-3 border-b border-[#2b313e] mb-4">Specification Receipt</h2>
          <div class="space-y-3 text-xs font-mono">
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Dimensions:</span>
              <span id="statDimensions" class="text-white">64 × 64 px</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Max Size:</span>
              <span class="text-[#10b981]">256 KB</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-[6px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Platform Gate:</span>
              <span class="text-[#f59e0b]">Boost L2 + Manage Roles</span>
            </div>
            <div class="pt-2 border-t border-[#2b313e] text-[11px] text-[#6b7385] font-sans">
              <strong>Requirement:</strong> Server must reach Server Boost Level 2 to unlock custom role icons. Requires Manage Roles permission.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const editorPanel = document.getElementById('editorPanel');
    const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
    const resetBtn = document.getElementById('resetBtn');
    const exportBtn = document.getElementById('exportBtn');
    const roleBadgeImg = document.getElementById('roleBadgeImg') as HTMLImageElement;
    const badgePlaceholder = document.getElementById('badgePlaceholder');

    let currentBlob: Blob | null = null;
    let currentObjectUrl: string | null = null;

    fileInput.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const ctx = mainCanvas.getContext('2d');
            if (!ctx) return;

            mainCanvas.width = 64;
            mainCanvas.height = 64;
            ctx.clearRect(0, 0, 64, 64);

            const scale = Math.min(64 / img.width, 64 / img.height);
            const w = img.width * scale;
            const h = img.height * scale;
            const x = (64 - w) / 2;
            const y = (64 - h) / 2;

            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            ctx.drawImage(img, x, y, w, h);
            editorPanel?.classList.remove('hidden');

            mainCanvas.toBlob((blob) => {
              if (blob) {
                currentBlob = blob;
                if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
                currentObjectUrl = URL.createObjectURL(blob);
                roleBadgeImg.src = currentObjectUrl;
                roleBadgeImg.classList.remove('hidden');
                badgePlaceholder?.classList.add('hidden');
              }
            }, 'image/png');
          };
          img.src = event.target?.result as string;
        };
        reader.readAsDataURL(file);
      }
    });

    resetBtn?.addEventListener('click', () => {
      currentBlob = null;
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      editorPanel?.classList.add('hidden');
      roleBadgeImg?.classList.add('hidden');
      badgePlaceholder?.classList.remove('hidden');
      fileInput.value = '';
    });

    exportBtn?.addEventListener('click', () => {
      if (!currentBlob || !currentObjectUrl) return;
      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = 'discord-role-icon-64x64.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    });
  </script>
</Layout>
