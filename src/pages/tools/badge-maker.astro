---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import BadgeMakerWorkspace from '../../components/tools/BadgeMakerWorkspace.astro';
import ToolDossier from '../../components/tools/ToolDossier.astro';
import ToolFaq from '../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Logo Maker | Text and Badge Icons";
const pageDescription = "Free Discord logo maker: build your own server badge from initials or an emoji over a color or gradient, in a circle or square. 512x512 PNG, in-browser.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/tools/badge-maker/";

const appSchema = generateSoftwareApplicationSchema(
  "Discord Logo & Badge Maker",
  pageDescription,
  pageUrl
);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Logo & Badge Maker", url: pageUrl }
]);

const faqItems = [
  { q: "How do I make a logo for my Discord server for free?", a: "Type your server's initials or pick an emoji, choose a background color or gradient and a shape, then download the 512x512 PNG. Upload it as your server icon in Server Settings > Overview. This maker builds your own original artwork for free in the browser — it does not use Discord's logo or brand marks." },
  { q: "Is this the official Discord logo maker or affiliated with Discord?", a: "No. This is an independent badge maker for creating your own server or community icon. It is not affiliated with or endorsed by Discord, and it does not reproduce Discord's Clyde logo or wordmark. You keep full rights to the simple text or emoji badge you generate here." },
  { q: "What size should a Discord server icon or logo be?", a: "A Discord server icon should be a 512x512 pixel square PNG — the recommended upload size, which Discord then masks into a rounded square. Every badge here exports at exactly 512x512, and the circle and rounded-square shapes preserve transparent corners so the icon sits cleanly on the dark sidebar." },
  { q: "Can I use an emoji instead of letters in my Discord badge?", a: "Yes. Type or paste any emoji into the text field and it renders as full-color artwork centered in the badge. You can combine short initials or use a single emoji — whatever reads best at small sizes in the server list, where icons shrink to around 48 pixels wide." },
  { q: "Why does my Discord server icon look blurry or pixelated?", a: "A blurry server icon usually means the source image was smaller than 512x512 and Discord upscaled it, or fine detail collapsed at the tiny sidebar size. Exporting a crisp 512x512 badge with a bold lettermark or single emoji — instead of a detailed illustration — keeps it sharp everywhere it appears." }
];

const dossier = {
  eyebrow: "Logo & Badge Blueprint",
  heading: "Server badges that read at",
  highlight: "48 pixels wide",
  intro: "A server icon shrinks to a tiny circle in the sidebar, so a clean lettermark beats a busy illustration every time. Here is how initials, contrast, masking, and export size come together into a badge that stays legible.",
  steps: [
    "Lettermarks That Read Small",
    "Color & Gradient Contrast",
    "Shape Masking & 512px Export",
    "Independent & Trademark-Safe"
  ],
  cards: [
    {
      kicker: "TYPE MECHANICS // 01",
      badge: "1–4 CHARACTERS",
      badgeTone: "emerald" as const,
      title: "Why a lettermark beats a detailed illustration",
      body: [
        "In the server list, your icon is displayed at roughly 48 pixels across. Fine illustrations, thin lines, and small text all turn to mush at that size. A lettermark — one to four bold characters of your community's name — stays legible because there is nothing small to lose.",
        "This maker centers your initials on the canvas so nothing important sits near the edges, where Discord's rounded-square mask clips the corners. Keep it to two or three characters for the strongest read; a single glyph or emoji works too when the shape alone is recognizable."
      ]
    },
    {
      kicker: "COLOR SCIENCE // 02",
      badge: "SOLID / GRADIENT",
      badgeTone: "blue" as const,
      title: "Contrast that survives the dark sidebar",
      body: [
        "Discord's sidebar is near-black, so a dark badge disappears into it. Pick a background — a solid color or one of the gradient presets — bright or saturated enough to separate from that dark backdrop, then keep the lettering high-contrast against the fill.",
        "Gradients add depth without adding clutter: a two-tone diagonal reads as a single confident shape at small sizes, while a light glyph over a mid-tone gradient keeps the letters crisp. Avoid low-contrast pairings like grey-on-grey that vanish the moment the icon shrinks."
      ]
    },
    {
      kicker: "EXPORT GEOMETRY // 03",
      badge: "512 × 512 PNG",
      badgeTone: "amber" as const,
      title: "Shape masking and the 512×512 export",
      body: [
        "Every badge exports as a 512×512 PNG, Discord's recommended server-icon size, and the same file works for an avatar. Choosing the circle or rounded-square shape preserves transparent corners so the badge sits flush on any background instead of showing a hard square edge.",
        "Because Discord masks server icons into a rounded square regardless, a centered composition is the safe layout — nothing critical gets clipped. Export at the full 512×512 rather than scaling up a smaller file, so the icon stays sharp when Discord resizes it down."
      ],
      footer: "512×512 PNG matches Discord's server-icon spec — sharp when masked to a rounded square."
    },
    {
      kicker: "BRAND SAFETY // 04",
      badge: "TRADEMARK-SAFE",
      badgeTone: "purple" as const,
      title: "Original artwork you fully own",
      body: [
        "This is a generic badge generator: it creates original text-and-color artwork that belongs to you. It is not affiliated with or endorsed by Discord, and it deliberately excludes Discord's Clyde logo, wordmark, and brand assets — so you can use what you make without trademark worries.",
        "Everything renders in your browser with no upload, account, or watermark. When you are ready to install it, pair it with the Server Icon Maker to preview the rounded-square framing, or drop the file straight into Server Settings."
      ],
      footer: "Original artwork, generated in-browser — no Discord marks, no uploads, no watermark."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://discord-creator-asset-studio.pages.dev/og/badge-maker.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="mb-8">
      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono">
        <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Logo & Badge Maker</span>
      </div>
        <a href="/es/tools/badge-maker/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold" hreflang="es">🌐 Español</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Logo Maker</mark> <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">& Badge Builder</span><SketchUnderline color="#66A3BF" /></span>
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Build your own server badge from initials or an emoji • Gradients & shapes • 512×512 PNG</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Local Browser Processing
        </div>
      </div>
    </div>

    <!-- Main Workspace Layout (shared component, EN + ES) -->
    <BadgeMakerWorkspace lang="en" />

    <ToolDossier {...dossier} />

    <ToolFaq items={faqItems} />

  </div>
</Layout>
