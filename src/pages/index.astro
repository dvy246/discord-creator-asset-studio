---
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/HomeContent.astro';
import { generateItemListSchema } from '../utils/seo';
import { homeFaqs } from '../data/home-i18n.ts';

const pageTitle = "Free Discord Creator Tools — Avatars, Banners & Emojis";
const pageDescription = "Free browser-based Discord creator tools to make and resize avatars, banners, emojis, stickers and GIFs — no uploads, 100% private.";

// WebSite + Organization entities are emitted site-wide by Layout.astro (shared
// /#website and /#organization @ids). Do NOT re-inject either here or the entity
// graph gets duplicate nodes.

// FAQPage JSON-LD is built from the same source as the visible <details> list
// (home-i18n.ts) so structured data and on-page content never diverge.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.en.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const itemListSchema = JSON.parse(generateItemListSchema([
  { name: "Discord Creator Asset Studio", url: "https://discord-creator-asset-studio.pages.dev/", description: "Browser-based studio to make and resize Discord avatars, banners, emojis, stickers & GIFs — no uploads, 100% private" },
  { name: "Discord Emoji Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/emoji/", description: "Format custom emojis to 128x128 under 256 KiB" },
  { name: "Discord Sticker Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/sticker/", description: "Resize stickers to exact 320x320 under 512 KiB" },
  { name: "Discord Banner Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/banner/", description: "Crop server & profile banners with safe-zone overlay" },
  { name: "Discord Avatar Cropper", url: "https://discord-creator-asset-studio.pages.dev/tools/avatar/", description: "Circular crop 512x512 profile pictures" },
  { name: "Discord Role Icon Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/role-icon/", description: "Format 64x64 role icons under 256 KB" },
  { name: "Discord Image Compressor", url: "https://discord-creator-asset-studio.pages.dev/tools/image-compressor/", description: "Shrink PNG, JPG & WebP under the 10MB Discord upload limit without resizing" },
  { name: "Discord Image Resizer", url: "https://discord-creator-asset-studio.pages.dev/tools/image-resizer/", description: "Scale images to exact avatar, sticker, emoji, and banner dimensions with fit modes" },
  { name: "Discord Spoiler Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/spoiler/", description: "Hide text with || || markup or blur an image using the SPOILER_ filename prefix" },
  { name: "Discord Color Palette & Hex Codes", url: "https://discord-creator-asset-studio.pages.dev/tools/colors/", description: "Copy Discord background, blurple, and status hex codes with a HEX/RGB/HSL picker" },
  { name: "Discord Timestamp Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/timestamp/", description: "Generate dynamic timezone-aware Discord timestamp markup for all seven style codes" },
  { name: "Discord Emoji Copy & Paste Board", url: "https://discord-creator-asset-studio.pages.dev/tools/emoji-copy-paste/", description: "Click-to-copy Unicode emojis and kaomoji that paste into any Discord chat" },
  { name: "Discord Font Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/fonts/", description: "Turn text into fancy Unicode fonts for names, bios, and chat with one-click copy" },
  { name: "Discord Colored Text Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/colored-text/", description: "Style words with ANSI color codes, bold, and underline, then copy a ready-to-paste code block" },
  { name: "Discord Markdown Previewer", url: "https://discord-creator-asset-studio.pages.dev/tools/markdown/", description: "Format bold, italics, spoilers, quotes, lists, and code blocks with a live preview of how the message renders in chat" },
  { name: "Discord Embed Builder", url: "https://discord-creator-asset-studio.pages.dev/tools/embed-builder/", description: "Design a rich embed with a visual form and live Discord preview, then copy the webhook JSON or send it straight to a channel" },
  { name: "Discord Server Icon Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/server-icon/", description: "Frame artwork to an exact 512x512 server icon with a rounded-square preview" },
  { name: "Discord Logo & Badge Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/badge-maker/", description: "Build a trademark-safe text or emoji server badge over a gradient, 512x512 PNG" },
  { name: "Discord GIF Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/gif-maker/", description: "Convert video to animated Discord GIFs under 10MB" },
  { name: "Discord GIF Compressor", url: "https://discord-creator-asset-studio.pages.dev/tools/gif-compressor/", description: "Shrink animated GIFs under the 256 KiB emoji or 10MB chat limit in-browser" },
  { name: "Discord Asset Library", url: "https://discord-creator-asset-studio.pages.dev/assets/", description: "100+ free animated Discord banners, matching avatars & profile themes" },
  { name: "Discord Snowflake Decoder", url: "https://discord-creator-asset-studio.pages.dev/tools/snowflake/", description: "Decode any Discord ID into its creation date, worker & process IDs, and timestamp markup, plus grab public avatars & banners" },
  { name: "Discord Permission Calculator", url: "https://discord-creator-asset-studio.pages.dev/tools/permissions-calculator/", description: "Tick role or bot permissions to get the exact permissions integer, decode any value, load presets, and build the OAuth2 bot invite URL" },
  { name: "Discord Username Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/username-generator/", description: "Generate Discord username ideas in nine styles with a 3 & 4-letter mode, click-to-copy, and saved favorites" },
  { name: "Discord Bio Template Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/bio-generator/", description: "Build a Discord bio from copy-paste templates or themed word banks with a 190-character counter, symbol & divider inserts, and saved favorites" },
  { name: "Discord Text Formatting Generator", url: "https://discord-creator-asset-studio.pages.dev/tools/text-formatting/", description: "Type your text once and copy every Discord markdown style — bold, italic, underline, strikethrough, spoiler, headers, subtext and code — each with a live rendered preview" },
  { name: "Discord Video Compressor", url: "https://discord-creator-asset-studio.pages.dev/tools/video-compressor/", description: "Transcode MP4, WebM & MOV in-browser with ffmpeg.wasm to fit the 10MB Discord upload limit — resolution downscale, CRF quality, optional audio strip" },
  { name: "Discord Fake Message Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/fake-message-maker/", description: "Build a fictional Discord chat screenshot for memes, comics & roleplay on a canvas — names, name colors, avatars, BOT tags, dark/light theme, FICTIONAL watermark on by default" }
]));
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <HomeContent lang="en" />
</Layout>
