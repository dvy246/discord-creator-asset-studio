---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
import SketchCircle from '../components/SketchCircle.astro';
import HeroSimulator from '../components/HeroSimulator.astro';
import { DISCORD_RULES } from '../data/discord-rules';

const pageTitle = "Discord Asset Studio | Creator Resizer & Validator";
const pageDescription = "Inspect, resize, and validate Discord assets against official rules. 100% in-browser processing for emojis, stickers, banners, and avatars.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did Discord reject my custom emoji under 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). A file showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exact dimensions for Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server when I use this tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server."
      }
    },
    {
      "@type": "Question",
      "name": "What are the rules for animated Discord stickers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section: Creative Studio First -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Studio Value Prop & Direct Action CTAs (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Discreet Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-5 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488]"></span>
          <span>Discord rules verified · Private by design</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#192538] tracking-tight leading-[1.12] mb-5">
          The asset studio built for Discord creators. <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Pixel-perfect.</span><SketchUnderline color="#66A3BF" /></span>
        </h1>

        <p class="text-[#475569] text-base sm:text-lg leading-relaxed mb-7 max-w-xl">
          Design vibrant custom emojis, crisp server stickers, immersive banners, and sharp profile avatars calibrated for Discord's exact display engines. 100% in-browser.
        </p>

        <!-- Primary & Secondary Action Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-5">
          <a href="#asset-showcase" class="btn-primary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold shadow-sm">
            Create an Asset
          </a>
          <a href="/tools/emoji" class="btn-secondary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Check a File
          </a>
        </div>

        <!-- Quick Asset Category Selector -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6">
          <span class="font-medium">Or start with:</span>
          <a href="/tools/banner" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🖼️ Banner
          </a>
          <a href="/tools/avatar" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            👤 Avatar
          </a>
          <a href="/tools/emoji" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            😀 Emoji
          </a>
          <a href="/tools/sticker" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🏷️ Sticker
          </a>
        </div>

        <!-- Privacy Assurance -->
        <div class="flex items-center gap-2 text-xs text-[#6B7A90]">
          <svg class="w-3.5 h-3.5 text-[#0D9488] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Private by design: Local browser processing only. No cloud uploads.</span>
        </div>
      </div>

      <!-- Right Column: Interactive Studio Stage (5 cols) -->
      <div class="lg:col-span-5">
        <HeroSimulator />
      </div>
    </div>
  </section>

  <!-- Visual Asset Showcase: "Made for Discord" Vault -->
  <section id="asset-showcase" class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-[#E0DBD0] dark:border-[#263346] scroll-mt-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight">
          Made for <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Discord</span><SketchUnderline color="#66A3BF" /></span>
        </h2>
        <p class="text-[#475569] text-sm sm:text-base mt-2 max-w-xl">
          Calibrated dimensions, safe-zone clearances, and lossless compression for creators, communities, and developers.
        </p>
      </div>
      <!-- Quick Asset Filter Tabs -->
      <div class="flex items-center gap-1.5 p-1 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] overflow-x-auto select-none" id="showcaseFilterBar">
        <button type="button" data-filter="all" class="showcase-filter-btn px-3 py-1.5 rounded-[8px] text-xs font-bold bg-[#3368A0] text-white shadow-xs">
          All
        </button>
        <button type="button" data-filter="banner" class="showcase-filter-btn px-3 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Banners
        </button>
        <button type="button" data-filter="avatar" class="showcase-filter-btn px-3 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Avatars
        </button>
        <button type="button" data-filter="sticker" class="showcase-filter-btn px-3 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Stickers
        </button>
        <button type="button" data-filter="emoji" class="showcase-filter-btn px-3 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Emojis
        </button>
      </div>
    </div>

    <!-- Visual Asset Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="showcaseGrid">
      
      <!-- Vault Item 1: Celestial Horizon Banner -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="banner">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#0E1420] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346]">
            <svg class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" viewBox="0 0 960 540" fill="none">
              <defs>
                <linearGradient id="vaultBanner1Grad" x1="0" y1="0" x2="960" y2="540" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#0E1420" />
                  <stop offset="60%" stop-color="#1A2D4A" />
                  <stop offset="100%" stop-color="#3368A0" />
                </linearGradient>
                <radialGradient id="vaultMoonGrad" cx="500" cy="180" r="160" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FAF8F5" />
                  <stop offset="50%" stop-color="#C8DFDB" />
                  <stop offset="100%" stop-color="#3368A0" stop-opacity="0" />
                </radialGradient>
              </defs>
              <rect width="960" height="540" fill="url(#vaultBanner1Grad)" />
              <g fill="#FFFFFF" opacity="0.6"><circle cx="120" cy="80" r="2" /><circle cx="340" cy="60" r="1.5" /><circle cx="750" cy="100" r="2.5" /><circle cx="890" cy="70" r="1.5" /></g>
              <circle cx="500" cy="180" r="160" fill="url(#vaultMoonGrad)" />
              <path d="M0 400 L 220 280 L 440 370 L 660 260 L 820 330 L 960 250 L 960 540 L 0 540 Z" fill="#141E30" opacity="0.95" />
              <path d="M0 470 L 300 360 L 520 440 L 780 340 L 960 410 L 960 540 L 0 540 Z" fill="#0C121C" />
            </svg>
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/50 backdrop-blur-xs text-white text-[10px] font-mono font-semibold">
              960 × 540 (16:9)
            </span>
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-emerald-500/20 backdrop-blur-xs text-emerald-300 text-[10px] font-mono font-bold border border-emerald-400/30">
              Safe Zone Cleared
            </span>
          </div>
          <div class="p-5">
            <div class="text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] font-semibold">Server & Profile Banner</div>
            <h3 class="text-base font-bold text-[#192538] mt-1">Celestial Horizon</h3>
            <p class="text-xs text-[#475569] mt-1.5 leading-relaxed">
              Designed with 48px top-header occlusion protection so channel titles and server pills never cover focal art.
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a href="/tools/banner" class="btn-secondary w-full py-2.5 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 group-hover:bg-[#3368A0] group-hover:text-white transition-colors">
            <span>Customize in Banner Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Vault Item 2: Cyber Katana Avatar -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="avatar">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#141A24] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346] flex items-center justify-center p-4">
            <!-- Circular Avatar Mockup -->
            <div class="relative w-24 h-24 rounded-full overflow-hidden border-2 border-[#5865F2] shadow-lg group-hover:scale-110 transition-transform duration-500">
              <svg class="w-full h-full" viewBox="0 0 512 512" fill="none">
                <rect width="512" height="512" fill="#182335" />
                <circle cx="256" cy="210" r="110" fill="#F2EFE7" />
                <rect x="176" y="180" width="160" height="44" rx="22" fill="#66A3BF" />
                <line x1="195" y1="202" x2="317" y2="202" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" />
                <path d="M110 470 C 130 350, 190 320, 256 320 C 322 320, 382 350, 402 470 Z" fill="#0C121C" />
              </svg>
              <div class="absolute bottom-0 right-0 w-5 h-5 rounded-full bg-[#23A55A] border-2 border-[#182335]"></div>
            </div>
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/50 backdrop-blur-xs text-white text-[10px] font-mono font-semibold">
              512 × 512 Square
            </span>
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-[#3368A0]/20 text-[#3368A0] dark:text-[#66A3BF] text-[10px] font-mono font-bold border border-[#66A3BF]/30">
              Circle Mask Safe
            </span>
          </div>
          <div class="p-5">
            <div class="text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] font-semibold">User & Bot Avatar</div>
            <h3 class="text-base font-bold text-[#192538] mt-1">Cyberpunk Visor</h3>
            <p class="text-xs text-[#475569] mt-1.5 leading-relaxed">
              1:1 aspect ratio centered within Discord's round crop bounds with zero corner clipping in profile popouts.
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a href="/tools/avatar" class="btn-secondary w-full py-2.5 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 group-hover:bg-[#3368A0] group-hover:text-white transition-colors">
            <span>Crop in Avatar Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Vault Item 3: Holographic Mascot Sticker -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="sticker">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#FAF8F5] dark:bg-[#111620] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346] flex items-center justify-center p-4">
            <!-- Die-Cut Sticker Graphic -->
            <div class="w-24 h-24 drop-shadow-[0_8px_16px_rgba(51,104,160,0.3)] group-hover:scale-110 transition-transform duration-500">
              <svg class="w-full h-full" viewBox="0 0 320 320" fill="none">
                <path d="M160 25 C 235 25, 295 85, 295 160 C 295 235, 235 295, 160 295 C 85 295, 25 235, 25 160 C 25 85, 85 25, 160 25 Z" fill="#FFFFFF" stroke="#D1D5DB" stroke-width="6" />
                <path d="M160 40 C 225 40, 280 95, 280 160 C 280 225, 225 280, 160 280 C 95 280, 40 225, 40 160 C 40 95, 95 40, 160 40 Z" fill="#3368A0" />
                <polygon points="90,75 125,120 70,125" fill="#141E30" />
                <polygon points="230,75 195,120 250,125" fill="#141E30" />
                <ellipse cx="160" cy="165" rx="80" ry="60" fill="#0C121C" />
                <circle cx="130" cy="160" r="14" fill="#C8DFDB" />
                <circle cx="190" cy="160" r="14" fill="#C8DFDB" />
              </svg>
            </div>
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/50 backdrop-blur-xs text-white text-[10px] font-mono font-semibold">
              Exact 320 × 320
            </span>
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">
              Lossless APNG
            </span>
          </div>
          <div class="p-5">
            <div class="text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] font-semibold">Server Sticker</div>
            <h3 class="text-base font-bold text-[#192538] mt-1">Mecha Mascot Sticker</h3>
            <p class="text-xs text-[#475569] mt-1.5 leading-relaxed">
              Formatted to exact 320x320 dimensions with white die-cut contour and lossless transparency under 512 KiB.
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a href="/tools/sticker" class="btn-secondary w-full py-2.5 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 group-hover:bg-[#3368A0] group-hover:text-white transition-colors">
            <span>Format in Sticker Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Vault Item 4: Prismatic Mana Gem Emoji -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="emoji">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#FAF8F5] dark:bg-[#111620] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346] flex items-center justify-center p-4">
            <div class="w-16 h-16 drop-shadow-md group-hover:scale-125 transition-transform duration-500">
              <svg class="w-full h-full" viewBox="0 0 128 128" fill="none">
                <polygon points="64,12 108,44 94,114 34,114 20,44" fill="#3368A0" stroke="#192538" stroke-width="3" />
                <polygon points="64,12 108,44 64,54" fill="#C8DFDB" opacity="0.8" />
                <polygon points="64,12 20,44 64,54" fill="#FFFFFF" opacity="0.9" />
                <circle cx="48" cy="38" r="4" fill="#FFFFFF" />
              </svg>
            </div>
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/50 backdrop-blur-xs text-white text-[10px] font-mono font-semibold">
              128 × 128 HD
            </span>
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">
              32px Chat Tested
            </span>
          </div>
          <div class="p-5">
            <div class="text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] font-semibold">Custom Emoji</div>
            <h3 class="text-base font-bold text-[#192538] mt-1">Prismatic Mana Gem</h3>
            <p class="text-xs text-[#475569] mt-1.5 leading-relaxed">
              High-contrast edge definition ensures readability at native 32x32 chat dimensions while remaining under 256 KiB.
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a href="/tools/emoji" class="btn-secondary w-full py-2.5 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 group-hover:bg-[#3368A0] group-hover:text-white transition-colors">
            <span>Craft in Emoji Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Vault Item 5: Retro Synthwave Banner -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="banner">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#141A24] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346]">
            <svg class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" viewBox="0 0 960 540" fill="none">
              <defs>
                <linearGradient id="retroSky" x1="0" y1="0" x2="0" y2="340" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#141E30" />
                  <stop offset="100%" stop-color="#3368A0" />
                </linearGradient>
              </defs>
              <rect width="960" height="540" fill="#0C121C" />
              <rect width="960" height="340" fill="url(#retroSky)" />
              <circle cx="480" cy="220" r="110" fill="#C8DFDB" />
              <line x1="380" y1="200" x2="580" y2="200" stroke="#3368A0" stroke-width="4" />
              <line x1="390" y1="230" x2="570" y2="230" stroke="#3368A0" stroke-width="6" />
              <!-- Perspective Horizon Grid -->
              <path d="M0 340 L 960 340 M 0 380 L 960 380 M 0 440 L 960 440 M 0 520 L 960 520" stroke="#66A3BF" stroke-width="1.5" stroke-opacity="0.4" />
              <line x1="480" y1="340" x2="480" y2="540" stroke="#66A3BF" stroke-width="2" stroke-opacity="0.5" />
              <line x1="480" y1="340" x2="200" y2="540" stroke="#66A3BF" stroke-width="2" stroke-opacity="0.5" />
              <line x1="480" y1="340" x2="760" y2="540" stroke="#66A3BF" stroke-width="2" stroke-opacity="0.5" />
            </svg>
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/50 backdrop-blur-xs text-white text-[10px] font-mono font-semibold">
              960 × 540 (16:9)
            </span>
          </div>
          <div class="p-5">
            <div class="text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] font-semibold">Community Banner</div>
            <h3 class="text-base font-bold text-[#192538] mt-1">Midnight Synthwave</h3>
            <p class="text-xs text-[#475569] mt-1.5 leading-relaxed">
              Vibrant neon grid aesthetic with dark header buffer zone ensuring clear typography on all server interfaces.
            </p>
          </div>
        </div>
        <div class="px-5 pb-5 pt-0">
          <a href="/tools/banner" class="btn-secondary w-full py-2.5 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 group-hover:bg-[#3368A0] group-hover:text-white transition-colors">
            <span>Customize in Banner Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Vault Item 6: Astral Astronaut Avatar -->
      <div class="showcase-item card-panel rounded-[16px] overflow-hidden group flex flex-col justify-between" data-type="avatar">
        <div>
          <div class="relative w-full aspect-[16/9] bg-[#141A24] overflow-hidden border-b border-[#E0DBD0] dark:border-[#263346] flex items-center justify-center p-4">
            <div class="relative w-24 h-24 rounded-full overflow-hidden border-2 border-[#66A3BF] shadow-lg group-hover:scale-110 transition-transform duration-500">
              <svg class="w-full h-full" viewBox="0 0 512 512" fill="none">
                <rect width="512" height="512" fill="#0C121C" />
                <circle cx="256" cy="230" r="130" fill="#3368A0" />
                <ellipse cx="256" cy="220" rx="90" ry="70" fill="#C8DFDB" />
