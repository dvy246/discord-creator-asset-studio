---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
import SketchCircle from '../components/SketchCircle.astro';
import { DISCORD_RULES } from '../data/discord-rules';

const pageTitle = "Discord Asset Studio | Creator Resizer & Validator";
const pageDescription = "Inspect, resize, and validate Discord assets against official rules. 100% in-browser processing for emojis, stickers, banners, and avatars.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did Discord reject my custom emoji under 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). A file showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exact dimensions for Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server when I use this tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server."
      }
    },
    {
      "@type": "Question",
      "name": "What are the rules for animated Discord stickers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section: Asymmetric Split -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Value Prop & CTAs (7 cols) -->
      <div class="lg:col-span-7">
        <div class="relative inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-6 shadow-xs sketch-trigger">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Verified Rule Engine • Zero Server Uploads
          <SketchCircle color="#3368A0" class="opacity-40 dark:opacity-70" />
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#192538] tracking-tight leading-[1.15] mb-6">
          Upload-ready Discord assets. <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">No guessing.</span><SketchUnderline color="#66A3BF" /></span>
        </h1>

        <p class="text-[#475569] text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          Generic design tools leave you with blurry icons, awkward crops, and mysterious 256 KiB upload rejections. Discord Asset Studio inspects, resizes, and repairs your media directly in your browser against verified Discord rules.
        </p>

        <!-- CTA Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="/tools/emoji" class="btn-primary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Launch Emoji Validator
          </a>
          <a href="/guides/discord-sizes" class="btn-secondary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            View Official Size Guide
          </a>
        </div>

        <!-- Privacy & Local Processing Statement -->
        <div class="flex items-center gap-3 text-xs text-[#6B7A90]">
          <svg class="w-4 h-4 text-[#0D9488] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Private by architecture: Media stays in your local browser memory. No cloud processing or accounts required.</span>
        </div>
      </div>

      <!-- Right Column: Live Working Asset Validator Preview Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="card-panel rounded-[14px] p-6 relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] mb-5">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#E0DBD0] dark:bg-[#303E54]"></span>
              <span class="w-3 h-3 rounded-full bg-[#C8DFDB] dark:bg-[#485C7A]"></span>
              <span class="w-3 h-3 rounded-full bg-[#66A3BF]"></span>
              <span class="text-xs font-mono font-medium text-[#475569] ml-2">rule-check: custom-emoji</span>
            </div>
            <span class="text-[11px] font-mono font-semibold uppercase bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/20">Verified</span>
          </div>

          <!-- Interactive Target Selector Preview -->
          <div class="space-y-3.5 text-xs font-mono">
            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Target:</span>
              <span class="text-[#192538] font-bold">Custom Emoji (128x128)</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Binary Byte Cap:</span>
              <span class="text-[#0D9488] font-bold">256 KiB (262,144 bytes)</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Display Preview:</span>
              <span class="text-[#3368A0] dark:text-[#66A3BF] font-bold">32 × 32 px chat size</span>
            </div>

            <div class="p-3.5 rounded-[8px] bg-[#C8DFDB]/30 dark:bg-[#1E2838] border border-[#66A3BF]/30 text-[#192538] text-[11px] leading-relaxed">
              <span class="text-[#3368A0] dark:text-[#66A3BF] font-bold">Rule Provenance:</span> Discord Help Center #204849977. Rule verified and maintained against active Discord client standards.
            </div>

            <a href="/tools/emoji" class="btn-primary w-full py-3 rounded-[8px] text-xs font-semibold text-center block">
              Open Interactive Tool →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Asset Category Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 border-t border-[#E0DBD0]">
    <div class="mb-10">
      <span class="text-xs font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Creator Tool Suite</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mt-1">
        Dedicated <span class="relative inline-block sketch-trigger"><span class="relative z-10">Utilities</span><SketchUnderline color="#66A3BF" /></span>
      </h2>
      <p class="text-[#475569] text-sm mt-1">Select an asset type to inspect dimensions, test byte limits, and auto-correct format issues.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Emoji Card -->
      <a href="/tools/emoji" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          😀
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Custom Emoji Studio</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Upload up to 128x128, preview at 32x32 chat dimensions, and enforce the 256 KiB upload limit with lossless local compression.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Inspect Emoji →</span>
      </a>

      <!-- Sticker Card -->
      <a href="/tools/sticker" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🏷️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Sticker Compressor</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Format images to exactly 320x320 pixels and compress to under 512 KiB. Supports static PNG and animated APNG workflows.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Format Sticker →</span>
      </a>

      <!-- Banner Card -->
      <a href="/tools/banner" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🖼️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Profile & Server Banners</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Presets for Global (680x240), Per-Server (600x240), and Server Banners (960x540) with official top 48px safe-zone overlays.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Design Banner →</span>
      </a>

      <!-- Avatar Card -->
      <a href="/tools/avatar" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          👤
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Avatar & Profile Picture</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Circular crop preview and 512x512 square authoring canvas with transparent background checks and Nitro animated avatar flags.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Crop Avatar →</span>
      </a>

      <!-- Role Icon Card -->
      <a href="/tools/role-icon" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🛡️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Role Icon Maker</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Resize to exactly 64x64 pixels and verify under 256 KB. Cites Boost Level 2 and Manage Roles permission rules.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Create Role Icon →</span>
      </a>

      <!-- Size Guide Card -->
      <a href="/guides/discord-sizes" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          📋
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Official Size Cheat Sheet</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Comprehensive specification table covering dimensions, aspect ratios, file extensions, and server level requirements.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Browse Specs →</span>
      </a>
    </div>
  </section>

  <!-- Text-Locking Sticky Scroll Section (Linear / Apple aesthetic) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 lg:py-28 border-t border-[#E0DBD0]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Pinned / Sticky Text Lock -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
            Deterministic Pipeline
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#192538] tracking-tight leading-[1.15]">
            Every asset <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">locked</span><SketchUnderline color="#66A3BF" /></span> to official specs.
          </h2>

          <p class="text-[#475569] text-base leading-relaxed">
            Scroll through our four-step client validation engine. Files never touch external servers, never compress into blurry artifacts, and never get rejected at upload.
          </p>
        </div>

        <!-- Vertical Step Timeline & Lock Indicator -->
        <div class="relative pl-6 space-y-6 select-none">
          <!-- Background track line -->
          <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-[#E0DBD0] dark:bg-[#263346]"></div>
          <!-- Active fill line -->
          <div id="scroll-progress-line" class="absolute left-2.5 top-2 w-0.5 bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 ease-out" style="height: 0%;"></div>

          <!-- Step 01 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#3368A0] dark:text-[#66A3BF] font-bold" data-step="1">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-current bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 scale-110 transition-transform">1</span>
            <span class="text-sm tracking-wide">01 / Local Ingestion</span>
          </div>

          <!-- Step 02 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="2">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">2</span>
            <span class="text-sm tracking-wide">02 / Rule Evaluation</span>
          </div>

          <!-- Step 03 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="3">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">3</span>
            <span class="text-sm tracking-wide">03 / Canvas Cropping</span>
          </div>

          <!-- Step 04 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="4">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">4</span>
            <span class="text-sm tracking-wide">04 / Verified Blob Export</span>
          </div>
        </div>

        <div class="pt-2">
          <a href="/tools/emoji" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-[10px] text-xs font-semibold">
            <span>Test With Your Artwork</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Scrolling Cards with Micro-Interactions -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Card 1 -->
        <div class="scroll-step-card card-panel p-8 rounded-[16px] space-y-4" data-step="1">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0]">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">STEP 01</span>
              <span class="text-xs text-[#6B7A90] font-mono">/ INGESTION</span>
            </div>
            <span class="text-[11px] font-mono uppercase bg-[#C8DFDB]/60 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/30 font-semibold">100% In-Browser</span>
          </div>
          <h3 class="text-xl font-bold text-[#192538]">Zero-Server Local Media Ingestion</h3>
          <p class="text-sm text-[#475569] leading-relaxed">
            Drag and drop images, animated GIFs, or paste directly from your operating system clipboard. Files are parsed strictly into browser RAM using HTML5 <code class="font-mono text-xs bg-[#FAF8F5] dark:bg-[#1B2330] px-1.5 py-0.5 rounded border border-[#E0DBD0] text-[#3368A0] dark:text-[#66A3BF]">FileReader</code> and <code class="font-mono text-xs bg-[#FAF8F5] dark:bg-[#1B2330] px-1.5 py-0.5 rounded border border-[#E0DBD0] text-[#3368A0] dark:text-[#66A3BF]">createObjectURL</code> APIs.
          </p>
          <div class="p-3.5 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] flex items-center justify-between text-xs font-mono text-[#6B7A90]">
            <span>Network Transmission:</span>
            <span class="text-[#0D9488] font-bold">0 Bytes Transferred</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="scroll-step-card card-panel p-8 rounded-[16px] space-y-4" data-step="2">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0]">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">STEP 02</span>
              <span class="text-xs text-[#6B7A90] font-mono">/ EVALUATION</span>
            </div>
            <span class="text-[11px] font-mono uppercase bg-[#C8DFDB]/60 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/30 font-semibold">28 Active Rules</span>
          </div>
          <h3 class="text-xl font-bold text-[#192538]">Deterministic Rule Specification Audit</h3>
          <p class="text-sm text-[#475569] leading-relaxed">
            Your file is automatically benchmarked against the official Discord Rule Registry. We check binary byte boundaries (enforcing 256 KiB / 262,144 bytes vs naive 256 KB decimal limits), exact aspect ratios, and format requirements before any modification.
          </p>
          <div class="p-3.5 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] flex items-center justify-between text-xs font-mono text-[#6B7A90]">
            <span>Rule Evaluation Latency:</span>
            <span class="text-[#3368A0] dark:text-[#66A3BF] font-bold">&lt; 4 milliseconds</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="scroll-step-card card-panel p-8 rounded-[16px] space-y-4" data-step="3">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0]">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">STEP 03</span>
              <span class="text-xs text-[#6B7A90] font-mono">/ TRANSFORMATION</span>
            </div>
            <span class="text-[11px] font-mono uppercase bg-[#C8DFDB]/60 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/30 font-semibold">Lossless Canvas</span>
          </div>
          <h3 class="text-xl font-bold text-[#192538]">Hardware-Accelerated Canvas Cropping</h3>
          <p class="text-sm text-[#475569] leading-relaxed">
            Our multi-threaded Web Workers execute bicubic downscaling, transparent Alpha channel preservation, and safe-zone overlay alignment (such as the desktop client's top 48px banner obstruction) without altering your original source master.
          </p>
          <div class="p-3.5 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] flex items-center justify-between text-xs font-mono text-[#6B7A90]">
            <span>Safe-Zone Precision:</span>
            <span class="text-[#0D9488] font-bold">100% Geometry Match</span>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="scroll-step-card card-panel p-8 rounded-[16px] space-y-4" data-step="4">
          <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0]">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-[#3368A0] dark:text-[#66A3BF]">STEP 04</span>
              <span class="text-xs text-[#6B7A90] font-mono">/ EXPORT</span>
            </div>
            <span class="text-[11px] font-mono uppercase bg-[#C8DFDB]/60 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/30 font-semibold">Zero Upload Failures</span>
          </div>
