---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
import SketchCircle from '../components/SketchCircle.astro';
import HeroSimulator from '../components/HeroSimulator.astro';
import AnimatedHeroTitle from '../components/AnimatedHeroTitle.astro';
import { DISCORD_RULES } from '../data/discord-rules';

const pageTitle = "Discord Asset Studio | Creator Resizer & Validator";
const pageDescription = "Inspect, resize, and validate Discord assets against official rules. 100% in-browser processing for emojis, stickers, banners, and avatars.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did Discord reject my custom emoji under 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). A file showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exact dimensions for Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server when I use this tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server."
      }
    },
    {
      "@type": "Question",
      "name": "What are the rules for animated Discord stickers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section: Creative Studio First -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Studio Value Prop & Direct Action CTAs (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Discreet Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-5 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488]"></span>
          <span>Discord rules verified · Private by design</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#192538] dark:text-white tracking-tight leading-[1.15] mb-5">
          <span class="block">The asset studio built for</span>
          <span class="block">
            <AnimatedHeroTitle />
          </span>
          <span class="block mt-1 sm:mt-1.5">
            <span class="relative inline-block sketch-trigger">
              <span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Made to fit Discord.</span>
              <SketchUnderline color="#66A3BF" />
            </span>
          </span>
        </h1>

        <p class="text-[#475569] dark:text-[#94A3B8] text-base sm:text-lg leading-relaxed mb-7 max-w-xl">
          Design vibrant custom emojis, crisp server stickers, immersive banners, and sharp profile avatars calibrated for Discord's exact display engines. 100% in-browser.
        </p>

        <!-- Primary & Secondary Action Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-5">
          <a href="#asset-vault" class="btn-primary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold shadow-sm">
            Create an Asset
          </a>
          <a href="/tools/emoji" class="btn-secondary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Check a File
          </a>
        </div>

        <!-- Quick Asset Category Selector -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6">
          <span class="font-medium">Or start with:</span>
          <a href="/tools/banner" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🖼️ Banner
          </a>
          <a href="/tools/avatar" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            👤 Avatar
          </a>
          <a href="/tools/emoji" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            😀 Emoji
          </a>
          <a href="/tools/sticker" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🏷️ Sticker
          </a>
        </div>

        <!-- Privacy Assurance -->
        <div class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7]">
          <svg class="w-3.5 h-3.5 text-[#0D9488] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Private by design: Local browser processing only. No cloud uploads.</span>
        </div>
      </div>

      <!-- Right Column: Interactive Studio Stage (5 cols) -->
      <div class="lg:col-span-5">
        <HeroSimulator />
      </div>
    </div>
  </section>

  <!-- Visual Asset Vault: "Start with a design" -->
  <section id="asset-vault" class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-16 border-t border-[#E0DBD0] dark:border-[#263346] scroll-mt-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#192538] dark:text-white tracking-tight">
          Start with a <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">design</span><SketchUnderline color="#66A3BF" /></span>
        </h2>
        <p class="text-[#475569] dark:text-[#94A3B8] text-sm sm:text-base mt-2">
          Curated Discord templates crafted for exact display dimensions. Hover any design to customize.
        </p>
      </div>

      <!-- Filter Buttons: All · Banner · Avatar · Emoji · Sticker -->
      <div class="flex items-center gap-1.5 p-1 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] overflow-x-auto select-none" id="showcaseFilterBar">
        <button type="button" data-filter="all" class="showcase-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold bg-[#3368A0] text-white shadow-xs">
          All
        </button>
        <button type="button" data-filter="banner" class="showcase-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Banner
        </button>
        <button type="button" data-filter="avatar" class="showcase-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Avatar
        </button>
        <button type="button" data-filter="emoji" class="showcase-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Emoji
        </button>
        <button type="button" data-filter="sticker" class="showcase-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
          Sticker
        </button>
      </div>
    </div>

    <!-- Visual Asset Cards Grid: Artwork-First Vault -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6" id="showcaseGrid">
      
      <!-- Vault Item 1: Neo Tokyo Nights (Banner) -->
      <a href="/tools/banner" class="showcase-item group relative rounded-[16px] overflow-hidden bg-[#0A0E1A] border border-[#E0DBD0] dark:border-[#263346] shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col aspect-[4/3] cursor-pointer" data-type="banner">
        <div class="relative w-full h-full overflow-hidden">
          <svg class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500 ease-out" viewBox="0 0 400 300" fill="none">
            <defs>
              <linearGradient id="ntSky" x1="0" y1="0" x2="0" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#080718" />
                <stop offset="45%" stop-color="#1E1236" />
                <stop offset="75%" stop-color="#3A1752" />
                <stop offset="100%" stop-color="#0D1122" />
              </linearGradient>
              <linearGradient id="neonCyanGleam" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#58E1FF" />
                <stop offset="100%" stop-color="#5865F2" />
              </linearGradient>
            </defs>
            <rect width="400" height="300" fill="url(#ntSky)" />
            <!-- City Spire Silhouettes -->
            <polygon points="40,300 40,110 65,95 90,110 90,300" fill="#0E0D22" />
            <polygon points="110,300 110,70 140,50 170,70 170,300" fill="#12102A" />
            <polygon points="190,300 190,120 220,105 250,120 250,300" fill="#0C0B1E" />
            <polygon points="270,300 270,80 300,60 330,80 330,300" fill="#13102C" />
            <polygon points="345,300 345,130 380,115 395,130 395,300" fill="#0B0A1C" />
            <!-- Neon Windows & Signs -->
            <line x1="140" y1="50" x2="140" y2="25" stroke="#58E1FF" stroke-width="2" />
            <circle cx="140" cy="23" r="3" fill="#EF4444" />
            <rect x="125" y="90" width="30" height="4" rx="2" fill="#58E1FF" />
            <rect x="125" y="105" width="30" height="4" rx="2" fill="#FF5E7E" />
            <rect x="125" y="120" width="30" height="4" rx="2" fill="#58E1FF" />
            <rect x="285" y="95" width="30" height="4" rx="2" fill="#57F287" />
            <rect x="285" y="110" width="30" height="4" rx="2" fill="#EB459E" />
            <!-- Street Reflection Glow -->
            <rect y="270" width="400" height="30" fill="#180F33" opacity="0.8" />
            <line x1="0" y1="270" x2="400" y2="270" stroke="url(#neonCyanGleam)" stroke-width="2" stroke-opacity="0.8" />
            <!-- Safe Zone Header Indicator -->
            <rect width="400" height="28" fill="#000000" fill-opacity="0.45" />
            <line x1="0" y1="28" x2="400" y2="28" stroke="#FFFFFF" stroke-width="0.75" stroke-opacity="0.2" />
          </svg>

          <!-- Top-Left Badge -->
          <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-white/90 text-[10px] font-mono font-semibold border border-white/10 shadow-xs">
              16:9 Banner
            </span>
          </div>

          <!-- Bottom Label (Resting View) -->
          <div class="absolute inset-x-0 bottom-0 p-3.5 pt-10 bg-gradient-to-t from-black/85 via-black/40 to-transparent z-10 flex items-center justify-between group-hover:opacity-0 transition-opacity duration-300">
            <div>
              <div class="text-xs font-bold text-white tracking-wide">Neo Tokyo Nights</div>
              <div class="text-[10px] font-mono text-emerald-400">960 × 540 • Safe Zone Ready</div>
            </div>
            <span class="text-white/60 text-xs">→</span>
          </div>

          <!-- Hover Overlay Scrim -->
          <div class="absolute inset-0 z-20 bg-black/65 backdrop-blur-[3px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center">
            <span class="text-xs font-mono text-emerald-400 font-bold mb-1 tracking-wider uppercase">Discord Ready</span>
            <h3 class="text-base font-bold text-white mb-3">Neo Tokyo Nights</h3>
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[8px] bg-[#3368A0] text-white text-xs font-bold shadow-md hover:bg-[#285280] transition-colors">
              <span>Customize</span>
              <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- Vault Item 2: Celestial Horizon (Banner) -->
      <a href="/tools/banner" class="showcase-item group relative rounded-[16px] overflow-hidden bg-[#0A0E1A] border border-[#E0DBD0] dark:border-[#263346] shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col aspect-[4/3] cursor-pointer" data-type="banner">
        <div class="relative w-full h-full overflow-hidden">
          <svg class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500 ease-out" viewBox="0 0 400 300" fill="none">
            <defs>
              <linearGradient id="chSky" x1="0" y1="0" x2="0" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#080B14" />
                <stop offset="50%" stop-color="#141E33" />
                <stop offset="100%" stop-color="#1E3A8A" />
              </linearGradient>
              <radialGradient id="chPlanet" cx="280" cy="110" r="90" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#FFFDF7" />
                <stop offset="45%" stop-color="#C8DFDB" />
                <stop offset="100%" stop-color="#3368A0" stop-opacity="0" />
              </radialGradient>
            </defs>
            <rect width="400" height="300" fill="url(#chSky)" />
            <!-- Starfield -->
            <g fill="#FFFFFF" opacity="0.8">
              <circle cx="50" cy="40" r="1.2" /><circle cx="120" cy="60" r="1.5" /><circle cx="200" cy="30" r="1.0" />
              <circle cx="340" cy="45" r="1.8" /><circle cx="70" cy="120" r="1.2" /><circle cx="370" cy="110" r="1.4" />
            </g>
            <!-- Giant Ringed Planet -->
            <circle cx="280" cy="110" r="60" fill="url(#chPlanet)" />
            <ellipse cx="280" cy="110" rx="110" ry="22" fill="none" stroke="#C8DFDB" stroke-width="4" stroke-opacity="0.4" transform="rotate(-15 280 110)" />
            <!-- Aurora Ribbon -->
            <path d="M0 160 C 120 110, 260 190, 400 130 L 400 220 C 280 170, 140 230, 0 160 Z" fill="#58E1FF" opacity="0.35" />
            <!-- Mountain Silhouette -->
            <path d="M0 240 L 90 180 L 190 225 L 290 160 L 400 230 L 400 300 L 0 300 Z" fill="#0C121D" />
            <line x1="0" y1="298" x2="400" y2="298" stroke="#58E1FF" stroke-width="2" stroke-opacity="0.6" />
          </svg>

          <!-- Top-Left Badge -->
          <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-white/90 text-[10px] font-mono font-semibold border border-white/10 shadow-xs">
              16:9 Banner
            </span>
          </div>

          <!-- Bottom Label -->
          <div class="absolute inset-x-0 bottom-0 p-3.5 pt-10 bg-gradient-to-t from-black/85 via-black/40 to-transparent z-10 flex items-center justify-between group-hover:opacity-0 transition-opacity duration-300">
            <div>
              <div class="text-xs font-bold text-white tracking-wide">Celestial Horizon</div>
              <div class="text-[10px] font-mono text-emerald-400">960 × 540 • 48px Header Safe</div>
            </div>
            <span class="text-white/60 text-xs">→</span>
          </div>

          <!-- Hover Overlay Scrim -->
          <div class="absolute inset-0 z-20 bg-black/65 backdrop-blur-[3px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center">
            <span class="text-xs font-mono text-emerald-400 font-bold mb-1 tracking-wider uppercase">Discord Ready</span>
            <h3 class="text-base font-bold text-white mb-3">Celestial Horizon</h3>
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[8px] bg-[#3368A0] text-white text-xs font-bold shadow-md hover:bg-[#285280] transition-colors">
              <span>Customize</span>
              <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- Vault Item 3: Cyber Samurai (Avatar) -->
      <a href="/tools/avatar" class="showcase-item group relative rounded-[16px] overflow-hidden bg-[#121620] border border-[#E0DBD0] dark:border-[#263346] shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col aspect-[4/3] cursor-pointer" data-type="avatar">
        <div class="relative w-full h-full overflow-hidden flex items-center justify-center p-4">
          <!-- Circular Safe Mask Preview -->
          <div class="relative w-32 h-32 rounded-full overflow-hidden border-2 border-[#5865F2] shadow-xl group-hover:scale-110 transition-transform duration-500">
            <svg class="w-full h-full" viewBox="0 0 200 200" fill="none">
              <rect width="200" height="200" fill="#141E30" />
              <!-- Helmet & Armor Silhouette -->
              <circle cx="100" cy="85" r="44" fill="#F2EFE7" />
              <!-- Cyberpunk Visor Slit -->
              <rect x="68" y="76" width="64" height="16" rx="8" fill="#3368A0" />
              <line x1="74" y1="84" x2="126" y2="84" stroke="#58E1FF" stroke-width="3" stroke-linecap="round" />
              <!-- Shoulders & Crest -->
              <polygon points="100,28 112,50 88,50" fill="#66A3BF" />
              <path d="M40 185 C 45 135, 75 125, 100 125 C 125 125, 155 135, 160 185 Z" fill="#0A0E18" />
              <path d="M85 125 L 100 155 L 115 125 Z" fill="#3368A0" />
            </svg>
            <!-- Discord Online Status Badge -->
            <div class="absolute bottom-1 right-1 w-5 h-5 rounded-full bg-[#23A55A] border-2 border-[#141E30]"></div>
          </div>

          <!-- Top-Left Badge -->
          <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-white/90 text-[10px] font-mono font-semibold border border-white/10 shadow-xs">
              512×512 Avatar
            </span>
          </div>

          <!-- Bottom Label -->
          <div class="absolute inset-x-0 bottom-0 p-3.5 pt-10 bg-gradient-to-t from-black/85 via-black/40 to-transparent z-10 flex items-center justify-between group-hover:opacity-0 transition-opacity duration-300">
            <div>
              <div class="text-xs font-bold text-white tracking-wide">Cyber Samurai</div>
              <div class="text-[10px] font-mono text-emerald-400">1:1 Circle Safe • HD 512px</div>
            </div>
            <span class="text-white/60 text-xs">→</span>
          </div>

          <!-- Hover Overlay Scrim -->
          <div class="absolute inset-0 z-20 bg-black/65 backdrop-blur-[3px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center">
            <span class="text-xs font-mono text-emerald-400 font-bold mb-1 tracking-wider uppercase">Discord Ready</span>
            <h3 class="text-base font-bold text-white mb-3">Cyber Samurai</h3>
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-[8px] bg-[#3368A0] text-white text-xs font-bold shadow-md hover:bg-[#285280] transition-colors">
              <span>Customize</span>
              <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- Vault Item 4: Astral Kitsune (Avatar) -->
      <a href="/tools/avatar" class="showcase-item group relative rounded-[16px] overflow-hidden bg-[#0D121F] border border-[#E0DBD0] dark:border-[#263346] shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col aspect-[4/3] cursor-pointer" data-type="avatar">
        <div class="relative w-full h-full overflow-hidden flex items-center justify-center p-4">
          <!-- Circular Safe Mask Preview -->
          <div class="relative w-32 h-32 rounded-full overflow-hidden border-2 border-[#58E1FF] shadow-xl group-hover:scale-110 transition-transform duration-500">
            <svg class="w-full h-full" viewBox="0 0 200 200" fill="none">
              <defs>
                <radialGradient id="kitsuneBg" cx="100" cy="100" r="100" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#1A2D4A" />
                  <stop offset="100%" stop-color="#080C14" />
                </radialGradient>
              </defs>
              <rect width="200" height="200" fill="url(#kitsuneBg)" />
              <!-- Fox Mask Face -->
              <polygon points="50,45 80,95 40,105" fill="#111A2B" />
              <polygon points="150,45 120,95 160,105" fill="#111A2B" />
              <polygon points="58,58 80,95 50,100" fill="#58E1FF" opacity="0.6" />
              <polygon points="142,58 120,95 150,100" fill="#58E1FF" opacity="0.6" />
              <!-- Head Silhouette -->
              <ellipse cx="100" cy="115" rx="55" ry="48" fill="#F2EFE7" />
              <polygon points="100,145 85,115 115,115" fill="#3368A0" />
              <!-- Glowing Azure Slit Eyes -->
              <ellipse cx="80" cy="110" rx="8" ry="4" fill="#58E1FF" transform="rotate(-15 80 110)" />
              <ellipse cx="120" cy="110" rx="8" ry="4" fill="#58E1FF" transform="rotate(15 120 110)" />
              <!-- Forehead Crest -->
              <circle cx="100" cy="88" r="4" fill="#EF4444" />
            </svg>
            <div class="absolute bottom-1 right-1 w-5 h-5 rounded-full bg-[#593695] border-2 border-[#0D121F]"></div>
          </div>

          <!-- Top-Left Badge -->
          <div class="absolute top-3 left-3 z-10">
            <span class="px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-white/90 text-[10px] font-mono font-semibold border border-white/10 shadow-xs">
              512×512 Avatar
            </span>
          </div>

          <!-- Bottom Label -->
