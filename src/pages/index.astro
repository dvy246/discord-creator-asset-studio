  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 border-t border-[#E0DBD0]">
    <div class="mb-10 text-center">
      <span class="text-xs font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Frequently Asked Questions</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mt-1">Discord Creator Asset FAQs</h2>
    </div>

    <div class="space-y-4">
      <div class="card-panel p-6 rounded-[14px]">
        <h3 class="text-base font-bold text-[#192538] mb-2">Why did Discord reject my custom emoji under 256 KB?</h3>
        <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
          Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). An emoji showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count.
        </p>
      </div>

      <div class="card-panel p-6 rounded-[14px]">
        <h3 class="text-base font-bold text-[#192538] mb-2">What are the exact dimensions for Discord server banners?</h3>
        <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
          Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone.
        </p>
      </div>

      <div class="card-panel p-6 rounded-[14px]">
        <h3 class="text-base font-bold text-[#192538] mb-2">Are my images uploaded to any server when I use this tool?</h3>
        <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
          No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server.
        </p>
      </div>

      <div class="card-panel p-6 rounded-[14px]">
        <h3 class="text-base font-bold text-[#192538] mb-2">What are the rules for animated Discord stickers?</h3>
        <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
          Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Scroll Stacking & Observer Script -->
  <script>
    function setupScrollStackSection(wrapperClass: string, indicatorClass: string, progressLineId: string) {
      const cardWrappers = document.querySelectorAll<HTMLElement>(wrapperClass);
      const stepIndicators = document.querySelectorAll<HTMLElement>(indicatorClass);
      const progressBar = document.getElementById(progressLineId);

      if (!cardWrappers.length) return () => {};

      function updateCardStack() {
        let activeIndex = 0;

        cardWrappers.forEach((wrapper, index) => {
          const rect = wrapper.getBoundingClientRect();
          const stickyTop = parseInt(window.getComputedStyle(wrapper).top, 10) || (96 + index * 16);
          const isLocked = rect.top <= stickyTop + 8;

          if (isLocked) {
            activeIndex = index;
          }

          // Smoothly scale previous locked cards as next card scrolls up
          const nextCard = cardWrappers[index + 1];
          if (nextCard) {
            const nextRect = nextCard.getBoundingClientRect();
            const nextStickyTop = parseInt(window.getComputedStyle(nextCard).top, 10) || (96 + (index + 1) * 16);
            const transitionDist = 180;
            
            if (nextRect.top < nextStickyTop + transitionDist) {
              const progress = Math.max(0, Math.min(1, (nextStickyTop + transitionDist - nextRect.top) / transitionDist));
              wrapper.style.transform = `scale(${1 - progress * 0.035})`;
              wrapper.style.filter = `brightness(${1 - progress * 0.08})`;
            } else {
              wrapper.style.transform = 'scale(1)';
              wrapper.style.filter = 'brightness(1)';
            }
          }
        });

        // Update left timeline indicators
        stepIndicators.forEach((ind, i) => {
          const dot = ind.querySelector('.step-dot');
          if (i <= activeIndex) {
            ind.classList.add('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.remove('text-[#6B7A90]', 'opacity-70');
            dot?.classList.add('border-current', 'scale-110');
            dot?.classList.remove('border-[#D0C9BD]', 'dark:border-[#35435C]');
          } else {
            ind.classList.remove('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
            ind.classList.add('text-[#6B7A90]', 'opacity-70');
            dot?.classList.remove('border-current', 'scale-110');
            dot?.classList.add('border-[#D0C9BD]', 'dark:border-[#35435C]');
          }
        });

        if (progressBar) {
          const pct = (activeIndex / (cardWrappers.length - 1)) * 100;
          progressBar.style.height = `${pct}%`;
        }
      }

      window.addEventListener('scroll', updateCardStack, { passive: true });
      updateCardStack();
      return updateCardStack;
    }

    function setupAllScrollLocking() {
      setupScrollStackSection('.sticky-step-wrapper', '.scroll-step-indicator', 'scroll-progress-line');
      setupScrollStackSection('.dossier-sticky-wrapper', '.dossier-step-indicator', 'dossier-progress-line');
    }

    setupAllScrollLocking();
    document.addEventListener('astro:after-swap', setupAllScrollLocking);
  </script>
</Layout>
