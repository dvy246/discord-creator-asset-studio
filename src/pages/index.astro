  <!-- Sticky Scroll Observer Script -->
  <script>
    function setupScrollLocking() {
      const stepCards = document.querySelectorAll('.scroll-step-card');
      const stepIndicators = document.querySelectorAll('.scroll-step-indicator');
      const progressBar = document.getElementById('scroll-progress-line');

      if (!stepCards.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const stepIndex = entry.target.getAttribute('data-step');
            stepIndicators.forEach((ind) => {
              const indStep = ind.getAttribute('data-step');
              const dot = ind.querySelector('.step-dot');
              if (indStep === stepIndex) {
                ind.classList.add('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
                ind.classList.remove('text-[#6B7A90]', 'opacity-70');
                dot?.classList.add('border-current', 'scale-110');
                dot?.classList.remove('border-[#D0C9BD]', 'dark:border-[#35435C]');
              } else {
                ind.classList.remove('text-[#3368A0]', 'dark:text-[#66A3BF]', 'font-bold');
                ind.classList.add('text-[#6B7A90]', 'opacity-70');
                dot?.classList.remove('border-current', 'scale-110');
                dot?.classList.add('border-[#D0C9BD]', 'dark:border-[#35435C]');
              }
            });

            if (progressBar && stepIndex) {
              const pct = ((parseInt(stepIndex, 10) - 1) / (stepCards.length - 1)) * 100;
              progressBar.style.height = `${pct}%`;
            }
          }
        });
      }, {
        rootMargin: '-20% 0px -40% 0px',
        threshold: 0.2
      });

      stepCards.forEach(card => observer.observe(card));
    }

    setupScrollLocking();
    document.addEventListener('astro:after-swap', setupScrollLocking);
  </script>
