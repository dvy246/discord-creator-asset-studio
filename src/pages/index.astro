---
import Layout from '../layouts/Layout.astro';
import { DISCORD_RULES } from '../data/discord-rules';

const pageTitle = "Discord Asset Studio | Creator Resizer & Validator";
const pageDescription = "Inspect, resize, and validate Discord assets against official rules. 100% in-browser processing for emojis, stickers, banners, and avatars.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did Discord reject my custom emoji under 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). A file showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exact dimensions for Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server when I use this tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server."
      }
    },
    {
      "@type": "Question",
      "name": "What are the rules for animated Discord stickers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section: Asymmetric Split -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Value Prop & CTAs (7 cols) -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#3b82f6]/10 text-[#3b82f6] text-xs font-semibold border border-[#3b82f6]/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
          Verified Rule Engine • Zero Server Uploads
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-6">
          Upload-ready Discord assets. <span class="text-[#3b82f6]">No guessing.</span>
        </h1>

        <p class="text-[#9da6b8] text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          Generic design tools leave you with blurry icons, awkward crops, and mysterious 256 KiB upload rejections. Discord Asset Studio inspects, resizes, and repairs your media directly in your browser against verified Discord rules.
        </p>

        <!-- CTA Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="/tools/emoji" class="inline-flex items-center justify-center px-6 py-3.5 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-sm font-semibold transition-colors shadow-sm">
            Launch Emoji Validator
          </a>
          <a href="/guides/discord-sizes" class="inline-flex items-center justify-center px-6 py-3.5 rounded-[8px] bg-[#1c2028] hover:bg-[#242934] border border-[#2b313e] text-[#f0f2f5] text-sm font-semibold transition-colors">
            View Official Size Guide
          </a>
        </div>

        <!-- Privacy & Local Processing Statement -->
        <div class="flex items-center gap-3 text-xs text-[#6b7385]">
          <svg class="w-4 h-4 text-[#10b981] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Private by architecture: Media stays in your local browser memory. No cloud processing or accounts required.</span>
        </div>
      </div>

      <!-- Right Column: Live Working Asset Validator Preview Card (5 cols) -->
      <div class="lg:col-span-5">
        <div class="bg-[#15181e] border border-[#2b313e] rounded-[12px] p-6 shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#2b313e] mb-5">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#ef4444]"></span>
              <span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span>
              <span class="w-3 h-3 rounded-full bg-[#10b981]"></span>
              <span class="text-xs font-mono text-[#9da6b8] ml-2">rule-check: custom-emoji</span>
            </div>
            <span class="text-[10px] font-mono uppercase bg-[#10b981]/10 text-[#10b981] px-2 py-0.5 rounded">Verified</span>
          </div>

          <!-- Interactive Target Selector Preview -->
          <div class="space-y-4 text-xs font-mono">
            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Target:</span>
              <span class="text-white font-semibold">Custom Emoji (128x128)</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Binary Byte Cap:</span>
              <span class="text-[#10b981] font-semibold">256 KiB (262,144 bytes)</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#1c2028] border border-[#2b313e]">
              <span class="text-[#9da6b8]">Display Preview:</span>
              <span class="text-[#f59e0b] font-semibold">32 × 32 px chat size</span>
            </div>

            <div class="p-3.5 rounded-[8px] bg-[#242934]/60 border border-[#3b82f6]/30 text-[#f0f2f5] text-[11px] leading-relaxed">
              <span class="text-[#3b82f6] font-bold">Rule Provenance:</span> Discord Help Center #204849977. Rule verified and maintained against active Discord client standards.
            </div>

            <a href="/tools/emoji" class="w-full py-2.5 rounded-[8px] bg-[#3b82f6] hover:bg-[#2563eb] text-white text-xs font-semibold text-center block transition-colors">
              Open Interactive Tool →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Asset Category Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-[#2b313e]">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white tracking-tight">Dedicated Creator Utilities</h2>
      <p class="text-[#9da6b8] text-sm mt-1">Select an asset type to inspect dimensions, test byte limits, and auto-correct format issues.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Emoji Card -->
      <a href="/tools/emoji" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          😀
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Custom Emoji Studio</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Upload up to 128x128, preview at 32x32 chat dimensions, and enforce the 256 KiB upload limit with lossless local compression.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Inspect Emoji →</span>
      </a>

      <!-- Sticker Card -->
      <a href="/tools/sticker" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          🏷️
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Sticker Compressor</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Format images to exactly 320x320 pixels and compress to under 512 KiB. Supports static PNG and animated APNG workflows.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Format Sticker →</span>
      </a>

      <!-- Banner Card -->
      <a href="/tools/banner" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          🖼️
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Profile & Server Banners</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Presets for Global (680x240), Per-Server (600x240), and Server Banners (960x540) with official top 48px safe-zone overlays.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Design Banner →</span>
      </a>

      <!-- Avatar Card -->
      <a href="/tools/avatar" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          👤
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Avatar & Profile Picture</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Circular crop preview and 512x512 square authoring canvas with transparent background checks and Nitro animated avatar flags.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Crop Avatar →</span>
      </a>

      <!-- Role Icon Card -->
      <a href="/tools/role-icon" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          🛡️
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Role Icon Maker</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Resize to exactly 64x64 pixels and verify under 256 KB. Cites Boost Level 2 and Manage Roles permission rules.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Create Role Icon →</span>
      </a>

      <!-- Size Guide Card -->
      <a href="/guides/discord-sizes" class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e] hover:border-[#3b82f6] transition-all block group">
        <div class="w-10 h-10 rounded-[8px] bg-[#3b82f6]/10 text-[#3b82f6] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-105 transition-transform">
          📋
        </div>
        <h3 class="text-base font-semibold text-white group-hover:text-[#3b82f6] transition-colors">Official Size Cheat Sheet</h3>
        <p class="text-xs text-[#9da6b8] mt-2 leading-relaxed">
          Comprehensive specification table covering dimensions, aspect ratios, file extensions, and server level requirements.
        </p>
        <span class="inline-flex items-center text-xs text-[#3b82f6] font-semibold mt-4">Browse Specs →</span>
      </a>
    </div>
  </section>

  <!-- 4-Step Workflow Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-[#2b313e]">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-semibold text-[#3b82f6] uppercase tracking-wider">The Verification Pipeline</span>
      <h2 class="text-3xl font-bold text-white tracking-tight mt-2">How Discord Asset Studio Works</h2>
      <p class="text-[#9da6b8] text-sm mt-2">Every asset runs through our four-step client validation engine before downloading.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <div class="text-xs font-mono font-bold text-[#3b82f6] mb-2">01 / UPLOAD</div>
        <h3 class="text-base font-semibold text-white mb-2">Select Media Locally</h3>
        <p class="text-xs text-[#9da6b8] leading-relaxed">
          Drag and drop images or paste from clipboard. Your file stays strictly within browser memory without reaching remote endpoints.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <div class="text-xs font-mono font-bold text-[#3b82f6] mb-2">02 / VALIDATE</div>
        <h3 class="text-base font-semibold text-white mb-2">Rule Evaluation</h3>
        <p class="text-xs text-[#9da6b8] leading-relaxed">
          We inspect pixel width, height, aspect ratio, format MIME, and exact binary byte weight against the Discord Rule Registry.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <div class="text-xs font-mono font-bold text-[#3b82f6] mb-2">03 / REPAIR</div>
        <h3 class="text-base font-semibold text-white mb-2">Canvas Crop & Compress</h3>
        <p class="text-xs text-[#9da6b8] leading-relaxed">
          Automatically crop to target aspect ratios, quantize color palettes, and downscale dimensions using client-side Canvas operations.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <div class="text-xs font-mono font-bold text-[#3b82f6] mb-2">04 / EXPORT</div>
        <h3 class="text-base font-semibold text-white mb-2">Blob Measurement</h3>
        <p class="text-xs text-[#9da6b8] leading-relaxed">
          Before your file downloads, we measure the final encoded Blob byte count to prove it falls within the required limits.
        </p>
      </div>
    </div>
  </section>

  <!-- Authoritative 650+ Word Editorial Guide Section (Crucial for SEO) -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 border-t border-[#2b313e]">
    <div class="mb-8">
      <span class="text-xs font-semibold text-[#3b82f6] uppercase tracking-wider">Technical Reference & Guide</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mt-2">
        Understanding Discord Asset Constraints: Sizes, Formats, and Limits
      </h2>
    </div>

    <div class="space-y-6 text-[#9da6b8] text-sm leading-relaxed border-l-2 border-[#3b82f6]/40 pl-6">
      <p>
        Creating assets for Discord requires navigating an intricate combination of pixel dimensions, binary byte boundaries, container formats, and permission tiers. Unlike traditional social media platforms where images are automatically downsampled or compressed on upload, Discord frequently rejects non-compliant assets with vague errors such as "File is too powerful" or silent visual cropping.
      </p>

      <h3 class="text-base font-semibold text-white pt-2">The Critical Difference Between Kilobytes and Kibibytes</h3>
      <p>
        One of the most frequent points of failure when uploading custom emojis is the file size threshold. Discord’s backend specifies a hard ceiling of <strong>256 KiB (262,144 bytes)</strong> for custom emojis. However, modern operating systems and design software frequently display file sizes in decimal units where 1 kilobyte equals 1,000 bytes rather than 1,024 bytes. A creator exporting an image measured at "256 KB" in macOS Finder or Windows Explorer may actually have an image weighing 262,500 bytes. To Discord's server, this asset exceeds the 262,144-byte cap and is rejected. Discord Asset Studio guarantees that every export is validated directly from its final in-memory Blob byte length, eliminating this disparity before download.
      </p>

      <h3 class="text-base font-semibold text-white pt-2">Server Banners and the Top 48-Pixel Safe Zone</h3>
      <p>
        Server banners represent one of the most prominent branding surfaces for community administrators. While Discord accepts banners starting at 960x540 pixels (and commonly recommends 1920x1080 to accommodate high-DPI displays), the desktop client overlays navigation headers, the server name, and dropdown menus across the upper 48 pixels of the artwork. Placing typography, critical badges, or character faces in this top region leads to obscured elements. Creators should structure banner compositions with focal points centered or positioned toward the lower two-thirds of the canvas.
      </p>

      <h3 class="text-base font-semibold text-white pt-2">Custom Stickers: Exact Dimension Enforcement</h3>
      <p>
        Unlike emojis, which can be uploaded at arbitrary square dimensions and scaled down by the Discord client, custom stickers must conform to exact geometric criteria. Discord mandates that custom stickers be exactly <strong>320x320 pixels</strong> and stay beneath <strong>512 KiB (524,288 bytes)</strong>. Animated stickers are further restricted: they must use the Animated PNG (APNG) format, have a total duration of 5 seconds or fewer, and not exceed 60 frames per second. Attempting to upload a GIF as a server sticker will result in an upload failure unless converted to APNG.
      </p>

      <h3 class="text-base font-semibold text-white pt-2">Color Space Management & Transparent Backgrounds</h3>
      <p>
        Discord clients render across a wide variety of hardware, from mobile OLED screens to desktop sRGB monitors. Assets exported in wide color gamuts such as Display P3 or Adobe RGB often appear desaturated or shifted when rendered inside Chromium-based desktop clients. For optimal color fidelity, all static and animated creator assets should be exported in standard sRGB with an 8-bit color depth. Additionally, preserving transparent Alpha channels in PNG files ensures emojis and role icons blend seamlessly across both Discord Dark and Light themes.
      </p>

      <h3 class="text-base font-semibold text-white pt-2">Client-Side Privacy: Why Local Processing Matters</h3>
      <p>
        Many online conversion utilities route your images through backend cloud servers, creating privacy risks and latency. Discord Asset Studio executes 100% of its transformations inside your device's browser memory. By leveraging HTML5 Canvas contexts, Web Workers, and native Blob encoders, we provide immediate visual feedback and verified downloads while ensuring that zero bytes of your artwork or proprietary brand assets are transmitted across the internet.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 border-t border-[#2b313e]">
    <div class="mb-10 text-center">
      <span class="text-xs font-semibold text-[#3b82f6] uppercase tracking-wider">Frequently Asked Questions</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mt-2">Discord Creator Asset FAQs</h2>
    </div>

    <div class="space-y-4">
      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <h3 class="text-base font-semibold text-white mb-2">Why did Discord reject my custom emoji under 256 KB?</h3>
        <p class="text-xs sm:text-sm text-[#9da6b8] leading-relaxed">
          Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). An emoji showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <h3 class="text-base font-semibold text-white mb-2">What are the exact dimensions for Discord server banners?</h3>
        <p class="text-xs sm:text-sm text-[#9da6b8] leading-relaxed">
          Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <h3 class="text-base font-semibold text-white mb-2">Are my images uploaded to any server when I use this tool?</h3>
        <p class="text-xs sm:text-sm text-[#9da6b8] leading-relaxed">
          No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server.
        </p>
      </div>

      <div class="p-6 rounded-[12px] bg-[#15181e] border border-[#2b313e]">
        <h3 class="text-base font-semibold text-white mb-2">What are the rules for animated Discord stickers?</h3>
        <p class="text-xs sm:text-sm text-[#9da6b8] leading-relaxed">
          Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower.
        </p>
      </div>
    </div>
  </section>
</Layout>
