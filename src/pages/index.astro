---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
import SketchCircle from '../components/SketchCircle.astro';
import HeroSimulator from '../components/HeroSimulator.astro';
import AnimatedHeroTitle from '../components/AnimatedHeroTitle.astro';
import TemplateCarousel from '../components/TemplateCarousel.astro';
import { generateItemListSchema } from '../utils/seo';
import { DISCORD_RULES } from '../data/discord-rules';

const pageTitle = "Discord Image Resizer | Format Without Uploads | Studio";
const pageDescription = "Free browser-based Discord image resizer. Inspect, resize, and validate custom emojis, stickers, banners, and avatars to official rules with zero uploads.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Discord Creator Asset Studio",
  "url": "https://discord-creator-asset-studio.pages.dev/",
  "description": pageDescription
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Discord Creator Asset Studio",
  "url": "https://discord-creator-asset-studio.pages.dev/",
  "logo": "https://discord-creator-asset-studio.pages.dev/favicon.svg"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why did Discord reject my custom emoji under 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord enforces a strict binary limit of 256 KiB (262,144 bytes). Operating systems frequently display file sizes in decimal kilobytes (1 KB = 1,000 bytes). A file showing as 256 KB on your computer might actually be 262,500 bytes, causing Discord to reject it. Discord Asset Studio measures the exact encoded Blob byte count."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exact dimensions for Discord server banners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recommends a minimum size of 960x540 pixels with a 16:9 aspect ratio, though 1920x1080 is commonly used. Remember that Discord overlays channel headers and navigation across the top 48 pixels of the banner on desktop, so important content should remain below that zone."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server when I use this tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Discord Asset Studio runs 100% client-side in your browser. All resizing, cropping, and compression happens locally inside your device memory using Web Workers and the HTML5 Canvas API. No media or filenames are ever sent to an external server."
      }
    },
    {
      "@type": "Question",
      "name": "What are the rules for animated Discord stickers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord custom stickers must be exactly 320x320 pixels and under 512 KiB (524,288 bytes). Animated stickers must use APNG (Animated PNG), have a maximum duration of 5 seconds, and run at 60 frames per second or lower."
      }
    }
  ]
};

const itemListSchema = JSON.parse(generateItemListSchema([
  { name: "Discord Emoji Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/emoji/", description: "Format custom emojis to 128x128 under 256 KiB" },
  { name: "Discord Sticker Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/sticker/", description: "Resize stickers to exact 320x320 under 512 KiB" },
  { name: "Discord Banner Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/banner/", description: "Crop server & profile banners with safe-zone overlay" },
  { name: "Discord Avatar Cropper", url: "https://discord-creator-asset-studio.pages.dev/tools/avatar/", description: "Circular crop 512x512 profile pictures" },
  { name: "Discord Role Icon Maker", url: "https://discord-creator-asset-studio.pages.dev/tools/role-icon/", description: "Format 64x64 role icons under 256 KB" }
]));
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Inject Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- Hero Section: Creative Studio First -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Studio Value Prop & Direct Action CTAs (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Discreet Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-5 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488]"></span>
          <span>Discord rules verified · Private by design</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#192538] dark:text-white tracking-tight leading-[1.15] mb-4">
          <span class="block"><mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Image Resizer</mark> & Asset Studio</span>
          <span class="block mt-1 sm:mt-1.5">
            <span class="relative inline-block sketch-trigger">
              <span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Made to fit Discord.</span>
              <SketchUnderline color="#66A3BF" />
            </span>
          </span>
        </h1>

        <div class="text-lg sm:text-2xl font-bold text-[#475569] dark:text-[#94A3B8] mb-6">
          The creator suite built for <AnimatedHeroTitle />
        </div>

        <p class="text-[#475569] dark:text-[#94A3B8] text-base sm:text-lg leading-relaxed mb-7 max-w-xl">
          Design vibrant custom emojis, crisp server stickers, immersive banners, and sharp profile avatars calibrated for Discord's exact display engines. 100% in-browser.
        </p>

        <!-- Primary & Secondary Action Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 mb-5">
          <a href="#asset-vault" class="btn-primary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold shadow-sm">
            Create an Asset
          </a>
          <a href="/tools/emoji/" class="btn-secondary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Check a File
          </a>
        </div>

        <!-- Quick Asset Category Selector -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6">
          <span class="font-medium">Or start with:</span>
          <a href="/tools/banner/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🖼️ Banner
          </a>
          <a href="/tools/avatar/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            👤 Avatar
          </a>
          <a href="/tools/emoji/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            😀 Emoji
          </a>
          <a href="/tools/sticker/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🏷️ Sticker
          </a>
          <a href="/tools/gif-maker/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🎞️ GIF Maker
          </a>
          <a href="/tools/profile-viewer/" class="px-2.5 py-1 rounded-md bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] text-[#192538] dark:text-[#CBD5E1] hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF] font-semibold transition-colors">
            🔍 Profile Viewer
          </a>
        </div>

        <!-- Privacy Assurance -->
        <div class="flex items-center gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7]">
          <svg class="w-3.5 h-3.5 text-[#0D9488] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Private by design: Local browser processing only. No cloud uploads.</span>
        </div>
      </div>

      <!-- Right Column: Interactive Studio Stage (5 cols) -->
      <div class="lg:col-span-5">
        <HeroSimulator />
      </div>
    </div>
  </section>

  <!-- 3D Stacked Template Showcase: "Start with a design" -->
  <section id="asset-vault" class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-16 border-t border-[#E0DBD0] dark:border-[#263346] scroll-mt-20">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/50 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-3 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488]"></span>
        <span>Interactive 3D Template Showcase · Drag & Explore</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#192538] dark:text-white tracking-tight">
        Start with a <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">design</span><SketchUnderline color="#66A3BF" /></span>
      </h2>
      <p class="text-[#475569] dark:text-[#94A3B8] text-sm sm:text-base mt-2 max-w-2xl">
        Swipe or drag through curated Discord templates crafted for exact platform dimensions. Click any design to bring it forward or open it in the studio.
      </p>
    </div>

    <TemplateCarousel />
  </section>

  <!-- Core Asset Category Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 border-t border-[#E0DBD0]">
    <div class="mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mt-1">
        Dedicated <span class="relative inline-block sketch-trigger"><span class="relative z-10">Utilities</span><SketchUnderline color="#66A3BF" /></span>
      </h2>
      <p class="text-[#475569] text-sm mt-1">Select an asset type to inspect dimensions, test byte limits, and auto-correct format issues.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Emoji Card -->
      <a href="/tools/emoji/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          😀
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Custom Emoji Studio</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Upload up to 128x128, preview at 32x32 chat dimensions, and enforce the 256 KiB upload limit with lossless local compression.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Inspect Emoji →</span>
      </a>

      <!-- Sticker Card -->
      <a href="/tools/sticker/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🏷️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Sticker Compressor</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Format images to exactly 320x320 pixels and compress to under 512 KiB. Supports static PNG and animated APNG workflows.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Format Sticker →</span>
      </a>

      <!-- Banner Card -->
      <a href="/tools/banner/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🖼️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Profile & Server Banners</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Presets for Global (680x240), Per-Server (600x240), and Server Banners (960x540) with official top 48px safe-zone overlays.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Design Banner →</span>
      </a>

      <!-- Avatar Card -->
      <a href="/tools/avatar/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          👤
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Avatar & Profile Picture</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Circular crop preview and 512x512 square authoring canvas with transparent background checks and Nitro animated avatar flags.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Crop Avatar →</span>
      </a>

      <!-- Role Icon Card -->
      <a href="/tools/role-icon/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🛡️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Role Icon Maker</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Resize to exactly 64x64 pixels and verify under 256 KB. Cites Boost Level 2 and Manage Roles permission rules.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Create Role Icon →</span>
      </a>

      <!-- Size Guide Card -->
      <a href="/guides/discord-sizes/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          📋
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Official Size Cheat Sheet</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Comprehensive specification table covering dimensions, aspect ratios, file extensions, and server level requirements.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Browse Specs →</span>
      </a>

      <!-- GIF Maker Card -->
      <a href="/tools/gif-maker/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🎞️
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Discord GIF Maker</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Convert MP4 and WebM clips to animated Discord GIFs with auto-compression under the strict 10MB Nitro limit.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Make GIF →</span>
      </a>

      <!-- Profile Viewer Card -->
      <a href="/tools/profile-viewer/" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">
          🔍
        </div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Profile Viewer & Grabber</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">
          Inspect full-resolution Discord avatars and animated banners by User ID. Instant snowflake account age calculator.
        </p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Lookup User →</span>
      </a>
    </div>
  </section>

  <!-- Text-Locking Sticky Scroll Section (Linear / Apple aesthetic) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 lg:py-28 border-t border-[#E0DBD0]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Pinned / Sticky Text Lock -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse"></span>
            Deterministic Pipeline
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#192538] tracking-tight leading-[1.15]">
            Every asset <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">locked</span><SketchUnderline color="#66A3BF" /></span> to official specs.
          </h2>

          <p class="text-[#475569] text-base leading-relaxed">
            Scroll through our four-step client validation engine. Files never touch external servers, never compress into blurry artifacts, and never get rejected at upload.
          </p>
        </div>

        <!-- Vertical Step Timeline & Lock Indicator -->
        <div class="relative pl-6 space-y-6 select-none">
          <!-- Background track line -->
          <div class="absolute left-2.5 top-2 bottom-2 w-0.5 bg-[#E0DBD0] dark:bg-[#263346]"></div>
          <!-- Active fill line -->
          <div id="scroll-progress-line" class="absolute left-2.5 top-2 w-0.5 bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 ease-out" style="height: 0%;"></div>

          <!-- Step 01 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#3368A0] dark:text-[#66A3BF] font-bold" data-step="1">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-current bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 scale-110 transition-transform">1</span>
            <span class="text-sm tracking-wide">01 / Local Ingestion</span>
          </div>

          <!-- Step 02 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="2">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">2</span>
            <span class="text-sm tracking-wide">02 / Rule Evaluation</span>
          </div>

          <!-- Step 03 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="3">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">3</span>
            <span class="text-sm tracking-wide">03 / Canvas Cropping</span>
          </div>

          <!-- Step 04 -->
          <div class="scroll-step-indicator flex items-center gap-4 transition-all duration-200 text-[#6B7A90] opacity-70" data-step="4">
            <span class="step-dot w-5 h-5 rounded-full border-2 border-[#D0C9BD] dark:border-[#35435C] bg-[#FAF8F5] dark:bg-[#141A24] flex items-center justify-center text-[10px] z-10 transition-transform">4</span>
            <span class="text-sm tracking-wide">04 / Verified Blob Export</span>
          </div>
        </div>

        <div class="pt-2">
          <a href="/tools/emoji/" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-[10px] text-xs font-semibold">
            <span>Test With Your Artwork</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Stacking & Locking Cards on Scroll -->
      <div class="lg:col-span-7 relative pb-20">
        <!-- Step 01 Card -->
