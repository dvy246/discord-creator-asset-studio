---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import SketchCircle from '../../components/SketchCircle.astro';

const pageTitle = "Discord Asset Studio | Validador y Redimensionador de Assets";
const pageDescription = "Inspecciona, redimensiona y valida imágenes para Discord. Procesamiento 100% en el navegador sin servidores para emojis, stickers y banners.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Por qué Discord rechazó mi emoji de menos de 256 KB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord impone un límite binario estricto de 256 KiB (262,144 bytes). Los sistemas operativos suelen mostrar tamaños en kilobytes decimales (1 KB = 1,000 bytes). Un archivo de 256 KB en su computadora puede tener 262,500 bytes. Discord Asset Studio mide los bytes exactos antes de la descarga."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuáles son las dimensiones exactas para el banner del servidor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Discord recomienda un mínimo de 960x540 píxeles con relación de aspecto 16:9 (o 1920x1080). Recuerde que los primeros 48 píxeles superiores están cubiertos por el menú de Discord en clientes de escritorio."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="relative inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-6 shadow-xs sketch-trigger">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Reglas Verificadas • Cero Subidas al Servidor
          <SketchCircle color="#3368A0" class="opacity-40 dark:opacity-70" />
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#192538] tracking-tight leading-[1.15] mb-6">
          Assets para Discord listos. <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Sin errores.</span><SketchUnderline color="#66A3BF" /></span>
        </h1>

        <p class="text-[#475569] text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          Las herramientas genéricas generan íconos borrosos, recortes imprevistos y rechazos de 256 KiB. Discord Asset Studio inspecciona, recorta y repara tus archivos directamente en tu navegador.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
          <a href="/tools/emoji" class="btn-primary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Crear y Validar Emoji
          </a>
          <a href="/es/guides/discord-sizes" class="btn-secondary inline-flex items-center justify-center px-7 py-3.5 rounded-[10px] text-sm font-semibold">
            Guía Oficial de Tamaños
          </a>
        </div>

        <div class="flex items-center gap-3 text-xs text-[#6B7A90]">
          <svg class="w-4 h-4 text-[#0D9488] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Privacidad total: Las imágenes no salen de tu dispositivo. Procesamiento local mediante Web Workers.</span>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="card-panel rounded-[14px] p-6 relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] mb-5">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#E0DBD0] dark:bg-[#303E54]"></span>
              <span class="w-3 h-3 rounded-full bg-[#C8DFDB] dark:bg-[#485C7A]"></span>
              <span class="w-3 h-3 rounded-full bg-[#66A3BF]"></span>
              <span class="text-xs font-mono font-medium text-[#475569] ml-2">regla: custom-emoji</span>
            </div>
            <span class="text-[11px] font-mono font-semibold uppercase bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] px-2.5 py-0.5 rounded border border-[#66A3BF]/20">Verificado</span>
          </div>

          <div class="space-y-3.5 text-xs font-mono">
            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Dimensiones:</span>
              <span class="text-[#192538] font-bold">128 × 128 px</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-[8px] bg-[#FAF8F5] border border-[#E0DBD0]">
              <span class="text-[#6B7A90]">Límite Binario:</span>
              <span class="text-[#0D9488] font-bold">256 KiB (262,144 bytes)</span>
            </div>
            <a href="/tools/emoji" class="btn-primary w-full py-3 rounded-[8px] text-xs font-semibold text-center block">
              Abrir Validador →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías de Herramientas -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 border-t border-[#E0DBD0]">
    <div class="mb-10">
      <span class="text-xs font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Herramientas</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#192538] tracking-tight mt-1">
        Utilidades para Creadores de <span class="relative inline-block sketch-trigger"><span class="relative z-10">Discord</span><SketchUnderline color="#66A3BF" /></span>
      </h2>
      <p class="text-[#475569] text-sm mt-1">Herramientas especializadas con reglas oficiales integradas.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <a href="/tools/emoji" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">😀</div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Editor de Emojis</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">128x128 y compresión exacta a 256 KiB con vista previa a 32px.</p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Inspeccionar →</span>
      </a>
      <a href="/tools/sticker" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">🏷️</div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Compresor de Stickers</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">Exactamente 320x320 píxeles y menos de 512 KiB en PNG/APNG.</p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Formatear →</span>
      </a>
      <a href="/tools/banner" class="card-panel p-6 rounded-[14px] block group">
        <div class="w-10 h-10 rounded-[10px] bg-[#C8DFDB]/50 dark:bg-[#1F2E45] text-[#3368A0] dark:text-[#66A3BF] flex items-center justify-center text-lg font-bold mb-4 group-hover:scale-110 transition-transform">🖼️</div>
        <h3 class="text-base font-bold text-[#192538] group-hover:text-[#3368A0] dark:group-hover:text-[#66A3BF] transition-colors">Banners de Servidor</h3>
        <p class="text-xs text-[#475569] mt-2 leading-relaxed">Guía de zona segura superior de 48px y soporte para Nitro y Boosts.</p>
        <span class="inline-flex items-center text-xs text-[#3368A0] dark:text-[#66A3BF] font-bold mt-4 group-hover:translate-x-1 transition-transform">Diseñar →</span>
      </a>
    </div>
  </section>
</Layout>
