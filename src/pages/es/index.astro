---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { generateItemListSchema } from '../../utils/seo';
import { homeFaqs } from '../../data/home-i18n.ts';

const pageTitle = "Creador de Banners de Discord y Estudio de Assets";
const pageDescription = "Creador de banners de Discord en el navegador, más herramientas de emoji, sticker, avatar e icono de rol. Ajusta a tamaños exactos y exporta sin subidas.";

// WebSite + Organization entities are emitted site-wide by Layout.astro (shared
// /#website and /#organization @ids, host-derived). Do NOT re-inject here.

// FAQPage JSON-LD built from the same Spanish source as the visible <details>
// list (home-i18n.ts) so structured data and on-page content never diverge.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.es.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const itemListSchema = JSON.parse(generateItemListSchema([
  { name: "Creador de Banners de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/", description: "Diseña banners de servidor y perfil de 960x540 con superposiciones de zona segura en tu navegador" },
  { name: "Creador de Emojis de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/emoji/", description: "Formatea emojis personalizados a 128x128 bajo 256 KiB" },
  { name: "Creador de Stickers de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/sticker/", description: "Redimensiona stickers a exactamente 320x320 bajo 512 KiB" },
  { name: "Creador de Banners de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/banner/", description: "Recorta banners de servidor y perfil con superposición de zona segura" },
  { name: "Recortador de Avatares de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/avatar/", description: "Recorte circular de fotos de perfil de 512x512" },
  { name: "Creador de Iconos de Rol de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/role-icon/", description: "Formatea iconos de rol de 64x64 bajo 256 KB" },
  { name: "Compresor de Imágenes de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/image-compressor/", description: "Reduce PNG, JPG y WebP por debajo del límite de subida de 10MB sin redimensionar" },
  { name: "Redimensionador de Imágenes de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/image-resizer/", description: "Escala imágenes a dimensiones exactas de avatar, sticker, emoji y banner con modos de ajuste" },
  { name: "Creador de Spoilers de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/spoiler/", description: "Oculta texto con marcado || || o difumina una imagen con el prefijo SPOILER_" },
  { name: "Paleta de Colores y Códigos Hex de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/colors/", description: "Copia los códigos hex de fondo, blurple y estados con selector HEX/RGB/HSL" },
  { name: "Generador de Marcas de Tiempo de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/timestamp/", description: "Genera marcado de marca de tiempo dinámico con zona horaria en los siete estilos" },
  { name: "Tablero de Copiar y Pegar Emojis de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/emoji-copy-paste/", description: "Copia con un clic emojis Unicode y kaomoji para pegar en cualquier chat de Discord" },
  { name: "Generador de Fuentes de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/fonts/", description: "Convierte texto en fuentes Unicode para nombres, biografías y chat con copia de un clic" },
  { name: "Generador de Texto de Colores para Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/colored-text/", description: "Aplica códigos de color ANSI, negrita y subrayado a tus palabras y copia un bloque listo para pegar" },
  { name: "Previsualizador de Markdown para Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/markdown/", description: "Da formato con negrita, cursiva, spoilers, citas, listas y bloques de código con una vista previa en vivo del mensaje en el chat" },
  { name: "Creador de Embeds Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/embed-builder/", description: "Diseña un embed rico con un formulario visual y vista previa en vivo de Discord, luego copia el JSON del webhook o envíalo directo a un canal" },
  { name: "Creador de Icono de Servidor de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/server-icon/", description: "Encuadra tu arte a un icono de servidor exacto de 512x512 con vista de cuadrado redondeado" },
  { name: "Creador de Logos e Insignias de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/badge-maker/", description: "Crea una insignia de servidor de texto o emoji sin riesgo de marca, PNG 512x512" },
  { name: "Compresor de GIF de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/gif-compressor/", description: "Reduce GIFs animados bajo el límite de 256 KiB para emojis o 10MB de chat" },
  { name: "Decodificador de Snowflake Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/snowflake/", description: "Decodifica cualquier ID de Discord en su fecha de creación, IDs de worker y proceso, y marcado de marca de tiempo, y extrae avatares y banners públicos" },
  { name: "Calculadora de Permisos Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/permissions-calculator/", description: "Marca los permisos de un rol o bot para obtener el entero exacto, decodifica cualquier valor, carga presets y crea la URL de invitación OAuth2 del bot" },
  { name: "Generador de Nombres de Usuario Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/username-generator/", description: "Genera ideas de nombre de usuario de Discord en nueve estilos con modo de 3 y 4 letras, copia con un clic y favoritos guardados" },
  { name: "Generador de Bio para Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/bio-generator/", description: "Crea una bio de Discord desde plantillas para copiar y pegar o bancos de palabras temáticos con contador de 190 caracteres, símbolos y favoritos guardados" },
  { name: "Generador de Formato de Texto para Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/text-formatting/", description: "Escribe tu texto una vez y copia cada estilo de markdown de Discord — negrita, cursiva, subrayado, tachado, spoiler, títulos, subtexto y código — cada uno con vista previa en vivo" },
  { name: "Compresor de Vídeo de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/video-compressor/", description: "Transcodifica MP4, WebM y MOV en el navegador con ffmpeg.wasm para caber en el límite de 10MB de Discord — reduce resolución, calidad CRF y opción de quitar audio" },
  { name: "Generador de Mensajes Falsos de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/fake-message-maker/", description: "Crea una captura de chat falso de Discord para memes, cómics y roleplay en un canvas — nombres, colores, avatares, etiquetas BOT, tema oscuro/claro y marca de agua FICTICIO activada por defecto" },
  { name: "Guía de Tamaños de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/guides/discord-sizes/", description: "Tabla de especificaciones con cada dimensión y límite de Discord" }
]));
---

<Layout title={pageTitle} description={pageDescription} lang="es">
  <!-- Inyectar Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <HomeContent lang="es" />
</Layout>
