---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { generateItemListSchema } from '../../utils/seo';
import { homeFaqs } from '../../data/home-i18n.ts';

const pageTitle = "Creador de Banners de Discord y Estudio de Assets";
const pageDescription = "Creador de banners de Discord en el navegador, más herramientas de emoji, sticker, avatar e icono de rol. Ajusta a tamaños exactos y exporta sin subidas.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Discord Creator Asset Studio",
  "url": "https://discord-creator-asset-studio.pages.dev/es/",
  "inLanguage": "es",
  "description": pageDescription
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Discord Creator Asset Studio",
  "url": "https://discord-creator-asset-studio.pages.dev/",
  "logo": "https://discord-creator-asset-studio.pages.dev/favicon.svg"
};

// FAQPage JSON-LD built from the same Spanish source as the visible <details>
// list (home-i18n.ts) so structured data and on-page content never diverge.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.es.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const itemListSchema = JSON.parse(generateItemListSchema([
  { name: "Creador de Banners de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/", description: "Diseña banners de servidor y perfil de 960x540 con superposiciones de zona segura en tu navegador" },
  { name: "Creador de Emojis de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/emoji/", description: "Formatea emojis personalizados a 128x128 bajo 256 KiB" },
  { name: "Creador de Stickers de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/sticker/", description: "Redimensiona stickers a exactamente 320x320 bajo 512 KiB" },
  { name: "Creador de Banners de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/banner/", description: "Recorta banners de servidor y perfil con superposición de zona segura" },
  { name: "Recortador de Avatares de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/avatar/", description: "Recorte circular de fotos de perfil de 512x512" },
  { name: "Creador de Iconos de Rol de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/tools/role-icon/", description: "Formatea iconos de rol de 64x64 bajo 256 KB" },
  { name: "Guía de Tamaños de Discord", url: "https://discord-creator-asset-studio.pages.dev/es/guides/discord-sizes/", description: "Tabla de especificaciones con cada dimensión y límite de Discord" }
]));
---

<Layout title={pageTitle} description={pageDescription} lang="es">
  <!-- Inyectar Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <HomeContent lang="es" />
</Layout>
