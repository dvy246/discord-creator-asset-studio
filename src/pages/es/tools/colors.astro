---
import Layout from '../../../layouts/Layout.astro';
import ColorWorkspace from '../../../components/tools/ColorWorkspace.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../../utils/seo';

const pageTitle = "Color de Fondo de Discord | Códigos Hex y Paleta";
const pageDescription = "Color de fondo de Discord: tema oscuro #313338, blurple #5865F2, colores de estado y más. Copia HEX, RGB, HSL con un clic, más un selector personalizado.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/colors/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/colors/";

const appSchema = generateSoftwareApplicationSchema("Paleta de Colores y Selector Hex de Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Color y Hex", url: pageUrl }
]);

const faqItems = [
  { q: "¿De qué color es el fondo de Discord?", a: "En el tema oscuro actual, el fondo principal del chat es #313338, con una barra lateral un poco más oscura en #2B2D31 y el riel de servidores más oscuro en #1E1F22. El tema claro usa #FFFFFF para el área principal y #F2F3F5 para los paneles laterales. Puedes copiar cualquiera de estos códigos hex desde la paleta." },
  { q: "¿Cuál es el código hex del blurple de Discord?", a: "El blurple de marca de Discord es #5865F2. El blurple anterior, más claro, usado antes del rediseño de 2021, es #7289DA. Un tono más oscuro para estados de botón presionado es #4752C4." },
  { q: "¿Cuáles son los colores de estado de Discord?", a: "En línea es verde #23A55A, Ausente es ámbar #F0B232, No molestar es rojo #F23F43, Transmitiendo es morado #593695 y Desconectado es gris #80848E. Aparecen en el pequeño punto de presencia sobre el avatar." },
  { q: "¿Cómo combino un color con el tema de Discord?", a: "Usa el selector personalizado para muestrear cualquier color y leer sus valores exactos HEX, RGB y HSL. Copia el valor en tu herramienta de diseño para que banners, emojis e iconos de rol encajen sobre el fondo oscuro #313338 o el claro #FFFFFF." }
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "es",
  "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/colors.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Color y Hex</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        Valores de referencia
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Color de Fondo de Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Copia los códigos hex del tema oscuro, el tema claro, el blurple y los estados de Discord, más un selector personalizado con <strong>HEX, RGB y HSL</strong>.
      </p>
    </header>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <ColorWorkspace lang="es" />

    <div class="space-y-6 mb-12 mt-8">
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">¿De Qué Color Es el Fondo de Discord?</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          En el tema oscuro, el área principal del chat es <strong>#313338</strong>. Las barras laterales van un tono más oscuro en <strong>#2B2D31</strong> y el riel de servidores es el más oscuro en <strong>#1E1F22</strong>. El tema claro usa <strong>#FFFFFF</strong> con paneles en <strong>#F2F3F5</strong>. Previsualizar un PNG transparente sobre #313338 te muestra cómo se verá en la mayoría de los servidores.
        </p>
      </article>
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Blurple de Marca y Colores de Estado</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          El color de marca de Discord es el blurple <strong>#5865F2</strong> (el anterior era <strong>#7289DA</strong>). Los puntos de presencia usan verde <strong>#23A55A</strong>, ámbar <strong>#F0B232</strong>, rojo <strong>#F23F43</strong> y gris <strong>#80848E</strong>. Cada muestra copia su código con un clic.
        </p>
      </article>
    </div>

    <section>
      <h2 class="text-2xl font-bold text-[#192538] dark:text-white mb-6 text-center">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.q}</h3>
            <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
