---
import Layout from '../../../layouts/Layout.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../../utils/seo';

const pageTitle = "Recortador de Avatar Discord | Circular 512×512";
const pageDescription = "Recortador de avatar Discord: recorta fotos de perfil a 512×512 px con máscara circular. PNG, GIF y WebP. 100% en tu navegador, sin subidas.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/avatar/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/avatar/";

const appSchema = generateSoftwareApplicationSchema("Recortador de Avatares para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Estudio de Avatares", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cuál es el tamaño recomendado para el avatar de Discord?", a: "Se recomienda 512×512 píxeles (relación 1:1). Discord recorta el avatar en círculo y permite subidas de hasta 8 MB." },
  { q: "¿Qué formatos acepta Discord para avatares?", a: "PNG, JPEG, WebP y GIF animado. Los avatares animados GIF requieren una suscripción Nitro." },
  { q: "¿Por qué mi avatar se ve borroso?", a: "Si lo creas por debajo de 512×512, las pantallas Retina lo amplían y pixelan. Exporta siempre a 512×512 con la composición centrada." }
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "es",
  "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/avatar.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Estudio de Avatares</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        100% en el navegador · Cero subidas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Recortador de Avatar Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Recorta fotos de perfil e iconos de servidor a <strong>512×512 píxeles</strong> con vista previa de máscara circular. Comprueba el recorte circular antes de subir. Todo el procesamiento ocurre localmente en tu navegador.
      </p>
    </header>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Tamaño</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">512×512 px</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Límite</p>
        <p class="text-sm font-bold text-[#0D9488]">8 MB</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Máscara</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">Circular</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Formatos</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">PNG GIF WebP</p>
      </div>
    </div>

    <div class="rounded-[16px] border-2 border-[#3368A0]/30 dark:border-[#66A3BF]/30 bg-gradient-to-br from-[#FAF8F5] to-[#C8DFDB]/20 dark:from-[#141A24] dark:to-[#202E42]/50 p-6 sm:p-8 text-center mb-8">
      <span class="inline-block px-3 py-1 rounded-full bg-[#0D9488]/15 text-[#0D9488] font-bold text-xs font-mono mb-3">HERRAMIENTA INTERACTIVA</span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-[#192538] dark:text-white mb-2">Abrir el Estudio de Avatares</h2>
      <p class="text-sm text-[#475569] dark:text-[#CBD5E1] max-w-lg mx-auto mb-5">
        La herramienta interactiva completa (recorte cuadrado con vista previa de máscara circular en vivo) está disponible en el estudio principal.
      </p>
      <a href={enUrl} class="btn-primary inline-block text-xs px-6 py-3 rounded-[10px] font-semibold shadow-sm">
        Abrir Herramienta de Avatares →
      </a>
      <p class="text-[11px] text-[#6B7A90] mt-3">La herramienta funciona igual en todos los idiomas — tus archivos nunca salen de tu dispositivo.</p>
    </div>

    
    <div class="space-y-6 mb-12 mt-8">
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">La Máscara Circular</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          Discord renderiza los avatares dentro de una máscara circular en el chat y los perfiles. Las esquinas se recortan, así que mantén el punto focal centrado dentro de la zona circular segura y evita colocar detalles importantes en las esquinas del lienzo.
        </p>
      </article>
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Resolución para Pantallas Retina</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          Crea siempre tus avatares a 512×512 píxeles. Las pantallas de alta densidad (2x/3x) amplían las imágenes de menor resolución y causan pixelación. Exporta con composición centrada y bordes limpios.
        </p>
      </article>
    </div>

    <section>
      <h2 class="text-2xl font-bold text-[#192538] dark:text-white mb-6 text-center">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.q}</h3>
            <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

