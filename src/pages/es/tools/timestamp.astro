---
import Layout from '../../../layouts/Layout.astro';
import TimestampWorkspace from '../../../components/tools/TimestampWorkspace.astro';
import ToolDossier from '../../../components/tools/ToolDossier.astro';
import ToolFaq from '../../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../../utils/seo';

const pageTitle = "Generador de Marcas de Tiempo Discord | Dinámicas";
const pageDescription = "Generador de marcas de tiempo Discord: elige una fecha y copia el marcado <t:UNIX:F> en todos los estilos. Se ajustan a la zona horaria de cada persona.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/timestamp/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/timestamp/";

const appSchema = generateSoftwareApplicationSchema("Generador de Marcas de Tiempo para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Marcas de Tiempo", url: pageUrl }
]);

const faqItems = [
  { q: "¿Qué es una marca de tiempo de Discord y cómo funciona el formato <t:UNIX:estilo>?", a: "Una marca de tiempo de Discord es un marcado escrito como <t:UNIX:estilo>, donde UNIX es el tiempo epoch en segundos y la letra de estilo fija el formato. Discord reemplaza el código por una fecha con zona horaria que cada lector ve en su propio reloj local." },
  { q: "¿Cuáles son todos los códigos de formato de marca de tiempo de Discord (t, T, d, D, f, F, R)?", a: "Hay siete letras de estilo: t (hora corta), T (hora larga con segundos), d (fecha corta), D (fecha larga), f (fecha y hora corta, por defecto), F (fecha y hora larga con día de la semana) y R (relativa, como 'en 2 horas'). Este generador produce las siete para cualquier fecha." },
  { q: "¿Cómo obtengo la marca de tiempo Unix para un mensaje de Discord?", a: "Elige la fecha y hora que quieras en el generador de arriba y convierte tu selección a un valor epoch Unix automáticamente, luego lo envuelve en el código <t:UNIX:estilo> completo. Copia el estilo que necesites y pégalo directo en Discord, sin cálculos de epoch manuales." },
  { q: "¿Las marcas de tiempo de Discord se ajustan a la zona horaria de cada usuario?", a: "Sí. Discord muestra el mismo código en la zona horaria local de cada lector, así una persona en Nueva York y otra en Tokio ven el momento correcto en su propia hora. Eso hace ideales las marcas de tiempo para programar eventos sin listar varias zonas horarias." },
  { q: "¿Cómo hago un temporizador de cuenta regresiva o una marca de tiempo relativa en Discord?", a: "Usa el estilo relativo, <t:UNIX:R>. Se muestra como 'en 3 horas' o 'hace 2 días' y se recalcula solo con el paso del tiempo, así un evento cuenta regresiva de forma discreta. Elige tu fecha objetivo arriba y copia la salida en estilo R para insertar una cuenta viva en cualquier mensaje." }
];

const dossier = {
  eyebrow: "Plano Técnico de Marcas de Tiempo",
  heading: "Marcas de tiempo que se adaptan a la",
  highlight: "zona horaria de cada lector",
  intro: "Las marcas de tiempo de Discord son más que una fecha: son marcado dinámico que se muestra en la hora local de cada persona e incluso puede contar hacia atrás por sí solo. Así encajan la sintaxis, los estilos y el motor de zona horaria.",
  steps: [
    "Sintaxis de la Marca",
    "Los Siete Códigos de Estilo",
    "Conversión Automática de Zona",
    "Cuentas Regresivas y Eventos"
  ],
  cards: [
    {
      kicker: "ANATOMÍA DE SINTAXIS // 01",
      badge: "<t:UNIX:ESTILO>",
      badgeTone: "emerald" as const,
      title: "El marcado <t:UNIX:estilo>, descifrado",
      body: [
        "Toda marca de tiempo de Discord sigue un patrón: una apertura <t:, un tiempo epoch Unix medido en segundos desde el 1 de enero de 1970, dos puntos, una letra de estilo opcional y un cierre >. Por ejemplo, <t:1735689600:F> apunta a un instante preciso, y la F le dice a Discord que lo muestre como fecha y hora larga.",
        "El número epoch es el mismo para todo el planeta: es el ancla neutral respecto a la zona horaria. La letra de estilo es puramente cosmética. Como nunca escribes una fecha humana directamente, no hay ambigüedad de orden día-mes ni AM/PM: eliges un momento arriba y el generador produce el código exacto que Discord espera."
      ]
    },
    {
      kicker: "REGISTRO DE ESTILOS // 02",
      badge: "7 LETRAS DE ESTILO",
      badgeTone: "blue" as const,
      title: "Los siete códigos de estilo y cuándo usar cada uno",
      body: [
        "Discord admite siete estilos: t hora corta, T hora larga con segundos, d fecha corta, D fecha larga, f fecha y hora corta (por defecto cuando no se da letra), F fecha y hora larga con día de la semana, y R relativa. Cada uno lee el mismo epoch subyacente pero lo enmarca distinto.",
        "Usa D o F para anuncios puntuales donde importa la fecha completa, t para horas rápidas dentro de una frase, y R para lo que deba sentirse vivo. El generador muestra una vista previa de los siete a la vez, así copias con un clic el estilo que se lea más natural en tu mensaje."
      ]
    },
    {
      kicker: "MOTOR DE ZONA HORARIA // 03",
      badge: "AUTO-LOCALIZADO",
      badgeTone: "amber" as const,
      title: "Por qué cada lector ve su propia hora local",
      body: [
        "La mayor razón para usar marcas de tiempo es la seguridad de zona horaria. En vez de escribir 'la raid empieza a las 8 PM EST / 1 AM UTC / 10 AM JST', publicas un código <t:UNIX:F> y Discord lo convierte al reloj del dispositivo de cada miembro automáticamente. Nadie hace cálculos y nadie llega una hora antes.",
        "Esto funciona porque el valor epoch es absoluto. El cliente de Discord lee la zona horaria del sistema operativo al mostrar y formatea el momento en consecuencia, así el mismo mensaje es correcto para un lector en Los Ángeles, Londres o Sídney."
      ],
      footer: "Un código, correcto en cada zona horaria — sin listar EST / UTC / JST a mano."
    },
    {
      kicker: "RENDERIZADO DINÁMICO // 04",
      badge: "CUENTA ESTILO R",
      badgeTone: "purple" as const,
      title: "Cuentas regresivas vivas para eventos y horarios",
      body: [
        "El estilo relativo, <t:UNIX:R>, es el único que cambia después de enviarlo. Se muestra como 'en 3 horas' antes de un evento y pasa a 'hace 2 horas' después, recalculándose cada vez que se ve el mensaje. Eso lo hace perfecto para descripciones de eventos, fines de sorteo y avisos de mantenimiento programado.",
        "Combina un estilo fijo con uno relativo para lo mejor de ambos: por ejemplo 'Empieza <t:UNIX:F> (<t:UNIX:R>)' muestra la fecha local exacta y una cuenta regresiva que se actualiza sola, lado a lado. Todo se genera en tu navegador, sin cuenta, sin subida ni rastreo."
      ],
      footer: "El estilo R se recalcula en cada vista — una cuenta regresiva que se mantiene sola."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/timestamp.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems, 'es')} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 relative z-10">
    <div class="mb-8">
      <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono" aria-label="Miga de pan">
        <div class="flex items-center gap-2">
          <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
          <span>/</span>
          <span class="text-[#192538] dark:text-white font-semibold">Marcas de Tiempo</span>
        </div>
        <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            Generador de Marcas de Tiempo Discord
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Elige una fecha y copia el marcado &lt;t:UNIX:estilo&gt; en los siete estilos • Se ajusta a la zona horaria de cada lector.</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Procesado en el navegador
        </div>
      </div>
    </div>

    <!-- Herramienta interactiva (mismo componente de workspace EN + ES) -->
    <TimestampWorkspace lang="es" />

    <!-- Dossier técnico de desplazamiento (componente compartido) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (componente compartido, misma fuente que el JSON-LD) -->
    <ToolFaq items={faqItems} heading="Preguntas Frecuentes" />
  </div>
</Layout>
