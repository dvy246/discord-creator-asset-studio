---
import Layout from '../../../layouts/Layout.astro';
import ImageCompressorWorkspace from '../../../components/tools/ImageCompressorWorkspace.astro';
import ToolDossier from '../../../components/tools/ToolDossier.astro';
import ToolFaq from '../../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../../utils/seo';

const pageTitle = "Compresor de Imágenes Discord | Bajo 10 MB";
const pageDescription = "Compresor de imágenes Discord: reduce PNG, JPG y WebP por debajo del límite de subida de 10 MB sin redimensionar. 100% en tu navegador, sin subidas.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/image-compressor/";
const enUrl = "/tools/image-compressor/";

const appSchema = generateSoftwareApplicationSchema("Compresor de Imágenes para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Compresor de Imágenes", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cómo comprimo una imagen para Discord?", a: "Suelta tu PNG, JPG o WebP en la herramienta, elige un tamaño objetivo acorde al límite de subida de tu cuenta y escoge un formato de salida. La imagen se redibuja en un canvas del navegador y se vuelve a codificar más pequeña; para JPEG o WebP ajustas el control de calidad hasta que encaje, y luego descargas el archivo comprimido y lo adjuntas en Discord." },
  { q: "¿Cuál es el límite de tamaño para subir imágenes en Discord?", a: "En una cuenta gratuita el límite es de 10 MB por archivo en el chat. Nitro Basic lo sube a 50 MB y Nitro completo a 500 MB, mientras que los avatares y los iconos de servidor tienen un tope aparte de 8 MB. El límite es por adjunto, así que una imagen demasiado grande hay que comprimirla en lugar de dividirla." },
  { q: "¿Cómo reduzco el tamaño de un PNG sin perder calidad?", a: "El PNG ya es sin pérdida, así que un control de calidad no puede encogerlo. Para hacer un PNG más pequeño sin pérdida visible, reduce su profundidad de color o sus dimensiones, o vuelve a codificarlo como WebP, que admite transparencia y modo sin pérdida a la vez que produce un archivo mucho menor. En gráficos planos y logotipos esos pasos recortan tamaño sin una caída de calidad perceptible." },
  { q: "JPEG vs PNG vs WebP: ¿cuál es mejor para Discord?", a: "Depende de la imagen. Usa PNG para transparencia o gráficos planos nítidos que deban ser sin pérdida, y JPEG para fotos que también compartes fuera de Discord. Para la mayoría de fotos y capturas publicadas en Discord gana WebP: se muestra de forma nativa en el chat y mete más detalle en menos bytes, dando el mejor equilibrio de tamaño y calidad bajo el límite." },
  { q: "¿Comprimir una imagen reduce su resolución?", a: "No. La compresión vuelve a codificar los mismos píxeles de forma más eficiente, así que el ancho y el alto se mantienen idénticos y la imagen se ve igual de nítida en una pantalla de alta resolución. Solo redimensionar cambia la resolución. Si necesitas un tamaño exacto como un avatar de 512×512, comprime primero y luego usa la herramienta de redimensionado del estudio." }
];

const dossier = {
  eyebrow: "Plano del Compresor de Imágenes",
  heading: "De una exportación demasiado grande a",
  highlight: "un archivo que Discord acepta",
  intro: "Discord rechaza cualquier adjunto de chat que supere su límite gratuito de 10 MB. En lugar de recortar detalle, este compresor vuelve a codificar los mismos píxeles en un archivo más pequeño — así encajan el límite, el codificador, la elección de formato y tu privacidad, todo en tu navegador.",
  steps: [
    "El Límite de 10 MB",
    "Con Pérdida vs Sin Pérdida",
    "Elegir el Formato",
    "Local y Privado"
  ],
  cards: [
    {
      kicker: "TOPE DE SUBIDA // 01",
      badge: "10 MB GRATIS",
      badgeTone: "emerald" as const,
      title: "Por qué tu PNG no se sube",
      body: [
        "Toda cuenta gratuita de Discord limita los adjuntos del chat a 10 MB por archivo. Parece generoso hasta que intentas compartir una captura en 4K, una foto de móvil apenas retocada o una obra de arte detallada — cualquiera de ellas puede superar el tope y rebotar con un mensaje de \"archivo demasiado grande\". Los PNG de alta resolución son los peores infractores: como PNG guarda cada píxel sin pérdida, una sola captura de pantalla completa puede pesar 15, 20 o incluso 30 MB antes de que añadas nada. El límite es por archivo, así que dividir la subida no ayuda con una única imagen grande.",
        "La compresión resuelve esto reduciendo el tamaño en bytes mientras mantiene la imagen utilizable. Apuntas la herramienta a un objetivo — los 10 MB gratuitos de Discord, o un nivel de Nitro superior si lo tienes — y vuelve a codificar la imagen para quedar por debajo de ese número. Nitro Basic sube el límite a 50 MB y Nitro completo a 500 MB, pero los 10 MB gratuitos son el muro con el que choca la mayoría. Como comprimes a un objetivo exacto en vez de adivinar, el archivo exportado pasa el límite en la primera subida en lugar de obligarte a probar, fallar y recortarlo a mano."
      ]
    },
    {
      kicker: "CIENCIA DEL CODIFICADOR // 02",
      badge: "CONTROL DE CALIDAD",
      badgeTone: "blue" as const,
      title: "Con pérdida frente a sin pérdida",
      body: [
        "Por dentro, la herramienta dibuja tu imagen en un canvas HTML y pide al navegador que la vuelva a codificar. Ese único paso es donde ocurre la reducción de tamaño, y cómo ocurre depende del formato. JPEG y WebP son con pérdida: un control de calidad te deja cambiar un poco de detalle fino por un archivo mucho más pequeño, y en ajustes moderados el detalle que descarta es invisible al ojo. Baja el control y el codificador desecha información de alta frecuencia que la mayoría de las pantallas y visores nunca llegan a resolver, así que la imagen sigue viéndose limpia mientras el recuento de bytes cae con fuerza.",
        "PNG funciona de otra manera. Es sin pérdida, es decir, guarda una copia exacta de cada píxel, así que un control de calidad no tiene nada que intercambiar y la herramienta lo desactiva para la salida PNG. Aún puedes hacer un PNG más pequeño — reduciendo sus dimensiones o su profundidad de color — pero no puedes regular la calidad como con un formato con pérdida. Esa es la decisión clave: los formatos con pérdida te dan una perilla suave de tamaño frente a calidad, mientras que el PNG sin pérdida garantiza un resultado píxel a píxel a costa de un archivo mayor. Saber qué palanca ofrece cada formato es lo que te permite alcanzar el objetivo sin arruinar la imagen."
      ]
    },
    {
      kicker: "ELECCIÓN DE FORMATO // 03",
      badge: "PNG / JPEG / WEBP",
      badgeTone: "amber" as const,
      title: "Elige el formato correcto",
      body: [
        "La elección de formato importa tanto como el ajuste de calidad, y depende de lo que contenga la imagen. Recurre a PNG cuando necesites transparencia o gráficos planos nítidos — logotipos, maquetas de interfaz, pixel art, cualquier cosa con bordes duros o un canal alfa que deba mantenerse afiladísimo. Elige JPEG para fotografías cuando quieras la máxima compatibilidad con otras apps y plataformas fuera de Discord. Para fotos y capturas que viven dentro de Discord, WebP suele ser la opción más inteligente: conserva el detalle fotográfico de maravilla y Discord lo muestra de forma nativa en el chat, así que no hay penalización de compatibilidad por el archivo más pequeño.",
        "WebP se gana su fama por el equilibrio entre tamaño y calidad: la predicción de bloques y la codificación de entropía modernas hacen que un archivo WebP sea claramente más pequeño que un JPEG con la misma calidad visual, y mucho más pequeño que un PNG en contenido fotográfico. La regla práctica es sencilla. Si la imagen tiene transparencia o debe ser sin pérdida, elige PNG. Si es una foto que va más allá de Discord, JPEG es la apuesta segura. Para casi todo lo demás — fotos, capturas y gráficos ricos publicados en Discord — WebP te da el mejor equilibrio y el archivo más pequeño que aún se ve bien, que es justo lo que quieres bajo un límite estricto."
      ],
      footer: "PNG para transparencia, JPEG para máxima compatibilidad, WebP para el mejor equilibrio de tamaño y calidad en Discord."
    },
    {
      kicker: "PRIVACIDAD POR DISEÑO // 04",
      badge: "CERO SUBIDAS",
      badgeTone: "purple" as const,
      title: "Todo corre en tu navegador",
      body: [
        "La mayoría de los compresores en línea suben tu archivo a un servidor, lo procesan allí y te devuelven un enlace de descarga — lo que significa que una copia de tu imagen queda ahora en la máquina de otra persona. Esta herramienta no hace nada de eso. Usa el propio codificador canvas del navegador, así que tu imagen se lee, se vuelve a codificar y se guarda por completo en tu propio dispositivo. Nada se transmite a un servidor, nada se registra y nada se conserva después de que te vayas. No hay cuenta que crear ni cola que esperar; el trabajo ocurre en el instante en que sueltas un archivo, ahí mismo en la pestaña.",
        "Ese diseño solo-local hace que la herramienta sea segura para las cosas que nunca querrías entregar a la nube de un desconocido: capturas privadas, recursos de trabajo sin publicar, fotos personales, maquetas de cliente bajo NDA. Como la imagen nunca sale de tu navegador, no hay subida que interceptar, ni registro de servidor que se filtre, ni política de retención en la que confiar. Cuando cierras la pestaña, todo rastro del archivo desaparece de la memoria. Obtienes la misma comodidad que un servicio en línea — arrastrar, comprimir, descargar — sin nada de la exposición que supone enviar tus originales por internet para procesarlos."
      ],
      footer: "La recodificación en canvas corre en tu dispositivo — sin subidas, sin registros, nada queda al cerrar la pestaña."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/image-compressor.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems, 'es')} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 relative z-10">
    <div class="mb-8">
      <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-2 font-mono" aria-label="Miga de pan">
        <div class="flex items-center gap-2">
          <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
          <span>/</span>
          <span class="text-[#192538] dark:text-white font-semibold">Compresor de Imágenes</span>
        </div>
        <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
      </nav>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-[#192538] dark:text-white tracking-tight">
            Compresor de Imágenes Discord
          </h1>
          <p class="text-xs sm:text-sm text-[#475569] dark:text-gray-400 mt-1">Reduce PNG, JPG y WebP bajo el límite de subida de Discord • Dimensiones originales intactas • 100% en el navegador</p>
        </div>
        <div class="flex items-center gap-2 text-xs bg-[#FFFFFF] dark:bg-black/40 px-3.5 py-1.5 rounded-[8px] border border-[#C8DFDB] dark:border-white/10 text-[#3368A0] dark:text-[#66A3BF] font-medium shadow-xs backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
          Procesado en el navegador
        </div>
      </div>
    </div>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <ImageCompressorWorkspace lang="es" />

    <ToolDossier {...dossier} />

    <ToolFaq items={faqItems} heading="Preguntas Frecuentes" />
  </div>
</Layout>
