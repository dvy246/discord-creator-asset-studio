---
import Layout from '../../../layouts/Layout.astro';
import AnsiWorkspace from '../../../components/tools/AnsiWorkspace.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../../utils/seo';

const pageTitle = "Texto de Colores Discord | Códigos ANSI";
const pageDescription = "Generador de texto de colores Discord: aplica códigos ANSI a tus palabras y copia un bloque listo para pegar. Negrita, subrayado y vista previa.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/colored-text/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/colored-text/";

const appSchema = generateSoftwareApplicationSchema("Generador de Texto de Colores para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Texto de Colores", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cómo pongo texto de colores en Discord?", a: "Discord colorea el texto dentro de un bloque de código con la etiqueta de lenguaje ansi. Este generador escribe los códigos de escape por ti: escribe tu texto, selecciona una parte, elige un color y copia. Pega el resultado en Discord y el bloque ansi con triples comillas invertidas se muestra en color." },
  { q: "¿Por qué mi texto de colores se ve como código plano?", a: "Discord solo colorea los bloques ANSI en escritorio y en la app web. Las versiones antiguas de la app móvil muestran el bloque como texto monoespaciado sin color. Las palabras se leen igual — simplemente no se tiñen en esos clientes." },
  { q: "¿Qué colores puedo usar en el texto ANSI de Discord?", a: "Discord admite ocho colores de texto (gris, rojo, verde, dorado, azul, rosa, cian, blanco) y ocho resaltados de fondo, más negrita y subrayado. Corresponden a los códigos ANSI SGR 30-37 y 40-47, con la paleta estilo Solarized de Discord." },
  { q: "¿Funciona el texto de colores en nombres o biografías?", a: "No. Los colores ANSI solo aparecen dentro de un bloque de código en los mensajes. Los nombres, apodos y el Sobre mí son texto plano, así que el marcado del bloque se vería literal. Para nombres con estilo usa una fuente Unicode." }
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "es",
  "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/colored-text.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Texto de Colores</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        100% en el navegador · Cero subidas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Generador de Texto de Colores Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Aplica <strong>colores ANSI</strong> a tus palabras y copia un bloque <code class="font-mono text-[#3368A0] dark:text-[#66A3BF]">```ansi</code> listo para pegar. Negrita, subrayado y vista previa en vivo.
      </p>
    </header>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <AnsiWorkspace lang="es" />

    <div class="space-y-6 mb-12 mt-8">
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Cómo Funciona el Texto de Colores</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          Discord no tiene selector de color en el chat. Lo que colorea el texto es un <strong>bloque de código con el lenguaje <code class="font-mono text-[#3368A0] dark:text-[#66A3BF]">ansi</code></strong>. Dentro, Discord lee los códigos de escape ANSI clásicos y pinta cada tramo de texto. Esta herramienta escribe esos códigos por ti — todo ocurre en tu navegador: selecciona texto, toca un color y copia el bloque terminado.
        </p>
      </article>
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Dónde Se Ve el Texto de Colores</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          El color ANSI se muestra en <strong>los mensajes de Discord en escritorio y en la app web</strong>. Las versiones antiguas de la app móvil muestran el bloque como texto plano — legible, pero sin teñir. No funciona en el <code class="font-mono text-[#3368A0] dark:text-[#66A3BF]">@usuario</code>, apodos ni Sobre mí, porque son texto plano. Para nombres con estilo usa una <a href="/es/tools/fonts/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline">fuente Unicode</a>.
        </p>
      </article>
    </div>

    <section>
      <h2 class="text-2xl font-bold text-[#192538] dark:text-white mb-6 text-center">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.q}</h3>
            <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
