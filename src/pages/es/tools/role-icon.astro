---
import Layout from '../../../layouts/Layout.astro';
import RoleIconWorkspace from '../../../components/tools/RoleIconWorkspace.astro';
import ToolDossier from '../../../components/tools/ToolDossier.astro';
import ToolFaq from '../../../components/tools/ToolFaq.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../../utils/seo';

const pageTitle = "Creador de Iconos de Rol Discord | Exacto 64×64";
const pageDescription = "Redimensiona iconos de rol de Discord a exactamente 64×64 píxeles por debajo de 256 KB para servidores Boost Nivel 2. 100% en tu navegador, sin subidas.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/role-icon/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/role-icon/";

const appSchema = generateSoftwareApplicationSchema("Creador de Iconos de Rol para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Estudio de Iconos de Rol", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cuál es el tamaño de un icono de rol de Discord?", a: "Los iconos de rol deben subirse como un cuadrado de 64×64 píxeles y mantenerse por debajo de 256 KB. Discord los reduce luego a unos 16–20 píxeles junto a los nombres, así que partir de un archivo limpio de 64×64 mantiene la insignia nítida en pantallas de alta resolución sin superar el límite." },
  { q: "¿Cómo añado un icono a un rol de Discord?", a: "Abre Ajustes del Servidor → Roles, selecciona el rol que quieras y ve a su pestaña de Visualización. Desde ahí puedes subir una imagen personalizada de 64×64 o elegir un emoji estándar como icono y guardar. La insignia aparecerá junto a cada miembro que tenga ese rol." },
  { q: "¿Se necesitan boosts para los iconos de rol?", a: "Sí. Los iconos de rol personalizados requieren que el servidor alcance Boost Nivel 2, que necesita siete boosts de los miembros. Si el servidor baja luego de Nivel 2, tus iconos guardados quedan ocultos en el chat hasta que se restablezca el nivel. También necesitas el permiso de Gestionar Roles." },
  { q: "¿Puede ser un GIF animado un icono de rol de Discord?", a: "No. Discord solo admite imágenes estáticas para los iconos de rol, así que funcionan los archivos PNG y JPG, pero no los GIFs animados ni los APNG. Un PNG transparente suele lucir mejor porque el icono queda limpio junto al nombre, sin una caja de fondo visible." },
  { q: "¿Por qué mi icono de rol se ve borroso o es rechazado?", a: "El desenfoque suele venir de un exceso de detalle: a 16–20 píxeles, las líneas finas y el texto pequeño se emborronan, así que las siluetas simples y contundentes se leen mejor. Los rechazos suelen deberse a dimensiones incorrectas — debe ajustarse a 64×64 — o a superar el tope de 256 KB." }
];

const dossier = {
  eyebrow: "Plano Técnico del Icono de Rol",
  heading: "Iconos de rol que se reconocen a",
  highlight: "simple vista",
  intro: "Los iconos de rol son los gráficos más pequeños de todo Discord. Los subes a 64×64 píxeles, pero Discord los reduce a unos 16–20 píxeles junto a los nombres. Así encajan las reglas de tamaño, el reescalado, la teoría de siluetas y los requisitos de Boost para que tus insignias se reconozcan al instante.",
  steps: [
    "El Tamaño Exacto 64×64",
    "Reducción a 16px en el Chat",
    "Siluetas Nítidas y Contraste",
    "Boost Nivel 2 y Permisos"
  ],
  cards: [
    {
      kicker: "MÉTRICA DE ESPECIFICACIÓN // 01",
      badge: "64 × 64 PÍXELES",
      badgeTone: "emerald" as const,
      title: "La regla exacta de 64×64 píxeles",
      body: [
        "Discord recomienda subir los iconos de rol como un cuadrado de 64×64 píxeles con una relación 1:1 limpia. A diferencia de los banners o los emojis, que admiten formas variadas, un icono de rol debe caber en ese cuadrado ordenado, así que las dimensiones raras como 63×64 se estiran o se recortan de forma extraña al procesarse.",
        "El tope de archivo es 256 KB, espacio de sobra para un PNG o JPG nítido a este tamaño. Un PNG transparente luce mejor porque el icono flota limpio junto al nombre, sin una caja visible. Este creador centra y redimensiona tu arte en un lienzo exacto de 64×64 dentro de tu navegador, para que exportes sin errores de subida."
      ]
    },
    {
      kicker: "REESCALADO ÓPTICO // 02",
      badge: "CHAT A 16PX",
      badgeTone: "blue" as const,
      title: "Lo pequeño que se ve un icono de rol",
      body: [
        "Aunque lo subas a 64×64 píxeles, Discord muestra los iconos de rol a unos 16×16 píxeles junto a los nombres en el chat y a unos 20×20 píxeles en la lista de miembros. Es casi una reducción de 4:1 respecto al archivo que subes, así que cada detalle se comprime en una huella diminuta.",
        "A esa escala, el texto pequeño, las líneas finas, los sombreados sutiles y los escudos intrincados se difuminan en una mancha confusa. El truco es diseñar para el tamaño de visualización, no para el de subida. Previsualiza tu icono junto a un nombre de ejemplo a escala real de chat antes de usarlo y simplifica todo lo que se vea turbio."
      ]
    },
    {
      kicker: "LEGIBILIDAD GRÁFICA // 03",
      badge: "TEORÍA DE SILUETAS",
      badgeTone: "amber" as const,
      title: "Siluetas nítidas y formas de alto contraste",
      body: [
        "Los mejores iconos de rol funcionan como señales de tráfico: reconoces la forma al instante. Una sola silueta contundente — una corona para administradores, un escudo para moderadores, una estrella para boosters, un mando para gamers o una paleta para artistas — se lee mucho mejor que una ilustración detallada. Las formas sólidas de un color sobreviven a la reducción; los degradados y los emblemas finos no.",
        "El contraste importa igual. Como el icono se sitúa junto a un nombre de rol de color, una insignia toda dorada puede desaparecer junto al texto dorado. Los elementos blancos y limpios o un contorno tenue ayudan a que la forma resalte tanto en temas oscuros como claros, y se mantenga legible sea cual sea el color del rol."
      ],
      footer: "Siluetas simples y de alto contraste se mantienen legibles en temas oscuros y claros."
    },
    {
      kicker: "REQUISITOS DEL SERVIDOR // 04",
      badge: "BOOST NIVEL 2",
      badgeTone: "purple" as const,
      title: "Boost Nivel 2 y cómo asignar un icono",
      body: [
        "Los iconos de rol personalizados solo se desbloquean cuando el servidor alcanza Boost Nivel 2, que requiere siete boosts de los miembros. Si el servidor baja de Nivel 2, tus iconos subidos siguen guardados en los ajustes, pero Discord los oculta del chat hasta que se recupere el nivel de boost. También necesitas el permiso de Gestionar Roles para asignarlos.",
        "Para configurarlo, abre Ajustes del Servidor → Roles, elige un rol y usa su pestaña de Visualización. Puedes subir una imagen personalizada o elegir un emoji estándar como icono. Discord admite PNG y JPG estáticos aquí, no GIFs animados. Todo en esta página se procesa en tu navegador, así que nada se sube nunca a un servidor."
      ],
      footer: "Configúralo en Ajustes del Servidor → Roles → Visualización · cero subidas, todo en el navegador."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/role-icon.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems, 'es')} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Estudio de Iconos de Rol</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        100% en el navegador · Cero subidas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Creador de Iconos de Rol para Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Formatea iconos de rol a exactamente <strong>64×64 píxeles</strong> por debajo de <strong>256 KB</strong> para servidores con Boost Nivel 2. Requiere el permiso de Gestionar Roles. Todo el procesamiento ocurre localmente en tu navegador.
      </p>
    </header>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Tamaño</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">64×64 px</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Límite</p>
        <p class="text-sm font-bold text-[#0D9488]">256 KB</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Nivel</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">Boost L2</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Permiso</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">Gestionar Roles</p>
      </div>
    </div>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <RoleIconWorkspace lang="es" />

    <!-- Dossier de desplazamiento (componente compartido) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (componente compartido, misma fuente que el JSON-LD) -->
    <ToolFaq items={faqItems} heading="Preguntas Frecuentes" />
  </div>
</Layout>
