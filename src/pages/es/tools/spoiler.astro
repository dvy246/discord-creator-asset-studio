---
import Layout from '../../../layouts/Layout.astro';
import SpoilerWorkspace from '../../../components/tools/SpoilerWorkspace.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema } from '../../../utils/seo';

const pageTitle = "Spoiler de Imagen Discord | Oculta Texto e Imágenes";
const pageDescription = "Crea un spoiler de imagen Discord: envuelve texto en marcado ||spoiler|| o añade el prefijo SPOILER_ para difuminar una imagen. En tu navegador, sin subidas.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/spoiler/";
const enUrl = "https://discord-creator-asset-studio.pages.dev/tools/spoiler/";

const appSchema = generateSoftwareApplicationSchema("Creador de Spoilers de Imagen para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Creador de Spoilers", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cómo hago un spoiler de imagen en Discord?", a: "Discord difumina cualquier adjunto cuyo nombre de archivo empiece por SPOILER_. Sube tu imagen aquí y descarga la copia renombrada — al adjuntar ese archivo, Discord la oculta automáticamente tras un clic. En escritorio también puedes marcar 'Marcar como spoiler' antes de enviar." },
  { q: "¿Cómo oculto texto como spoiler en Discord?", a: "Envuelve el texto en dobles barras verticales: ||así||. Discord lo muestra como una barra negra que revela el texto al hacer clic. Pega tu mensaje en la pestaña de texto y añade el marcado || || por ti, con opción de ocultar cada línea por separado." },
  { q: "¿Funciona el prefijo SPOILER_ en el móvil?", a: "Sí. El prefijo SPOILER_ lo lee Discord en escritorio, web y móvil, así que una imagen renombrada se difumina en todas partes. En la app móvil también puedes mantener pulsada la miniatura del adjunto y elegir 'Marcar como Spoiler' antes de enviar." },
  { q: "¿La herramienta de spoiler es privada?", a: "Sí. El marcado de texto se genera en tu navegador y las imágenes solo se renombran localmente — nada se sube a un servidor. La vista previa difuminada se dibuja con CSS en tu dispositivo para que confirmes el efecto antes de enviar." }
];

const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "es",
  "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/spoiler.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Creador de Spoilers</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        100% en el navegador · Cero subidas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Spoiler de Imagen Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Envuelve texto en marcado <strong>|| ||</strong> o difumina una imagen con el prefijo <strong>SPOILER_</strong> que usa Discord. Todo el procesamiento ocurre localmente en tu navegador.
      </p>
    </header>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <SpoilerWorkspace lang="es" />

    <div class="space-y-6 mb-12 mt-8">
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Ocultar Texto con Dobles Barras</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          Discord trata dos barras verticales a cada lado del texto como una etiqueta de spoiler. Escribir <code class="font-mono">||giro argumental||</code> muestra una barra negra que solo revela las palabras al hacer clic. Funciona en medio de una frase, así que puedes ocultar una palabra o un párrafo entero.
        </p>
      </article>
      <article class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
        <h2 class="text-lg font-bold text-[#192538] dark:text-white mb-2">Difuminar una Imagen con el Prefijo SPOILER_</h2>
        <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">
          Discord difumina automáticamente cualquier adjunto cuyo nombre empiece por <code class="font-mono">SPOILER_</code>. Renombra <code class="font-mono">arte.png</code> a <code class="font-mono">SPOILER_arte.png</code> y se sube ya oculto, sin clics extra. La pestaña de imagen renombra tu archivo a esa forma exacta.
        </p>
      </article>
    </div>

    <section>
      <h2 class="text-2xl font-bold text-[#192538] dark:text-white mb-6 text-center">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="card-panel p-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24]">
            <h3 class="text-sm font-bold text-[#192538] dark:text-white mb-2">{item.q}</h3>
            <p class="text-xs sm:text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
