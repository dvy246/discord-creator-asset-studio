---
import Layout from '../../../layouts/Layout.astro';
import { generateSoftwareApplicationSchema, generateBreadcrumbSchema, generateFaqSchema } from '../../../utils/seo';
import BannerWorkspace from '../../../components/tools/BannerWorkspace.astro';
import ToolDossier from '../../../components/tools/ToolDossier.astro';
import ToolFaq from '../../../components/tools/ToolFaq.astro';

const pageTitle = "Creador de Banners Discord | Zona Segura 48px";
const pageDescription = "Creador de banners Discord: 960×540 servidor y 680×240 perfil con zona segura de 48px marcada. Reglas de Nitro y Boost. 100% en tu navegador.";
const pageUrl = "https://discord-creator-asset-studio.pages.dev/es/tools/banner/";
const enUrl = "/tools/banner/";

const appSchema = generateSoftwareApplicationSchema("Creador de Banners para Discord", pageDescription, pageUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/es/" },
  { name: "Estudio de Banners", url: pageUrl }
]);

const faqItems = [
  { q: "¿Cuál es el tamaño del banner de servidor de Discord y las dimensiones exactas?", a: "El mínimo para un banner de servidor es 960×540 píxeles, una relación panorámica 16:9. Para texto nítido en pantallas Retina de alta densidad recomendamos exportar a 1920×1080. Los banners de servidor requieren Boost Nivel 2 para versiones estáticas." },
  { q: "¿Cómo cambio el banner de mi servidor de Discord?", a: "Abre Discord, ve a Ajustes del Servidor > Información General > Fondo del Banner del Servidor y sube tu gráfico. Los banners estáticos necesitan Boost Nivel 2 (7 boosts) y los banners animados en GIF requieren Boost Nivel 3 (14 boosts)." },
  { q: "¿Por qué es crítica la zona segura superior de 48px en los banners?", a: "En escritorio y navegador, Discord superpone el nombre del servidor, el menú desplegable y las insignias de boost sobre los 48 píxeles superiores del banner. Si colocas texto, logos o caras en esa franja, los controles los taparán. La superposición de zona segura te ayuda a mantener lo importante por debajo." },
  { q: "¿Cuántos boosts necesito para un banner de servidor o animado?", a: "Los banners estáticos de servidor se desbloquean con Boost Nivel 2, que requiere 7 boosts. Los banners animados en GIF necesitan Boost Nivel 3, es decir 14 boosts. Si el servidor pierde boosts y baja de nivel, Discord oculta el banner hasta recuperarlo." },
  { q: "¿Qué tamaño tiene el banner de perfil de Discord y necesito Nitro?", a: "El banner de perfil global mide 680×240 píxeles (relación ~5:2) y las tarjetas de perfil por servidor 600×240. Los banners de perfil estáticos requieren Nitro Basic o Nitro estándar, y los animados requieren Nitro completo." }
];

const dossier = {
  eyebrow: "Plano Técnico del Banner",
  heading: "Diseña banners de Discord que",
  highlight: "encajan perfecto",
  intro: "Los banners de servidor y las tarjetas de perfil usan formas completamente distintas. Además, en escritorio Discord coloca menús sobre el borde superior. Así mantienes tu arte y tu texto nítidos en todas partes.",
  steps: [
    "Ratios Servidor vs Perfil",
    "Zona Segura de 48px",
    "Resolución Retina Nítida",
    "Boosts de Servidor y Nitro"
  ],
  cards: [
    {
      kicker: "MATEMÁTICA DE RATIOS // 01",
      badge: "16:9 VS 5:2",
      badgeTone: "emerald" as const,
      title: "Banners de servidor (16:9) vs perfiles (5:2)",
      body: [
        "Un error común es usar el mismo recorte para las cabeceras de servidor y para los banners de perfil. Tienen formas muy distintas: los banners de servidor usan una relación panorámica 16:9 (mínimo 960×540 px) y se extienden por la parte superior de los canales.",
        "Los banners de perfil, en cambio, son anchos y estrechos. Los perfiles globales miden 680×240 píxeles y las tarjetas por servidor 600×240 (unos 5:2). Si pegas un banner 16:9 en tu perfil, Discord recorta casi el 40% superior e inferior. Este creador te da el lienzo exacto para ambos formatos."
      ]
    },
    {
      kicker: "SUPERPOSICIÓN DE INTERFAZ // 02",
      badge: "OCLUSIÓN 48PX",
      badgeTone: "blue" as const,
      title: "La zona segura de 48px: proteger la tipografía",
      body: [
        "En las apps de escritorio y en el navegador, Discord coloca el nombre del servidor, el menú desplegable y las insignias de boost justo sobre el borde superior del banner, con una sombra oscura sutil para que el texto siga siendo legible.",
        "Esta interfaz cubre aproximadamente los 48 píxeles superiores (o 96 en pantallas Retina). Si pones el título del servidor, un logo o la cara de un personaje en esa franja, los botones lo taparán. Mostramos una superposición roja de zona segura mientras editas para que coloques lo importante donde nada lo bloquee."
      ],
      footer: "Protección de zona segura: la superposición evita colisiones con la navegación del servidor."
    },
    {
      kicker: "OFICIO DE RESOLUCIÓN // 03",
      badge: "1920×1080 RETINA",
      badgeTone: "amber" as const,
      title: "Escalado Retina 2x y contraste del fondo",
      body: [
        "El mínimo oficial de Discord es 960×540 píxeles. Eso funcionaba bien hace años, pero en pantallas Retina de MacBook, monitores 1440p y smartphones modernos, una imagen de 960px se estira y puede verse borrosa o poco definida.",
        "Recomendamos exportar a 1920×1080 píxeles (la misma forma 16:9). A 1080p tu arte se mantiene nítido en pantallas de alta densidad. Como Discord permite archivos de hasta 10 MB, un PNG o GIF limpio a 1080p se sube sin problemas ni pérdida de nitidez."
      ],
      footer: "Master recomendado: 1920×1080 px (16:9 Retina), con tope de 10 MB."
    },
    {
      kicker: "PROTOCOLOS DE PERMISO // 04",
      badge: "BOOST NIVEL 2 Y 3",
      badgeTone: "purple" as const,
      title: "Niveles de Boost y verificación de Nitro",
      body: [
        "Antes de exportar tu arte, confirma que tu servidor ha desbloqueado las ventajas correctas. Los banners estáticos de servidor se activan con Boost Nivel 2 (7 boosts) y los banners GIF animados requieren Boost Nivel 3 (14 boosts). Si el servidor pierde boosts y cae por debajo de ese nivel, Discord oculta el banner hasta recuperarlo.",
        "Para los perfiles de usuario, los banners estáticos necesitan Nitro Basic o Nitro estándar, mientras que los animados requieren Nitro completo. Todo se procesa en tu navegador, así que puedes probar y recortar tus diseños antes de subirlos a Discord."
      ],
      footer: "Cero subidas al servidor · Alineación geométrica 16:9 y 5:2 en el navegador."
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} lang="es" ogImage="https://discord-creator-asset-studio.pages.dev/og/banner.png">
  <script type="application/ld+json" set:html={appSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={generateFaqSchema(faqItems, 'es')} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <nav class="flex items-center justify-between gap-2 text-xs text-[#6B7A90] dark:text-[#8494A7] mb-6 font-mono" aria-label="Miga de pan">
      <div class="flex items-center gap-2">
        <a href="/es/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Estudio de Banners</span>
      </div>
      <a href={enUrl} class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold">🌐 English</a>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        100% en el navegador · Cero subidas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] dark:text-white tracking-tight mb-3">
        Creador de Banners Discord
      </h1>
      <p class="text-[#475569] dark:text-[#CBD5E1] text-sm sm:text-base leading-relaxed max-w-2xl">
        Diseña banners de servidor (<strong>960×540</strong>, 16:9) y de perfil (<strong>680×240</strong>) con la zona segura superior de 48 píxeles claramente marcada. Todo el procesamiento ocurre localmente en tu navegador.
      </p>
    </header>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Servidor</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">960×540</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Perfil</p>
        <p class="text-sm font-bold text-[#0D9488]">680×240</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Relación</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">16:9 / 5:2</p>
      </div>
      <div class="p-3 rounded-[10px] bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] text-center">
        <p class="text-[10px] font-mono text-[#6B7A90] uppercase">Zona segura</p>
        <p class="text-sm font-bold text-[#192538] dark:text-white">48px sup.</p>
      </div>
    </div>

    <!-- Herramienta interactiva completa (mismo componente que la versión en inglés) -->
    <BannerWorkspace lang="es" />

    <!-- Dossier de desplazamiento (componente compartido) -->
    <ToolDossier {...dossier} />

    <!-- FAQ (componente compartido, misma fuente que el JSON-LD) -->
    <ToolFaq items={faqItems} heading="Preguntas Frecuentes" />
  </div>
</Layout>
