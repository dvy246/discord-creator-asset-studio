  <!-- CLIENT SCRIPT: FILTER & SEARCH CONTROLLER -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('pfp-search-input');
      const categoryPills = document.querySelectorAll('.pfp-filter-pill');
      const toggleAnimBtn = document.getElementById('pfp-toggle-animation-btn');
      const animStatusText = document.getElementById('pfp-anim-status');
      const animIndicator = document.getElementById('pfp-anim-indicator');
      const clearBtn = document.getElementById('pfp-clear-filters-btn');
      const countEl = document.getElementById('pfp-results-count');
      const cards = Array.from(document.querySelectorAll('.pfp-card'));
      const emptyState = document.getElementById('pfp-empty-state');
      const emptyResetBtn = document.getElementById('pfp-empty-reset-btn');

      let currentCategory = 'all';
      let searchQuery = '';
      let isAnimEnabled = true;

      function applyFilters() {
        let visibleCount = 0;

        cards.forEach(card => {
          const title = (card.getAttribute('data-title') || '').toLowerCase();
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const isAnim = card.getAttribute('data-is-animated') === 'true';
          const isFemale = card.getAttribute('data-is-female') === 'true';
          const isMale = card.getAttribute('data-is-male') === 'true';
          const isAnime = card.getAttribute('data-is-anime') === 'true';
          const isDark = card.getAttribute('data-is-dark') === 'true';
          const isCat = card.getAttribute('data-is-cat') === 'true';
          const isStreetwear = card.getAttribute('data-is-streetwear') === 'true';

          // Search match
          const matchesSearch = !searchQuery || title.includes(searchQuery) || tags.includes(searchQuery);

          // Category pill match
          let matchesCategory = true;
          if (currentCategory === 'female') matchesCategory = isFemale;
          else if (currentCategory === 'male') matchesCategory = isMale;
          else if (currentCategory === 'anime') matchesCategory = isAnime;
          else if (currentCategory === 'dark') matchesCategory = isDark;
          else if (currentCategory === 'animated') matchesCategory = isAnim;
          else if (currentCategory === 'cats') matchesCategory = isCat;
          else if (currentCategory === 'streetwear') matchesCategory = isStreetwear;

          if (matchesSearch && matchesCategory) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countEl) countEl.textContent = String(visibleCount);
        if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);

        // Toggle clear filters button
        const hasFilters = currentCategory !== 'all' || searchQuery.length > 0;
        if (clearBtn) clearBtn.classList.toggle('hidden', !hasFilters);
      }

      // Search event
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        applyFilters();
      });

      // Category pill clicks
      categoryPills.forEach(pill => {
        pill.addEventListener('click', () => {
          categoryPills.forEach(p => {
            p.classList.remove('active', 'border-[#FF84BA]', 'bg-[#FF84BA]/15', 'text-[#FF84BA]');
            p.classList.add('border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-[#FAF8F5]', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#CBD5E1]');
          });
          pill.classList.remove('border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-[#FAF8F5]', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#CBD5E1]');
          pill.classList.add('active', 'border-[#FF84BA]', 'bg-[#FF84BA]/15', 'text-[#FF84BA]');

          currentCategory = pill.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      // GIF On/Off Toggle
      toggleAnimBtn?.addEventListener('click', () => {
        isAnimEnabled = !isAnimEnabled;
        if (animStatusText) animStatusText.textContent = isAnimEnabled ? 'ON' : 'OFF';
        if (animIndicator) {
          animIndicator.classList.toggle('bg-[#22C55E]', isAnimEnabled);
          animIndicator.classList.toggle('bg-[#EF4444]', !isAnimEnabled);
        }

        // Toggle animation playback on webp images
        document.querySelectorAll('.pfp-avatar-img').forEach(img => {
          if (!isAnimEnabled) {
            img.setAttribute('data-original-src', img.src);
          } else {
            const orig = img.getAttribute('data-original-src');
            if (orig) img.src = orig;
          }
        });
      });

      // Reset / Clear
      function resetFilters() {
        currentCategory = 'all';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        categoryPills.forEach((p, idx) => {
          if (idx === 0) {
            p.classList.add('active', 'border-[#FF84BA]', 'bg-[#FF84BA]/15', 'text-[#FF84BA]');
          } else {
            p.classList.remove('active', 'border-[#FF84BA]', 'bg-[#FF84BA]/15', 'text-[#FF84BA]');
          }
        });
        applyFilters();
      }

      clearBtn?.addEventListener('click', resetFilters);
      emptyResetBtn?.addEventListener('click', resetFilters);

      // Download PFP Handler
      document.querySelectorAll('.pfp-download-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = btn.getAttribute('data-url');
          const filename = btn.getAttribute('data-filename') || 'discord-pfp.png';
          if (!url) return;

          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        });
      });

      // Customize in Studio Handler (Opens modal in PFP mode)
      document.querySelectorAll('.pfp-customize-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.pfp-card');
          if (!card) return;

          const modal = document.getElementById('asset-customizer-modal');
          if (!modal) return;

          // Dispatch event or trigger open
          const presetId = btn.getAttribute('data-preset-id');
          window.dispatchEvent(new CustomEvent('open-asset-customizer', {
            detail: {
              presetId: presetId,
              mode: 'avatar'
            }
          }));
        });
      });

    });
  </script>
