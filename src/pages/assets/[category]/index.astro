---
import Layout from '../../../layouts/Layout.astro';
import AssetCard from '../../../components/AssetCard.astro';
import AssetCustomizerModal from '../../../components/AssetCustomizerModal.astro';
import SketchUnderline from '../../../components/SketchUnderline.astro';
import { 
  ASSET_CATEGORIES, 
  getPresetsByCategory, 
  type AssetCategory, 
  type CategoryInfo, 
  type DiscordAssetPreset 
} from '../../../data/assets';
import {
  generateBreadcrumbSchema,
  generateSoftwareApplicationSchema,
  SITE_ORIGIN
} from '../../../utils/seo';

export async function getStaticPaths() {
  const categories: AssetCategory[] = ['anime', 'gaming', 'cyberpunk', 'dark', 'aesthetic', 'icons-2d'];
  return categories.map((cat) => ({
    params: { category: cat },
    props: {
      categoryInfo: ASSET_CATEGORIES[cat],
      presets: getPresetsByCategory(cat),
    }
  }));
}

interface Props {
  categoryInfo: CategoryInfo;
  presets: DiscordAssetPreset[];
}

const { categoryInfo, presets } = Astro.props;
const category = categoryInfo.id;
const canonicalUrl = new URL(`/assets/${categoryInfo.slug}/`, Astro.site).toString();

// 1. Structured Data: Breadcrumbs
const breadcrumbSchema = JSON.parse(generateBreadcrumbSchema([
  { name: "Studio", url: `/` },
  { name: "Asset Library", url: `/assets/` },
  { name: categoryInfo.shortName, url: canonicalUrl }
]));

// 2. Structured Data: CollectionPage & ItemList
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": ["CollectionPage", "ImageGallery"],
  "name": categoryInfo.seoTitle,
  "headline": categoryInfo.h1Title,
  "description": categoryInfo.metaDescription,
  "url": canonicalUrl,
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Discord Creator Asset Studio",
    "url": `/`
  },
  "about": [
    { "@type": "Thing", "name": `${categoryInfo.name} Discord Banners` },
    { "@type": "Thing", "name": `${categoryInfo.name} Discord Profile Pictures` },
    { "@type": "Thing", "name": "Discord Safe Zones" },
    { "@type": "Thing", "name": "Discord Profile Theme Matching" }
  ],
  "numberOfItems": presets.length,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": presets.length,
    "itemListElement": presets.map((preset, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": preset.title,
      "description": preset.description,
      "url": `${canonicalUrl}#preset-${preset.slug}`
    }))
  }
};

// 3. Structured Data: Software Application for In-Browser Customizer
const appSchema = JSON.parse(generateSoftwareApplicationSchema(
  `${categoryInfo.name} Discord Asset Studio`,
  `Interactive browser-based studio to preview, customize, and export ${categoryInfo.name.toLowerCase()} Discord banners and matching profile pictures with safe zones.`,
  canonicalUrl
));

// 4. Category-Specific Creator Technical Guide Content
interface TechnicalGuide {
  tagline: string;
  safeZoneRule: string;
  safeZoneAdvice: string;
  hexAdvice: string;
  motionAdvice: string;
  avatarAdvice: string;
  proTip: string;
  suggestedHexes: { name: string; hex: string }[];
}

const CATEGORY_GUIDES: Record<string, TechnicalGuide> = {
  anime: {
    tagline: "Precision Safe Zones, Cinematic Lighting & Seamless Profile Blending",
    safeZoneRule: "960x540 Banner (16:9) with 48px Top Safe Margin & Left Avatar Offset",
    safeZoneAdvice: "Discord profile banners are rendered in a 16:9 ratio, but the Discord client overlays top interface elements and places the circular avatar directly over the bottom-left 120x120px region. For anime art, position character faces, swords, and central focal points in the center or right half of the canvas (X: 45%-85%, Y: 20%-75%) so no essential details are clipped by profile badges.",
    hexAdvice: "Anime profiles frequently utilize deep twilight violet, cherry blossom magenta, or midnight navy backgrounds. Discord Nitro allows custom Primary and Accent theme colors. Match your Discord profile hex to the background color of your chosen anime preset (such as #120D1C or #1E1229) to eliminate the visible border between your banner and profile card.",
    motionAdvice: "Discord Nitro supports animated GIF banners up to 10MB. To keep motion fluid without hitching, our anime presets use 2-4 second seamless looping cycles with atmospheric particles (falling sakura petals, digital sparks, rain ripples). This provides smooth 45-60 FPS playback while staying well under Nitro file size thresholds.",
    avatarAdvice: "Discord renders profile pictures in a circular mask with an overlapping status badge in the bottom-right corner. When pairing an anime PFP with your banner, use a 512x512 square canvas with 15-20% margin around the character's face. Our anime presets automatically recompose the artwork with centered focal points.",
    proTip: "Set your Discord profile theme Accent color to the vibrant eye or sword glow color (#FF84BA or #99C2FF) from the anime preset for maximum visual pop.",
    suggestedHexes: [
      { name: "Twilight Violet", hex: "#120D1C" },
      { name: "Sakura Ink", hex: "#1F142B" },
      { name: "Night Ronin", hex: "#0E131F" },
      { name: "Cherry Accent", hex: "#FF84BA" }
    ]
  },
  gaming: {
    tagline: "Tactical HUD Composition, High-Contrast Gradients & Esports Alignment",
    safeZoneRule: "960x540 Profile Banners & 512x512 Avatars with Tactical Margin Buffers",
    safeZoneAdvice: "Esports banners and gaming clan graphics must preserve team logos, gamertags, and sponsor crests. Keep all typography and critical logos between 20% and 80% horizontal canvas width, well above the 48px top status overlay and clear of the bottom-left avatar bubble.",
    hexAdvice: "Tactical gaming profiles demand high visual contrast. Set your Discord profile primary theme to stealth carbon (#0B0F19 or #111827) and your accent color to matrix emerald (#10B981) or cyber cyan (#06B6D4). This makes your Discord badges, roles, and status message stand out sharply.",
    motionAdvice: "Gaming animations (HUD pulses, neon grid scans, and laser sweeps) look best when looped at high frame rates. Our presets utilize 60 FPS motion timings with optimized color palettes that stay well under Discord's 10MB Nitro upload ceiling.",
    avatarAdvice: "Circular gaming avatars must keep clan logos and emblem silhouettes dead center. Avoid thin line borders near the edges that can become distorted when Discord anti-aliases circular avatar crops on mobile.",
    proTip: "If you manage an esports server, use 1920x1080 for your Discord Server Banner to guarantee ultra-sharp rendering on 4K monitors, while keeping user profile banners at 960x540.",
    suggestedHexes: [
      { name: "Stealth Carbon", hex: "#0B0F19" },
      { name: "Abyssal Navy", hex: "#111827" },
      { name: "Matrix Glow", hex: "#10B981" },
