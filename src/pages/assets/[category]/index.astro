    },
    {
      question: "How do aesthetic banners look in both Discord Light and Dark modes?",
      answer: "While most Discord users use Dark mode, aesthetic banners are uniquely versatile. Our pastel presets maintain soft contrast ratios that look gorgeous against dark Discord cards while remaining readable and elegant if someone views them in Discord Light mode."
    },
    {
      question: "How do I match my Discord profile bio and card colors to an aesthetic banner?",
      answer: "Every aesthetic preset includes a sampled Profile Theme Hex (such as #FCE7F3 or #EDE9FE). In Discord, navigate to User Settings > Profiles, select 'Theme Colors', click 'Custom', and paste the hex into the Primary color field. This harmonizes your status bubble, bio background, and banner into a single pastel aesthetic."
    },
    {
      question: "What safe-zone precautions should I take with aesthetic floral or cloud borders?",
      answer: "Ensure decorative floral wreaths or fluffy clouds frame the edges without crowding the top 48px margin or colliding with the bottom-left avatar bubble. Our aesthetic templates position border decorations with a generous 60px inset to avoid any overlap."
    },
    {
      question: "Can I customize the color tint of these aesthetic presets?",
      answer: "Yes! In the customizer modal, use the Hue Shift and Saturation sliders to adjust soft pink tones into soothing lavender, baby blue, or matcha green with instant real-time canvas preview."
    }
  ],
  'icons-2d': [
    {
      question: "What are the official dimensions for Discord server role icons?",
      answer: "Discord server role icons must be uploaded at 64x64 pixels (1:1 square) in PNG, JPG, or WEBP format, under 256KB. Our studio exports role icons at exactly 64x64 pixels with optimized file sizes under 20KB."
    },
    {
      question: "What size should Discord custom emojis and stickers be?",
      answer: "Custom Discord emojis are uploaded at 128x128 pixels (PNG/GIF under 256KB). Discord stickers can be up to 320x320 pixels (under 512KB). All 2D assets in this category export at high-resolution 128x128 pixels with crisp anti-aliasing."
    },
    {
      question: "Can I download 2D assets with transparent backgrounds?",
      answer: "Yes. Every 2D asset can be downloaded as either a circular-badged role icon or a transparent PNG sticker for direct upload to Discord server settings."
    },
    {
      question: "Can I use these 2D assets for commercial community servers?",
      answer: "Yes. All 2D assets and icons are 100% original and free for personal, community, and commercial Discord server roles and emojis."
    }
  ]
};

const categoryFaqs = CATEGORY_FAQS[category] || CATEGORY_FAQS.anime;

// 6. Structured Data: FAQPage
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": categoryFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// 7. Navigation Tabs for the 5 SEO Categories
const seoCategories = [
  { id: 'anime', name: 'Anime', icon: '⚔️', href: '/assets/anime/' },
  { id: 'gaming', name: 'Gaming', icon: '🎮', href: '/assets/gaming/' },
  { id: 'cyberpunk', name: 'Cyberpunk', icon: '⚡', href: '/assets/cyberpunk/' },
  { id: 'dark', name: 'Dark', icon: '🌑', href: '/assets/dark/' },
  { id: 'aesthetic', name: 'Aesthetic', icon: '🌸', href: '/assets/aesthetic/' },
];

// Extract distinct moods present in this category for quick filtering
const availableMoods = Array.from(new Set(presets.map(p => p.mood))).sort();
---

<Layout 
  title={categoryInfo.seoTitle} 
  description={categoryInfo.metaDescription} 
  canonicalUrl={canonicalUrl}
>
  <!-- Inject SEO Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <!-- Ambient Cosmic Sunset Background Orbs (Harmonized Theme) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10 aria-hidden">
    <div class="absolute -top-40 left-1/4 w-96 h-96 rounded-full bg-[#FF84BA]/10 dark:bg-[#FF84BA]/15 blur-3xl transform -translate-x-1/2"></div>
    <div class="absolute top-80 right-10 w-[30rem] h-[30rem] rounded-full bg-[#99C2FF]/10 dark:bg-[#99C2FF]/15 blur-3xl"></div>
    <div class="absolute top-[48rem] left-10 w-80 h-80 rounded-full bg-[#FFDF82]/10 dark:bg-[#FFDF82]/10 blur-3xl"></div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-24">
    
    <!-- BREADCRUMB NAVIGATION -->
    <nav class="flex items-center gap-2 text-xs font-mono text-[#6B7A90] dark:text-[#8494A7] mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#3368A0] dark:hover:text-[#99C2FF] transition-colors">Studio</a>
      <span>/</span>
      <a href="/assets/" class="hover:text-[#3368A0] dark:hover:text-[#99C2FF] transition-colors">Asset Library</a>
      <span>/</span>
      <span class="text-[#192538] dark:text-[#FFEFE3] font-bold" aria-current="page">{categoryInfo.shortName}</span>
    </nav>

    <!-- HERO SECTION -->
    <header class="text-center max-w-4xl mx-auto mb-12 sm:mb-16">
      <!-- Category Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-[#FF84BA]/15 via-[#FFDF82]/15 to-[#99C2FF]/15 dark:from-[#FF84BA]/20 dark:via-[#FFDF82]/20 dark:to-[#99C2FF]/20 border border-[#FF84BA]/30 dark:border-[#FF84BA]/40 text-xs font-semibold text-[#192538] dark:text-[#FFEFE3] mb-6 shadow-xs backdrop-blur-xs">
