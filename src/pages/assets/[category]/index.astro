    safeZoneAdvice: "Cyberpunk banners feature terminal readouts, Japanese kanji glyphs, and holographic wireframes along the perimeters. Ensure all critical UI elements are offset at least 48px from the top and 140px from the bottom-left to avoid avatar collision.",
    hexAdvice: "Because Discord defaults to dark mode (#313338), cyberpunk presets utilize deep obsidian blacks (#090C16) and deep synthwave blues. Matching your Discord profile primary hex to #090C16 creates an infinite borderless illusion where neon holograms appear to float directly on the Discord client.",
    motionAdvice: "Glitch sweeps and holographic scans should loop seamlessly every 2 to 3 seconds. By utilizing rhythmic easing and high-contrast glow vectors, our motion presets achieve maximum visual intensity with file sizes under 6MB.",
    avatarAdvice: "For cyberpunk PFPs, high-contrast silhouettes (cybernetic visors, neon helmets, robotic skulls) create the strongest impression in Discord member lists. Maintain a 20% outer padding so the circular mask does not cut off visor corners.",
    proTip: "Pair your cyberpunk banner with a glowing custom status emoji and set your profile accent to hot magenta (#FF0055) or cyan (#00F0FF) to match the preset's glow layer.",
    suggestedHexes: [
      { name: "Obsidian Core", hex: "#090C16" },
      { name: "Neon Cyberpunk", hex: "#00F0FF" },
      { name: "Glitch Magenta", hex: "#FF0055" },
      { name: "Synthwave Dusk", hex: "#1E1B4B" }
    ]
  },
  dark: {
    tagline: "Obsidian Negative Space, Gothic Silhouettes & Atmospheric Mist",
    safeZoneRule: "Subtle Obsidian Contrast & Center-Right Gothic Focal Points",
    safeZoneAdvice: "Dark aesthetic compositions rely on negative space and chiaroscuro lighting. Position focal subjects (gothic spires, crescent moons, solitary silhouettes) along the center-right rule-of-thirds axis. Keep the bottom-left region dark to seamlessly cradle your Discord avatar.",
    hexAdvice: "Avoid pure #000000 pitch black, which can cause harsh OLED banding and contrast crushing. Instead, use rich midnight tones like obsidian violet (#0A0A0F) or muted slate (#13111C). Setting your Discord profile theme to this exact hex creates a smooth, immersive dark mode aesthetic.",
    motionAdvice: "Atmospheric dark effects (gothic rain, falling ash, drifting cemetery mist) are subtle and hypnotic. Our looping parameters are calibrated with gentle linear and sine drifts that loop imperceptibly and compress efficiently down to 2MB-4MB.",
    avatarAdvice: "Dark gothic avatars need clear silhouette separation. Use circular avatars with subtle rim lighting or an ethereal back-glow so the character outline remains distinct against Discord's dark chat backgrounds.",
    proTip: "Use the Asset Customizer's Contrast and Brightness sliders to fine-tune your banner's shadows to match your monitor's gamma curve before exporting.",
    suggestedHexes: [
      { name: "Midnight Obsidian", hex: "#0A0A0F" },
      { name: "Blood Moon Plum", hex: "#1A0B14" },
      { name: "Cathedral Violet", hex: "#13111C" },
      { name: "Crimson Spark", hex: "#EF4444" }
    ]
  },
  aesthetic: {
    tagline: "Pastel Color Harmony, Soft Cloudscapes & Calming Cohesive Sets",
    safeZoneRule: "Pastel Symmetry & Balanced Perimeter Framing",
    safeZoneAdvice: "Aesthetic and pastel banners frequently incorporate soft cloudscapes, floral borders, and starry twilight horizons. Maintain a 60px perimeter inset so fluffy cloud borders and floral motifs aren't cut off by the top navigation bar or bottom avatar overlap.",
    hexAdvice: "Pastel aesthetics work by creating visual softness. Sample the primary pastel tone (such as blush pink #FCE7F3, lavender #EDE9FE, or mint #D1FAE5) into your Discord profile theme settings to unify your bio, roles, and banner into a cohesive dreamy palette.",
    motionAdvice: "Gentle floating stars, shimmering clouds, and drifting petals should move with soft, low-velocity easing. Our aesthetic motion configs use low particle counts and gentle sine wave floating that loop seamlessly without visual stutter.",
    avatarAdvice: "Aesthetic profile pictures shine with soft, centered subjects like pastel bunnies, cup-of-tea icons, or dreamy celestial moons. The 1:1 circular crop naturally enhances symmetrical circular subjects.",
    proTip: "Aesthetic presets look gorgeous in both Discord Dark and Light themes. If switching between themes, choose one of our dual-luminance pastel presets that retain readability across both backdrops.",
    suggestedHexes: [
      { name: "Blush Pastel", hex: "#FCE7F3" },
      { name: "Lavender Mist", hex: "#EDE9FE" },
      { name: "Twilight Peach", hex: "#FED7AA" },
      { name: "Rose Quartz", hex: "#FF84BA" }
    ]
  },
  'icons-2d': {
    tagline: "Crisp 2D Vector Server Assets, Role Badges & Custom Emojis",
    safeZoneRule: "64x64 Role Icons & 128x128 Emoji Stickers with Transparent / Badge Backgrounds",
    safeZoneAdvice: "Discord server role icons are displayed at 64x64 pixels next to user names in chat and server member lists. Custom emojis are uploaded at 128x128 pixels. Keep line weights bold and glyphs centered so they remain legible at micro sizes.",
    hexAdvice: "Role icons and server badges look cleanest when matched with Discord role colors. Use the pre-sampled profile and role hex values to create harmonized role hierarchies in your server settings.",
    motionAdvice: "Animated role icons and server emojis are supported on Nitro servers. Keep frame counts tight and loops seamless for lightweight chat rendering without client lag.",
    avatarAdvice: "2D server badges can also double as avatar profile accents or community membership tokens with circular badge framing.",
    proTip: "Export role icons with circular gradient badges for member rank badges, or with transparent backgrounds for custom chat emojis.",
    suggestedHexes: [
      { name: "Admin Ruby", hex: "#E63946" },
      { name: "Mod Cyan", hex: "#00F0FF" },
      { name: "VIP Gold", hex: "#FFDF82" },
      { name: "Member Violet", hex: "#A855F7" }
