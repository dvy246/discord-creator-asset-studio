<script>
  // Client-Side In-Page Filtering for Category Presets
  function initCategoryFilter() {
    const searchInput = document.getElementById('category-search-input') as HTMLInputElement | null;
    const moodButtons = document.querySelectorAll<HTMLButtonElement>('.mood-filter-btn');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.category-card-wrapper'));
    const emptyState = document.getElementById('category-empty-state');
    const resetBtn = document.getElementById('category-reset-filters-btn');

    if (!cards.length) return;

    let currentMood = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      cards.forEach(card => {
        const mood = card.getAttribute('data-mood') || '';
        const title = card.getAttribute('data-title') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesMood = currentMood === 'all' || mood.toLowerCase() === currentMood.toLowerCase();
        const matchesSearch = !searchQuery || title.includes(searchQuery) || tags.includes(searchQuery);

        if (matchesMood && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    moodButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        moodButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#3368A0]', 'dark:bg-[#99C2FF]', 'text-white', 'dark:text-black', 'font-bold');
          b.classList.add('font-medium', 'border', 'border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-white', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#99C2FF]');
        });

        btn.classList.add('active', 'bg-[#3368A0]', 'dark:bg-[#99C2FF]', 'text-white', 'dark:text-black', 'font-bold');
        btn.classList.remove('font-medium', 'border', 'border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-white', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#99C2FF]');

        currentMood = btn.getAttribute('data-mood') || 'all';
        filterCards();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterCards();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentMood = 'all';

      moodButtons.forEach(b => {
        const isAll = b.getAttribute('data-mood') === 'all';
        if (isAll) {
          b.classList.add('active', 'bg-[#3368A0]', 'dark:bg-[#99C2FF]', 'text-white', 'dark:text-black', 'font-bold');
          b.classList.remove('font-medium', 'border', 'border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-white', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#99C2FF]');
        } else {
          b.classList.remove('active', 'bg-[#3368A0]', 'dark:bg-[#99C2FF]', 'text-white', 'dark:text-black', 'font-bold');
          b.classList.add('font-medium', 'border', 'border-[#E0DBD0]', 'dark:border-[#263454]', 'bg-white', 'dark:bg-[#161F2E]', 'text-[#6B7A90]', 'dark:text-[#99C2FF]');
        }
      });

      filterCards();
    });
  }

  initCategoryFilter();
  document.addEventListener('astro:page-load', initCategoryFilter);
</script>
