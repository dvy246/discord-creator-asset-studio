---
import Layout from '../layouts/Layout.astro';
import SketchUnderline from '../components/SketchUnderline.astro';
import { generateWebPageSchema, generateBreadcrumbSchema } from '../utils/seo';

const pageUrl = "https://discord-creator-asset-studio.pages.dev/about/";
const aboutSchema = generateWebPageSchema({
  type: 'AboutPage',
  name: 'About Discord Creator Asset Studio',
  description: 'The mission, engineering philosophy, and privacy-first, in-browser architecture behind Discord Creator Asset Studio — an independent project not affiliated with Discord.',
  url: pageUrl
});
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "About", url: pageUrl }
]);
---

<Layout title="About Us | Discord Asset Studio" description="Learn about the mission, engineering philosophy, and privacy-first architecture of Discord Asset Studio.">
  <script type="application/ld+json" set:html={aboutSchema} />
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-10">
      <span class="text-xs font-bold text-[#3368A0] dark:text-[#66A3BF] uppercase tracking-wider">Independent Creator Tooling</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#192538] tracking-tight mt-2 mb-4">
        About Discord <span class="relative inline-block sketch-trigger"><span class="relative z-10">Asset Studio</span><SketchUnderline color="#66A3BF" /></span>
      </h1>
      <p class="text-[#475569] text-base leading-relaxed">
        Simple, fast, and private Discord asset tools that run entirely in your browser.
      </p>
    </div>

    <div class="space-y-8 text-[#475569] text-sm leading-relaxed border-t border-[#E0DBD0] pt-8">
      <section class="card-panel p-6 sm:p-8 rounded-[14px]">
        <h2 class="text-lg font-bold text-[#192538] mb-3">Our Philosophy</h2>
        <p class="mb-3">
          Many online image converters make you upload your private graphics to remote servers, cover the screen with ads, or charge subscriptions just to remove watermarks.
        </p>
        <p>
          We built Discord Asset Studio to keep things simple, private, and free:
        </p>
        <ul class="list-disc pl-5 space-y-2 mt-3 text-[#192538] font-medium">
          <li><strong>100% In-Browser:</strong> Your images and GIFs are processed directly on your device using your browser. Nothing is ever uploaded to a server.</li>
          <li><strong>Accurate Limits:</strong> We check exact pixel dimensions and byte counts before you download so Discord never rejects your files.</li>
          <li><strong>Clear Requirements:</strong> We make it obvious which features are completely free and which ones require Discord Nitro or Server Boost tiers.</li>
          <li><strong>No Annoyances:</strong> No account signups, no watermarks, no artificial countdowns, and no paywalls.</li>
        </ul>
      </section>

      <section class="card-panel p-6 sm:p-8 rounded-[14px]">
        <h2 class="text-lg font-bold text-[#192538] mb-3">Always Up to Date</h2>
        <p class="mb-3">
          We maintain our asset dimensions by constantly verifying against Discord's official developer documentation and Help Center guides:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-xs font-mono text-[#3368A0] dark:text-[#66A3BF] mb-4">
          <li>
            <a href="https://discord.com/developers/docs" target="_blank" rel="noopener noreferrer" class="hover:underline">
              Discord Developer Portal &rarr;
            </a>
          </li>
          <li>
            <a href="https://support.discord.com/hc/en-us" target="_blank" rel="noopener noreferrer" class="hover:underline">
              Discord Help Center & Knowledge Base &rarr;
            </a>
          </li>
        </ul>
        <p class="text-xs text-[#6B7A90]">
          Discord Asset Studio is an independent project. We are not affiliated with, endorsed by, or sponsored by Discord Inc. Discord is a registered trademark of Discord Inc.
        </p>
      </section>

      <section class="card-panel p-6 sm:p-8 rounded-[14px]">
        <h2 class="text-lg font-bold text-[#192538] mb-3">Privacy & Maintainers</h2>
        <p class="mb-3">
          Discord Asset Studio is built and maintained by independent web developers who care about clean, fast, and privacy-respecting software. We run zero trackers, store no personal cookies, and process all image pixels right inside your web browser.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2 text-xs font-semibold">
          <a href="/contact/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline">
            Submit a Specification Update &rarr;
          </a>
          <span class="text-[#CBD5E1]">•</span>
          <a href="mailto:support@discordassets.studio" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline">
            support@discordassets.studio
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
