---
import Layout from '../../layouts/Layout.astro';
import SketchUnderline from '../../components/SketchUnderline.astro';
import { generateBreadcrumbSchema, generateFaqSchema } from '../../utils/seo';

const pageTitle = "Discord Banner Size | Full Dimensions Guide | Asset Studio";
const pageDescription = "Verified guide to Discord banner size, avatar dimensions, emoji limits, and sticker specs for 2026. Safe zones, Nitro limits, and boost tier requirements.";

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": pageTitle,
  "description": pageDescription,
  "image": "https://discord-creator-asset-studio.pages.dev/og-image.png",
  "inLanguage": "en",
  "url": "https://discord-creator-asset-studio.pages.dev/guides/discord-sizes/",
  "datePublished": "2026-01-01T00:00:00+00:00",
  "dateModified": "2026-03-01T00:00:00+00:00",
  "author": {
    "@type": "Organization",
    "name": "Discord Creator Asset Studio",
    "url": "https://discord-creator-asset-studio.pages.dev/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Discord Creator Asset Studio",
    "url": "https://discord-creator-asset-studio.pages.dev/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://discord-creator-asset-studio.pages.dev/favicon.svg"
    }
  }
};

const breadcrumbJson = generateBreadcrumbSchema([
  { name: "Studio", url: "https://discord-creator-asset-studio.pages.dev/" },
  { name: "Size Guide", url: "https://discord-creator-asset-studio.pages.dev/guides/discord-sizes/" }
]);

const faqItems = [
  {
    q: "What is the correct Discord banner size?",
    a: "A Discord server banner is 960×540 (16:9), and a profile banner is a minimum of 680×240. Both accept PNG, JPG, or animated GIF files up to 10 MB. Server banners require Boost Level 2 or 3; profile banners require Discord Nitro."
  },
  {
    q: "What size should a Discord PFP or avatar be?",
    a: "The recommended Discord avatar (profile picture) size is 512×512 pixels at a 1:1 ratio, under 8 MB. Discord crops the square image into a circle, hiding about 21% of the corners, so keep faces and logos centered."
  },
  {
    q: "Why does Discord reject my emoji when it says 256 KB?",
    a: "Discord's real limit is 256 KiB (262,144 bytes), not 256 KB (256,000 bytes). A 257,000-byte file fails to upload even when your computer labels it \"256 KB\". Export at 128×128 and compress under 262,144 bytes to guarantee it uploads."
  },
  {
    q: "What are the exact dimensions and file size for a Discord sticker?",
    a: "A Discord sticker must be exactly 320×320 pixels and under 512 KiB (524,288 bytes). Static stickers use PNG; animated stickers require APNG (not GIF), with a maximum length of 5 seconds and 60 FPS or lower."
  },
  {
    q: "What Boost level or Nitro tier do I need for banners and role icons?",
    a: "Server banners need Server Boost Level 2 or 3, invite backgrounds need Level 1, and role icons need Level 2 plus the Manage Roles permission. Global profile banners and animated avatars require Discord Nitro."
  }
];
const faqSchema = generateFaqSchema(faqItems, "en");
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  ogImage="https://discord-creator-asset-studio.pages.dev/og/guide-sizes.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
  <script type="application/ld+json" set:html={breadcrumbJson} />
  <script type="application/ld+json" set:html={faqSchema} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <!-- Breadcrumb & Alternate Language -->
    <div class="flex items-center justify-between gap-4 mb-6 text-xs font-mono">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[#6B7A90] dark:text-[#8494A7]">
        <a href="/" class="hover:text-[#3368A0] transition-colors">Studio</a>
        <span>/</span>
        <span class="text-[#192538] dark:text-white font-semibold">Size Guide</span>
      </nav>
      <a href="/es/guides/discord-sizes/" class="text-[#3368A0] dark:text-[#66A3BF] hover:underline font-semibold flex items-center gap-1">
        🌐 Leer en Español
      </a>
    </div>

    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C8DFDB]/60 dark:bg-[#202E42] text-[#3368A0] dark:text-[#66A3BF] text-xs font-semibold border border-[#66A3BF]/30 mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0D9488]"></span>
        Updated for 2026 Platform Releases
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[#192538] tracking-tight mb-4">
        <mark class="bg-[#C8DFDB]/60 dark:bg-[#66A3BF]/20 text-[#192538] dark:text-white font-semibold px-1 rounded">Discord Banner Size</mark> & <span class="relative inline-block sketch-trigger"><span class="relative z-10 text-[#3368A0] dark:text-[#66A3BF]">Asset Guide</span><SketchUnderline color="#66A3BF" /></span>
      </h1>
      <p class="text-[#475569] text-lg leading-relaxed max-w-3xl">
        Every official dimension, file size limit, supported format, and permission requirement for Discord creator assets, verified against Discord's Help Center and developer docs.
      </p>
    </div>

    <!-- Quick Reference Table -->
    <div class="overflow-x-auto rounded-[14px] border border-[#E0DBD0] bg-[#FFFFFF] shadow-sm mb-16">
      <table class="w-full text-left text-sm">
        <thead class="bg-[#FAF8F5] text-xs uppercase font-bold text-[#192538] border-b border-[#E0DBD0]">
          <tr>
            <th class="py-4 px-5">Asset Type</th>
            <th class="py-4 px-5">Required Dimensions</th>
            <th class="py-4 px-5">Max File Size</th>
            <th class="py-4 px-5">Supported Formats</th>
            <th class="py-4 px-5">Gating / Requirement</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E0DBD0] text-[#192538]">
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Global Profile Banner</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">Min 680 × 240</td>
            <td class="py-4 px-5 font-mono text-xs">10 MB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG, Animated GIF</td>
            <td class="py-4 px-5 text-xs"><span class="px-2.5 py-1 rounded-md bg-[#D97706]/10 text-[#D97706] border border-[#D97706]/20 font-semibold">Discord Nitro</span></td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Per-Server Profile Banner</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">Min 600 × 240</td>
            <td class="py-4 px-5 font-mono text-xs">10 MB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG, Animated GIF</td>
            <td class="py-4 px-5 text-xs"><span class="px-2.5 py-1 rounded-md bg-[#D97706]/10 text-[#D97706] border border-[#D97706]/20 font-semibold">Discord Nitro</span></td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Server Banner</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">960 × 540 (16:9)</td>
            <td class="py-4 px-5 font-mono text-xs">10 MB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG, GIF</td>
            <td class="py-4 px-5 text-xs"><span class="px-2.5 py-1 rounded-md bg-[#C8DFDB]/60 text-[#3368A0] border border-[#66A3BF]/30 font-semibold">Boost L2 / L3</span></td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Custom Emoji</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">128 × 128 (32x32 view)</td>
            <td class="py-4 px-5 font-mono text-xs text-[#DC2626] font-bold">256 KiB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG, GIF, WEBP</td>
            <td class="py-4 px-5 text-xs font-medium">Server Emoji Slots</td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Custom Sticker</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">Exactly 320 × 320</td>
            <td class="py-4 px-5 font-mono text-xs text-[#DC2626] font-bold">512 KiB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG (Static) / APNG (Anim)</td>
            <td class="py-4 px-5 text-xs font-medium">Max 5s duration & 60 FPS</td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Avatar / PFP</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">512 × 512 (1:1)</td>
            <td class="py-4 px-5 font-mono text-xs">8 MB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG, GIF</td>
            <td class="py-4 px-5 text-xs font-medium">Nitro for animated</td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Role Icon</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">Exactly 64 × 64</td>
            <td class="py-4 px-5 font-mono text-xs text-[#DC2626] font-bold">256 KB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG</td>
            <td class="py-4 px-5 text-xs"><span class="px-2.5 py-1 rounded-md bg-[#C8DFDB]/60 text-[#3368A0] border border-[#66A3BF]/30 font-semibold">Boost L2 + Manage Roles</span></td>
          </tr>
          <tr class="hover:bg-[#FAF8F5]/80 transition-colors">
            <td class="py-4 px-5 font-bold text-[#192538]">Server Invite Background</td>
            <td class="py-4 px-5 font-mono text-xs text-[#3368A0] font-bold">Exactly 1920 × 1080</td>
            <td class="py-4 px-5 font-mono text-xs">10 MB</td>
            <td class="py-4 px-5 text-xs text-[#475569]">PNG, JPG (GIF unsupported)</td>
            <td class="py-4 px-5 text-xs"><span class="px-2.5 py-1 rounded-md bg-[#C8DFDB]/60 text-[#3368A0] border border-[#66A3BF]/30 font-semibold">Boost Level 1</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Detailed Section Guides -->
    <div class="space-y-8">
      <div class="card-panel p-8 rounded-[14px]">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-xl font-bold text-[#192538]">1. Server Banner Safe Zone & Readability Guidance</h2>
          <a href="https://support.discord.com/hc/en-us/articles/115001580171-Channel-Banners" target="_blank" rel="noopener noreferrer" class="text-xs text-[#3368A0] dark:text-[#66A3BF] hover:underline font-mono">Official Support Spec &rarr;</a>
        </div>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          Discord places your server title, boost badge, and dropdown menu right over the <strong>top 48 pixels</strong> of your server banner on desktop apps. When designing to official Discord banner dimensions (1920×1080 or 960×540) using the widescreen 16:9 Discord banner aspect ratio, keep important text, logos, and faces below this top 48px line so the buttons don't cover them up.
        </p>
        <a href="/tools/banner/" class="inline-flex items-center text-xs font-bold text-[#3368A0] hover:underline">
          Open Banner Studio with live safe zone overlay →
        </a>
      </div>

      <div class="card-panel p-8 rounded-[14px]">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-xl font-bold text-[#192538]">2. The 256 KiB vs 256 KB Boundary on Custom Emojis</h2>
          <a href="https://support.discord.com/hc/en-us/articles/360036479811-Custom-Emojis" target="_blank" rel="noopener noreferrer" class="text-xs text-[#3368A0] dark:text-[#66A3BF] hover:underline font-mono">Official Support Spec &rarr;</a>
        </div>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          The official Discord emoji size standard is 128×128 pixels (which renders at 32×32 pixels inside chat messages). Discord enforces a strict file limit of <strong>256 KiB (262,144 bytes)</strong>. A file that is 257,000 bytes will fail to upload even if your computer labels it as "256 KB". Our studio calculates the exact byte length in memory to guarantee your emoji uploads smoothly.
        </p>
        <a href="/tools/emoji/" class="inline-flex items-center text-xs font-bold text-[#3368A0] hover:underline">
          Format & compress emojis to 256 KiB now →
        </a>
      </div>

      <div class="card-panel p-8 rounded-[14px]">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-xl font-bold text-[#192538]">3. Custom Stickers: APNG vs GIF</h2>
          <a href="https://support.discord.com/hc/en-us/articles/4405269739799-Custom-Stickers-FAQ" target="_blank" rel="noopener noreferrer" class="text-xs text-[#3368A0] dark:text-[#66A3BF] hover:underline font-mono">Official Support Spec &rarr;</a>
        </div>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          Custom stickers must be <strong>exactly 320×320 pixels</strong> and under <strong>512 KiB (524,288 bytes)</strong>. For animations, Discord requires APNG (Animated PNG) rather than regular GIFs, with a maximum length of 5 seconds and a frame rate of 60 FPS or lower.
        </p>
        <a href="/tools/sticker/" class="inline-flex items-center text-xs font-bold text-[#3368A0] hover:underline">
          Format stickers to exact 320x320 specifications →
        </a>
      </div>

      <div class="card-panel p-8 rounded-[14px]">
        <h2 class="text-xl font-bold text-[#192538] mb-3">4. Discord Avatar & PFP Standards</h2>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          The recommended Discord avatar size and Discord profile picture size is <strong>512×512 pixels</strong>. Because Discord crops your square image into a circle, about 21% of the corner area gets cut off. Keep faces, logos, and important details centered so they stay in full view.
        </p>
        <a href="/tools/avatar/" class="inline-flex items-center text-xs font-bold text-[#3368A0] hover:underline">
          Crop & preview profile picture in Avatar Studio →
        </a>
      </div>

      <div class="card-panel p-8 rounded-[14px]">
        <h2 class="text-xl font-bold text-[#192538] mb-3">5. Custom Role Icons for Boost Level 2 Servers</h2>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          The official Discord role icon size is <strong>64×64 pixels</strong> under 256 KB. In chat and member lists, Discord shrinks them down to 16×16 or 20×20 pixels next to usernames. Uploading them requires Server Boost Level 2 and the 'Manage Roles' permission.
        </p>
        <a href="/tools/role-icon/" class="inline-flex items-center text-xs font-bold text-[#3368A0] hover:underline">
          Format custom role icons in Role Icon Studio →
        </a>
      </div>

      <div class="card-panel p-8 rounded-[14px]">
        <h2 class="text-xl font-bold text-[#192538] mb-3">6. Discord UI Colors & Background Themes</h2>
        <p class="text-[#475569] text-sm leading-relaxed mb-4">
          Discord's interface uses a default Dark theme with a Discord background color of <strong>#313338</strong> and an optional Light theme (#FFFFFF). Giving custom emojis, stickers, and role badges a subtle white or light outline ensures they stay clear and readable on every Discord background color.
        </p>
      </div>

      <div class="card-panel p-8 rounded-[14px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#66A3BF]/30">
        <h2 class="text-xl font-bold text-[#192538] dark:text-white mb-3">7. Creating Animated Discord GIFs</h2>
        <p class="text-[#475569] dark:text-[#CBD5E1] text-sm leading-relaxed mb-4">
          Want to create animated emojis, animated banners, or Nitro profile pictures? Check out our complete guide for Discord GIF limits, frame rates, and compression tips.
        </p>
        <a href="/guides/discord-gif-guide/" class="btn-primary inline-flex items-center text-xs px-4 py-2 rounded-[8px] font-bold">
          Read the Discord GIF Guide &rarr;
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold text-[#192538] dark:text-white mb-6 text-center">
        Discord Size Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="card-panel p-6 rounded-[14px]">
            <h3 class="text-base font-bold text-[#192538] dark:text-white mb-2">{item.q}</h3>
            <p class="text-sm text-[#475569] dark:text-[#CBD5E1] leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
