---
/**
 * EmojiWorkspace.astro — shared interactive Discord emoji tool (128×128, 256 KiB).
 *
 * Language-agnostic logic keyed off fixed element IDs; only visible labels and
 * alert strings vary by locale. Imported by both the EN (/tools/emoji/) and
 * ES (/es/tools/emoji/) pages so Spanish users get the real tool, not a redirect.
 */
interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    dropTitle: 'Click to browse or drop emoji artwork',
    dropHint: 'PNG, JPG, WebP, or GIF (Processed in local memory)',
    canvasTitle: 'Canvas Transformation (128 × 128)',
    reset: 'Reset',
    exportBtn: 'Export Verified Emoji',
    chatPreview: 'Discord Chat Preview',
    dark: 'Dark',
    light: 'Light',
    member: 'Server Member',
    timestamp: 'Today at 4:20 PM',
    chatLine: 'Check out this custom emoji:',
    audit: 'Compliance Audit',
    awaiting: 'Awaiting Media',
    targetDims: 'Target Dimensions:',
    originalDims: 'Original Dimensions:',
    binaryLimit: 'Binary Limit:',
    measured: 'Measured Byte Size:',
    encoding: 'Export Encoding:'
  },
  es: {
    dropTitle: 'Haz clic para explorar o suelta tu arte de emoji',
    dropHint: 'PNG, JPG, WebP o GIF (procesado en memoria local)',
    canvasTitle: 'Transformación de Lienzo (128 × 128)',
    reset: 'Reiniciar',
    exportBtn: 'Exportar Emoji Verificado',
    chatPreview: 'Vista Previa del Chat de Discord',
    dark: 'Oscuro',
    light: 'Claro',
    member: 'Miembro del Servidor',
    timestamp: 'Hoy a las 16:20',
    chatLine: 'Mira este emoji personalizado:',
    audit: 'Auditoría de Cumplimiento',
    awaiting: 'Esperando Archivo',
    targetDims: 'Dimensiones Objetivo:',
    originalDims: 'Dimensiones Originales:',
    binaryLimit: 'Límite Binario:',
    measured: 'Tamaño Medido en Bytes:',
    encoding: 'Codificación de Exportación:'
  }
}[lang];

// Alert / receipt strings consumed by the client script via data-* attributes.
const js = {
  en: {
    invalidFile: 'Please upload a valid image file (PNG, JPG, WebP, or GIF).',
    compliant: 'Compliant',
    exceeds: 'Exceeds Cap',
    pass: '✓ Pass: Exactly within the 256 KiB upload limit and 128x128 dimensions.',
    warnPrefix: "⚠ Warning: File size (",
    warnMid: ") exceeds Discord's 256 KiB cap by ",
    warnSuffix: ' bytes.',
    exportBlocked: 'Cannot export: Final encoded Blob (',
    exportBlockedSuffix: ' KiB) exceeds the 256 KiB Discord limit.'
  },
  es: {
    invalidFile: 'Sube un archivo de imagen válido (PNG, JPG, WebP o GIF).',
    compliant: 'Conforme',
    exceeds: 'Supera el Límite',
    pass: '✓ Correcto: Dentro del límite de 256 KiB y dimensiones 128x128.',
    warnPrefix: '⚠ Advertencia: El tamaño (',
    warnMid: ') supera el límite de 256 KiB de Discord por ',
    warnSuffix: ' bytes.',
    exportBlocked: 'No se puede exportar: el Blob final (',
    exportBlockedSuffix: ' KiB) supera el límite de 256 KiB de Discord.'
  }
}[lang];
---

<!-- Main Workspace Layout -->
<div
  class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16"
  id="emoji-workspace"
  data-invalid-file={js.invalidFile}
  data-compliant={js.compliant}
  data-exceeds={js.exceeds}
  data-pass={js.pass}
  data-warn-prefix={js.warnPrefix}
  data-warn-mid={js.warnMid}
  data-warn-suffix={js.warnSuffix}
  data-export-blocked={js.exportBlocked}
  data-export-blocked-suffix={js.exportBlockedSuffix}
  data-awaiting={t.awaiting}
>
  <!-- Left Column: Upload & Canvas Controls (7 cols) -->
  <div class="lg:col-span-7 space-y-6">
    <!-- File Input Dropzone -->
    <div
      id="dropzone"
      class="border-2 border-dashed border-[#C8DFDB] hover:border-[#3368A0] rounded-[14px] bg-[#FFFFFF] dark:bg-[#141A24] p-8 text-center transition-all cursor-pointer relative shadow-xs"
    >
      <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp,image/gif" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
      <div class="space-y-3 pointer-events-none">
        <div class="w-12 h-12 rounded-[12px] bg-[#C8DFDB]/50 text-[#3368A0] flex items-center justify-center mx-auto text-xl font-bold">
          📁
        </div>
        <div>
          <p class="text-sm font-bold text-[#192538] dark:text-white">{t.dropTitle}</p>
          <p class="text-xs text-[#6B7A90] mt-1">{t.dropHint}</p>
        </div>
      </div>
    </div>

    <!-- Canvas & Editor Controls -->
    <div id="editorPanel" class="card-panel rounded-[14px] p-6 hidden">
      <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
        <h2 class="text-sm font-bold text-[#192538] dark:text-white">{t.canvasTitle}</h2>
        <button id="resetBtn" class="btn-secondary text-xs px-3 py-1.5 rounded-[6px]">
          {t.reset}
        </button>
      </div>

      <!-- Live Canvas Surface -->
      <div class="flex items-center justify-center p-6 bg-[#FAF8F5] dark:bg-[#1B2330] rounded-[10px] border border-[#E0DBD0] dark:border-[#263346] overflow-hidden mb-6">
        <canvas id="mainCanvas" width="128" height="128" class="max-w-[128px] max-h-[128px] shadow-sm rounded-[6px] bg-[repeating-conic-gradient(#EAE6DC_0%_25%,#FFFFFF_0%_50%)] [background-size:16px_16px]"></canvas>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button id="exportBtn" class="btn-primary w-full sm:flex-1 py-3.5 rounded-[10px] text-sm font-semibold flex items-center justify-center gap-2">
          <span>{t.exportBtn}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Right Column: Validation Receipt & Live Discord Preview (5 cols) -->
  <div class="lg:col-span-5 space-y-6">
    <!-- Live Chat Size Previews -->
    <div class="card-panel rounded-[14px] p-6">
      <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
        <h2 class="text-sm font-bold text-[#192538] dark:text-white">{t.chatPreview}</h2>
        <!-- Light/Dark Preview Surface Toggle -->
        <div class="flex items-center gap-1 bg-[#FAF8F5] dark:bg-[#1B2330] p-1 rounded-[6px] border border-[#E0DBD0] dark:border-[#263346]">
          <button id="themeDarkBtn" class="text-[11px] px-2.5 py-0.5 rounded bg-[#3368A0] text-white font-medium">{t.dark}</button>
          <button id="themeLightBtn" class="text-[11px] px-2.5 py-0.5 rounded text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] font-medium">{t.light}</button>
        </div>
      </div>

      <div id="previewSurface" class="p-4 rounded-[10px] bg-[#313338] text-white transition-colors">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full bg-[#5865f2] flex items-center justify-center font-bold text-xs flex-shrink-0">
            User
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-xs font-semibold">{t.member}</span>
              <span class="text-[10px] text-[#949ba4]">{t.timestamp}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs">{t.chatLine}</span>
              <!-- 32x32 Container for Chat Simulation -->
              <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center bg-black/10 rounded overflow-hidden">
                <img id="chatPreviewImg" class="max-w-full max-h-full object-contain hidden" alt="Emoji Preview" />
                <span id="chatPreviewPlaceholder" class="text-[10px] text-[#949ba4]">--</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Real-time Verification Receipt -->
    <div class="card-panel rounded-[14px] p-6">
      <div class="flex items-center justify-between pb-3 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
        <h2 class="text-sm font-bold text-[#192538] dark:text-white">{t.audit}</h2>
        <span id="receiptBadge" class="text-[11px] font-mono uppercase bg-[#FAF8F5] dark:bg-[#1B2330] text-[#6B7A90] border border-[#E0DBD0] dark:border-[#263346] px-2.5 py-0.5 rounded">
          {t.awaiting}
        </span>
      </div>

      <div class="space-y-3 font-mono text-xs">
        <div class="flex justify-between py-1.5 border-b border-[#FAF8F5] dark:border-[#1B2330]">
          <span class="text-[#6B7A90]">{t.targetDims}</span>
          <span class="font-bold text-[#192538] dark:text-white">128 × 128 px</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#FAF8F5] dark:border-[#1B2330]">
          <span class="text-[#6B7A90]">{t.originalDims}</span>
          <span id="statDimensions" class="text-[#192538] dark:text-white">-- × --</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#FAF8F5] dark:border-[#1B2330]">
          <span class="text-[#6B7A90]">{t.binaryLimit}</span>
          <span class="text-[#0D9488] font-bold">256 KiB (262,144 bytes)</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-[#FAF8F5] dark:border-[#1B2330]">
          <span class="text-[#6B7A90]">{t.measured}</span>
          <span id="statBytes" class="text-[#192538] dark:text-white">-- KiB</span>
        </div>
        <div class="flex justify-between py-1.5">
          <span class="text-[#6B7A90]">{t.encoding}</span>
          <span id="statFormat" class="text-[#192538] dark:text-white">PNG / WebP</span>
        </div>
      </div>

      <div id="receiptAlert" class="mt-4 hidden p-3 rounded-[8px] text-xs"></div>
    </div>
  </div>
</div>

<script>
  const MAX_EMOJI_BYTES = 256 * 1024; // 262,144 bytes

  const ws = document.getElementById('emoji-workspace');
  const L = {
    invalidFile: ws?.dataset.invalidFile || 'Please upload a valid image file.',
    compliant: ws?.dataset.compliant || 'Compliant',
    exceeds: ws?.dataset.exceeds || 'Exceeds Cap',
    pass: ws?.dataset.pass || '',
    warnPrefix: ws?.dataset.warnPrefix || '',
    warnMid: ws?.dataset.warnMid || '',
    warnSuffix: ws?.dataset.warnSuffix || '',
    exportBlocked: ws?.dataset.exportBlocked || '',
    exportBlockedSuffix: ws?.dataset.exportBlockedSuffix || ''
  };

  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const dropzone = document.getElementById('dropzone');
  const editorPanel = document.getElementById('editorPanel');
  const mainCanvas = document.getElementById('mainCanvas') as HTMLCanvasElement;
  const resetBtn = document.getElementById('resetBtn');
  const exportBtn = document.getElementById('exportBtn');
  const chatPreviewImg = document.getElementById('chatPreviewImg') as HTMLImageElement;
  const chatPreviewPlaceholder = document.getElementById('chatPreviewPlaceholder');
  const previewSurface = document.getElementById('previewSurface');
  const themeDarkBtn = document.getElementById('themeDarkBtn');
  const themeLightBtn = document.getElementById('themeLightBtn');

  const statDimensions = document.getElementById('statDimensions');
  const statBytes = document.getElementById('statBytes');
  const statFormat = document.getElementById('statFormat');
  const receiptBadge = document.getElementById('receiptBadge');
  const receiptAlert = document.getElementById('receiptAlert');

  let currentBlob: Blob | null = null;
  let currentObjectUrl: string | null = null;
  let sourceImage: HTMLImageElement | null = null;

  function cleanup() {
    if (currentObjectUrl) {
      URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = null;
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    handleFile(file);
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-[#3368A0]', 'bg-[#FAF8F5]');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-[#3368A0]', 'bg-[#FAF8F5]');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-[#3368A0]', 'bg-[#FAF8F5]');
    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    handleFile(file);
  });

  function handleFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert(L.invalidFile);
      return;
    }

    cleanup();
    currentObjectUrl = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      sourceImage = img;
      processEmoji(img, file);
    };
    img.src = currentObjectUrl;
  }

  function processEmoji(img: HTMLImageElement, originalFile: File) {
    const ctx = mainCanvas.getContext('2d');
    if (!ctx) return;

    const targetSize = 128;
    mainCanvas.width = targetSize;
    mainCanvas.height = targetSize;
    ctx.clearRect(0, 0, targetSize, targetSize);

    const scale = Math.min(targetSize / img.width, targetSize / img.height);
    const w = img.width * scale;
    const h = img.height * scale;
    const x = (targetSize - w) / 2;
    const y = (targetSize - h) / 2;

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, x, y, w, h);

    mainCanvas.toBlob((blob) => {
      if (!blob) return;
      currentBlob = blob;
      cleanup();
      currentObjectUrl = URL.createObjectURL(blob);

      chatPreviewImg.src = currentObjectUrl;
      chatPreviewImg.classList.remove('hidden');
      chatPreviewPlaceholder?.classList.add('hidden');

      editorPanel?.classList.remove('hidden');

      const bytes = blob.size;
      const kib = (bytes / 1024).toFixed(1);
      statDimensions!.innerText = `${img.width}×${img.height} → 128×128`;
      statBytes!.innerText = `${kib} KiB (${bytes.toLocaleString()} bytes)`;
      statFormat!.innerText = blob.type.replace('image/', '').toUpperCase();

      if (bytes <= MAX_EMOJI_BYTES) {
        receiptBadge!.innerText = L.compliant;
        receiptBadge!.className = 'text-[11px] font-mono uppercase bg-[#C8DFDB]/60 text-[#0D9488] border border-[#0D9488]/30 px-2.5 py-0.5 rounded font-bold';
        receiptAlert!.className = 'p-3 rounded-[8px] text-xs bg-[#C8DFDB]/40 text-[#0D9488] border border-[#0D9488]/30 block font-medium';
        receiptAlert!.innerText = L.pass;
      } else {
        receiptBadge!.innerText = L.exceeds;
        receiptBadge!.className = 'text-[11px] font-mono uppercase bg-[#DC2626]/10 text-[#DC2626] border border-[#DC2626]/20 px-2.5 py-0.5 rounded font-bold';
        receiptAlert!.className = 'p-3 rounded-[8px] text-xs bg-[#DC2626]/10 text-[#DC2626] border border-[#DC2626]/20 block font-medium';
        receiptAlert!.innerText = `${L.warnPrefix}${kib} KiB${L.warnMid}${(bytes - MAX_EMOJI_BYTES).toLocaleString()}${L.warnSuffix}`;
      }
    }, 'image/png');
  }

  resetBtn?.addEventListener('click', () => {
    cleanup();
    currentBlob = null;
    sourceImage = null;
    editorPanel?.classList.add('hidden');
    chatPreviewImg?.classList.add('hidden');
    chatPreviewPlaceholder?.classList.remove('hidden');
    statDimensions!.innerText = '-- × --';
    statBytes!.innerText = '-- KiB';
    statFormat!.innerText = 'PNG / WebP';
    receiptBadge!.innerText = ws?.dataset.awaiting || 'Awaiting Media';
    receiptBadge!.className = 'text-[11px] font-mono uppercase bg-[#FAF8F5] text-[#6B7A90] border border-[#E0DBD0] px-2.5 py-0.5 rounded';
    receiptAlert?.classList.add('hidden');
    fileInput.value = '';
  });

  exportBtn?.addEventListener('click', () => {
    if (!currentBlob || !currentObjectUrl) return;

    if (currentBlob.size > MAX_EMOJI_BYTES) {
      alert(`${L.exportBlocked}${(currentBlob.size / 1024).toFixed(1)}${L.exportBlockedSuffix}`);
      return;
    }

    const a = document.createElement('a');
    a.href = currentObjectUrl;
    a.download = 'discord-emoji-128x128.png';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });

  themeDarkBtn?.addEventListener('click', () => {
    previewSurface!.className = 'p-4 rounded-[10px] bg-[#313338] text-white transition-colors';
    themeDarkBtn.className = 'text-[11px] px-2.5 py-0.5 rounded bg-[#3368A0] text-white font-medium';
    themeLightBtn!.className = 'text-[11px] px-2.5 py-0.5 rounded text-[#475569] hover:text-[#192538] font-medium';
  });

  themeLightBtn?.addEventListener('click', () => {
    previewSurface!.className = 'p-4 rounded-[10px] bg-[#ffffff] text-[#313338] transition-colors border border-[#e3e5e8]';
    themeLightBtn.className = 'text-[11px] px-2.5 py-0.5 rounded bg-[#3368A0] text-white font-medium';
    themeDarkBtn!.className = 'text-[11px] px-2.5 py-0.5 rounded text-[#475569] hover:text-[#192538] font-medium';
  });

  // Add the awaiting label into the reset badge default (data attr)
  if (ws && receiptBadge && !receiptBadge.innerText.trim()) {
    receiptBadge.innerText = ws.dataset.awaiting || 'Awaiting Media';
  }
</script>
