---
/**
 * BioGeneratorWorkspace.astro — Discord "About Me" bio generator + templates.
 *
 * Builds Discord bio ideas from themed banks (aesthetic, cute, gaming, dark,
 * minimal, motivational, funny, music): a Generate button assembles a divider
 * + tagline + interests + closer, a curated template gallery offers ready
 * copy-paste bios, and click-to-insert symbol / divider / kaomoji rows let you
 * decorate an editable output box with a live 190-character counter (Discord's
 * About Me limit). Copy, plus localStorage favorites. All client-side.
 *
 * Unlike the username handle, a Discord bio DOES allow Unicode symbols and
 * emoji, so the decorative banks in ../../data/aesthetic-symbols are fair game.
 * Language-neutral symbols come from that module; localized text banks live in
 * BANKS below. Imported by EN (/tools/bio-generator/) and ES (/es/…) pages.
 */
import { DIVIDERS, SYMBOLS, KAOMOJI } from '../../data/aesthetic-symbols';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;

// Theme values are language-agnostic (drive the client generator); labels localized.
const THEMES = [
  { value: 'aesthetic', en: 'Aesthetic', es: 'Estético' },
  { value: 'cute', en: 'Cute', es: 'Tierno' },
  { value: 'gaming', en: 'Gaming', es: 'Gaming' },
  { value: 'dark', en: 'Dark / edgy', es: 'Oscuro / edgy' },
  { value: 'minimal', en: 'Minimal', es: 'Minimalista' },
