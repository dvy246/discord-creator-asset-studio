---
<div
  id="bg-workspace"
  data-copied={js.copied}
  data-copy={js.copy}
  data-saved={js.saved}
  data-save={js.save}
  data-favempty={js.favEmpty}
  class="mx-auto w-full max-w-4xl"
>
  <script type="application/json" id="bg-banks" set:html={JSON.stringify(BANKS)}></script>

  <!-- Controls -->
  <div class="rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24] p-5 sm:p-6 shadow-sm">
    <div class="flex flex-wrap items-end gap-4">
      <div class="min-w-[180px] flex-1">
        <label for="bg-theme" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-[#6B7A90] dark:text-[#8494A7]">{t.themeLabel}</label>
        <select id="bg-theme" class="w-full rounded-[10px] border border-[#E0DBD0] dark:border-[#263346] bg-[#FAF8F5] dark:bg-[#1B2330] px-4 py-3 text-sm font-semibold text-[#192538] dark:text-white outline-none focus:border-[#3368A0]">
          {THEMES.map((m) => <option value={m.value}>{t.themes[m.value]}</option>)}
        </select>
      </div>
      <button id="bg-generate" type="button" class="btn-primary rounded-[10px] px-5 py-3 text-sm font-semibold">{t.generate}</button>
    </div>
  </div>

  <!-- Editor -->
  <div class="mt-5 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24] p-5 shadow-sm">
    <div class="mb-2 flex items-center justify-between gap-3">
      <label for="bg-editor" class="text-xs font-bold uppercase tracking-wide text-[#6B7A90] dark:text-[#8494A7]">{t.editorLabel}</label>
      <span id="bg-count" class="font-mono text-xs font-semibold text-[#6B7A90] dark:text-[#8494A7]">0 / 190</span>
    </div>
    <textarea id="bg-editor" rows="5" class="w-full resize-y rounded-[10px] border border-[#E0DBD0] dark:border-[#263346] bg-[#FAF8F5] dark:bg-[#1B2330] px-4 py-3 font-mono text-sm text-[#192538] dark:text-white outline-none focus:border-[#3368A0]"></textarea>
    <div class="mt-3 flex flex-wrap gap-2">
      <button id="bg-copy" type="button" class="btn-primary rounded-[10px] px-5 py-2.5 text-sm font-semibold">{t.copy}</button>
      <button id="bg-save" type="button" class="btn-secondary rounded-[10px] px-4 py-2.5 text-xs font-semibold">{t.saveFav}</button>
    </div>
    <p class="mt-2 text-xs text-[#6B7A90] dark:text-[#8494A7]">{t.editorHint}</p>
  </div>

  <!-- Click-to-insert: dividers / symbols / faces -->
  <div class="mt-5 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24] p-5 shadow-sm">
    <p class="mb-3 text-xs font-bold uppercase tracking-wide text-[#6B7A90] dark:text-[#8494A7]">{t.insertLabel}</p>
    <div class="mb-3 flex flex-wrap gap-2" role="tablist">
      <button id="bg-tab-dividers" type="button" data-tab="dividers" class="bg-tab btn-secondary rounded-full px-4 py-1.5 text-xs font-semibold">{t.tabDividers}</button>
      <button id="bg-tab-symbols" type="button" data-tab="symbols" class="bg-tab btn-secondary rounded-full px-4 py-1.5 text-xs font-semibold">{t.tabSymbols}</button>
      <button id="bg-tab-kaomoji" type="button" data-tab="kaomoji" class="bg-tab btn-secondary rounded-full px-4 py-1.5 text-xs font-semibold">{t.tabKaomoji}</button>
    </div>
    <div id="bg-insert-grid" class="flex flex-wrap gap-2"></div>
  </div>

  <!-- Template gallery -->
  <div class="mt-5">
    <p class="mb-2 text-xs font-bold uppercase tracking-wide text-[#6B7A90] dark:text-[#8494A7]">{t.templatesLabel}</p>
    <div id="bg-templates" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>

  <!-- Favorites -->
  <div class="mt-6 rounded-[14px] border border-[#E0DBD0] dark:border-[#263346] bg-white dark:bg-[#141A24] p-5 shadow-sm">
    <div class="mb-3 flex items-center justify-between gap-3">
      <p class="text-xs font-bold uppercase tracking-wide text-[#6B7A90] dark:text-[#8494A7]">⭐ {t.favLabel}</p>
      <button id="bg-clearfav" type="button" class="btn-secondary rounded-full px-3 py-1.5 text-xs font-semibold">{t.clearFav}</button>
    </div>
    <div id="bg-favorites" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="bg-fav-empty" class="text-xs text-[#6B7A90] dark:text-[#8494A7]">{t.favEmpty}</p>
  </div>

  <!-- About-Me rules note -->
  <p class="mt-5 rounded-[10px] border border-[#C8DFDB] dark:border-[#263346] bg-[#F0F7F6] dark:bg-[#141A24] px-4 py-3 text-xs text-[#475569] dark:text-[#94A3B8]">
    ℹ️ {t.rules}
  </p>

  <!-- Trailing internal links -->
  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    {t.links.map((link) => (
      <a href={link.href} class="font-semibold text-[#3368A0] dark:text-[#66A3BF] transition hover:underline">{link.label} →</a>
    ))}
  </div>
</div>
<script>
  import { DIVIDERS, SYMBOLS, KAOMOJI } from '../../data/aesthetic-symbols';
  const ws = document.getElementById('bg-workspace');
  if (ws) {
    const L = {
      copied: ws.dataset.copied || 'Copied!',
      copy: ws.dataset.copy || 'Copy',
      saved: ws.dataset.saved || 'Saved!',
      save: ws.dataset.save || 'Save',
      favEmpty: ws.dataset.favempty || '',
    };
    let BANKS: any = {};
    try { BANKS = JSON.parse(document.getElementById('bg-banks')?.textContent || '{}'); } catch {}
    const themeSel = ws.querySelector('#bg-theme') as HTMLSelectElement;
    const editor = ws.querySelector('#bg-editor') as HTMLTextAreaElement;
    const countEl = ws.querySelector('#bg-count') as HTMLElement;
    const genBtn = ws.querySelector('#bg-generate') as HTMLButtonElement;
    const copyBtn = ws.querySelector('#bg-copy') as HTMLButtonElement;
    const saveBtn = ws.querySelector('#bg-save') as HTMLButtonElement;
    const insertGrid = ws.querySelector('#bg-insert-grid') as HTMLElement;
    const templatesBox = ws.querySelector('#bg-templates') as HTMLElement;
    const favBox = ws.querySelector('#bg-favorites') as HTMLElement;
    const favEmpty = ws.querySelector('#bg-fav-empty') as HTMLElement;
    const clearFavBtn = ws.querySelector('#bg-clearfav') as HTMLButtonElement;
    const tabs = Array.from(ws.querySelectorAll('.bg-tab')) as HTMLButtonElement[];

    const MAX = 190;
    const FAV_KEY = 'dcas-bio-favorites';
    const INSERTS: Record<string, string[]> = { dividers: DIVIDERS, symbols: SYMBOLS, kaomoji: KAOMOJI };
    const clen = (s: string) => [...s].length;
    const rand = (a: string[]) => a[Math.floor(Math.random() * a.length)];
    async function copyText(text: string) {
      try { await navigator.clipboard.writeText(text); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch {}
        document.body.removeChild(ta);
      }
    }
    function updateCount() {
      const n = clen(editor.value);
      countEl.textContent = n + ' / ' + MAX;
      countEl.classList.toggle('!text-[#ed4245]', n > MAX);
      countEl.classList.toggle('text-[#6B7A90]', n <= MAX);
    }
    function insertAtCursor(text: string) {
      const start = editor.selectionStart ?? editor.value.length;
      const end = editor.selectionEnd ?? editor.value.length;
      editor.value = editor.value.slice(0, start) + text + editor.value.slice(end);
      const pos = start + text.length;
      editor.focus(); editor.setSelectionRange(pos, pos);
      updateCount();
    }
    // Assemble divider + tagline + interests + closer, trimmed to 190 code points.
    function generate(theme: string) {
      const tl = BANKS.taglines?.[theme] || [];
      const ints = BANKS.interests?.[theme] || [];
      const cls = BANKS.closers?.[theme] || [];
      const picks = [...ints].sort(() => Math.random() - 0.5).slice(0, 3);
      const lines: string[] = [];
      lines.push(rand(DIVIDERS));
      if (tl.length) lines.push(rand(tl));
      if (picks.length) lines.push(picks.join(' · '));
      if (cls.length) lines.push(rand(cls));
      let bio = lines.join('\n');
      while (clen(bio) > MAX && lines.length > 1) { lines.pop(); bio = lines.join('\n'); }
      if (clen(bio) > MAX) bio = [...bio].slice(0, MAX).join('');
      return bio;
    }
    function chip(char: string, onClick: () => void) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'rounded-[10px] border border-[#E0DBD0] dark:border-[#263346] bg-[#FAF8F5] dark:bg-[#1B2330] px-3 py-2 font-mono text-sm text-[#192538] dark:text-white transition hover:border-[#3368A0] hover:text-[#3368A0] dark:hover:text-[#66A3BF]';
      b.textContent = char;
      b.addEventListener('click', onClick);
      return b;
    }
    function setActiveTab(name: string) {
      tabs.forEach((tb) => {
        const on = tb.dataset.tab === name;
        tb.classList.toggle('ring-2', on);
        tb.classList.toggle('ring-[#FF84BA]', on);
        tb.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }
    function renderInserts(name: string) {
      insertGrid.innerHTML = '';
      (INSERTS[name] || []).forEach((c) => insertGrid.appendChild(chip(c, () => insertAtCursor(c))));
      setActiveTab(name);
    }
    function templateCard(text: string) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'whitespace-pre-line rounded-[12px] border border-[#E0DBD0] dark:border-[#263346] bg-[#FAF8F5] dark:bg-[#1B2330] p-4 text-left font-mono text-sm leading-relaxed text-[#192538] dark:text-white transition hover:border-[#3368A0]';
      b.textContent = text;
      b.addEventListener('click', () => { editor.value = text; updateCount(); editor.focus(); });
      return b;
    }
    function renderTemplates(theme: string) {
      templatesBox.innerHTML = '';
      (BANKS.templates?.[theme] || []).forEach((tpl: string) => templatesBox.appendChild(templateCard(tpl)));
    }
    function loadFavs(): string[] {
      try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch { return []; }
    }
    function saveFavs(list: string[]) {
      try { localStorage.setItem(FAV_KEY, JSON.stringify(list)); } catch {}
    }
    function favCard(text: string) {
      const wrap = document.createElement('div');
      wrap.className = 'relative whitespace-pre-line rounded-[12px] border border-[#C8DFDB] dark:border-[#263346] bg-[#F0F7F6] dark:bg-[#1B2330] p-4 pr-9 font-mono text-sm leading-relaxed text-[#192538] dark:text-white';
      const load = document.createElement('button');
      load.type = 'button'; load.className = 'block w-full text-left'; load.textContent = text;
      load.addEventListener('click', () => { editor.value = text; updateCount(); editor.focus(); });
      const x = document.createElement('button');
      x.type = 'button'; x.className = 'absolute right-2 top-2 rounded-full px-1 text-[#6B7A90] transition hover:text-[#ed4245]'; x.textContent = '×'; x.setAttribute('aria-label', 'remove');
      x.addEventListener('click', () => { const l = loadFavs().filter((v) => v !== text); saveFavs(l); renderFavs(); });
      wrap.appendChild(load); wrap.appendChild(x);
      return wrap;
    }
    function renderFavs() {
      const list = loadFavs(); favBox.innerHTML = '';
      if (!list.length) { favEmpty.style.display = ''; favEmpty.textContent = L.favEmpty; return; }
      favEmpty.style.display = 'none';
      list.forEach((v) => favBox.appendChild(favCard(v)));
    }

    genBtn.addEventListener('click', () => { editor.value = generate(themeSel.value); updateCount(); });
    themeSel.addEventListener('change', () => renderTemplates(themeSel.value));
    editor.addEventListener('input', updateCount);
    tabs.forEach((tb) => tb.addEventListener('click', () => renderInserts(tb.dataset.tab || 'dividers')));
    copyBtn.addEventListener('click', async () => {
      if (!editor.value) return;
      await copyText(editor.value);
      copyBtn.textContent = L.copied;
      setTimeout(() => { copyBtn.textContent = L.copy; }, 1200);
    });
    saveBtn.addEventListener('click', () => {
      const v = editor.value.trim(); if (!v) return;
      const list = loadFavs(); if (!list.includes(v)) list.unshift(v);
      saveFavs(list); renderFavs();
      saveBtn.textContent = L.saved;
      setTimeout(() => { saveBtn.textContent = L.save; }, 1200);
    });
    clearFavBtn.addEventListener('click', () => { saveFavs([]); renderFavs(); });

    editor.value = generate(themeSel.value);
    updateCount();
    renderInserts('dividers');
    renderTemplates(themeSel.value);
    renderFavs();
  }
</script>


