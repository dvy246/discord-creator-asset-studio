---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  hasSpanishAlternate?: boolean;
}

const { 
  title, 
  description, 
  canonicalUrl,
  ogType = 'website',
  ogImage = 'https://discord-creator-asset-studio.pages.dev/og-image.png',
  noindex = false,
  hasSpanishAlternate,
} = Astro.props;

// OG image alt text + dimensions improve social scraper rendering
const ogImageAlt = `${title} — Discord Creator Asset Studio`;

const site = Astro.site ? new URL(Astro.site).origin : 'https://discord-creator-asset-studio.pages.dev';
const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/$/, '') || '/';

// Format clean canonical with trailing slash
const canonicalPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = canonicalUrl || new URL(canonicalPath, site).toString();

const isEs = pathname.startsWith('/es');
const basePathWithoutEs = normalizedPath.replace(/^\/es/, '') || '/';
const basePathWithSlash = basePathWithoutEs.endsWith('/') ? basePathWithoutEs : `${basePathWithoutEs}/`;

const enUrl = new URL(basePathWithSlash, site).toString();
const esUrl = new URL(basePathWithSlash === '/' ? '/es/' : `/es${basePathWithSlash}`, site).toString();
const xDefaultUrl = enUrl;

// Determine if this route has a matching Spanish translation
const SPANISH_ROUTES = new Set([
  '/',
  '/es',
  '/guides/discord-sizes',
  '/es/guides/discord-sizes',
  '/tools/emoji',
  '/es/tools/emoji',
  '/tools/sticker',
  '/es/tools/sticker',
  '/tools/banner',
  '/es/tools/banner',
  '/tools/avatar',
  '/es/tools/avatar',
  '/tools/role-icon',
  '/es/tools/role-icon',
  '/tools/image-compressor',
  '/es/tools/image-compressor',
  '/tools/image-resizer',
  '/es/tools/image-resizer',
  '/tools/spoiler',
  '/es/tools/spoiler',
  '/tools/colors',
  '/es/tools/colors',
  '/tools/timestamp',
  '/es/tools/timestamp'
]);

const routeHasSpanish = hasSpanishAlternate !== undefined
  ? hasSpanishAlternate
  : SPANISH_ROUTES.has(normalizedPath);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#F2EFE7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141A24" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Discord Asset Studio Blog" href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    {routeHasSpanish && (
      <>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      </>
    )}
  </>
)}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content="Discord Asset Studio" />
<meta property="og:locale" content={isEs ? 'es_ES' : 'en_US'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
