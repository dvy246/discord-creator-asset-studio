---
// Hyper-Optimized 3D Stacked Template Showcase
// 100% GPU-Accelerated, 0% CPU Thrash, Zero DOM Rebuilds during interactions
---

<div class="w-full select-none" id="templateCarouselRoot">
  <!-- Controls Bar: Category Filters & Instructions -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 px-2">
    <!-- Filter Pills -->
    <div class="flex items-center gap-1.5 p-1 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] overflow-x-auto" id="carouselFilters">
      <button type="button" data-filter="all" class="carousel-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold bg-[#3368A0] text-white shadow-xs transition-colors cursor-pointer">
        All
      </button>
      <button type="button" data-filter="banner" class="carousel-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white transition-colors cursor-pointer">
        Banner
      </button>
      <button type="button" data-filter="avatar" class="carousel-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white transition-colors cursor-pointer">
        Avatar
      </button>
      <button type="button" data-filter="sticker" class="carousel-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white transition-colors cursor-pointer">
        Sticker
      </button>
      <button type="button" data-filter="emoji" class="carousel-filter-btn px-3.5 py-1.5 rounded-[8px] text-xs font-bold text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white transition-colors cursor-pointer">
        Emoji
      </button>
    </div>

    <!-- Navigation Tip -->
    <div class="hidden sm:flex items-center gap-2 text-xs font-medium text-[#6B7A90] dark:text-[#8494A7]">
      <svg class="w-4 h-4 text-[#3368A0] dark:text-[#66A3BF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
      </svg>
      <span>Swipe or click side cards to navigate</span>
    </div>
  </div>

  <!-- 3D Carousel Stage -->
  <div class="relative w-full h-[400px] sm:h-[460px] lg:h-[500px] flex items-center justify-center overflow-hidden touch-pan-y" id="carouselStage">
    <!-- Prev Chevron Button -->
    <button
      type="button"
      id="carouselPrevBtn"
      class="absolute left-2 sm:left-4 lg:left-8 z-50 p-3 rounded-full bg-white/95 dark:bg-[#1B2330]/95 border border-[#E0DBD0] dark:border-[#263346] shadow-md text-[#192538] dark:text-white hover:scale-110 active:scale-95 transition-transform cursor-pointer focus:outline-none"
      aria-label="Previous template"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next Chevron Button -->
    <button
      type="button"
      id="carouselNextBtn"
      class="absolute right-2 sm:right-4 lg:right-8 z-50 p-3 rounded-full bg-white/95 dark:bg-[#1B2330]/95 border border-[#E0DBD0] dark:border-[#263346] shadow-md text-[#192538] dark:text-white hover:scale-110 active:scale-95 transition-transform cursor-pointer focus:outline-none"
      aria-label="Next template"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- 3D Card Stack Container -->
    <div class="relative w-full h-full flex items-center justify-center pointer-events-auto" id="carouselCardDeck">

      <!-- Card 0: Neo-Tokyo Ronin (Banner) -->
      <div
        class="carousel-card absolute w-[260px] h-[340px] sm:w-[300px] sm:h-[400px] lg:w-[330px] lg:h-[440px] rounded-[20px] overflow-hidden bg-[#0A0E1A] border-2 border-white/10 shadow-xl pointer-events-auto cursor-pointer group"
        data-category="banner"
        data-tool="/tools/banner/"
        data-index="0"
      >
        <div class="relative w-full h-full overflow-hidden flex flex-col justify-between">
          <img
            src="/assets/banners/cyberpunk-ronin-neo-tokyo.webp"
            alt="Neo-Tokyo Ronin Discord Banner"
            class="card-artwork absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />

          <!-- Top Badge -->
          <div class="relative z-20 p-4 sm:p-5 flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-black/75 backdrop-blur-xs text-white text-[11px] font-mono font-bold border border-white/15">
              16:9 BANNER
            </span>
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          </div>

          <div class="card-depth-overlay absolute inset-0 bg-black/60 pointer-events-none transition-opacity duration-300 z-10 opacity-0 group-hover:opacity-10"></div>

          <!-- Bottom Content Bar -->
          <div class="relative z-20 p-5 sm:p-6 bg-gradient-to-t from-black/95 via-black/75 to-transparent">
            <span class="text-[11px] font-mono text-emerald-400 font-bold uppercase tracking-wider block mb-1">
              960 × 540 • SAFE ZONE VERIFIED
            </span>
            <h3 class="text-lg sm:text-xl font-extrabold text-white tracking-tight mb-2">
              Neo-Tokyo Ronin
            </h3>
            <p class="text-xs text-white/70 line-clamp-2 mb-4">
              Cyborg ronin in rain-slicked Neo-Tokyo with verified top 48px header clearance.
            </p>
            <a
              href="/tools/banner/"
              class="card-cta-btn inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-[10px] bg-[#3368A0] hover:bg-[#265280] text-white text-xs font-bold shadow-md transition-all hover:scale-102 cursor-pointer"
            >
              <span>Customize in Studio</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Card 1: Spire Sunset Dive (Banner - Animated) -->
      <div
        class="carousel-card absolute w-[260px] h-[340px] sm:w-[300px] sm:h-[400px] lg:w-[330px] lg:h-[440px] rounded-[20px] overflow-hidden bg-[#0C0B18] border-2 border-white/10 shadow-xl pointer-events-auto cursor-pointer group"
        data-category="banner"
        data-tool="/tools/banner/"
        data-index="1"
      >
        <div class="relative w-full h-full overflow-hidden flex flex-col justify-between">
