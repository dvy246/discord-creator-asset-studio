<style>
  .carousel-card {
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1), opacity 380ms ease, box-shadow 250ms ease, border-color 250ms ease;
  }
  
  /* Center card hover highlight */
  .carousel-card.is-center:hover,
  .carousel-card.is-center.is-hovered {
    border-color: #5865F2 !important;
    box-shadow: 0 0 35px rgba(88, 101, 242, 0.5), 0 20px 40px -10px rgba(0, 0, 0, 0.8) !important;
  }

  /* Flanking card hover highlight */
  .carousel-card:not(.is-center):hover,
  .carousel-card:not(.is-center).is-hovered {
    border-color: rgba(88, 225, 255, 0.6) !important;
    box-shadow: 0 10px 30px -10px rgba(88, 225, 255, 0.3) !important;
  }
  .carousel-card:not(.is-center):hover .card-depth-overlay,
  .carousel-card:not(.is-center).is-hovered .card-depth-overlay {
    opacity: 0.1 !important;
  }
</style>

<script>
  function setup3DCarousel() {
    const root = document.getElementById('templateCarouselRoot');
    if (!root) return;

    const stage = document.getElementById('carouselStage');
    const prevBtn = document.getElementById('carouselPrevBtn');
    const nextBtn = document.getElementById('carouselNextBtn');
    const dotsContainer = document.getElementById('carouselDots');
    const filterBtns = root.querySelectorAll<HTMLButtonElement>('.carousel-filter-btn');
    const allCards = Array.from(root.querySelectorAll<HTMLElement>('.carousel-card'));

    let activeFilter = 'all';
    let visibleCards: HTMLElement[] = [...allCards];
    let currentIndex = 0;

    function getConfig() {
      const width = window.innerWidth;
      if (width < 640) {
        return {
          xMultiplier: 85,
          yMultiplier: 16,
          rotationMultiplier: 7,
          scaleReduction: 0.08,
        };
      }
      if (width < 1024) {
        return {
          xMultiplier: 135,
          yMultiplier: 24,
          rotationMultiplier: 9,
          scaleReduction: 0.10,
        };
      }
      return {
        xMultiplier: 175,
        yMultiplier: 32,
        rotationMultiplier: 11,
        scaleReduction: 0.12,
      };
    }

    // Initialize dots once per filter change (0 CPU overhead during movement)
    function initDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      visibleCards.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Go to template ${idx + 1}`);
        dot.className = idx === currentIndex
          ? 'w-7 h-2 rounded-full bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 cursor-pointer'
          : 'w-2 h-2 rounded-full bg-[#E0DBD0] dark:bg-[#263346] hover:bg-[#9CB8B4] transition-all duration-300 cursor-pointer';
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          goToIndex(idx);
        });
        dotsContainer.appendChild(dot);
      });
    }

    function updateDots() {
      if (!dotsContainer) return;
      const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('button');
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'w-7 h-2 rounded-full bg-[#3368A0] dark:bg-[#66A3BF] transition-all duration-300 cursor-pointer';
        } else {
          dot.className = 'w-2 h-2 rounded-full bg-[#E0DBD0] dark:bg-[#263346] hover:bg-[#9CB8B4] transition-all duration-300 cursor-pointer';
        }
      });
    }

    // Set 3D transforms using native hardware-accelerated CSS
    function updateCards() {
      const total = visibleCards.length;
      if (total === 0) return;

      const config = getConfig();

      visibleCards.forEach((card, index) => {
        let diff = (index - currentIndex) % total;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;

        const absDiff = Math.abs(diff);

        if (absDiff > 2.5) {
          card.style.opacity = '0';
          card.style.pointerEvents = 'none';
          card.style.visibility = 'hidden';
          return;
        }

        card.style.visibility = 'visible';
        card.style.pointerEvents = 'auto';

        const x = diff * config.xMultiplier;
        const y = absDiff * config.yMultiplier;
        const rotate = diff * config.rotationMultiplier;
        const scale = Math.max(0.72, 1 - absDiff * config.scaleReduction);
        const zIndex = Math.round(100 - absDiff * 10);
        const opacity = absDiff > 2.1 ? Math.max(0, 1 - (absDiff - 2.1) * 2.5) : 1;

        card.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rotate}deg) scale(${scale})`;
        card.style.zIndex = `${zIndex}`;
        card.style.opacity = `${opacity}`;

        const overlay = card.querySelector<HTMLElement>('.card-depth-overlay');
        if (overlay) {
          const darkness = Math.min(0.65, absDiff * 0.3);
          overlay.style.opacity = `${darkness}`;
        }

        if (absDiff === 0) {
          card.classList.add('is-center', 'border-[#3368A0]', 'dark:border-[#66A3BF]', 'shadow-[0_20px_45px_rgba(51,104,160,0.35)]');
          card.classList.remove('border-white/10');
        } else {
          card.classList.remove('is-center', 'border-[#3368A0]', 'dark:border-[#66A3BF]', 'shadow-[0_20px_45px_rgba(51,104,160,0.35)]');
          card.classList.add('border-white/10');
        }
      });

      updateDots();
    }

    function goToIndex(idx: number) {
      const total = visibleCards.length;
      if (total === 0) return;

      currentIndex = ((idx % total) + total) % total;
      updateCards();
    }

    function filterDeck(category: string) {
      activeFilter = category;

      filterBtns.forEach(btn => {
        const cat = btn.getAttribute('data-filter');
        if (cat === category) {
          btn.classList.add('bg-[#3368A0]', 'text-white', 'shadow-xs');
          btn.classList.remove('text-[#475569]', 'dark:text-[#CBD5E1]');
        } else {
          btn.classList.remove('bg-[#3368A0]', 'text-white', 'shadow-xs');
          btn.classList.add('text-[#475569]', 'dark:text-[#CBD5E1]');
        }
      });

      allCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (category === 'all' || cardCat === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
          card.style.opacity = '0';
        }
      });

      visibleCards = allCards.filter(card => category === 'all' || card.getAttribute('data-category') === category);
      currentIndex = 0;

      initDots();
      updateCards();
    }

    // Ultra-Fast Swipe Gestures (zero drag lag)
    if (stage) {
      let touchStartX = 0;
      let touchStartY = 0;
      let isSwiping = false;

      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = true;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        if (!isSwiping) return;
        isSwiping = false;

        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const dx = touchEndX - touchStartX;
        const dy = touchEndY - touchStartY;

        // If horizontal swipe is dominant and > 35px
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 35) {
          if (dx < 0) {
            goToIndex(currentIndex + 1);
          } else {
            goToIndex(currentIndex - 1);
          }
        }
      }, { passive: true });

      // Desktop mouse drag / flick
      let mouseStartX = 0;
      let isMouseDown = false;

      stage.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).closest('#carouselPrevBtn') || (e.target as HTMLElement).closest('#carouselNextBtn')) {
          return;
        }
        isMouseDown = true;
        mouseStartX = e.clientX;
      });

      window.addEventListener('mouseup', (e) => {
        if (!isMouseDown) return;
        isMouseDown = false;

        const dx = e.clientX - mouseStartX;
        if (Math.abs(dx) > 40) {
          if (dx < 0) {
            goToIndex(currentIndex + 1);
          } else {
            goToIndex(currentIndex - 1);
          }
        }
      });
    }

    // Prev / Next button clicks
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      goToIndex(currentIndex - 1);
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      goToIndex(currentIndex + 1);
    });

    // Card hover & click
    allCards.forEach(card => {
      card.addEventListener('pointerenter', () => {
        card.classList.add('is-hovered');
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-hovered');
      });

      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.card-cta-btn')) {
          return;
        }

        const idx = visibleCards.indexOf(card);
        if (idx !== -1 && idx !== currentIndex) {
          e.preventDefault();
          goToIndex(idx);
        }
      });
    });

    // Category filter button clicks
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-filter') || 'all';
        filterDeck(cat);
      });
    });

    window.addEventListener('resize', () => {
      updateCards();
    });

    initDots();
    updateCards();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup3DCarousel);
  } else {
    setup3DCarousel();
  }
  document.addEventListener('astro:after-swap', setup3DCarousel);
</script>
