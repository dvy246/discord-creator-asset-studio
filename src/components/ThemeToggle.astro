---
// ThemeToggle.astro - Minimalist tactile slider switch for Light / Dark modes
---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Toggle dark and light theme"
  class="relative inline-flex items-center w-14 h-7 p-0.5 rounded-full cursor-pointer transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3368A0] focus-visible:ring-offset-2 select-none group bg-[#E5E0D5] border border-[#D0C9BD] dark:bg-[#1E2738] dark:border-[#35435C]"
  title="Toggle dark / light theme"
>
  <!-- Background icon hints -->
  <span class="absolute left-1.5 top-1/2 -translate-y-1/2 text-[#9A8F7C] dark:text-[#556782] transition-opacity duration-200 pointer-events-none">
    <!-- Sun icon on left -->
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>

  <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[#9A8F7C] dark:text-[#556782] transition-opacity duration-200 pointer-events-none">
    <!-- Moon icon on right -->
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>

  <!-- Sliding thumb knob -->
  <span
    id="theme-slider-thumb"
    class="relative z-10 flex items-center justify-center w-6 h-6 rounded-full bg-[#FFFFFF] text-[#3368A0] shadow-[0_1px_4px_rgba(0,0,0,0.15)] dark:bg-[#0D131F] dark:text-[#66A3BF] dark:shadow-[0_2px_8px_rgba(0,0,0,0.6)] transform translate-x-0 dark:translate-x-7 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:scale-105"
  >
    <!-- Sun icon inside thumb (visible in light mode) -->
    <svg class="w-3.5 h-3.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>

    <!-- Moon icon inside thumb (visible in dark mode) -->
    <svg class="w-3.5 h-3.5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</button>

<script>
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    function updateAriaState() {
      const isDark = document.documentElement.classList.contains('dark');
      toggleBtn?.setAttribute('aria-checked', isDark ? 'true' : 'false');
    }

    updateAriaState();

    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateAriaState();
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: isDark ? 'dark' : 'light' } }));
    });
  }

  // Run on page load and support any future page swap
  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
