---
interface Props {
  class?: string;
  color?: string;
}

const { class: className = "", color } = Astro.props;
---

<svg
  class={`sketch-circle-svg absolute -inset-x-2 -inset-y-1.5 w-[calc(100%+16px)] h-[calc(100%+12px)] overflow-visible pointer-events-none ${className}`}
  viewBox="0 0 160 60"
  fill="none"
  preserveAspectRatio="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M 16 32 C 12 14, 42 6, 82 7 C 124 8, 152 18, 150 34 C 148 50, 114 56, 74 54 C 36 52, 12 42, 18 24 C 21 16, 38 9, 58 8"
    stroke={color || "currentColor"}
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="sketch-circle-path"
  />
</svg>
