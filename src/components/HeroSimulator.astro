---
// HeroSimulator.astro - High-end interactive Discord asset studio stage with dynamic motion, bespoke vector art & live calibration
---

<div id="heroSimulatorCard" class="card-panel rounded-[18px] p-5 sm:p-6 relative overflow-hidden shadow-2xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24] transition-all duration-300">
  
  <!-- Ambient Floating Verification Chips -->
  <div class="absolute -top-1.5 -right-1.5 sm:top-3 sm:right-4 z-30 pointer-events-none hidden xs:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#192538]/90 dark:bg-[#3368A0]/90 text-white text-[10px] font-mono font-bold shadow-lg backdrop-blur-md border border-white/20 animate-drift-slow">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
    <span>DISCORD-READY STAGE</span>
  </div>

  <!-- Top Bar: Studio Canvas Header -->
  <div class="flex items-center justify-between pb-3.5 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#E0DBD0] dark:bg-[#303E54]"></span>
      <span class="w-3 h-3 rounded-full bg-[#C8DFDB] dark:bg-[#485C7A]"></span>
      <span class="w-3 h-3 rounded-full bg-[#66A3BF] animate-pulse"></span>
      <span class="text-xs font-mono font-semibold text-[#475569] dark:text-[#8494A7] ml-1.5">studio: live-preview-stage</span>
    </div>
    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#0D9488]/10 text-[#0D9488] text-[11px] font-mono font-semibold border border-[#0D9488]/20">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488] animate-ping"></span>
      <span id="simulatorLiveBadge">CALIBRATED // LIVE</span>
    </div>
  </div>

  <!-- Interactive Category Tabs with Auto-Play Progress Fill -->
  <div class="flex items-center gap-1.5 p-1 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] mb-4 overflow-x-auto select-none" id="simulatorTabs">
    <button type="button" data-asset="banner" class="sim-tab relative overflow-hidden flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap bg-[#3368A0] text-white shadow-xs">
      <span class="relative z-10">🖼️ Banner</span>
      <span class="tab-progress absolute bottom-0 left-0 h-[2.5px] bg-emerald-400 w-full transition-all duration-100"></span>
    </button>
    <button type="button" data-asset="avatar" class="sim-tab relative overflow-hidden flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      <span class="relative z-10">👤 Avatar</span>
      <span class="tab-progress absolute bottom-0 left-0 h-[2.5px] bg-emerald-400 w-0 transition-all duration-100"></span>
    </button>
    <button type="button" data-asset="sticker" class="sim-tab relative overflow-hidden flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      <span class="relative z-10">🏷️ Sticker</span>
      <span class="tab-progress absolute bottom-0 left-0 h-[2.5px] bg-emerald-400 w-0 transition-all duration-100"></span>
    </button>
    <button type="button" data-asset="emoji" class="sim-tab relative overflow-hidden flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      <span class="relative z-10">😀 Emoji</span>
      <span class="tab-progress absolute bottom-0 left-0 h-[2.5px] bg-emerald-400 w-0 transition-all duration-100"></span>
    </button>
  </div>

  <!-- Visual Artwork Stage: With Dynamic Motion & Scanner Beam -->
  <div id="stageViewport" class="relative rounded-[14px] p-3 sm:p-4 bg-[#FAF8F5] dark:bg-[#111620] border border-[#E0DBD0] dark:border-[#263346] overflow-hidden mb-4 min-h-[230px] flex flex-col justify-center items-center group">
    
    <!-- Stage 1: Banner Artwork & Discord Server Card Preview -->
    <div id="stage-banner" class="sim-stage stage-active w-full flex flex-col items-center">
      <div class="relative w-full rounded-[12px] bg-[#2B2D31] dark:bg-[#181C26] border border-[#E0DBD0] dark:border-[#2E3C52] overflow-hidden shadow-lg">
        
        <!-- Banner Graphic (16:9 Art-Directed Celestial Sanctuary with Living Cosmic Motion) -->
        <div class="relative w-full aspect-[16/9] max-h-[165px] overflow-hidden">
          
          <!-- Moving Laser Calibration Scanner Line -->
          <div class="laser-scanner pointer-events-none absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-cyan-400 to-transparent shadow-[0_0_10px_#22d3ee] z-20"></div>

          <img
            src="/assets/banners/cyberpunk-ronin-neo-tokyo.webp"
            alt="Neo-Tokyo Ronin Cyberpunk Discord Banner"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />

          <!-- Discord Top 48px Header Safe Zone Overlay -->
          <div class="absolute inset-x-0 top-0 h-8 sm:h-9 bg-black/45 backdrop-blur-[2px] border-b border-white/15 px-3 flex items-center justify-between z-10">
            <span class="text-[9px] font-mono text-emerald-300 font-bold tracking-wider flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              SAFE ZONE VERIFIED (TOP 48PX)
            </span>
            <span class="text-[8px] font-mono text-white/80 font-bold">16:9 • 960×540</span>
          </div>
        </div>

        <!-- Discord Server Card Bottom Info Bar -->
        <div class="p-2.5 sm:p-3 flex items-center justify-between bg-[#232428] text-white">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-[#5865F2] to-[#3368A0] border border-white/30 flex items-center justify-center text-xs font-bold shadow-xs anim-pulse-subtle overflow-hidden">
              <img src="/assets/pfps/cyberpunk-ronin-neo-tokyo.webp" alt="Neo-Tokyo Server Icon" class="w-full h-full object-cover" />
            </div>
            <div>
              <div class="text-xs font-bold leading-none flex items-center gap-1.5">
                <span>NEO-TOKYO SANCTUARY</span>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-[#5865F2] text-white font-mono">VERIFIED</span>
              </div>
              <div class="text-[10px] text-[#949BA4] mt-0.5">18,420 Members • Level 3 Boosted</div>
            </div>
          </div>
          <span class="text-[10px] font-semibold text-[#0D9488] bg-[#0D9488]/15 px-2.5 py-0.5 rounded-full border border-[#0D9488]/30 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488] animate-pulse"></span>
            Discord Ready
          </span>
        </div>
      </div>
    </div>

    <!-- Stage 2: Avatar Artwork & Profile Popout Preview with Floating Motion -->
    <div id="stage-avatar" class="sim-stage hidden w-full flex flex-col items-center">
      <div class="w-full max-w-[320px] rounded-[14px] bg-[#232428] border border-[#35373C] p-4 text-white shadow-xl">
        <div class="flex items-center gap-3.5">
          <!-- Circular Avatar with Online Ring & Living Float Physics -->
          <div class="relative w-16 h-16 rounded-full overflow-hidden border-2 border-[#5865F2] flex-shrink-0 shadow-lg anim-avatar-float">
            <img
              src="/assets/pfps/cyberpunk-ronin-neo-tokyo.webp"
              alt="Cyber Ronin Oni Avatar"
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
            
            <!-- Discord Online Status Pill Badge with Live Ping -->
            <div class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-[#23A55A] border-2 border-[#232428] flex items-center justify-center">
              <span class="w-1.5 h-1.5 rounded-full bg-white opacity-80 animate-ping"></span>
            </div>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-bold text-white truncate">Kaelen</span>
              <span class="px-1.5 py-0.2 bg-[#5865F2] text-white text-[9px] font-bold rounded">CREATOR</span>
            </div>
            <div class="text-[11px] text-[#949BA4] truncate">@kaelen_design</div>
            <div class="text-[11px] text-[#D1D5DB] mt-1 flex items-center gap-1.5">
              <span class="inline-flex items-center gap-0.5">
                <span class="w-1 h-2.5 bg-emerald-400 rounded-full animate-pulse"></span>
                <span class="w-1 h-3.5 bg-emerald-400 rounded-full animate-pulse [animation-delay:150ms]"></span>
                <span class="w-1 h-2 bg-emerald-400 rounded-full animate-pulse [animation-delay:300ms]"></span>
              </span>
              <span class="truncate text-[10px] text-emerald-300 font-mono">crafting Discord visuals</span>
            </div>
          </div>
        </div>

        <div class="mt-3 pt-2.5 border-t border-[#35373C] flex items-center justify-between text-[10px] font-mono text-[#949BA4]">
          <span>512×512 Master Canvas</span>
          <span class="text-emerald-400 font-bold flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            Circle Mask Safe
          </span>
        </div>
      </div>
    </div>

    <!-- Stage 3: Sticker Artwork with Zero-Gravity Floating & Iridescent Sway -->
    <div id="stage-sticker" class="sim-stage hidden w-full flex flex-col items-center justify-center">
      <div class="relative py-1 flex flex-col items-center">
        
        <!-- Die-Cut Vinyl Sticker with Floating Physics -->
        <div class="w-32 h-32 relative anim-sticker-float flex items-center justify-center">
          <div class="relative w-28 h-28 p-1.5 bg-white rounded-3xl shadow-[0_16px_32px_rgba(0,0,0,0.4)] ring-4 ring-white/90">
            <img
              src="/assets/pfps/totoro-forest-belly-nap-animated.webp"
              alt="Totoro Forest Belly Nap Animated Discord Sticker"
              class="w-full h-full object-cover rounded-2xl"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="mt-2.5 flex items-center gap-2">
          <span class="text-[11px] font-mono font-bold text-[#192538] dark:text-[#E0E6ED] bg-white dark:bg-[#1B2330] px-2.5 py-0.5 rounded-full border border-[#E0DBD0] dark:border-[#263346] shadow-xs">
            Exact 320 × 320 px
          </span>
          <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            Lossless APNG
          </span>
        </div>
      </div>
    </div>

    <!-- Stage 4: Emoji Artwork with Facet Glint & Live Discord Message Bubble -->
    <div id="stage-emoji" class="sim-stage hidden w-full flex flex-col items-center">
      <div class="w-full flex flex-col sm:flex-row items-center justify-center gap-4">
        
        <!-- Left: 128x128 HD Master View with Floating Gemstone -->
        <div class="flex flex-col items-center">
          <div class="w-20 h-20 rounded-[12px] p-2 bg-[#FFFFFF] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] shadow-md flex items-center justify-center bg-[repeating-conic-gradient(#FAF8F5_0%_25%,#FFFFFF_0%_50%)] dark:bg-[repeating-conic-gradient(#141A24_0%_25%,#1B2330_0%_50%)] [background-size:12px_12px]">
            <div class="w-full h-full anim-gem-float flex items-center justify-center">
              <img
                src="/assets/pfps/pop-cat-animated.webp"
                alt="Pop Cat Animated Discord Emoji Master"
                class="w-full h-full object-contain"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
          <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7] mt-1 font-semibold">128×128 HD Master</span>
        </div>

        <!-- Right: Discord 32x32 Live Chat Message Bubble with Reactive Reaction Badge -->
        <div class="flex-1 max-w-[260px] bg-[#313338] text-white p-3 rounded-[10px] border border-black/25 shadow-md">
          <div class="flex items-start gap-2.5">
            <div class="w-7 h-7 rounded-full bg-[#5865F2] flex items-center justify-center text-[10px] font-bold shadow-xs">
              V
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-1.5">
                <span class="text-[11px] font-bold text-white">Vesper</span>
                <span class="text-[9px] text-[#949BA4]">Today at 4:18 PM</span>
              </div>
              
              <div class="flex items-center gap-2 mt-1">
                <span class="text-xs text-[#DBDEE1]">new nitro emote:</span>
                <!-- 32x32 Chat Rendered Size -->
                <div class="w-7 h-7 inline-block flex-shrink-0">
                  <img
                    src="/assets/pfps/pop-cat-animated.webp"
                    alt="Pop Cat in chat"
                    class="w-full h-full object-contain"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>

              <!-- Animated Reaction Pill -->
              <div class="mt-2 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[6px] bg-[#2B2D31] border border-[#5865F2]/50 text-white text-[10px] font-bold">
                <span class="w-4 h-4 inline-block">
                  <img
                    src="/assets/pfps/pop-cat-animated.webp"
                    alt="Pop Cat reaction"
                    class="w-full h-full object-contain"
                    loading="eager"
                    decoding="async"
                  />
                </span>
                <span class="text-[#58E1FF]">24</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Consolidated Studio Calibration & Verification Bar -->
  <div class="p-2.5 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] flex items-center justify-between text-xs font-mono mb-4">
    <div class="flex items-center gap-2 truncate">
      <span class="w-2 h-2 rounded-full bg-[#3368A0] dark:bg-[#66A3BF] flex-shrink-0"></span>
      <span id="simSpecText" class="font-bold text-[#192538] dark:text-[#F0F4F8] truncate">960 × 540 (16:9) • Top 48px Cleared</span>
    </div>
    <span id="simStatusBadge" class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 flex items-center gap-1 flex-shrink-0 ml-2">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
      VERIFIED READY
    </span>
  </div>

  <!-- Action CTAs -->
  <div class="grid grid-cols-2 gap-2.5">
    <button
      id="simInspectBtn"
      type="button"
      class="btn-secondary py-2.5 px-3 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1.5 transition-all active:scale-95"
    >
      <svg class="w-3.5 h-3.5 text-[#3368A0] dark:text-[#66A3BF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
      <span>Inspect Stage</span>
    </button>

    <a
      id="launchToolBtn"
      href="/tools/banner/"
      class="btn-primary py-2.5 px-3 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 text-center active:scale-95 transition-transform"
    >
      <span id="launchBtnText">Open Banner Studio</span>
      <span>→</span>
    </a>
  </div>
</div>

<style>
  /* Continuous Laser Scanner Sweep across Banner */
  @keyframes scanlineMove {
    0% {
      top: 0%;
      opacity: 0;
    }
    15% {
      opacity: 0.95;
    }
    85% {
      opacity: 0.95;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .laser-scanner {
    animation: scanlineMove 3.5s ease-in-out infinite;
  }

  /* Twinkling Star Animations */
  @keyframes starTwinkleA {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.3); }
  }
  @keyframes starTwinkleB {
    0%, 100% { opacity: 0.9; transform: scale(1.2); }
    50% { opacity: 0.2; transform: scale(0.7); }
  }
  @keyframes starTwinkleC {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.95; }
  }

  .anim-twinkle-1 {
    animation: starTwinkleA 2.6s ease-in-out infinite;
  }
  .anim-twinkle-2 {
    animation: starTwinkleB 3.4s ease-in-out infinite 0.7s;
  }
  .anim-twinkle-3 {
    animation: starTwinkleC 4s ease-in-out infinite 1.4s;
  }

  /* Shooting Star Sweep */
  @keyframes cometFly {
    0% {
      transform: translate(-60px, -40px) scale(0.2);
      opacity: 0;
    }
    15% {
      opacity: 1;
      transform: translate(0px, 0px) scale(1);
    }
    35% {
      transform: translate(220px, 140px) scale(0.3);
      opacity: 0;
    }
    100% {
      transform: translate(220px, 140px) scale(0);
      opacity: 0;
    }
  }

  .anim-shooting-star {
    animation: cometFly 7s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }

  /* Celestial Glow Pulse */
  @keyframes pulseSlow {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.04); opacity: 1; }
  }
  .anim-pulse-slow {
    transform-origin: 480px 180px;
    animation: pulseSlow 5s ease-in-out infinite;
  }

  .anim-pulse-fast {
    animation: pulseSlow 2s ease-in-out infinite;
  }

  .anim-pulse-subtle {
    animation: pulseSlow 3s ease-in-out infinite;
  }

  /* Avatar Floating Physics */
  @keyframes avatarFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(1deg);
    }
  }
  .anim-avatar-float {
    animation: avatarFloat 4.2s ease-in-out infinite;
  }

  /* Visor Holographic Sweep */
  @keyframes visorSweepAnim {
    0%, 25% {
      transform: translateX(-40px);
      opacity: 0;
    }
    45% {
      opacity: 0.8;
    }
    70%, 100% {
      transform: translateX(120px);
      opacity: 0;
    }
  }
  .anim-visor-sweep {
    animation: visorSweepAnim 3.8s ease-in-out infinite;
  }

  /* Sticker Zero-Gravity Floating & Sway */
  @keyframes stickerFloatAnim {
    0%, 100% {
      transform: translateY(0px) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-8px) rotate(2.5deg);
    }
  }
  .anim-sticker-float {
    animation: stickerFloatAnim 3.6s ease-in-out infinite;
  }

  /* Gemstone Float & Bob */
  @keyframes gemFloatAnim {
    0%, 100% {
      transform: translateY(0px) scale(1);
    }
    50% {
      transform: translateY(-5px) scale(1.05);
    }
  }
  .anim-gem-float {
    animation: gemFloatAnim 3s ease-in-out infinite;
  }

  /* Ambient Floating Badge Drift */
  @keyframes driftSlow {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-4px);
    }
  }
  .anim-drift-slow {
    animation: driftSlow 4s ease-in-out infinite;
  }

  /* Smooth Stage Transition (Slide In From Right & Fade) */
  @keyframes stageEnter {
    0% {
      opacity: 0;
      transform: translateX(20px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateX(0px) scale(1);
    }
  }

  .stage-active {
    animation: stageEnter 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  interface StudioSpec {
    formatName: string;
    specs: string;
    toolUrl: string;
    buttonLabel: string;
  }

  const STUDIO_SPECS: Record<string, StudioSpec> = {
    banner: {
      formatName: '16:9 Discord Server Banner',
      specs: '960 × 540 (16:9) • Top 48px Cleared',
      toolUrl: '/tools/banner/',
      buttonLabel: 'Open Banner Studio'
    },
    avatar: {
      formatName: 'Square Avatar Master',
      specs: '512 × 512 (1:1) • Circle Mask Safe',
      toolUrl: '/tools/avatar/',
      buttonLabel: 'Open Avatar Studio'
    },
    sticker: {
      formatName: 'Custom Server Sticker',
      specs: '320 × 320 • Lossless APNG Ready',
      toolUrl: '/tools/sticker/',
      buttonLabel: 'Open Sticker Studio'
    },
    emoji: {
      formatName: 'Custom Server Emoji',
      specs: '128 × 128 • 32px Chat Tested',
      toolUrl: '/tools/emoji/',
      buttonLabel: 'Open Emoji Studio'
    }
  };

  const ASSET_KEYS = ['banner', 'avatar', 'sticker', 'emoji'];

  function setupHeroSimulator() {
    const card = document.getElementById('heroSimulatorCard');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.sim-tab');
    const formatTextEl = document.getElementById('simFormatText');
    const specTextEl = document.getElementById('simSpecText');
    const launchBtn = document.getElementById('launchToolBtn') as HTMLAnchorElement | null;
    const launchBtnText = document.getElementById('launchBtnText');
    const resultTextEl = document.getElementById('simResultText');
    const inspectBtn = document.getElementById('simInspectBtn');
    const liveBadge = document.getElementById('simulatorLiveBadge');

    let currentAssetIndex = 0;
    let isPaused = false;
    let cycleTimer: ReturnType<typeof setInterval> | null = null;
    let progressTimer: ReturnType<typeof setInterval> | null = null;
    let progressStep = 0;
    const DURATION_MS = 4000;
    const TICK_MS = 50;

    function setAsset(assetKey: string, triggerAnimation = true) {
      const spec = STUDIO_SPECS[assetKey];
      if (!spec) return;

      currentAssetIndex = ASSET_KEYS.indexOf(assetKey);

      // Update active tab styling & reset progress bars
      tabs.forEach(tab => {
        const key = tab.getAttribute('data-asset');
        const isSelected = key === assetKey;
        const progressEl = tab.querySelector<HTMLElement>('.tab-progress');

        if (isSelected) {
          tab.classList.add('bg-[#3368A0]', 'text-white', 'shadow-xs');
          tab.classList.remove('text-[#475569]', 'dark:text-[#CBD5E1]');
          if (progressEl) progressEl.style.width = '100%';
        } else {
          tab.classList.remove('bg-[#3368A0]', 'text-white', 'shadow-xs');
          tab.classList.add('text-[#475569]', 'dark:text-[#CBD5E1]');
          if (progressEl) progressEl.style.width = '0%';
        }
      });

      // Update stage visibility with slide transition
      document.querySelectorAll('.sim-stage').forEach(el => {
        el.classList.add('hidden');
        el.classList.remove('stage-active');
      });

      const targetStage = document.getElementById(`stage-${assetKey}`);
      if (targetStage) {
        targetStage.classList.remove('hidden');
        if (triggerAnimation) {
          void targetStage.offsetWidth; // Trigger reflow for animation restart
          targetStage.classList.add('stage-active');
        }
      }

      // Update specs
      if (formatTextEl) formatTextEl.textContent = spec.formatName;
      if (specTextEl) specTextEl.textContent = spec.specs;
      if (launchBtn) launchBtn.href = spec.toolUrl;
      if (launchBtnText) launchBtnText.textContent = spec.buttonLabel;
      if (resultTextEl) resultTextEl.textContent = `Calibrated for Discord ${spec.formatName}`;
    }

    function advanceToNext() {
      if (isPaused) return;
      currentAssetIndex = (currentAssetIndex + 1) % ASSET_KEYS.length;
      setAsset(ASSET_KEYS[currentAssetIndex]);
      resetProgress();
    }

    function resetProgress() {
      progressStep = 0;
      const activeTab = tabs[currentAssetIndex];
      const progressEl = activeTab?.querySelector<HTMLElement>('.tab-progress');
      if (progressEl) progressEl.style.width = '0%';
    }

    function startAutoCycle() {
      stopAutoCycle();
      progressTimer = setInterval(() => {
        if (!isPaused) {
          progressStep += (TICK_MS / DURATION_MS) * 100;
          const activeTab = tabs[currentAssetIndex];
          const progressEl = activeTab?.querySelector<HTMLElement>('.tab-progress');
          if (progressEl) {
            progressEl.style.width = `${Math.min(100, progressStep)}%`;
          }
          if (progressStep >= 100) {
            advanceToNext();
          }
        }
      }, TICK_MS);
    }

    function stopAutoCycle() {
      if (progressTimer) clearInterval(progressTimer);
      if (cycleTimer) clearInterval(cycleTimer);
    }

    // Tab click handlers
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-asset');
        if (key) {
          setAsset(key);
          resetProgress();
        }
      });
    });

    // Pause on mouse enter, resume on mouse leave
    card?.addEventListener('mouseenter', () => {
      isPaused = true;
      if (liveBadge) liveBadge.textContent = 'PAUSED // INSPECTING';
    });

    card?.addEventListener('mouseleave', () => {
      isPaused = false;
      if (liveBadge) liveBadge.textContent = 'CALIBRATED // LIVE';
    });

    // Inspect button triggers an active scan pulse
    inspectBtn?.addEventListener('click', () => {
      if (resultTextEl) {
        resultTextEl.textContent = 'Scanning Discord display layers... Pixel-perfect!';
        const scanner = document.querySelector<HTMLElement>('.laser-scanner');
        if (scanner) {
          scanner.style.animation = 'none';
          void scanner.offsetWidth;
          scanner.style.animation = 'scanlineMove 1.5s ease-in-out 2';
        }
        setTimeout(() => {
          const spec = STUDIO_SPECS[ASSET_KEYS[currentAssetIndex]];
          if (resultTextEl && spec) resultTextEl.textContent = `Calibrated for Discord ${spec.formatName}`;
        }, 2200);
      }
    });

    // Initialize
    setAsset('banner', false);
    startAutoCycle();
  }

  setupHeroSimulator();
  document.addEventListener('astro:after-swap', setupHeroSimulator);
</script>
