---
// HeroSimulator.astro - Interactive, animated live asset verification simulator for the hero section
---

<div class="card-panel rounded-[18px] p-5 sm:p-6 relative overflow-hidden shadow-xl border border-[#E0DBD0] dark:border-[#263346] bg-[#FFFFFF] dark:bg-[#141A24]">
  <!-- Top Bar: Window Controls & Engine Status -->
  <div class="flex items-center justify-between pb-4 border-b border-[#E0DBD0] dark:border-[#263346] mb-4">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#E0DBD0] dark:bg-[#303E54]"></span>
      <span class="w-3 h-3 rounded-full bg-[#C8DFDB] dark:bg-[#485C7A]"></span>
      <span class="w-3 h-3 rounded-full bg-[#66A3BF]"></span>
      <span class="text-xs font-mono font-semibold text-[#475569] dark:text-[#8494A7] ml-1.5">engine: client-validator</span>
    </div>
    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#0D9488]/10 text-[#0D9488] text-[11px] font-mono font-semibold border border-[#0D9488]/20">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488] animate-ping"></span>
      <span>READY</span>
    </div>
  </div>

  <!-- Interactive Category Tabs -->
  <div class="flex items-center gap-1.5 p-1 rounded-[10px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] mb-4 overflow-x-auto select-none" id="simulatorTabs">
    <button type="button" data-asset="emoji" class="sim-tab flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap bg-[#3368A0] text-white shadow-xs">
      😀 Emoji
    </button>
    <button type="button" data-asset="sticker" class="sim-tab flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      🏷️ Sticker
    </button>
    <button type="button" data-asset="banner" class="sim-tab flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      🖼️ Banner
    </button>
    <button type="button" data-asset="avatar" class="sim-tab flex-1 py-1.5 px-2.5 rounded-[8px] text-xs font-bold transition-all text-center whitespace-nowrap text-[#475569] dark:text-[#CBD5E1] hover:text-[#192538] dark:hover:text-white">
      👤 Avatar
    </button>
  </div>

  <!-- Visual Mockup & Scanning Stage -->
  <div class="relative rounded-[12px] p-4 bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346] overflow-hidden mb-4 min-h-[140px] flex flex-col justify-center items-center group">
    <!-- Animated Scanning Laser Line -->
    <div id="scanLaser" class="absolute inset-x-0 h-0.5 bg-gradient-to-r from-transparent via-[#66A3BF] to-transparent opacity-0 pointer-events-none z-20 transition-opacity"></div>

    <!-- Live Preview Surface Switcher -->
    <div id="simPreviewStage" class="w-full flex items-center justify-center py-2 transition-all duration-300">
      <!-- Emoji Stage Preview -->
      <div id="stage-emoji" class="sim-stage flex items-center gap-3 bg-[#FFFFFF] dark:bg-[#141A24] px-4 py-3 rounded-[10px] border border-[#E0DBD0] dark:border-[#263346] shadow-xs">
        <div class="w-8 h-8 rounded-full bg-[#5865F2] flex items-center justify-center text-white text-[11px] font-bold">U</div>
        <div class="text-xs">
          <span class="font-semibold text-[#192538] dark:text-white">Pixel Art:</span>
          <span class="inline-block ml-1 text-lg leading-none animate-bounce">⚡</span>
        </div>
        <span class="text-[10px] font-mono text-[#6B7A90] ml-2 bg-[#FAF8F5] dark:bg-[#1B2330] px-2 py-0.5 rounded border border-[#E0DBD0] dark:border-[#263346]">32×32 chat</span>
      </div>

      <!-- Sticker Stage Preview -->
      <div id="stage-sticker" class="sim-stage hidden flex-col items-center gap-2">
        <div class="w-16 h-16 rounded-[10px] bg-[#FFFFFF] dark:bg-[#141A24] border-2 border-dashed border-[#66A3BF] flex items-center justify-center text-2xl shadow-xs">
          🚀
        </div>
        <span class="text-[10px] font-mono text-[#6B7A90] bg-[#FAF8F5] dark:bg-[#1B2330] px-2 py-0.5 rounded border border-[#E0DBD0] dark:border-[#263346]">Exact 320×320 px</span>
      </div>

      <!-- Banner Stage Preview -->
      <div id="stage-banner" class="sim-stage hidden w-full max-w-[260px] flex-col items-center">
        <div class="w-full h-14 rounded-[8px] bg-gradient-to-r from-[#3368A0] to-[#66A3BF] relative overflow-hidden shadow-xs">
          <!-- 48px safe zone indicator -->
          <div class="absolute inset-x-0 top-0 h-4 bg-red-500/30 border-b border-red-500/50 flex items-center justify-center">
            <span class="text-[8px] font-mono font-bold text-white uppercase tracking-wider">Top 48px Header Occlusion</span>
          </div>
        </div>
        <span class="text-[10px] font-mono text-[#6B7A90] mt-1.5">16:9 Aspect Ratio (960×540 min)</span>
      </div>

      <!-- Avatar Stage Preview -->
      <div id="stage-avatar" class="sim-stage hidden flex items-center gap-4">
        <div class="relative w-14 h-14 rounded-full overflow-hidden border-2 border-[#3368A0] shadow-sm bg-gradient-to-br from-[#66A3BF] to-[#3368A0] flex items-center justify-center text-xl text-white">
          👾
        </div>
        <span class="text-[10px] font-mono text-[#6B7A90] bg-[#FAF8F5] dark:bg-[#1B2330] px-2 py-0.5 rounded border border-[#E0DBD0] dark:border-[#263346]">512×512 Circle Crop</span>
      </div>
    </div>
  </div>

  <!-- Dynamic Specification Rows -->
  <div class="space-y-2.5 text-xs font-mono mb-4">
    <div class="flex items-center justify-between p-2.5 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
      <span class="text-[#6B7A90] dark:text-[#8494A7]">Target Rule:</span>
      <span id="simTargetName" class="text-[#192538] dark:text-[#F0F4F8] font-bold">Custom Emoji (128x128)</span>
    </div>

    <div class="flex items-center justify-between p-2.5 rounded-[8px] bg-[#FAF8F5] dark:bg-[#1B2330] border border-[#E0DBD0] dark:border-[#263346]">
      <span class="text-[#6B7A90] dark:text-[#8494A7]">Binary Limit:</span>
      <span id="simByteCap" class="text-[#0D9488] font-bold">256 KiB (262,144 bytes)</span>
    </div>

    <!-- Real-time Verification Result Feedback Banner -->
    <div id="simResultBox" class="p-2.5 rounded-[8px] bg-[#C8DFDB]/30 dark:bg-[#1F2E45] border border-[#66A3BF]/30 text-[#192538] dark:text-[#CBD5E1] text-[11px] flex items-center justify-between transition-colors">
      <span id="simResultText" class="font-medium">Status: Awaiting media simulation</span>
      <span id="simStatusBadge" class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-[#FAF8F5] dark:bg-[#141A24] text-[#3368A0] dark:text-[#66A3BF] border border-[#E0DBD0] dark:border-[#263346]">STANDBY</span>
    </div>
  </div>

  <!-- Interactive Action Buttons -->
  <div class="grid grid-cols-2 gap-2.5">
    <button
      id="runSimScanBtn"
      type="button"
      class="btn-secondary py-2.5 px-3 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1.5 transition-all"
    >
      <svg class="w-3.5 h-3.5 text-[#3368A0] dark:text-[#66A3BF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Simulate Scan</span>
    </button>

    <a
      id="launchToolBtn"
      href="/tools/emoji"
      class="btn-primary py-2.5 px-3 rounded-[8px] text-xs font-semibold flex items-center justify-center gap-1 text-center"
    >
      <span>Launch Studio</span>
      <span>→</span>
    </a>
  </div>
</div>

<style>
  @keyframes scanLaserAnim {
    0% { top: 0%; opacity: 0.8; }
    50% { top: 100%; opacity: 1; }
    100% { top: 0%; opacity: 0.8; }
  }
  .animate-scan {
    animation: scanLaserAnim 1.2s ease-in-out infinite;
  }
</style>

<script>
  interface AssetSpec {
    name: string;
    targetName: string;
    byteCap: string;
    toolUrl: string;
    simBytes: string;
    ruleId: string;
  }

  const ASSET_SPECS: Record<string, AssetSpec> = {
    emoji: {
      name: 'Custom Emoji',
      targetName: 'Custom Emoji (128x128)',
      byteCap: '256 KiB (262,144 bytes)',
      toolUrl: '/tools/emoji',
      simBytes: '248.4 KiB',
      ruleId: 'DISCORD-EMOJI-STATIC-01'
    },
    sticker: {
      name: 'Server Sticker',
      targetName: 'Custom Sticker (320x320)',
      byteCap: '512 KiB (524,288 bytes)',
      toolUrl: '/tools/sticker',
      simBytes: '482.1 KiB',
      ruleId: 'DISCORD-STICKER-STATIC-01'
    },
    banner: {
      name: 'Server & Profile Banner',
      targetName: 'Server Banner (960x540)',
      byteCap: '10.0 MB (Safe Zone: 48px)',
      toolUrl: '/tools/banner',
      simBytes: '2.4 MB',
      ruleId: 'DISCORD-BANNER-SERVER-01'
    },
    avatar: {
      name: 'User Avatar',
      targetName: 'Authoring Canvas (512x512)',
      byteCap: '8.0 MB (Circle Mask)',
      toolUrl: '/tools/avatar',
      simBytes: '840.2 KiB',
      ruleId: 'DISCORD-AVATAR-STATIC-01'
    }
  };

  function setupHeroSimulator() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.sim-tab');
    const targetNameEl = document.getElementById('simTargetName');
    const byteCapEl = document.getElementById('simByteCap');
    const launchBtn = document.getElementById('launchToolBtn') as HTMLAnchorElement | null;
    const resultTextEl = document.getElementById('simResultText');
    const statusBadgeEl = document.getElementById('simStatusBadge');
    const scanBtn = document.getElementById('runSimScanBtn');
    const scanLaser = document.getElementById('scanLaser');

    let currentAsset = 'emoji';

    function setAsset(assetKey: string) {
      currentAsset = assetKey;
      const spec = ASSET_SPECS[assetKey];
      if (!spec) return;

      // Update active tab styles
      tabs.forEach(tab => {
        const isSelected = tab.getAttribute('data-asset') === assetKey;
        if (isSelected) {
          tab.classList.add('bg-[#3368A0]', 'text-white', 'shadow-xs');
          tab.classList.remove('text-[#475569]', 'dark:text-[#CBD5E1]');
        } else {
          tab.classList.remove('bg-[#3368A0]', 'text-white', 'shadow-xs');
          tab.classList.add('text-[#475569]', 'dark:text-[#CBD5E1]');
        }
      });

      // Update stage visibility
      document.querySelectorAll('.sim-stage').forEach(el => {
        el.classList.add('hidden');
      });
      const targetStage = document.getElementById(`stage-${assetKey}`);
      targetStage?.classList.remove('hidden');

      // Update text fields
      if (targetNameEl) targetNameEl.textContent = spec.targetName;
      if (byteCapEl) byteCapEl.textContent = spec.byteCap;
      if (launchBtn) launchBtn.href = spec.toolUrl;

      // Reset result box
      if (resultTextEl) resultTextEl.textContent = `Target: ${spec.name} • Ready for test`;
      if (statusBadgeEl) {
        statusBadgeEl.textContent = 'STANDBY';
        statusBadgeEl.className = 'text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-[#FAF8F5] dark:bg-[#141A24] text-[#3368A0] dark:text-[#66A3BF] border border-[#E0DBD0] dark:border-[#263346]';
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-asset');
        if (key) setAsset(key);
      });
    });

    // Run verification scan simulation
    scanBtn?.addEventListener('click', () => {
      const spec = ASSET_SPECS[currentAsset];
      if (!spec) return;

      // Start laser animation
      scanLaser?.classList.remove('opacity-0');
      scanLaser?.classList.add('animate-scan');

      if (resultTextEl) resultTextEl.textContent = 'Calculating byte checksum & dimensions...';
      if (statusBadgeEl) {
        statusBadgeEl.textContent = 'ANALYZING';
        statusBadgeEl.className = 'text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30';
      }

      setTimeout(() => {
        scanLaser?.classList.add('opacity-0');
        scanLaser?.classList.remove('animate-scan');

        if (resultTextEl) {
          resultTextEl.innerHTML = `<span class="text-[#0D9488] font-bold">✓ VERIFIED PASS:</span> Measured ${spec.simBytes} (under ${spec.byteCap.split(' ')[0]} cap)`;
        }
        if (statusBadgeEl) {
          statusBadgeEl.textContent = 'COMPLIANT';
          statusBadgeEl.className = 'text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-[#0D9488]/15 text-[#0D9488] border border-[#0D9488]/30';
        }
      }, 700);
    });
  }

  setupHeroSimulator();
  document.addEventListener('astro:after-swap', setupHeroSimulator);
</script>
