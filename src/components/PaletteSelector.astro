---
// PaletteSelector.astro - Tactile Color Palette Selector with live swatches and persistent selection
---

<div class="relative inline-block text-left" id="palette-selector-root">
  <!-- Trigger Button -->
  <button
    id="palette-dropdown-btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Select color palette"
    class="header-nav-btn relative inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-[#E0DBD0] dark:border-[#263346] bg-white/70 dark:bg-[#161F2E]/70 backdrop-blur-xs text-[#192538] dark:text-[#CBD5E1] text-xs font-semibold shadow-[0_1px_2px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)] hover:border-[#3368A0] dark:hover:border-[#66A3BF] hover:bg-white dark:hover:bg-[#1E2738] hover:-translate-y-0.5 hover:shadow-xs transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3368A0]"
    title="Choose site color theme"
  >
    <!-- Palette Art Icon -->
    <svg class="w-4 h-4 text-[#3368A0] dark:text-[#66A3BF] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
      <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
      <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
      <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
      <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
    </svg>

    <!-- Active Palette Dot Preview (4 dots) -->
    <div id="active-palette-preview" class="flex items-center -space-x-1">
      <span class="w-2.5 h-2.5 rounded-full border border-white/80 shadow-2xs preview-dot-0 bg-[#FF84BA]"></span>
      <span class="w-2.5 h-2.5 rounded-full border border-white/80 shadow-2xs preview-dot-1 bg-[#FFDF82]"></span>
      <span class="w-2.5 h-2.5 rounded-full border border-white/80 shadow-2xs preview-dot-2 bg-[#99C2FF]"></span>
      <span class="w-2.5 h-2.5 rounded-full border border-white/80 shadow-2xs preview-dot-3 bg-[#FFEFE3]"></span>
    </div>

    <!-- Dropdown Chevron -->
    <svg class="w-3.5 h-3.5 text-[#6B7A90] dark:text-[#8494A7] transition-transform duration-200" id="palette-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Popover Panel -->
  <div
    id="palette-dropdown-menu"
    class="hidden absolute right-0 mt-2 w-76 max-h-[80vh] overflow-y-auto rounded-xl bg-white dark:bg-[#141A24] border border-[#E0DBD0] dark:border-[#263346] shadow-xl p-2 z-50 transform origin-top-right transition-all duration-150 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="palette-dropdown-btn"
  >
    <div class="sticky top-0 bg-white/95 dark:bg-[#141A24]/95 backdrop-blur-xs px-3 py-2 border-b border-[#E0DBD0]/60 dark:border-[#263346] mb-1.5 flex items-center justify-between z-10">
      <span class="text-xs font-bold uppercase tracking-wider text-[#192538] dark:text-[#CBD5E1]">Color Palettes</span>
      <span class="text-[10px] text-[#6B7A90] dark:text-[#8494A7] font-medium">13 Curated Themes</span>
    </div>

    <div class="space-y-1" id="palette-options-list">
      <!-- Default Studio -->
      <button
        type="button"
        data-palette="default"
        class="palette-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] transition-colors cursor-pointer group"
        role="menuitem"
      >
        <div class="flex items-center gap-2.5">
          <div class="flex items-center -space-x-1 shrink-0">
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #3368A0;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #66A3BF;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #C8DFDB;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #F2EFE7;"></span>
          </div>
          <span class="palette-label font-semibold text-[#192538] dark:text-[#F0F4F8]">Classic Studio</span>
        </div>
        <svg class="check-icon w-4 h-4 text-[#3368A0] dark:text-[#66A3BF] hidden shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>

      <!-- Palette 1: Burgundy Bloom -->
      <button
        type="button"
        data-palette="burgundy"
        class="palette-option-btn w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium hover:bg-[#FAF8F5] dark:hover:bg-[#1E2738] transition-colors cursor-pointer group"
        role="menuitem"
      >
        <div class="flex items-center gap-2.5">
          <div class="flex items-center -space-x-1 shrink-0">
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #800020;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #D45060;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #F3E6D5;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #FFF9F2;"></span>
