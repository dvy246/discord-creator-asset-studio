            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #8BDFDD;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #F48F68;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #FFE394;"></span>
          </div>
          <span class="palette-label font-semibold text-[#192538] dark:text-[#F0F4F8]">Coastal Sunshine</span>
