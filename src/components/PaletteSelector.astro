        </div>
        <svg class="check-icon w-4 h-4 text-[#F2BED1] dark:text-[#FDCEDF] hidden shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>

      <!-- Palette 9: Gothic Mahogany -->
      <button
        type="button"
        data-palette="mahogany"
