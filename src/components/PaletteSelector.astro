          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const PALETTE_DEFINITIONS: Record<string, string[]> = {
    default: ['#3368A0', '#66A3BF', '#C8DFDB', '#F2EFE7'],
    burgundy: ['#800020', '#D45060', '#F3E6D5', '#FFF9F2'],
    pastel: ['#FDF4D2', '#B0CDE6', '#A290B7', '#946D6D'],
    terracotta: ['#315B8C', '#F2765E', '#F5EBDD', '#413333'],
    crimson: ['#C62828', '#FF8F00', '#FBC02D', '#F5F5DC'],
    blush: ['#E2B4BD', '#F7D6D0', '#FFF5F5', '#4A4A4A'],
    mint: ['#BADFDB', '#FFA4A4', '#FFBDBD', '#FCF9EA'],
    retropop: ['#F599C6', '#FFEA88', '#7DCCAD', '#4D6787'],
    cottoncandy: ['#F9F5F6', '#F8E8EE', '#FDCEDF', '#F2BED1'],
    mahogany: ['#6D0808', '#2D0000', '#757D6F', '#EEEAD7'],
    gelato: ['#FF9D9D', '#FFC5AA', '#EEF8CD', '#BBF1D2'],
    electric: ['#FF84BA', '#FFDF82', '#99C2FF', '#FFEFE3'],
    coastal: ['#FFF6DE', '#8BDFDD', '#F48F68', '#FFE394'],
  };

  function setupPaletteSelector() {
    const dropdownBtn = document.getElementById('palette-dropdown-btn');
    const dropdownMenu = document.getElementById('palette-dropdown-menu');
    const chevron = document.getElementById('palette-chevron');
    const optionBtns = document.querySelectorAll('.palette-option-btn');

    if (!dropdownBtn || !dropdownMenu) return;

    function getActivePalette() {
      return document.documentElement.getAttribute('data-palette') || (localStorage.getItem('site-palette') === 'default' ? 'default' : 'electric');
    }

    function updateActiveUI(activePalette: string) {
      // Update checkmarks and active highlights in dropdown
      optionBtns.forEach(btn => {
        const p = btn.getAttribute('data-palette');
        const checkIcon = btn.querySelector('.check-icon');
        const isMatch = p === activePalette;
        if (checkIcon) {
          if (isMatch) {
            checkIcon.classList.remove('hidden');
            btn.classList.add('bg-[#FAF8F5]', 'dark:bg-[#1E2738]', 'font-bold');
          } else {
            checkIcon.classList.add('hidden');
            btn.classList.remove('bg-[#FAF8F5]', 'dark:bg-[#1E2738]', 'font-bold');
          }
        }
      });

      // Update the 4 preview dots in trigger button
      const colors = PALETTE_DEFINITIONS[activePalette] || PALETTE_DEFINITIONS['electric'];
      const previewDots = document.querySelectorAll('#active-palette-preview span');
      previewDots.forEach((dot, idx) => {
        if (colors[idx]) {
          (dot as HTMLElement).style.backgroundColor = colors[idx];
        }
      });

      // Also update any mobile drawer swatches if present
      document.querySelectorAll('.mobile-palette-btn').forEach(mBtn => {
        const p = mBtn.getAttribute('data-palette');
        if (p === activePalette) {
          mBtn.classList.add('ring-2', 'ring-[#3368A0]', 'dark:ring-[#66A3BF]');
        } else {
          mBtn.classList.remove('ring-2', 'ring-[#3368A0]', 'dark:ring-[#66A3BF]');
        }
      });
    }

    function setPalette(paletteId: string) {
      if (paletteId === 'default') {
        document.documentElement.removeAttribute('data-palette');
        localStorage.setItem('site-palette', 'default');
      } else {
        document.documentElement.setAttribute('data-palette', paletteId);
        localStorage.setItem('site-palette', paletteId);
      }
      updateActiveUI(paletteId);
      window.dispatchEvent(new CustomEvent('palette-changed', { detail: { palette: paletteId } }));
    }

    // Toggle dropdown open/close
    function toggleDropdown(show?: boolean) {
      const willShow = typeof show === 'boolean' ? show : dropdownMenu.classList.contains('hidden');
      if (willShow) {
        dropdownMenu.classList.remove('hidden');
        dropdownBtn.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      } else {
        dropdownMenu.classList.add('hidden');
        dropdownBtn.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    }

    dropdownBtn.onclick = (e) => {
      e.stopPropagation();
      toggleDropdown();
    };

    optionBtns.forEach(btn => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const chosen = btn.getAttribute('data-palette') || 'default';
        setPalette(chosen);
        toggleDropdown(false);
      };
    });

    // Mobile palette options click handler
    document.querySelectorAll('.mobile-palette-btn').forEach(mBtn => {
      mBtn.onclick = () => {
        const chosen = mBtn.getAttribute('data-palette') || 'default';
        setPalette(chosen);
      };
    });

    // Dismiss on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!dropdownBtn.contains(target) && !dropdownMenu.contains(target)) {
        toggleDropdown(false);
      }
    });

    // Dismiss on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleDropdown(false);
      }
    });

    // Initialize UI on load
    updateActiveUI(getActivePalette());
  }

  setupPaletteSelector();
  document.addEventListener('astro:after-swap', setupPaletteSelector);
</script>
