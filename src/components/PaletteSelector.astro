            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #FFDF82;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #99C2FF;"></span>
