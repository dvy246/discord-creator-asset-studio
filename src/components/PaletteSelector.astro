            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #F2765E;"></span>
            <span class="w-3.5 h-3.5 rounded-full border border-white shadow-xs" style="background-color: #F5EBDD;"></span>
