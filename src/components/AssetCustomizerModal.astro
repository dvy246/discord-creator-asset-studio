---
// AssetCustomizerModal.astro — Interactive Customization Studio for Discord Presets
---

<div
  id="asset-customizer-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-md overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="customizer-modal-title"
>
  <!-- Modal Card -->
  <div class="relative w-full max-w-5xl rounded-3xl border border-[#E0DBD0] dark:border-[#263454] bg-[#FAF8F5] dark:bg-[#101626] text-[#192538] dark:text-[#FFEFE3] shadow-2xl overflow-hidden flex flex-col my-auto max-h-[92vh]">
    
    <!-- Header Bar -->
    <div class="px-5 py-4 border-b border-[#E0DBD0] dark:border-[#263454] bg-white dark:bg-[#141A24] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-[#FF84BA]/20 text-[#FF84BA] flex items-center justify-center text-lg font-bold">
          🎨
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 id="customizer-modal-title" class="font-extrabold text-base sm:text-lg tracking-tight">
              Asset Customization Studio
            </h2>
            <span id="modal-category-badge" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#FF84BA]/15 text-[#FF84BA] border border-[#FF84BA]/30 uppercase">
              Preset
            </span>
          </div>
          <p id="modal-preset-subtitle" class="text-xs text-[#6B7A90] dark:text-[#99C2FF] line-clamp-1">
            Recompose, adjust colors, apply atmospheric motion, and export Discord-ready assets.
          </p>
        </div>
      </div>

      <!-- Close Button -->
      <button
        id="modal-close-btn"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#6B7A90] hover:text-[#192538] dark:text-[#8494A7] dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close customizer modal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body: Interactive Viewport + Controls Panel -->
    <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 overflow-y-auto">
      
      <!-- Left: Interactive Canvas & Simulator Viewport (7 Cols) -->
      <div class="lg:col-span-7 p-4 sm:p-6 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-[#E0DBD0] dark:border-[#263454] bg-[#F2EFE7]/50 dark:bg-[#090C16]/50">
        <div>
          <!-- View Mode Switcher Tabs -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <div class="inline-flex flex-wrap p-1 rounded-xl bg-white dark:bg-[#161F2E] border border-[#E0DBD0] dark:border-[#263454] text-xs font-semibold shadow-2xs gap-0.5">
              <button
                type="button"
                id="view-tab-dual"
                class="view-mode-tab active px-3 py-1.5 rounded-lg bg-[#FF84BA] text-black font-bold shadow-xs cursor-pointer transition-all flex items-center gap-1.5"
                data-mode="dual"
              >
                <span>⚡</span>
                <span>Dual View: Banner + Profile</span>
              </button>
              <button
                type="button"
                id="view-tab-banner"
                class="view-mode-tab px-3 py-1.5 rounded-lg text-[#6B7A90] dark:text-[#99C2FF] hover:text-[#192538] dark:hover:text-white cursor-pointer transition-all"
                data-mode="banner"
              >
                Banner (16:9)
              </button>
              <button
                type="button"
                id="view-tab-pfp"
                class="view-mode-tab px-3 py-1.5 rounded-lg text-[#6B7A90] dark:text-[#99C2FF] hover:text-[#192538] dark:hover:text-white cursor-pointer transition-all"
                data-mode="pfp"
              >
                Avatar (1:1 PFP)
              </button>
              <button
                type="button"
                id="view-tab-icon"
                class="view-mode-tab px-3 py-1.5 rounded-lg text-[#6B7A90] dark:text-[#99C2FF] hover:text-[#192538] dark:hover:text-white cursor-pointer transition-all"
                data-mode="icon"
              >
                2D Icon
              </button>
              <button
                type="button"
                id="view-tab-profile"
                class="view-mode-tab px-3 py-1.5 rounded-lg text-[#6B7A90] dark:text-[#99C2FF] hover:text-[#192538] dark:hover:text-white cursor-pointer transition-all"
                data-mode="profile"
              >
                Profile Card Full
              </button>
            </div>

            <!-- Safe Zone Toggle -->
            <label class="flex items-center gap-1.5 text-xs text-[#6B7A90] dark:text-[#99C2FF] cursor-pointer select-none font-medium shrink-0">
              <input type="checkbox" id="toggle-safe-zones" checked class="rounded accent-[#FF84BA] cursor-pointer" />
              <span>Safe Zones</span>
            </label>
          </div>

          <!-- Canvas Preview Container -->
          <div class="relative w-full aspect-[16/9] rounded-2xl overflow-hidden shadow-xl border border-[#E0DBD0] dark:border-[#263454] bg-black flex items-center justify-center select-none cursor-grab" id="preview-viewport-box">

            <!-- Direct-canvas interaction hint + magnetic snap guides + live file-size badge -->
            <div id="canvas-snap-guide-v" class="absolute top-0 bottom-0 left-1/2 w-px bg-[#99C2FF]/80 opacity-0 transition-opacity z-30 pointer-events-none"></div>
            <div id="canvas-snap-guide-h" class="absolute left-0 right-0 top-1/2 h-px bg-[#99C2FF]/80 opacity-0 transition-opacity z-30 pointer-events-none"></div>
            <div class="absolute top-1.5 right-1.5 z-40 pointer-events-none flex items-center gap-1.5">
              <span id="canvas-filesize-badge" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-black/60 text-[#0D9488] border border-[#0D9488]/40 backdrop-blur-xs">✓ &lt;10MB Nitro</span>
            </div>
            <div id="canvas-interaction-hint" class="absolute bottom-1.5 left-1.5 z-40 pointer-events-none text-[9px] font-mono text-white/70 bg-black/50 px-2 py-0.5 rounded-md backdrop-blur-xs">
              Drag to reframe · Scroll / pinch to zoom · Double-click to reset · ⌘Z / ⌘Y · ⌘S
            </div>

            <!-- Generative Rendering Stage -->
            <div
              id="stage-element"
              class="w-full h-full relative overflow-hidden transition-all duration-300"
              style="background: linear-gradient(135deg, #090C16 0%, #FF84BA 100%);"
            >
              <!-- High-Resolution Image Artwork Layer -->
              <img
                id="stage-bg-image"
                class="absolute inset-0 w-full h-full object-cover hidden pointer-events-none transition-transform duration-300 z-0"
                alt="Stage artwork backdrop"
              />

              <!-- Animated Atmospheric Layer -->
              <div id="stage-motion-layer" class="absolute inset-0 pointer-events-none z-1">
                <!-- Procedural canvas for particles & light -->
                <canvas id="motion-particle-canvas" class="w-full h-full absolute inset-0"></canvas>
              </div>

              <!-- Main Subject Icon / Graphic -->
              <div id="stage-subject-wrapper" class="absolute inset-0 flex items-center justify-center p-6 transition-transform">
                <span id="stage-icon" class="text-6xl sm:text-7xl filter drop-shadow-[0_8px_20px_rgba(0,0,0,0.7)] transition-transform">
                  ✨
                </span>
              </div>

              <!-- Custom Text Overlay Layer -->
              <div id="stage-text-overlay" class="absolute inset-0 flex items-center justify-center pointer-events-none p-4 text-center">
                <span
                  id="stage-custom-text"
                  class="font-black tracking-widest uppercase text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)] opacity-0 transition-opacity"
                  style="text-shadow: 0 0 20px #FF84BA;"
                >
                  STUDIO
                </span>
              </div>

              <!-- Safe Zone Guide Overlay -->
              <div id="modal-safe-zone-overlay" class="absolute inset-0 pointer-events-none border-2 border-dashed border-[#99C2FF]/70 z-20 transition-opacity">
                <!-- Top 48px Header Margin (Discord Banner Safe Margin) -->
                <div class="absolute top-0 left-0 right-0 h-6 bg-amber-500/25 border-b border-amber-400/50 text-[10px] font-mono text-amber-200 flex items-center justify-between px-2.5 font-bold">
                  <span>DISCORD TOP 48PX SAFE ZONE</span>
                  <span>AVOID HEADER BUTTON OVERLAP</span>
                </div>
                <!-- Bottom-Left Avatar Cutout indicator -->
                <div class="absolute -bottom-6 left-6 w-20 h-20 rounded-full border-2 border-[#FF84BA] bg-black/60 text-[10px] font-mono text-[#FF84BA] font-bold flex items-center justify-center text-center leading-tight">
                  AVATAR
                </div>
              </div>
            </div>

            <!-- Profile Card Mockup Container (Shown in Profile Card Full Mode) -->
            <div id="profile-card-mockup" class="hidden absolute inset-0 p-4 bg-[#090C16]/95 backdrop-blur-xl flex items-center justify-center z-30">
              <div class="w-full max-w-sm rounded-2xl border border-white/10 overflow-hidden shadow-2xl transition-colors duration-300" id="discord-mockup-outer" style="background-color: #0D0814;">
                <!-- Profile Banner in Mockup -->
                <div class="w-full h-24 relative overflow-hidden transition-all duration-300" id="mockup-banner-bg" style="background: linear-gradient(135deg, #0D0814 0%, #FF84BA 100%);">
                  <img
                    id="mockup-banner-img"
                    class="absolute inset-0 w-full h-full object-cover hidden pointer-events-none"
                    alt="Mockup Banner Backdrop"
                  />
                  <div class="absolute inset-0 flex items-center justify-center opacity-70">
                    <span id="mockup-banner-icon" class="text-3xl">✨</span>
                  </div>
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none p-2 text-center">
                    <span
                      id="mockup-banner-custom-text"
                      class="font-black tracking-widest uppercase text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] opacity-0 transition-opacity text-sm"
                      style="text-shadow: 0 0 15px #FF84BA;"
                    ></span>
                  </div>
                </div>

                <!-- Avatar & Profile Details -->
                <div class="p-4 pt-0 relative bg-[#232428]/95 dark:bg-[#111214]/95">
                  <!-- Overlapping Avatar & Badges -->
                  <div class="flex items-end justify-between mb-2">
                    <div class="relative -mt-10 mb-1 w-16 h-16 rounded-full border-4 border-[#232428] dark:border-[#111214] shadow-xl overflow-hidden flex items-center justify-center text-2xl transition-all duration-300" id="mockup-avatar-circle" style="background: linear-gradient(135deg, #0D0814 0%, #FF84BA 100%);">
                      <img id="mockup-avatar-img" class="w-full h-full object-cover hidden" alt="Mockup Avatar" />
                      <span id="mockup-avatar-icon">✨</span>
                      <!-- Nitro Avatar Decoration Overlay -->
                      <div id="mockup-avatar-decoration" class="avatar-decoration-layer absolute inset-0 pointer-events-none z-20 hidden"></div>
                      <!-- Online Status Dot -->
                      <div id="mockup-status-dot" class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-[#22C55E] border-2 border-[#232428] dark:border-[#111214] flex items-center justify-center transition-colors"></div>
                    </div>

                    <!-- Badges Row -->
                    <div class="flex items-center gap-1.5 p-1 rounded-lg bg-black/40 border border-white/10" id="mockup-badges-container">
                    </div>
                  </div>

                  <!-- Username & Badges -->
                  <div class="mb-2">
                    <div class="font-extrabold text-sm text-white flex items-center gap-1.5">
                      <span id="mockup-username-text">DiscordCreator</span>
                      <span id="mockup-bot-badge" class="hidden text-[10px] px-1.5 py-0.2 rounded bg-[#5865F2] text-white font-bold">BOT</span>
                    </div>
                    <div class="text-[11px] text-[#99C2FF] font-mono" id="mockup-handle-text">@creator_studio</div>
                  </div>

                  <!-- Custom Status -->
                  <div class="mb-2.5 px-2.5 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 text-[11px]">
                    <span>💬</span>
                    <span id="mockup-status-text" class="text-white/90 font-medium truncate">crafting Discord visuals</span>
                  </div>

                  <!-- About Me (Discord Markdown Bio) -->
                  <div id="mockup-bio-wrap" class="mb-2.5 hidden">
                    <div class="text-[9px] font-bold uppercase tracking-wider text-white/50 mb-1">About Me</div>
                    <div id="mockup-bio-text" class="text-[11px] leading-relaxed text-white/85 break-words whitespace-pre-wrap"></div>
                  </div>

                  <!-- Seamless Theme Color Matching Box -->
                  <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-xs font-mono flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-3 rounded-full border border-white/40" id="mockup-theme-color-dot" style="background-color: #0D0814;"></span>
                      <span class="text-[11px] text-white/80">Theme Match:</span>
                    </div>
                    <button
                      type="button"
                      id="mockup-copy-hex"
                      class="px-2 py-0.5 rounded bg-white/10 hover:bg-[#FF84BA] hover:text-black text-[11px] font-bold text-[#FF84BA] transition-colors cursor-pointer"
                    >
                      <span id="mockup-hex-text">#0D0814</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- Live Synchronized Discord Profile Popout Card (Simultaneous Live Preview in Dual View) -->
          <div id="docked-profile-preview" class="mt-4 transition-all duration-300">
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7] mb-2">
              <div class="flex items-center gap-2">
                <span>⚡ Live Discord Profile Popout Preview</span>
                <span class="text-[10px] font-mono text-[#0D9488] bg-[#0D9488]/10 px-2 py-0.5 rounded-full border border-[#0D9488]/20 font-bold">● Live Synced</span>
              </div>
              <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">Authentic Profile Popout</span>
            </div>

            <div class="rounded-2xl border border-white/15 dark:border-[#263454] overflow-hidden shadow-2xl transition-colors duration-300 bg-[#111214] text-white" id="docked-discord-card" style="background-color: #0D0814;">
              <!-- Profile Banner in Docked Popout -->
              <div class="w-full h-24 sm:h-28 relative overflow-hidden transition-all duration-300" id="docked-banner-bg" style="background: linear-gradient(135deg, #0D0814 0%, #FF84BA 100%);">
                <img
                  id="docked-banner-img"
                  class="absolute inset-0 w-full h-full object-cover hidden pointer-events-none transition-transform duration-300"
                  alt="Profile Banner Artwork"
                />
                <!-- Synced Motion Canvas -->
                <canvas id="docked-motion-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
                <div id="docked-banner-center" class="absolute inset-0 flex items-center justify-center opacity-70">
                  <span id="docked-banner-icon" class="text-3xl filter drop-shadow">✨</span>
                </div>
                <!-- Custom Text Overlay in Docked Banner -->
                <div id="docked-banner-text-overlay" class="absolute inset-0 flex items-center justify-center pointer-events-none p-2 text-center">
                  <span
                    id="docked-banner-custom-text"
                    class="font-black tracking-widest uppercase text-white drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] opacity-0 transition-opacity text-sm"
                    style="text-shadow: 0 0 15px #FF84BA;"
                  ></span>
                </div>
              </div>

              <!-- Avatar & Profile Details Body -->
              <div class="p-3.5 pt-0 relative bg-[#232428]/95 dark:bg-[#111214]/95">
                <!-- Overlapping Avatar & Badges Header Row -->
                <div class="flex items-end justify-between mb-2">
                  <div class="relative -mt-9 w-18 h-18 rounded-full border-4 border-[#232428] dark:border-[#111214] shadow-2xl overflow-hidden flex items-center justify-center text-3xl transition-all duration-300" id="docked-avatar-circle" style="background: linear-gradient(135deg, #0D0814 0%, #FF84BA 100%);">
                    <img id="docked-avatar-img" class="w-full h-full object-cover hidden" alt="Avatar" />
                    <span id="docked-avatar-icon">✨</span>
                    <!-- Nitro Avatar Decoration Overlay -->
                    <div id="docked-avatar-decoration" class="avatar-decoration-layer absolute inset-0 pointer-events-none z-20 hidden"></div>
                    <!-- Status Indicator Dot -->
                    <div
                      id="docked-status-indicator"
                      class="absolute bottom-0 right-0 w-5 h-5 rounded-full bg-[#23A55A] border-[3px] border-[#232428] dark:border-[#111214] flex items-center justify-center transition-colors"
                      title="Online"
                    ></div>
                  </div>

                  <!-- Badges Container -->
                  <div class="flex items-center gap-1.5 p-1 rounded-lg bg-black/40 border border-white/10" id="docked-badges-container">
                    <!-- Badges rendered via JS -->
                  </div>
                </div>

                <!-- Identity: Name, Tag & Bot Badge -->
                <div class="mb-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span id="docked-username-text" class="font-extrabold text-sm text-white tracking-tight">DiscordCreator</span>
                    <span id="docked-bot-badge" class="hidden text-[9px] px-1.5 py-0.2 rounded bg-[#5865F2] text-white font-black tracking-wider uppercase">BOT</span>
                  </div>
                  <div class="text-[11px] text-[#99C2FF] font-mono" id="docked-handle-text">@creator_studio</div>
                </div>

                <!-- Custom Status Pill -->
                <div class="mb-2 px-2.5 py-1.5 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2 text-[11px]">
                  <span>💬</span>
                  <span id="docked-status-text" class="text-white/90 font-medium truncate">crafting Discord visuals</span>
                </div>

                <!-- About Me (Discord Markdown Bio) -->
                <div id="docked-bio-wrap" class="mb-2 hidden">
                  <div class="text-[9px] font-bold uppercase tracking-wider text-white/50 mb-1">About Me</div>
                  <div id="docked-bio-text" class="text-[11px] leading-relaxed text-white/85 break-words whitespace-pre-wrap"></div>
                </div>

                <!-- Matching Theme Hex Pill -->
                <div class="p-2 rounded-xl bg-white/5 border border-white/10 text-xs font-mono flex items-center justify-between gap-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-3.5 h-3.5 rounded-full border border-white/40 shadow-xs" id="docked-theme-color-dot" style="background-color: #0D0814;"></span>
                    <span class="text-[11px] text-white/80 font-sans">Profile Theme:</span>
                    <code id="docked-hex-text" class="text-[11px] text-[#FF84BA] font-bold">#0D0814</code>
                  </div>
                  <button
                    type="button"
                    id="docked-copy-hex"
                    class="px-2 py-0.5 rounded bg-white/10 hover:bg-[#FF84BA] hover:text-black text-[11px] font-bold text-[#FF84BA] transition-all cursor-pointer"
                  >
                    Copy Hex
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Matching Color One-Click Copy Bar -->
        <div class="mt-4 p-3 rounded-xl bg-white dark:bg-[#161F2E] border border-[#E0DBD0] dark:border-[#263454] flex flex-wrap items-center justify-between gap-3 text-xs shadow-2xs">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full border border-white/50 shadow-xs" id="customizer-profile-hex-dot" style="background-color: #0D0814;"></span>
            <span class="font-semibold text-[#192538] dark:text-[#FFEFE3]">Discord Profile Theme Color <span class="text-[10px] font-mono text-[#0D9488]" id="theme-automatch-note"></span>:</span>
            <code id="customizer-profile-hex-code" class="font-mono font-bold text-[#FF84BA]">#0D0814</code>
          </div>
          <button
            type="button"
            id="copy-profile-hex-btn"
            class="px-3 py-1 rounded-lg bg-[#FF84BA]/15 text-[#FF84BA] hover:bg-[#FF84BA] hover:text-black font-bold font-mono transition-all cursor-pointer flex items-center gap-1"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-hex-label">Copy Discord Nitro Theme Hex</span>
          </button>
        </div>
      </div>

      <!-- Right: Intelligent Controls & Export Panel (5 Cols) -->
      <div class="lg:col-span-5 p-4 sm:p-6 flex flex-col justify-between space-y-6 overflow-y-auto">
        
        <div class="space-y-5">
          <!-- Recomposition & Focal Zoom -->
          <div>
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7] mb-2">
              <span>Intelligent Recomposition</span>
              <button type="button" id="reset-focal-btn" class="text-[10px] text-[#FF84BA] hover:underline cursor-pointer">Auto Focal</button>
            </div>

            <div class="space-y-3 p-3 rounded-xl bg-white dark:bg-[#161F2E] border border-[#E0DBD0] dark:border-[#263454]">
              <!-- Focal Zoom Slider -->
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-[#6B7A90] dark:text-[#99C2FF]">Subject Zoom & Framing</span>
                  <span id="zoom-val-text" class="font-mono font-bold text-xs">1.0x</span>
                </div>
                <input
                  type="range"
                  id="slider-zoom"
                  min="0.8"
                  max="3.0"
                  step="0.1"
                  value="1.0"
                  class="w-full accent-[#FF84BA] cursor-pointer"
                />
              </div>

              <!-- Recomposition X/Y Sliders -->
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <div class="flex justify-between text-[11px] mb-1">
                    <span class="text-[#6B7A90] dark:text-[#99C2FF]">Focal X</span>
                    <span id="focal-x-val" class="font-mono text-[10px]">50%</span>
                  </div>
                  <input type="range" id="slider-focal-x" min="10" max="90" value="50" class="w-full accent-[#FF84BA] cursor-pointer" />
                </div>
                <div>
                  <div class="flex justify-between text-[11px] mb-1">
                    <span class="text-[#6B7A90] dark:text-[#99C2FF]">Focal Y</span>
                    <span id="focal-y-val" class="font-mono text-[10px]">50%</span>
                  </div>
                  <input type="range" id="slider-focal-y" min="10" max="90" value="50" class="w-full accent-[#FF84BA] cursor-pointer" />
                </div>
              </div>
            </div>
          </div>

          <!-- Color Grading & Lighting Adjustment -->
          <div>
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7] mb-2">
              <span>Color Grading & Mood</span>
              <button type="button" id="reset-color-btn" class="text-[10px] text-[#FF84BA] hover:underline cursor-pointer">Reset</button>
            </div>

            <div class="space-y-3 p-3 rounded-xl bg-white dark:bg-[#161F2E] border border-[#E0DBD0] dark:border-[#263454]">
              <!-- Hue Rotation -->
              <div>
                <div class="flex justify-between text-xs mb-1">
                  <span class="text-[#6B7A90] dark:text-[#99C2FF]">Hue Shift</span>
