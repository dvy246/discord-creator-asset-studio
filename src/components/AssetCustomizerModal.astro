      radial-gradient(circle at 50% -6%, #FFB7D5 0 8%, transparent 9%),
      radial-gradient(circle at 106% 50%, #FF9EC6 0 8%, transparent 9%),
      radial-gradient(circle at 50% 106%, #FFC2DB 0 8%, transparent 9%),
      radial-gradient(circle at -6% 50%, #FF9EC6 0 8%, transparent 9%);
  }
  .avatar-decoration-layer.deco-cyber {
    box-shadow: inset 0 0 0 2px rgba(0, 240, 255, 0.9), 0 0 12px rgba(0, 240, 255, 0.7);
    border: 1px dashed rgba(255, 0, 127, 0.8);
  }
  .avatar-decoration-layer.deco-catears { box-shadow: 0 0 10px rgba(153, 194, 255, 0.5); }
  .avatar-decoration-layer.deco-flames {
    box-shadow: inset 0 0 0 2px rgba(255, 120, 30, 0.85), 0 0 14px rgba(255, 90, 0, 0.7);
  }
  .avatar-decoration-layer.deco-celestial {
    box-shadow: inset 0 0 0 2px rgba(255, 223, 130, 0.95), 0 0 12px rgba(255, 215, 90, 0.7);
  }
  .avatar-decoration-emoji {
    position: absolute; top: -34%; left: 50%; transform: translateX(-50%);
    font-size: 0.9rem; line-height: 1; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.6));
  }
  #input-profile-bio::placeholder { opacity: 0.55; }
  .bio-code { background: rgba(255,255,255,0.12); padding: 0 3px; border-radius: 3px; font-family: ui-monospace, monospace; font-size: 0.9em; }
  .bio-ts { color: #99C2FF; background: rgba(153,194,255,0.14); padding: 0 4px; border-radius: 4px; }
</style>

<script>
  // Interactive Customizer Client Controller
  function initAssetCustomizer() {
    const modal = document.getElementById('asset-customizer-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('modal-close-btn');
    const modalTitle = document.getElementById('customizer-modal-title');
    const modalSubtitle = document.getElementById('modal-preset-subtitle');
    const categoryBadge = document.getElementById('modal-category-badge');
    const stage = document.getElementById('stage-element');
    const stageIcon = document.getElementById('stage-icon');
    const stageSubjectWrapper = document.getElementById('stage-subject-wrapper');
    const safeZoneOverlay = document.getElementById('modal-safe-zone-overlay');
    const toggleSafeZones = document.getElementById('toggle-safe-zones') as HTMLInputElement | null;

    // Sliders
    const sliderHue = document.getElementById('slider-hue') as HTMLInputElement | null;
    const sliderSat = document.getElementById('slider-sat') as HTMLInputElement | null;
    const sliderBrightness = document.getElementById('slider-brightness') as HTMLInputElement | null;
    const sliderContrast = document.getElementById('slider-contrast') as HTMLInputElement | null;
    const sliderZoom = document.getElementById('slider-zoom') as HTMLInputElement | null;
    const sliderFocalX = document.getElementById('slider-focal-x') as HTMLInputElement | null;
    const sliderFocalY = document.getElementById('slider-focal-y') as HTMLInputElement | null;
    const sliderSpeed = document.getElementById('slider-speed') as HTMLInputElement | null;
    const toggleAnimation = document.getElementById('toggle-animation') as HTMLInputElement | null;
    const inputOverlayText = document.getElementById('input-overlay-text') as HTMLInputElement | null;
    const stageCustomText = document.getElementById('stage-custom-text');

    // Theme Color Copy elements
    const hexDot = document.getElementById('customizer-profile-hex-dot');
    const hexCode = document.getElementById('customizer-profile-hex-code');
    const copyHexBtn = document.getElementById('copy-profile-hex-btn');
    const copyHexLabel = document.getElementById('copy-hex-label');

    // Profile Mockup elements (Full Mockup)
    const profileMockup = document.getElementById('profile-card-mockup');
    const mockupOuter = document.getElementById('discord-mockup-outer');
    const mockupBannerBg = document.getElementById('mockup-banner-bg');
    const mockupBannerImg = document.getElementById('mockup-banner-img') as HTMLImageElement | null;
    const mockupBannerIcon = document.getElementById('mockup-banner-icon');
    const mockupBannerCustomText = document.getElementById('mockup-banner-custom-text');
    const mockupAvatarCircle = document.getElementById('mockup-avatar-circle');
    const mockupAvatarImg = document.getElementById('mockup-avatar-img') as HTMLImageElement | null;
    const mockupAvatarIcon = document.getElementById('mockup-avatar-icon');
    const mockupThemeDot = document.getElementById('mockup-theme-color-dot');
    const mockupHexText = document.getElementById('mockup-hex-text');
    const mockupUsernameText = document.getElementById('mockup-username-text');
    const mockupHandleText = document.getElementById('mockup-handle-text');
    const mockupStatusText = document.getElementById('mockup-status-text');
    const mockupStatusDot = document.getElementById('mockup-status-dot');
    const mockupBotBadge = document.getElementById('mockup-bot-badge');
    const mockupBadgesContainer = document.getElementById('mockup-badges-container');
    const mockupCopyHex = document.getElementById('mockup-copy-hex');

    // Live Synchronized Docked Profile Popout Elements
    const dockedProfilePreview = document.getElementById('docked-profile-preview');
    const dockedDiscordCard = document.getElementById('docked-discord-card');
    const dockedBannerBg = document.getElementById('docked-banner-bg');
    const dockedBannerImg = document.getElementById('docked-banner-img') as HTMLImageElement | null;
    const dockedBannerIcon = document.getElementById('docked-banner-icon');
    const dockedBannerCustomText = document.getElementById('docked-banner-custom-text');
    const dockedAvatarCircle = document.getElementById('docked-avatar-circle');
    const dockedAvatarImg = document.getElementById('docked-avatar-img') as HTMLImageElement | null;
    const dockedAvatarIcon = document.getElementById('docked-avatar-icon');
    const dockedStatusIndicator = document.getElementById('docked-status-indicator');
    const dockedBadgesContainer = document.getElementById('docked-badges-container');
    const dockedUsernameText = document.getElementById('docked-username-text');
    const dockedBotBadge = document.getElementById('docked-bot-badge');
    const dockedHandleText = document.getElementById('docked-handle-text');
    const dockedStatusText = document.getElementById('docked-status-text');
    const dockedThemeDot = document.getElementById('docked-theme-color-dot');
    const dockedHexText = document.getElementById('docked-hex-text');
    const dockedCopyHex = document.getElementById('docked-copy-hex');
    const dockedCanvas = document.getElementById('docked-motion-canvas') as HTMLCanvasElement | null;

    // Discord Profile Identity Controls
    const inputProfileDisplayName = document.getElementById('input-profile-display-name') as HTMLInputElement | null;
    const inputProfileHandle = document.getElementById('input-profile-handle') as HTMLInputElement | null;
    const inputProfileStatus = document.getElementById('input-profile-status') as HTMLInputElement | null;
    const statusPresencePills = document.querySelectorAll('.status-presence-pill');
    const profileBadgePills = document.querySelectorAll('.profile-badge-pill');

    // Export Buttons & Format Controls
    const exportBannerBtn = document.getElementById('export-banner-btn');
    const exportBannerBtnText = document.getElementById('export-banner-btn-text');
    const exportPfpBtn = document.getElementById('export-pfp-btn');
    const exportPfpBtnText = document.getElementById('export-pfp-btn-text');
    const exportVideoBtn = document.getElementById('export-video-btn');
    const exportGifBtn = document.getElementById('export-gif-btn');
    const exportRoleIconBtn = document.getElementById('export-role-icon-btn');
    const exportStickerBtn = document.getElementById('export-sticker-btn');
    const exportFullPackBtn = document.getElementById('export-full-pack-btn');
    const formatPills = document.querySelectorAll('.modal-format-pill');
    const activeFormatLabel = document.getElementById('modal-active-format-label');

    let selectedFormat: 'webp' | 'gif' | 'mp4' | 'pfp' | 'png' = 'webp';
    let currentPresetData: any = null;
    let currentMode: 'dual' | 'banner' | 'pfp' | 'profile' | 'icon' = 'dual';
    let currentPresence: 'online' | 'idle' | 'dnd' | 'invisible' = 'online';
    let activeBadges: Set<string> = new Set(['creator', 'nitro', 'booster']);
    let animationFrameId: number | null = null;
    let particleOffset = 0;

    // Canvas particle engine
    const canvas = document.getElementById('motion-particle-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const selectMotionStyle = document.getElementById('select-motion-style') as HTMLSelectElement | null;

    // Stateful particle pools for 60fps performance
    interface Snowflake { x: number; y: number; r: number; vy: number; vx: number; alpha: number; layer: number }
    interface Ember { x: number; y: number; r: number; vy: number; vx: number; life: number; maxLife: number; seed: number }
    interface RainDrop { x: number; y: number; len: number; vy: number; vx: number; alpha: number }
    interface Splash { x: number; y: number; r: number; maxR: number; alpha: number }
    interface DustMote { x: number; y: number; r: number; vy: number; vx: number; alpha: number; seed: number }
    interface SpaceStar { x: number; y: number; r: number; alpha: number; blinkSpeed: number; hasSpike: boolean }

    // 10+ New Animation Style Particle Interfaces
    interface CyberRainDrop { x: number; y: number; len: number; vy: number; vx: number; alpha: number; color: string }
    interface CyberSplash { x: number; y: number; r: number; maxR: number; alpha: number; color: string }
    interface SakuraPetal { x: number; y: number; size: number; rot: number; rotSpeed: number; flip: number; flipSpeed: number; vx: number; vy: number; alpha: number; color: string }
    interface WarpStar { x: number; y: number; z: number; prevZ: number; color: string }
    interface BioOrb { x: number; y: number; r: number; vy: number; vxSeed: number; pulseSeed: number; color: string; alpha: number }
    interface FogPuff { x: number; y: number; r: number; vx: number; pulseSeed: number }
    interface GemFlare { x: number; y: number; size: number; rot: number; rotSpeed: number; pulseSpeed: number; seed: number }
    interface FireworkSpark { x: number; y: number; vx: number; vy: number; alpha: number; color: string; decay: number; size: number }
    interface FireworkBurst { x: number; y: number; timer: number; delay: number; sparks: FireworkSpark[] }
    interface LightningArc { points: { x: number; y: number }[]; timer: number; sparks: { x: number; y: number; vx: number; vy: number; alpha: number; color: string }[] }

    let blizzardFlakes: Snowflake[] = [];
    let fireEmbers: Ember[] = [];
    let rainDrops: RainDrop[] = [];
    let splashRings: Splash[] = [];
    let dustMotes: DustMote[] = [];
    let spaceStars: SpaceStar[] = [];

    // Expanded Particle Pools
    let cyberRainDrops: CyberRainDrop[] = [];
    let cyberSplashes: CyberSplash[] = [];
    let sakuraPetals: SakuraPetal[] = [];
    let warpStars: WarpStar[] = [];
    let bioOrbs: BioOrb[] = [];
    let fogPuffs: FogPuff[] = [];
    let gemFlares: GemFlare[] = [];
    let fireworkBursts: FireworkBurst[] = [];
    let lightningState: LightningArc = { points: [], timer: 0, sparks: [] };

    function initParticlePools() {
      if (!canvas) return;
      const W = canvas.width || 800;
      const H = canvas.height || 450;

      // Blizzard flakes: 3 depth layers
      blizzardFlakes = Array.from({ length: 75 }, (_, i) => {
        const layer = i < 10 ? 0 : i < 35 ? 1 : 2;
        return {
          x: Math.random() * W,
          y: Math.random() * H,
          r: layer === 0 ? 3 + Math.random() * 2 : layer === 1 ? 1.6 + Math.random() * 1.2 : 0.6 + Math.random() * 0.8,
          vy: layer === 0 ? 2.5 + Math.random() * 1.5 : layer === 1 ? 1.4 + Math.random() * 0.8 : 0.7 + Math.random() * 0.5,
          vx: (Math.random() - 0.5) * 0.8,
          alpha: layer === 0 ? 0.8 : layer === 1 ? 0.7 : 0.35,
          layer
        };
      });

      // Fire embers
      fireEmbers = Array.from({ length: 45 }, () => ({
        x: Math.random() * W,
        y: H * 0.5 + Math.random() * (H * 0.5),
        r: 1.5 + Math.random() * 2.5,
        vy: 1.2 + Math.random() * 2.2,
        vx: (Math.random() - 0.5) * 1.2,
        life: Math.random() * 100,
        maxLife: 80 + Math.random() * 60,
        seed: Math.random() * 100
      }));

      // Rain drops
      rainDrops = Array.from({ length: 65 }, () => ({
        x: Math.random() * (W + 100),
        y: Math.random() * H,
        len: 12 + Math.random() * 16,
        vy: 8 + Math.random() * 6,
        vx: -2.5 - Math.random() * 1.5,
        alpha: 0.4 + Math.random() * 0.4
      }));

      // Dust motes
      dustMotes = Array.from({ length: 40 }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 1.2 + Math.random() * 2.2,
        vy: -0.3 - Math.random() * 0.4,
        vx: (Math.random() - 0.5) * 0.4,
        alpha: 0.2 + Math.random() * 0.6,
        seed: Math.random() * 50
      }));

      // Space stars
      spaceStars = Array.from({ length: 70 }, (_, i) => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 0.8 + Math.random() * 1.8,
        alpha: 0.3 + Math.random() * 0.7,
        blinkSpeed: 0.02 + Math.random() * 0.04,
        hasSpike: i % 8 === 0
      }));

      // 1. Cyber Neon Rain Drops & Splashes
      cyberRainDrops = Array.from({ length: 75 }, (_, i) => ({
        x: Math.random() * (W + 100),
        y: Math.random() * H,
        len: 16 + Math.random() * 14,
        vy: 12 + Math.random() * 8,
        vx: -3.5,
        alpha: 0.5 + Math.random() * 0.5,
        color: i % 2 === 0 ? '#00F0FF' : '#FF007F'
      }));
      cyberSplashes = [];

      // 2. Sakura Blossom Petals
      const sakuraColors = ['rgba(255, 183, 197, 0.85)', 'rgba(255, 192, 203, 0.8)', 'rgba(255, 214, 224, 0.85)', 'rgba(255, 166, 201, 0.9)'];
      sakuraPetals = Array.from({ length: 50 }, () => ({
        x: Math.random() * (W + 60) - 30,
        y: Math.random() * H,
        size: 6 + Math.random() * 5,
        rot: Math.random() * Math.PI * 2,
        rotSpeed: 0.01 + Math.random() * 0.02,
        flip: Math.random() * Math.PI,
        flipSpeed: 0.02 + Math.random() * 0.04,
        vx: 0.8 + Math.random() * 1.2,
        vy: 0.9 + Math.random() * 0.9,
        alpha: 0.65 + Math.random() * 0.3,
        color: sakuraColors[Math.floor(Math.random() * sakuraColors.length)]
      }));

      // 3. Hyperspace Warp Stars
      warpStars = Array.from({ length: 130 }, (_, i) => {
        const z = Math.random() * 1000 + 1;
        return {
          x: (Math.random() - 0.5) * W * 2.2,
          y: (Math.random() - 0.5) * H * 2.2,
          z,
          prevZ: z,
          color: i % 3 === 0 ? '#67E8F9' : i % 5 === 0 ? '#C084FC' : '#FFFFFF'
        };
      });

      // 4. Bioluminescent Deep Sea Orbs
      const bioColors = ['#06B6D4', '#10B981', '#8B5CF6'];
      bioOrbs = Array.from({ length: 32 }, (_, i) => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 3.5 + Math.random() * 6.5,
        vy: 0.4 + Math.random() * 0.6,
        vxSeed: Math.random() * 20,
        pulseSeed: Math.random() * 20,
        color: bioColors[i % 3],
        alpha: 0.5 + Math.random() * 0.4
      }));

      // 5. Volumetric Fog Puffs
      fogPuffs = Array.from({ length: 22 }, () => ({
        x: Math.random() * (W + 200) - 100,
        y: H * 0.6 + Math.random() * (H * 0.35),
        r: 110 + Math.random() * 90,
        vx: 0.2 + Math.random() * 0.35,
        pulseSeed: Math.random() * 10
      }));

      // 6. Prismatic Gem Flares
      const flareLocs = [
        { x: 0.18, y: 0.25 }, { x: 0.35, y: 0.18 }, { x: 0.52, y: 0.3 }, { x: 0.68, y: 0.2 },
        { x: 0.82, y: 0.28 }, { x: 0.25, y: 0.65 }, { x: 0.74, y: 0.68 }, { x: 0.12, y: 0.48 },
        { x: 0.88, y: 0.45 }, { x: 0.42, y: 0.72 }, { x: 0.6, y: 0.6 }, { x: 0.3, y: 0.4 }
      ];
      gemFlares = flareLocs.map((loc, i) => ({
        x: loc.x * W,
        y: loc.y * H,
        size: 18 + (i % 3) * 8,
        rot: (i * Math.PI) / 6,
        rotSpeed: 0.008 + (i % 2) * 0.008,
        pulseSpeed: 0.04 + (i % 4) * 0.02,
        seed: i * 1.8
      }));

      // 7. Golden Firework Bursts
      fireworkBursts = [
        { x: W * 0.28, y: H * 0.32, timer: 0, delay: 0, sparks: [] },
        { x: W * 0.68, y: H * 0.26, timer: 0, delay: 40, sparks: [] },
        { x: W * 0.48, y: H * 0.38, timer: 0, delay: 80, sparks: [] }
      ];

      // 8. Lightning State
      lightningState = { points: [], timer: 15, sparks: [] };
    }

    function resizeCanvas() {
      if (canvas && canvas.parentElement) {
        canvas.width = canvas.parentElement.clientWidth;
        canvas.height = canvas.parentElement.clientHeight;
        initParticlePools();
      }
    }

    function renderParticles() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (!toggleAnimation?.checked) return;

      const speed = parseFloat(sliderSpeed?.value || '1.0');
      particleOffset += 0.5 * speed;

      const W = canvas.width;
      const H = canvas.height;
      let motionType = selectMotionStyle?.value || 'auto';
      if (motionType === 'auto') {
        motionType = currentPresetData?.motionType || 'ambient-shimmer';
      }
      const glowColor = currentPresetData?.glowHex || '#FF84BA';
      const accentColor = currentPresetData?.accentHex || '#FFDF82';

      ctx.save();

      // 1. WINDBLOWN GRASS & MOON CORONA (Feudal Ronin)
      if (motionType === 'windblown-grass') {
        // Moon corona breathing aura
        const moonX = W * 0.5;
        const moonY = H * 0.38;
        const moonPulse = Math.sin(particleOffset * 0.04) * 18;
        const moonGrad = ctx.createRadialGradient(moonX, moonY, 35, moonX, moonY, 130 + moonPulse);
        moonGrad.addColorStop(0, 'rgba(235, 245, 255, 0.22)');
        moonGrad.addColorStop(0.5, 'rgba(150, 205, 255, 0.08)');
        moonGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = moonGrad;
        ctx.fillRect(0, 0, W, H);

        // Windblown tall grass stalks along bottom edge
        const grassCount = 55;
        for (let i = 0; i < grassCount; i++) {
          const gx = (i / grassCount) * W + (Math.sin(i * 3.7) * 8);
          const gh = H * 0.24 + Math.sin(i * 7.1) * 18;
          const sway = Math.sin(particleOffset * 0.06 + i * 0.22) * 26 + (Math.cos(particleOffset * 0.03 + i) * 6);

          ctx.beginPath();
          ctx.moveTo(gx, H);
          ctx.quadraticCurveTo(gx + sway * 0.45, H - gh * 0.55, gx + sway, H - gh);
          ctx.strokeStyle = i % 2 === 0 ? 'rgba(18, 38, 52, 0.85)' : 'rgba(32, 68, 88, 0.65)';
          ctx.lineWidth = i % 3 === 0 ? 3.0 : 2.0;
          ctx.stroke();
        }

        // Drifting seeds / pollen motes
        ctx.fillStyle = 'rgba(215, 235, 255, 0.7)';
        for (let i = 0; i < 16; i++) {
          const sx = ((i * 68 + particleOffset * 1.8) % (W + 40)) - 20;
          const sy = H - ((i * 24 + Math.sin(particleOffset * 0.05 + i) * 30 + particleOffset * 0.6) % (H * 0.7));
          ctx.beginPath();
          ctx.arc(sx, sy, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 2. BIRCH BLIZZARD (Winter Vigilante)
      else if (motionType === 'birch-blizzard') {
        const wind = 0.9 + Math.sin(particleOffset * 0.02) * 0.6;

        blizzardFlakes.forEach(f => {
          f.y += f.vy * speed;
          f.x += (f.vx + wind) * speed;
          if (f.y > H) { f.y = -5; f.x = Math.random() * W; }
          if (f.x > W) { f.x = -5; }
          if (f.x < -5) { f.x = W; }

          ctx.beginPath();
          ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${f.alpha})`;
          if (f.layer === 0) {
            ctx.shadowBlur = 6;
            ctx.shadowColor = 'rgba(255, 255, 255, 0.8)';
          } else {
            ctx.shadowBlur = 0;
          }
          ctx.fill();
        });

        // Atmospheric ground snow fog drift
        const fogPulse = Math.sin(particleOffset * 0.03) * 0.15 + 0.25;
        const fogGrad = ctx.createLinearGradient(0, H * 0.7, 0, H);
        fogGrad.addColorStop(0, 'rgba(230, 240, 245, 0)');
        fogGrad.addColorStop(1, `rgba(220, 235, 245, ${fogPulse})`);
        ctx.fillStyle = fogGrad;
        ctx.fillRect(0, H * 0.7, W, H * 0.3);
      }

      // 3. INFERNO SHIMMER (Dark Knight Fire)
      else if (motionType === 'inferno-shimmer') {
        // Base firelight glow
        const glowPulse = Math.sin(particleOffset * 0.1) * 0.15 + 0.35;
        const fireGrad = ctx.createLinearGradient(0, H * 0.6, 0, H);
        fireGrad.addColorStop(0, 'rgba(255, 90, 0, 0)');
        fireGrad.addColorStop(1, `rgba(255, 110, 0, ${glowPulse})`);
        ctx.fillStyle = fireGrad;
        ctx.fillRect(0, H * 0.6, W, H * 0.4);

        // Rising embers with heat turbulence
        fireEmbers.forEach(e => {
          e.life += 0.8 * speed;
          if (e.life > e.maxLife) {
            e.life = 0;
            e.x = Math.random() * W;
            e.y = H * 0.85 + Math.random() * (H * 0.15);
          }
          const progress = e.life / e.maxLife;
          e.y -= e.vy * speed * (1 + progress * 0.5);
          e.x += Math.sin(particleOffset * 0.08 + e.seed) * 1.8;

          const currentR = Math.max(0.5, e.r * (1 - progress * 0.6));
          const alpha = 1 - progress;

          // Color shifts: white-yellow -> orange -> crimson
          ctx.beginPath();
          ctx.arc(e.x, e.y, currentR, 0, Math.PI * 2);
          ctx.fillStyle = progress < 0.35
            ? `rgba(255, 245, 160, ${alpha})`
            : progress < 0.7
              ? `rgba(255, 120, 30, ${alpha})`
              : `rgba(215, 30, 40, ${alpha})`;
          ctx.shadowBlur = 8;
          ctx.shadowColor = '#FF7A18';
          ctx.fill();
        });
      }

      // 4. CLOUD DRIFT & SOARING BIRDS (Summer Cats)
      else if (motionType === 'cloud-drift') {
        // Soft volumetric cumulus clouds drifting horizontally
        const clouds = [
          { x: 0.2, y: 0.25, r: 80, speed: 0.18 },
          { x: 0.55, y: 0.18, r: 110, speed: 0.25 },
          { x: 0.85, y: 0.3, r: 90, speed: 0.15 }
        ];

        clouds.forEach(c => {
          const cx = ((c.x * W + particleOffset * c.speed * 2) % (W + c.r * 2)) - c.r;
          const cy = c.y * H;
          const cGrad = ctx.createRadialGradient(cx, cy, c.r * 0.2, cx, cy, c.r);
          cGrad.addColorStop(0, 'rgba(255, 255, 255, 0.25)');
          cGrad.addColorStop(0.7, 'rgba(255, 255, 255, 0.08)');
          cGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = cGrad;
          ctx.beginPath();
          ctx.arc(cx, cy, c.r, 0, Math.PI * 2);
          ctx.fill();
        });

        // Soaring flock of birds in V-formation
        const birdBaseX = ((particleOffset * 1.3) % (W + 200)) - 100;
        const birdBaseY = H * 0.22 + Math.sin(particleOffset * 0.02) * 14;
        const birdOffsets = [
          { dx: 0, dy: 0, s: 7 },
          { dx: -18, dy: 10, s: 5.5 },
          { dx: -34, dy: 22, s: 4.5 },
          { dx: -14, dy: -8, s: 5.0 }
        ];

        ctx.strokeStyle = 'rgba(20, 35, 50, 0.6)';
        ctx.lineWidth = 1.6;
        birdOffsets.forEach(b => {
          const bx = birdBaseX + b.dx;
          const by = birdBaseY + b.dy;
          const flap = Math.sin(particleOffset * 0.12 + b.dx) * (b.s * 0.4);

          ctx.beginPath();
          ctx.moveTo(bx - b.s, by - flap);
          ctx.quadraticCurveTo(bx - b.s * 0.4, by - flap * 0.5, bx, by);
          ctx.quadraticCurveTo(bx + b.s * 0.4, by - flap * 0.5, bx + b.s, by - flap);
          ctx.stroke();
        });
      }

      // 5. IRIS GLINT & PRISM SHEEN (Euphoria Eyes)
      else if (motionType === 'iris-glint') {
        const eyeX = W * 0.5;
        const eyeY = H * 0.46;

        // Breathing radial iris glow
        const irisPulse = Math.sin(particleOffset * 0.05) * 12;
        const irisGrad = ctx.createRadialGradient(eyeX, eyeY, 15, eyeX, eyeY, 90 + irisPulse);
        irisGrad.addColorStop(0, 'rgba(255, 220, 240, 0.35)');
        irisGrad.addColorStop(0.5, 'rgba(255, 140, 195, 0.15)');
        irisGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = irisGrad;
        ctx.fillRect(0, 0, W, H);

        // Prismatic sweep sheen beam
        const beamX = ((particleOffset * 1.6) % (W * 1.6)) - W * 0.3;
        const beamGrad = ctx.createLinearGradient(beamX - 60, 0, beamX + 60, H);
        beamGrad.addColorStop(0, 'rgba(255, 255, 255, 0)');
        beamGrad.addColorStop(0.5, 'rgba(255, 230, 245, 0.22)');
        beamGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = beamGrad;
        ctx.fillRect(0, 0, W, H);

        // Eyelash starlight glints
        for (let i = 0; i < 8; i++) {
          const gx = eyeX + (Math.sin(i * 1.8) * 120);
          const gy = eyeY + (Math.cos(i * 2.3) * 45);
          const glintAlpha = Math.sin(particleOffset * 0.1 + i * 2) * 0.5 + 0.5;
          ctx.fillStyle = `rgba(255, 255, 255, ${glintAlpha})`;
          ctx.beginPath();
          ctx.arc(gx, gy, 1.4, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 6. GOLDEN PRAIRIE (Prairie Dusk)
      else if (motionType === 'golden-prairie') {
        // Angled sunbeams
        const rayPulse = Math.sin(particleOffset * 0.03) * 0.08 + 0.18;
        const rayGrad = ctx.createLinearGradient(W * 0.6, 0, W * 0.3, H);
        rayGrad.addColorStop(0, `rgba(255, 215, 120, ${rayPulse * 1.5})`);
        rayGrad.addColorStop(0.7, `rgba(255, 175, 50, ${rayPulse * 0.8})`);
        rayGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = rayGrad;
        ctx.fillRect(0, 0, W, H);

        // Undulating golden wheat waves in foreground
        for (let wave = 0; wave < 3; wave++) {
          const waveY = H * (0.75 + wave * 0.08);
          ctx.beginPath();
          ctx.moveTo(0, H);
          for (let x = 0; x <= W; x += 20) {
            const y = waveY + Math.sin(x * 0.015 + particleOffset * 0.04 + wave) * 8;
            ctx.lineTo(x, y);
          }
          ctx.lineTo(W, H);
          ctx.closePath();
          ctx.fillStyle = wave === 0 ? 'rgba(215, 145, 45, 0.15)' : wave === 1 ? 'rgba(180, 115, 30, 0.25)' : 'rgba(140, 85, 20, 0.35)';
          ctx.fill();
        }

        // Floating golden dust motes
        dustMotes.forEach(m => {
          m.y += m.vy * speed;
          m.x += m.vx * speed;
          if (m.y < 0) { m.y = H; m.x = Math.random() * W; }

          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 225, 130, ${m.alpha})`;
          ctx.shadowBlur = 4;
          ctx.shadowColor = '#FFAA33';
          ctx.fill();
        });
      }

      // 7. CRIMSON CHAKRA (Frost Ronin Eye)
      else if (motionType === 'crimson-chakra') {
        const eyeX = W * 0.52;
        const eyeY = H * 0.44;

        // Pulsating crimson chakra aura
        const chakraPulse = Math.sin(particleOffset * 0.06) * 14;
        const chakraGrad = ctx.createRadialGradient(eyeX, eyeY, 10, eyeX, eyeY, 75 + chakraPulse);
        chakraGrad.addColorStop(0, 'rgba(255, 30, 60, 0.4)');
        chakraGrad.addColorStop(0.5, 'rgba(200, 10, 30, 0.18)');
        chakraGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = chakraGrad;
        ctx.fillRect(0, 0, W, H);

        // 3 rotating energy tomoe orbs
        const rotAngle = particleOffset * 0.04;
        for (let i = 0; i < 3; i++) {
          const theta = rotAngle + (i * Math.PI * 2 / 3);
          const orbX = eyeX + Math.cos(theta) * 32;
          const orbY = eyeY + Math.sin(theta) * 32;

          ctx.beginPath();
          ctx.arc(orbX, orbY, 3.2, 0, Math.PI * 2);
          ctx.fillStyle = '#FF1744';
          ctx.shadowBlur = 10;
          ctx.shadowColor = '#FF1744';
          ctx.fill();
        }

        // Swirling blizzard flurries cutting diagonally
        for (let i = 0; i < 35; i++) {
          const fx = ((i * 35 + particleOffset * 4.5) % (W + 80)) - 40;
          const fy = ((i * 22 + particleOffset * 3.0) % (H + 40)) - 20;
          ctx.beginPath();
          ctx.arc(fx, fy, 1.2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(235, 245, 255, 0.75)';
          ctx.shadowBlur = 0;
          ctx.fill();
        }
      }

      // 8. NEON RAIN ALLEY (Cyberpunk)
      else if (motionType === 'neon-rain-alley') {
        // Slanted neon rain streaks
        ctx.lineWidth = 1.2;
        rainDrops.forEach((d, idx) => {
          d.y += d.vy * speed;
          d.x += d.vx * speed;
          if (d.y > H) {
            d.y = -10;
            d.x = Math.random() * (W + 80);
            if (splashRings.length < 15 && Math.random() > 0.4) {
              splashRings.push({ x: d.x, y: H - Math.random() * 20, r: 1, maxR: 6 + Math.random() * 6, alpha: 0.8 });
            }
          }

          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.vx * 1.5, d.y + d.len);
          ctx.strokeStyle = idx % 2 === 0 ? `rgba(0, 240, 255, ${d.alpha})` : `rgba(255, 0, 127, ${d.alpha})`;
          ctx.stroke();
        });

        // Puddle splash rings
        for (let i = splashRings.length - 1; i >= 0; i--) {
          const sp = splashRings[i];
          sp.r += 0.5 * speed;
          sp.alpha -= 0.04 * speed;
          if (sp.alpha <= 0) {
            splashRings.splice(i, 1);
            continue;
          }
          ctx.beginPath();
          ctx.ellipse(sp.x, sp.y, sp.r * 2, sp.r * 0.7, 0, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(0, 240, 255, ${sp.alpha})`;
          ctx.lineWidth = 1.0;
          ctx.stroke();
        }

        // Horizontal neon scanline beam
        const scanY = (particleOffset * 1.5) % H;
        ctx.fillStyle = 'rgba(255, 0, 127, 0.06)';
        ctx.fillRect(0, scanY, W, 2);
      }

      // 9. ORBITAL WEIGHTLESS (Space / Cosmic)
      else if (motionType === 'orbital-weightless') {
        // Deep space twinkling stars
        spaceStars.forEach(s => {
          const currentAlpha = Math.sin(particleOffset * s.blinkSpeed) * 0.4 + s.alpha;
          ctx.fillStyle = `rgba(240, 245, 255, ${Math.max(0.1, currentAlpha)})`;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();

          if (s.hasSpike && currentAlpha > 0.6) {
            ctx.strokeStyle = `rgba(180, 220, 255, ${currentAlpha * 0.6})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(s.x - 7, s.y); ctx.lineTo(s.x + 7, s.y);
            ctx.moveTo(s.x, s.y - 7); ctx.lineTo(s.x, s.y + 7);
            ctx.stroke();
          }
        });

        // Cosmic nebula gas curtain drift
        const nebGrad = ctx.createRadialGradient(W * 0.7, H * 0.4, 40, W * 0.7, H * 0.4, 180);
        nebGrad.addColorStop(0, 'rgba(138, 63, 252, 0.22)');
        nebGrad.addColorStop(0.6, 'rgba(51, 177, 255, 0.1)');
        nebGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = nebGrad;
        ctx.fillRect(0, 0, W, H);
      }

      // 10. ARCANE DUST MOTES (Sanctuary / Fantasy)
      else if (motionType === 'arcane-dust-motes') {
        // Cathedral light beam
        const beamGrad = ctx.createLinearGradient(W * 0.2, 0, W * 0.7, H);
        beamGrad.addColorStop(0, 'rgba(245, 200, 105, 0.18)');
        beamGrad.addColorStop(0.6, 'rgba(245, 200, 105, 0.06)');
        beamGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = beamGrad;
        ctx.fillRect(0, 0, W, H);

        // Rising golden dust motes
        dustMotes.forEach(m => {
          m.y += m.vy * speed;
          m.x += m.vx * speed;
          if (m.y < 0) { m.y = H; m.x = Math.random() * W; }

          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(245, 210, 110, ${m.alpha})`;
          ctx.shadowBlur = 6;
          ctx.shadowColor = '#F5C869';
          ctx.fill();
        });

        // Floating arcane rune circle
        const runeX = W * 0.5;
        const runeY = H * 0.48;
        const runePulse = Math.sin(particleOffset * 0.04) * 0.2 + 0.5;
        ctx.strokeStyle = `rgba(245, 200, 105, ${runePulse * 0.6})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(runeX, runeY, 40, 0, Math.PI * 2);
        ctx.stroke();
      }

      // 11. SPIDER WEB GLINT (Spider-Man Void)
      else if (motionType === 'spider-web-glint') {
        const spotX = W * 0.45;
        const spotY = H * 0.4;
        const spotPulse = Math.sin(particleOffset * 0.05) * 15;
        const spotGrad = ctx.createRadialGradient(spotX, spotY, 20, spotX, spotY, 160 + spotPulse);
        spotGrad.addColorStop(0, 'rgba(255, 60, 60, 0.12)');
        spotGrad.addColorStop(0.5, 'rgba(40, 70, 180, 0.08)');
        spotGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = spotGrad;
        ctx.fillRect(0, 0, W, H);

        ctx.strokeStyle = 'rgba(200, 220, 255, 0.25)';
        ctx.lineWidth = 1;
        const cornerX = W * 0.95;
        const cornerY = H * 0.05;
        for (let i = 0; i < 7; i++) {
          const angle = Math.PI * 0.6 + i * 0.15;
          const len = 220 + Math.sin(particleOffset * 0.03 + i) * 10;
          ctx.beginPath();
          ctx.moveTo(cornerX, cornerY);
          ctx.lineTo(cornerX + Math.cos(angle) * len, cornerY + Math.sin(angle) * len);
          ctx.stroke();
        }

        for (let i = 0; i < 12; i++) {
          const glintX = ((i * 73 + particleOffset * 0.8) % W);
          const glintY = ((i * 37 + particleOffset * 0.6) % H);
          const glintAlpha = Math.sin(particleOffset * 0.1 + i) * 0.4 + 0.5;
          ctx.fillStyle = `rgba(255, 255, 255, ${glintAlpha})`;
          ctx.beginPath();
          ctx.arc(glintX, glintY, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 12. STARGAZER CONSTELLATIONS (Ash & Pikachu)
      else if (motionType === 'stargazer-constellations') {
        const stars = [
          { x: 0.55, y: 0.18 }, { x: 0.68, y: 0.14 }, { x: 0.78, y: 0.24 },
          { x: 0.85, y: 0.16 }, { x: 0.62, y: 0.32 }, { x: 0.74, y: 0.38 }
        ];

        const linePulse = Math.sin(particleOffset * 0.04) * 0.2 + 0.35;
        ctx.strokeStyle = `rgba(160, 210, 255, ${linePulse})`;
        ctx.lineWidth = 1.0;
        ctx.beginPath();
        for (let i = 0; i < stars.length - 1; i++) {
          ctx.moveTo(stars[i].x * W, stars[i].y * H);
          ctx.lineTo(stars[i + 1].x * W, stars[i + 1].y * H);
        }
        ctx.stroke();

        stars.forEach((s, idx) => {
          const sx = s.x * W;
          const sy = s.y * H;
          const starPulse = Math.sin(particleOffset * 0.08 + idx * 1.5) * 0.4 + 0.6;
          ctx.fillStyle = `rgba(255, 255, 255, ${starPulse})`;
          ctx.shadowBlur = 8;
          ctx.shadowColor = '#99C2FF';
          ctx.beginPath();
          ctx.arc(sx, sy, 2.0, 0, Math.PI * 2);
          ctx.fill();
        });

        const meteorCycle = (particleOffset * 2.5) % (W * 2);
        if (meteorCycle < W) {
          const mx = meteorCycle;
          const my = (meteorCycle * 0.4) % (H * 0.6);
          const mGrad = ctx.createLinearGradient(mx, my, mx - 60, my - 24);
          mGrad.addColorStop(0, 'rgba(255, 255, 255, 0.9)');
          mGrad.addColorStop(1, 'rgba(150, 200, 255, 0)');
          ctx.strokeStyle = mGrad;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(mx, my);
          ctx.lineTo(mx - 60, my - 24);
          ctx.stroke();
        }
      }

      // 13. ALPINE WIND DRIFT (Jeep Cliff Summit)
      else if (motionType === 'alpine-wind-drift') {
        const c1X = ((particleOffset * 0.4) % (W + 200)) - 100;
        const c1Grad = ctx.createRadialGradient(c1X, H * 0.28, 20, c1X, H * 0.28, 120);
        c1Grad.addColorStop(0, 'rgba(255, 235, 200, 0.2)');
        c1Grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = c1Grad;
        ctx.fillRect(0, 0, W, H * 0.6);

        const eagleX = ((particleOffset * 1.2) % (W + 150)) - 75;
        const eagleY = H * 0.2 + Math.sin(particleOffset * 0.03) * 12;
        ctx.strokeStyle = 'rgba(30, 25, 20, 0.65)';
        ctx.lineWidth = 2.0;
        ctx.beginPath();
        ctx.moveTo(eagleX - 14, eagleY + 4);
        ctx.quadraticCurveTo(eagleX - 7, eagleY - 4, eagleX, eagleY);
        ctx.quadraticCurveTo(eagleX + 7, eagleY - 4, eagleX + 14, eagleY + 4);
        ctx.stroke();

        for (let i = 0; i < 14; i++) {
          const wx = ((i * 85 + particleOffset * 3.5) % (W + 50)) - 25;
          const wy = ((i * 32 + Math.sin(i + particleOffset * 0.04) * 20) % (H * 0.8));
          ctx.fillStyle = 'rgba(255, 245, 220, 0.5)';
          ctx.beginPath();
          ctx.arc(wx, wy, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 14. CUMULUS SUNBURST (Shin-chan & Shiro)
      else if (motionType === 'cumulus-sunburst') {
        const sunX = W * 0.85;
        const sunY = H * 0.15;
        const sunPulse = Math.sin(particleOffset * 0.05) * 20;
        const sunGrad = ctx.createRadialGradient(sunX, sunY, 30, sunX, sunY, 180 + sunPulse);
        sunGrad.addColorStop(0, 'rgba(255, 220, 120, 0.35)');
        sunGrad.addColorStop(0.5, 'rgba(255, 180, 80, 0.12)');
        sunGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = sunGrad;
        ctx.fillRect(0, 0, W, H);

        const cloudPulse = Math.sin(particleOffset * 0.03) * 0.08 + 0.15;
        const cloudGrad = ctx.createLinearGradient(0, H * 0.3, 0, H * 0.8);
        cloudGrad.addColorStop(0, `rgba(255, 245, 230, ${cloudPulse})`);
        cloudGrad.addColorStop(1, 'rgba(255, 220, 180, 0)');
        ctx.fillStyle = cloudGrad;
        ctx.fillRect(0, H * 0.2, W, H * 0.6);

        for (let i = 0; i < 16; i++) {
          const dx = ((i * 64 + particleOffset * 0.7) % W);
          const dy = H * 0.3 + ((i * 28 + Math.sin(particleOffset * 0.04 + i) * 25) % (H * 0.5));
          ctx.fillStyle = 'rgba(255, 250, 210, 0.65)';
          ctx.shadowBlur = 6;
          ctx.shadowColor = '#FFDF82';
          ctx.beginPath();
          ctx.arc(dx, dy, 1.4, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 16. CYBER NEON RAIN & SPLASH RIPPLES
      else if (motionType === 'cyber-rain-neon') {
        ctx.lineWidth = 1.4;
        cyberRainDrops.forEach(d => {
          d.y += d.vy * speed;
          d.x += d.vx * speed;
          if (d.y > H) {
            d.y = -15;
            d.x = Math.random() * (W + 60);
            if (cyberSplashes.length < 25 && Math.random() > 0.35) {
              cyberSplashes.push({
                x: d.x,
                y: H - 4 - Math.random() * 16,
                r: 1,
                maxR: 8 + Math.random() * 8,
                alpha: 0.9,
                color: d.color
              });
            }
          }
          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x + d.vx * 1.6, d.y + d.len);
          ctx.strokeStyle = d.color;
          ctx.shadowBlur = 6;
          ctx.shadowColor = d.color;
          ctx.stroke();
        });

        // Expanding splash ripples on wet neon pavement
        for (let i = cyberSplashes.length - 1; i >= 0; i--) {
          const sp = cyberSplashes[i];
          sp.r += 0.8 * speed;
          sp.alpha -= 0.045 * speed;
          if (sp.alpha <= 0) {
            cyberSplashes.splice(i, 1);
            continue;
          }
          ctx.beginPath();
          ctx.ellipse(sp.x, sp.y, sp.r * 2.2, sp.r * 0.7, 0, 0, Math.PI * 2);
          ctx.strokeStyle = sp.color;
          ctx.globalAlpha = Math.max(0, sp.alpha);
          ctx.lineWidth = 1.2;
          ctx.shadowBlur = 4;
          ctx.shadowColor = sp.color;
          ctx.stroke();
          ctx.globalAlpha = 1;
        }

        // Wet pavement horizon reflective gradient
        const wetGrad = ctx.createLinearGradient(0, H * 0.82, 0, H);
        wetGrad.addColorStop(0, 'rgba(0, 240, 255, 0)');
        wetGrad.addColorStop(1, 'rgba(0, 240, 255, 0.12)');
        ctx.fillStyle = wetGrad;
        ctx.fillRect(0, H * 0.82, W, H * 0.18);
      }

      // 17. FLOATING SAKURA PETALS & SPRING BREEZE
      else if (motionType === 'sakura-blossom-drift') {
        const windGust = Math.sin(particleOffset * 0.03) * 1.2 + 1.2;
        sakuraPetals.forEach(p => {
          p.x += (p.vx + windGust) * speed;
          p.y += (p.vy + Math.cos(particleOffset * 0.04 + p.x * 0.01) * 0.4) * speed;
          p.rot += p.rotSpeed * speed;
          p.flip += p.flipSpeed * speed;

          if (p.x > W + 20) { p.x = -20; p.y = Math.random() * H; }
          if (p.y > H + 20) { p.y = -20; p.x = Math.random() * W; }

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.scale(1, Math.cos(p.flip));

          ctx.beginPath();
          ctx.moveTo(0, -p.size);
          ctx.bezierCurveTo(-p.size * 0.75, -p.size * 0.85, -p.size * 0.8, p.size * 0.6, 0, p.size);
          ctx.bezierCurveTo(p.size * 0.8, p.size * 0.6, p.size * 0.75, -p.size * 0.85, 0, -p.size);
          ctx.fillStyle = p.color;
          ctx.shadowBlur = 5;
          ctx.shadowColor = 'rgba(255, 150, 180, 0.5)';
          ctx.fill();
          ctx.restore();
        });

        // Spring breeze ambient aura
        const breezePulse = Math.sin(particleOffset * 0.02) * 0.06 + 0.08;
        const breezeGrad = ctx.createLinearGradient(0, 0, W, H);
        breezeGrad.addColorStop(0, `rgba(255, 214, 224, ${breezePulse})`);
        breezeGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = breezeGrad;
        ctx.fillRect(0, 0, W, H);
      }

      // 18. ELECTRIC LIGHTNING ARCS & KINETIC SPARKS
      else if (motionType === 'electric-lightning-arcs') {
        lightningState.timer -= 1 * speed;

        if (lightningState.timer <= 0) {
          lightningState.timer = 18 + Math.random() * 25;
          const startX = W * (0.15 + Math.random() * 0.7);
          const startY = 0;
          const endX = startX + (Math.random() - 0.5) * (W * 0.4);
          const endY = H * (0.65 + Math.random() * 0.35);

          const segments = 7;
          const pts: { x: number; y: number }[] = [{ x: startX, y: startY }];
          for (let i = 1; i < segments; i++) {
            const t = i / segments;
            const px = startX + (endX - startX) * t + (Math.random() - 0.5) * 45;
            const py = startY + (endY - startY) * t + (Math.random() - 0.5) * 20;
            pts.push({ x: px, y: py });

            if (Math.random() > 0.4) {
              lightningState.sparks.push({
                x: px,
                y: py,
                vx: (Math.random() - 0.5) * 8,
                vy: (Math.random() - 0.5) * 8,
                alpha: 1.0,
                color: Math.random() > 0.5 ? '#67E8F9' : '#FFFFFF'
              });
            }
          }
          pts.push({ x: endX, y: endY });
          lightningState.points = pts;
        }

        if (lightningState.points.length > 1) {
          ctx.fillStyle = 'rgba(103, 232, 249, 0.08)';
          ctx.fillRect(0, 0, W, H);

          ctx.beginPath();
          ctx.moveTo(lightningState.points[0].x, lightningState.points[0].y);
          for (let i = 1; i < lightningState.points.length; i++) {
            ctx.lineTo(lightningState.points[i].x, lightningState.points[i].y);
          }
          ctx.strokeStyle = '#67E8F9';
          ctx.lineWidth = 3.5;
          ctx.shadowBlur = 16;
          ctx.shadowColor = '#00F0FF';
          ctx.stroke();

          ctx.strokeStyle = '#FFFFFF';
          ctx.lineWidth = 1.4;
          ctx.shadowBlur = 4;
          ctx.stroke();

          if (lightningState.timer < 14) {
            lightningState.points = [];
          }
        }

        for (let i = lightningState.sparks.length - 1; i >= 0; i--) {
          const sp = lightningState.sparks[i];
          sp.x += sp.vx * speed;
          sp.y += sp.vy * speed;
          sp.vy += 0.15 * speed;
          sp.alpha -= 0.04 * speed;
          if (sp.alpha <= 0) {
            lightningState.sparks.splice(i, 1);
            continue;
          }
          ctx.beginPath();
          ctx.arc(sp.x, sp.y, 1.5, 0, Math.PI * 2);
          ctx.fillStyle = sp.color;
          ctx.globalAlpha = Math.max(0, sp.alpha);
          ctx.shadowBlur = 6;
          ctx.shadowColor = sp.color;
          ctx.fill();
          ctx.globalAlpha = 1;
        }
      }

      // 19. AURORA BOREALIS WAVES & COSMIC SHIMMER
      else if (motionType === 'aurora-borealis-waves') {
        const layers = [
          { baseY: H * 0.22, color1: 'rgba(52, 211, 153, 0.35)', color2: 'rgba(16, 185, 129, 0)', speedM: 0.02 },
          { baseY: H * 0.35, color1: 'rgba(56, 189, 248, 0.3)', color2: 'rgba(14, 165, 233, 0)', speedM: 0.028 },
          { baseY: H * 0.46, color1: 'rgba(168, 85, 247, 0.28)', color2: 'rgba(147, 51, 234, 0)', speedM: 0.018 }
        ];

        layers.forEach((layer, idx) => {
          const step = 20;
          for (let x = 0; x <= W; x += step) {
            const waveY = layer.baseY + Math.sin(x * 0.006 + particleOffset * layer.speedM + idx) * 32
              + Math.cos(x * 0.012 - particleOffset * 0.015) * 14;
            const curtainHeight = 110 + Math.sin(x * 0.008 + particleOffset * 0.03) * 30;

            const cGrad = ctx.createLinearGradient(x, waveY, x, waveY + curtainHeight);
            cGrad.addColorStop(0, layer.color1);
            cGrad.addColorStop(0.7, layer.color1.replace('0.3', '0.1').replace('0.28', '0.08'));
            cGrad.addColorStop(1, layer.color2);

            ctx.fillStyle = cGrad;
            ctx.fillRect(x, waveY, step + 2, curtainHeight);
          }
        });

        spaceStars.forEach(s => {
          const shimmer = Math.sin(particleOffset * s.blinkSpeed * 2) * 0.4 + 0.6;
          ctx.beginPath();
          ctx.arc(s.x, s.y * 0.6, s.r * 0.9, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(220, 245, 255, ${shimmer * s.alpha})`;
          ctx.shadowBlur = 4;
          ctx.shadowColor = '#67E8F9';
          ctx.fill();
        });
      }

      // 20. HYPERSPACE STARFIELD WARP DRIVE
      else if (motionType === 'hyperspace-warp-speed') {
        const cx = W * 0.5;
        const cy = H * 0.5;

        const coreGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 140);
        coreGrad.addColorStop(0, 'rgba(103, 232, 249, 0.28)');
        coreGrad.addColorStop(0.5, 'rgba(56, 189, 248, 0.08)');
        coreGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = coreGrad;
        ctx.fillRect(0, 0, W, H);

        warpStars.forEach(star => {
          star.prevZ = star.z;
          star.z -= 20 * speed;
          if (star.z <= 15) {
            star.z = 1000;
            star.prevZ = 1000;
            star.x = (Math.random() - 0.5) * W * 2.2;
            star.y = (Math.random() - 0.5) * H * 2.2;
          }

          const k = 340;
          const sx = cx + (star.x / star.z) * k;
          const sy = cy + (star.y / star.z) * k;
          const px = cx + (star.x / star.prevZ) * k;
          const py = cy + (star.y / star.prevZ) * k;

          const progress = 1 - star.z / 1000;
          const lineW = Math.max(0.6, progress * 3.2);

          ctx.beginPath();
          ctx.moveTo(px, py);
          ctx.lineTo(sx, sy);
          ctx.strokeStyle = star.color;
          ctx.lineWidth = lineW;
          ctx.shadowBlur = progress > 0.5 ? 8 : 0;
          ctx.shadowColor = star.color;
          ctx.stroke();
        });
      }

      // 21. RETRO CRT SCANLINES & GLITCH PULSE
      else if (motionType === 'crt-scanlines-glitch') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.28)';
        for (let y = 0; y < H; y += 4) {
          ctx.fillRect(0, y, W, 1.8);
        }

        const beamY = (particleOffset * 2.2) % (H + 60) - 30;
        const beamGrad = ctx.createLinearGradient(0, beamY - 40, 0, beamY + 40);
        beamGrad.addColorStop(0, 'rgba(0, 255, 180, 0)');
        beamGrad.addColorStop(0.5, 'rgba(0, 255, 180, 0.12)');
        beamGrad.addColorStop(1, 'rgba(0, 255, 180, 0)');
        ctx.fillStyle = beamGrad;
        ctx.fillRect(0, beamY - 40, W, 80);

        const glitchCycle = Math.sin(particleOffset * 0.14);
        if (glitchCycle > 0.82) {
          const sliceY = ((particleOffset * 3.7) % (H * 0.8)) + H * 0.1;
          const sliceH = 12 + Math.abs(Math.sin(particleOffset * 0.2)) * 26;

          ctx.fillStyle = 'rgba(255, 0, 80, 0.18)';
          ctx.fillRect(0, sliceY, W, sliceH);

          ctx.fillStyle = 'rgba(0, 240, 255, 0.18)';
          ctx.fillRect(6, sliceY - 3, W, sliceH);

          ctx.fillStyle = 'rgba(255, 255, 255, 0.65)';
          ctx.fillRect(0, sliceY + sliceH * 0.5, W, 1.2);
        }

        const vigGrad = ctx.createRadialGradient(W * 0.5, H * 0.5, W * 0.35, W * 0.5, H * 0.5, W * 0.65);
        vigGrad.addColorStop(0, 'rgba(0, 0, 0, 0)');
        vigGrad.addColorStop(1, 'rgba(0, 0, 0, 0.5)');
        ctx.fillStyle = vigGrad;
        ctx.fillRect(0, 0, W, H);
      }

      // 22. PRISMATIC GEM GLINT & FLARE SHIMMER
      else if (motionType === 'prismatic-gem-flares') {
        gemFlares.forEach((f, idx) => {
          f.rot += f.rotSpeed * speed;
          const pulse = Math.sin(particleOffset * f.pulseSpeed + f.seed) * 0.35 + 0.85;
          const flareLen = f.size * pulse;
          const flareW = f.size * 0.16 * pulse;

          ctx.save();
          ctx.translate(f.x, f.y);
          ctx.rotate(f.rot);

          for (let r = 0; r < 2; r++) {
            ctx.rotate(Math.PI * 0.5);
            const rGrad = ctx.createLinearGradient(-flareLen, 0, flareLen, 0);
            rGrad.addColorStop(0, 'rgba(255, 255, 255, 0)');
            rGrad.addColorStop(0.5, idx % 2 === 0 ? 'rgba(255, 130, 210, 0.85)' : 'rgba(100, 230, 255, 0.85)');
            rGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.fillStyle = rGrad;
            ctx.beginPath();
            ctx.moveTo(-flareLen, 0);
            ctx.lineTo(0, flareW);
            ctx.lineTo(flareLen, 0);
            ctx.lineTo(0, -flareW);
            ctx.closePath();
            ctx.fill();
          }

          ctx.beginPath();
          ctx.arc(0, 0, 2.5 * pulse, 0, Math.PI * 2);
          ctx.fillStyle = '#FFFFFF';
          ctx.shadowBlur = 14;
          ctx.shadowColor = idx % 2 === 0 ? '#FF84BA' : '#67E8F9';
          ctx.fill();

          ctx.restore();
        });
      }

      // 23. DEEP SEA BIOLUMINESCENT FLOATING ORBS
      else if (motionType === 'bioluminescent-orbs') {
        bioOrbs.forEach(orb => {
          orb.y -= orb.vy * speed;
          orb.x += Math.sin(particleOffset * 0.035 + orb.vxSeed) * 0.8;
          if (orb.y < -30) {
            orb.y = H + 25;
            orb.x = Math.random() * W;
          }

          const pulse = Math.sin(particleOffset * 0.05 + orb.pulseSeed) * 0.25 + 0.85;
          const outerR = orb.r * 2.4 * pulse;

          const orbGrad = ctx.createRadialGradient(orb.x, orb.y, 0, orb.x, orb.y, outerR);
          orbGrad.addColorStop(0, `rgba(255, 255, 255, ${0.9 * orb.alpha})`);
          orbGrad.addColorStop(0.35, orb.color);
          orbGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

          ctx.fillStyle = orbGrad;
          ctx.beginPath();
          ctx.arc(orb.x, orb.y, outerR, 0, Math.PI * 2);
          ctx.fill();

          const sporeY = orb.y + 12 + Math.sin(particleOffset * 0.06 + orb.vxSeed) * 4;
          ctx.beginPath();
          ctx.arc(orb.x, sporeY, 1.2, 0, Math.PI * 2);
          ctx.fillStyle = orb.color;
          ctx.shadowBlur = 4;
          ctx.shadowColor = orb.color;
          ctx.fill();
        });
      }

      // 24. LOW-HANGING VOLUMETRIC FOG & MIST DRIFT
      else if (motionType === 'volumetric-fog-mist') {
        const mistGrad = ctx.createLinearGradient(0, H * 0.6, 0, H);
        mistGrad.addColorStop(0, 'rgba(210, 230, 250, 0)');
        mistGrad.addColorStop(1, 'rgba(210, 230, 250, 0.25)');
        ctx.fillStyle = mistGrad;
        ctx.fillRect(0, H * 0.6, W, H * 0.4);

        fogPuffs.forEach(p => {
          p.x += p.vx * speed;
          if (p.x - p.r > W) p.x = -p.r;

          const bob = Math.sin(particleOffset * 0.02 + p.pulseSeed) * 8;
          const puffGrad = ctx.createRadialGradient(p.x, p.y + bob, 0, p.x, p.y + bob, p.r);
          puffGrad.addColorStop(0, 'rgba(225, 240, 255, 0.16)');
          puffGrad.addColorStop(0.65, 'rgba(210, 230, 250, 0.06)');
          puffGrad.addColorStop(1, 'rgba(200, 220, 245, 0)');

          ctx.fillStyle = puffGrad;
          ctx.beginPath();
          ctx.arc(p.x, p.y + bob, p.r, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      // 25. FESTIVAL GOLDEN FIREWORKS & STAR BURSTS
      else if (motionType === 'golden-firework-bursts') {
        const fireworkColors = ['#FFD700', '#FFA500', '#FFF5C0', '#FFE066'];
        fireworkBursts.forEach(burst => {
          burst.timer += 1 * speed;

          if (burst.timer >= burst.delay && burst.sparks.length === 0) {
            burst.x = W * (0.2 + Math.random() * 0.6);
            burst.y = H * (0.18 + Math.random() * 0.35);
            burst.delay = 60 + Math.random() * 50;
            burst.timer = 0;

            const sparkCount = 36;
            for (let i = 0; i < sparkCount; i++) {
              const angle = (i / sparkCount) * Math.PI * 2;
              const spd = 1.8 + Math.random() * 3.5;
              burst.sparks.push({
                x: burst.x,
                y: burst.y,
                vx: Math.cos(angle) * spd,
                vy: Math.sin(angle) * spd,
                alpha: 1.0,
                color: fireworkColors[Math.floor(Math.random() * fireworkColors.length)],
                decay: 0.016 + Math.random() * 0.012,
                size: 1.4 + Math.random() * 1.6
              });
            }
          }

          for (let i = burst.sparks.length - 1; i >= 0; i--) {
            const s = burst.sparks[i];
            s.x += s.vx * speed;
            s.y += s.vy * speed;
            s.vy += 0.06 * speed;
            s.vx *= 0.985;
            s.vy *= 0.985;
            s.alpha -= s.decay * speed;

            if (s.alpha <= 0) {
              burst.sparks.splice(i, 1);
              continue;
            }

            ctx.beginPath();
            ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
            ctx.fillStyle = s.color;
            ctx.globalAlpha = Math.max(0, s.alpha);
            ctx.shadowBlur = 8;
            ctx.shadowColor = s.color;
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        });
      }

      // 26. DEFAULT AMBIENT SHIMMER
      else {
        ctx.fillStyle = glowColor;
        ctx.shadowBlur = 10;
        ctx.shadowColor = glowColor;

        for (let i = 0; i < 24; i++) {
          const x = (Math.sin(i * 137.5 + particleOffset * 0.02) * 0.5 + 0.5) * W;
          const y = ((i * 37 + particleOffset * 1.5) % H);
          const radius = (Math.sin(i + particleOffset * 0.05) * 1.5 + 2);

          ctx.beginPath();
          ctx.arc(x, H - y, Math.max(1, radius), 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.restore();

      // Live Synchronize to Docked Discord Profile Popout Canvas
      if (dockedCanvas && (currentMode === 'dual' || currentMode === 'banner')) {
        const dParent = dockedCanvas.parentElement;
        if (dParent && (dockedCanvas.width !== dParent.clientWidth || dockedCanvas.height !== dParent.clientHeight)) {
          dockedCanvas.width = dParent.clientWidth;
          dockedCanvas.height = dParent.clientHeight;
        }
        const dCtx = dockedCanvas.getContext('2d');
        if (dCtx && canvas && dockedCanvas.width > 0 && dockedCanvas.height > 0) {
          dCtx.clearRect(0, 0, dockedCanvas.width, dockedCanvas.height);
          dCtx.drawImage(canvas, 0, 0, dockedCanvas.width, dockedCanvas.height);
        }
      }

      animationFrameId = requestAnimationFrame(renderParticles);
    }

    function applyFilters() {
      if (!stage) return;
      const h = sliderHue?.value || '0';
      const s = sliderSat?.value || '100';
      const b = sliderBrightness?.value || '100';
      const c = sliderContrast?.value || '100';

      const filterStr = `hue-rotate(${h}deg) saturate(${s}%) brightness(${b}%) contrast(${c}%)`;
      stage.style.filter = filterStr;
      if (dockedBannerBg) dockedBannerBg.style.filter = filterStr;
      if (mockupBannerBg) mockupBannerBg.style.filter = filterStr;

      // Update text values
      const hueText = document.getElementById('hue-val-text');
      if (hueText) hueText.textContent = `${h}°`;
      const satText = document.getElementById('sat-val-text');
      if (satText) satText.textContent = `${s}%`;
      const brightText = document.getElementById('bright-val-text');
      if (brightText) brightText.textContent = `${b}%`;
      const contrastText = document.getElementById('contrast-val-text');
      if (contrastText) contrastText.textContent = `${c}%`;
    }

    function applyFocalZoom() {
      const zoom = sliderZoom?.value || '1.0';
      const x = sliderFocalX?.value || '50';
      const y = sliderFocalY?.value || '50';

      if (stageSubjectWrapper && stageIcon) {
        stageSubjectWrapper.style.transform = `scale(${zoom}) translate(${(parseFloat(x) - 50) * 0.5}%, ${(parseFloat(y) - 50) * 0.5}%)`;
      }

      const stageBgImage = document.getElementById('stage-bg-image') as HTMLImageElement | null;
      if (stageBgImage && currentPresetData?.imageUrl) {
        stageBgImage.style.transform = `scale(${zoom})`;
        stageBgImage.style.objectPosition = `${x}% ${y}%`;
      }

      if (dockedBannerImg && currentPresetData?.imageUrl) {
        dockedBannerImg.style.transform = `scale(${zoom})`;
        dockedBannerImg.style.objectPosition = `${x}% ${y}%`;
      }

      const zoomText = document.getElementById('zoom-val-text');
      if (zoomText) zoomText.textContent = `${zoom}x`;
      const xText = document.getElementById('focal-x-val');
      if (xText) xText.textContent = `${x}%`;
      const yText = document.getElementById('focal-y-val');
      if (yText) yText.textContent = `${y}%`;
    }

    function setViewMode(mode: 'dual' | 'banner' | 'pfp' | 'profile' | 'icon') {
      currentMode = mode;
      const tabs = document.querySelectorAll('.view-mode-tab');
      tabs.forEach(tab => {
        if (tab.getAttribute('data-mode') === mode) {
          tab.classList.add('bg-[#FF84BA]', 'text-black', 'font-bold');
          tab.classList.remove('text-[#6B7A90]', 'dark:text-[#99C2FF]');
        } else {
          tab.classList.remove('bg-[#FF84BA]', 'text-black', 'font-bold');
          tab.classList.add('text-[#6B7A90]', 'dark:text-[#99C2FF]');
        }
      });

      const viewport = document.getElementById('preview-viewport-box');
      const stageBgImage = document.getElementById('stage-bg-image') as HTMLImageElement | null;
      const stageIcon = document.getElementById('stage-icon');

      if (mode === 'dual') {
        profileMockup?.classList.add('hidden');
        if (dockedProfilePreview) dockedProfilePreview.classList.remove('hidden');
        if (viewport) {
          viewport.classList.remove('aspect-square', 'max-w-xs', 'max-w-[240px]');
          viewport.classList.add('aspect-[16/9]');
        }
        if (safeZoneOverlay) safeZoneOverlay.style.display = toggleSafeZones?.checked ? 'block' : 'none';
        if (sliderZoom && currentPresetData) sliderZoom.value = '1.0';
        if (currentPresetData?.imageUrl || currentPresetData?.animatedUrl) {
          stageBgImage?.classList.remove('opacity-20');
          stageIcon?.classList.add('opacity-0');
        }
      } else if (mode === 'banner') {
        profileMockup?.classList.add('hidden');
        if (dockedProfilePreview) dockedProfilePreview.classList.add('hidden');
        if (viewport) {
          viewport.classList.remove('aspect-square', 'max-w-xs', 'max-w-[240px]');
          viewport.classList.add('aspect-[16/9]');
        }
        if (safeZoneOverlay) safeZoneOverlay.style.display = toggleSafeZones?.checked ? 'block' : 'none';
        if (sliderZoom && currentPresetData) sliderZoom.value = '1.0';
        if (currentPresetData?.imageUrl || currentPresetData?.animatedUrl) {
          stageBgImage?.classList.remove('opacity-20');
          stageIcon?.classList.add('opacity-0');
        }
      } else if (mode === 'pfp') {
        profileMockup?.classList.add('hidden');
        if (dockedProfilePreview) dockedProfilePreview.classList.add('hidden');
        if (viewport) {
          viewport.classList.remove('aspect-[16/9]', 'max-w-[240px]');
          viewport.classList.add('aspect-square', 'max-w-xs');
        }
        if (safeZoneOverlay) safeZoneOverlay.style.display = 'none';
        if (sliderZoom && currentPresetData) sliderZoom.value = currentPresetData.focalPfpZoom || '1.6';
        if (sliderFocalX && currentPresetData) sliderFocalX.value = currentPresetData.focalPfpX || '50';
        if (sliderFocalY && currentPresetData) sliderFocalY.value = currentPresetData.focalPfpY || '50';
        if (currentPresetData?.imageUrl || currentPresetData?.animatedUrl) {
          stageBgImage?.classList.remove('opacity-20');
          stageIcon?.classList.add('opacity-0');
        }
      } else if (mode === 'profile') {
        profileMockup?.classList.remove('hidden');
        if (dockedProfilePreview) dockedProfilePreview.classList.add('hidden');
        if (viewport) {
          viewport.classList.remove('aspect-square', 'max-w-xs', 'max-w-[240px]');
          viewport.classList.add('aspect-[16/9]');
        }
        if (safeZoneOverlay) safeZoneOverlay.style.display = 'none';
      } else if (mode === 'icon') {
        profileMockup?.classList.add('hidden');
        if (dockedProfilePreview) dockedProfilePreview.classList.add('hidden');
        if (viewport) {
          viewport.classList.remove('aspect-[16/9]', 'max-w-xs');
          viewport.classList.add('aspect-square', 'max-w-[240px]');
        }
        if (safeZoneOverlay) safeZoneOverlay.style.display = 'none';
        if (sliderZoom && currentPresetData) sliderZoom.value = '1.0';
        // In 2D icon mode, make sure the 2D icon is prominently visible
        stageBgImage?.classList.add('opacity-20');
        stageIcon?.classList.remove('opacity-0');
      }
      applyFocalZoom();
      resizeCanvas();
    }

    function updateFormatSelection(fmt: 'webp' | 'gif' | 'mp4' | 'pfp' | 'png') {
      selectedFormat = fmt;
      formatPills.forEach(pill => {
        const pFmt = pill.getAttribute('data-format');
        if (pFmt === fmt) {
          pill.className = 'modal-format-pill py-1 px-1 rounded-lg text-center cursor-pointer transition-all bg-white dark:bg-[#1E293B] text-[#FF84BA] font-bold shadow-xs border border-[#E0DBD0] dark:border-[#263454]';
        } else {
          pill.className = 'modal-format-pill py-1 px-1 rounded-lg text-center cursor-pointer transition-all text-[#6B7A90] dark:text-[#99C2FF] hover:text-[#192538] dark:hover:text-white';
        }
      });

      if (activeFormatLabel) {
        const labels: Record<string, string> = {
          webp: 'Animated WebP (Discord Nitro)',
          gif: 'Discord GIF (<10MB)',
          mp4: 'Full Video HD (MP4 Loop)',
          pfp: 'Avatar Loop (320x320)',
          png: 'Customized Snapshot (PNG)'
        };
        activeFormatLabel.textContent = labels[fmt] || fmt.toUpperCase();
      }

      if (exportBannerBtnText) {
        const btnLabels: Record<string, string> = {
          webp: 'Download WebP',
          gif: 'Download GIF',
          mp4: 'Download MP4',
          pfp: 'Download PFP',
          png: 'Download PNG'
        };
        exportBannerBtnText.textContent = btnLabels[fmt] || 'Download Banner';
      }
    }

    function openModalWithPreset(cardEl: HTMLElement) {
      currentPresetData = {
        id: cardEl.getAttribute('data-id'),
        slug: cardEl.getAttribute('data-slug'),
        title: cardEl.getAttribute('data-title'),
        category: cardEl.getAttribute('data-category'),
        themeHex: cardEl.getAttribute('data-theme-hex'),
        accentHex: cardEl.getAttribute('data-accent-hex'),
        glowHex: cardEl.getAttribute('data-glow-hex'),
        gradient: cardEl.getAttribute('data-gradient'),
        icon: cardEl.getAttribute('data-icon'),
        motionType: cardEl.getAttribute('data-motion-type'),
        motionSpeed: cardEl.getAttribute('data-motion-speed'),
        focalBannerX: cardEl.getAttribute('data-focal-banner-x'),
        focalBannerY: cardEl.getAttribute('data-focal-banner-y'),
        focalPfpX: cardEl.getAttribute('data-focal-pfp-x'),
        focalPfpY: cardEl.getAttribute('data-focal-pfp-y'),
        focalPfpZoom: cardEl.getAttribute('data-focal-pfp-zoom'),
        imageUrl: cardEl.getAttribute('data-image-url') || '',
        animatedUrl: cardEl.getAttribute('data-animated-url') || '',
        gifUrl: cardEl.getAttribute('data-gif-url') || '',
        videoUrl: cardEl.getAttribute('data-video-url') || '',
        pfpUrl: cardEl.getAttribute('data-pfp-url') || '',
        isAnimated: cardEl.getAttribute('data-is-animated') === 'true',
      };

      if (modalTitle) modalTitle.textContent = currentPresetData.title;
      if (categoryBadge) categoryBadge.textContent = currentPresetData.category;
      if (stage) stage.style.background = currentPresetData.gradient;
      if (stageIcon) stageIcon.textContent = currentPresetData.icon;

      // Handle Image / Animated Backdrop
      const stageBgImage = document.getElementById('stage-bg-image') as HTMLImageElement | null;
      const displayMedia = currentPresetData.animatedUrl || currentPresetData.imageUrl;
      if (displayMedia) {
        if (stageBgImage) {
          stageBgImage.src = displayMedia;
          stageBgImage.classList.remove('hidden');
        }
        if (stageIcon) stageIcon.classList.add('opacity-0');
        if (mockupBannerBg) {
          mockupBannerBg.style.backgroundImage = `url(${displayMedia})`;
          mockupBannerBg.style.backgroundSize = 'cover';
        }
        if (mockupAvatarCircle) {
          const pfpMedia = currentPresetData.pfpUrl || displayMedia;
          mockupAvatarCircle.style.backgroundImage = `url(${pfpMedia})`;
          mockupAvatarCircle.style.backgroundSize = 'cover';
        }
      } else {
        if (stageBgImage) {
          stageBgImage.src = '';
          stageBgImage.classList.add('hidden');
        }
        if (stageIcon) stageIcon.classList.remove('opacity-0');
        if (mockupBannerBg) {
          mockupBannerBg.style.backgroundImage = '';
          mockupBannerBg.style.background = currentPresetData.gradient;
        }
        if (mockupAvatarCircle) {
          mockupAvatarCircle.style.backgroundImage = '';
          mockupAvatarCircle.style.background = currentPresetData.gradient;
        }
      }

      // Format Selector Default
      if (currentPresetData.animatedUrl) {
        updateFormatSelection('webp');
