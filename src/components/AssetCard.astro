---
import type { DiscordAssetPreset } from '../data/assets';

interface Props {
  preset: DiscordAssetPreset;
  index: number;
}

const { preset, index } = Astro.props;

// Determine media types accurately
const isAnimated = Boolean(preset.isAnimated || preset.animatedWebpUrl || (preset.pfpImageUrl && preset.isAnimated));
const animatedMediaUrl = preset.animatedWebpUrl || (isAnimated && preset.pfpImageUrl ? preset.pfpImageUrl : undefined);
const staticMediaUrl = preset.imageUrl || (!isAnimated && preset.pfpImageUrl ? preset.pfpImageUrl : undefined);
const visualMediaUrl = animatedMediaUrl || staticMediaUrl;
const isPfpCard = Boolean(preset.isPfp || (!preset.imageUrl && !preset.animatedWebpUrl && preset.pfpImageUrl));
const isPure2d = !visualMediaUrl || preset.category === 'icons-2d';
const gifMediaUrl = preset.gifUrl || (isAnimated && preset.animatedWebpUrl ? preset.animatedWebpUrl.replace('/animated/', '/gifs/').replace('.webp', '.gif') : undefined);
const videoMediaUrl = preset.videoUrl || (isAnimated && preset.animatedWebpUrl ? preset.animatedWebpUrl.replace('/animated/', '/videos/').replace('.webp', '.mp4') : undefined);
---

<div
  class="asset-card card-panel group relative flex flex-col rounded-2xl border border-[#E0DBD0] dark:border-[#263454] bg-white dark:bg-[#101626] shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
  data-category={preset.category}
  data-mood={preset.mood}
  data-style={preset.style}
  data-tags={preset.tags.join(',')}
  data-id={preset.id}
  data-slug={preset.slug}
  data-title={preset.title}
  data-description={preset.description}
  data-is-popular={preset.isPopular ? 'true' : 'false'}
  data-is-staff-pick={preset.isStaffPick ? 'true' : 'false'}
  data-theme-hex={preset.profileThemeHex}
  data-accent-hex={preset.accentHex}
  data-glow-hex={preset.glowHex}
  data-gradient={preset.visualTheme.gradient}
  data-icon={preset.visualTheme.primaryIcon}
  data-motion-type={preset.motionConfig.type}
  data-motion-speed={preset.motionConfig.speed}
  data-motion-intensity={preset.motionConfig.intensity}
  data-focal-banner-x={preset.focalPoint.banner.x}
  data-focal-banner-y={preset.focalPoint.banner.y}
  data-focal-pfp-x={preset.focalPoint.pfp.x}
  data-focal-pfp-y={preset.focalPoint.pfp.y}
  data-focal-pfp-zoom={preset.focalPoint.pfp.zoom}
  data-image-url={preset.imageUrl || ''}
  data-animated-url={animatedMediaUrl || ''}
  data-gif-url={gifMediaUrl || ''}
  data-video-url={videoMediaUrl || ''}
  data-pfp-url={preset.pfpImageUrl || ''}
  data-has-image={visualMediaUrl ? 'true' : 'false'}
  data-is-animated={isAnimated ? 'true' : 'false'}
  data-is-pfp={isPfpCard ? 'true' : 'false'}
  data-is-2d={isPure2d ? 'true' : 'false'}
  data-asset-type={isAnimated ? 'animated-webp' : isPfpCard ? 'pfps' : preset.imageUrl ? 'cinematic' : '2d-icon'}
>
  <!-- Card Visual Preview Area (16:9 Banner Aspect with Avatar Overlay) -->
  <div class="relative w-full aspect-[16/9] overflow-hidden bg-slate-900 select-none">
    <!-- Generative Artwork / Image Container -->
    <div
      class="asset-preview-canvas w-full h-full relative transition-transform duration-500 group-hover:scale-105"
      style={`background: ${preset.visualTheme.gradient};`}
    >
      {animatedMediaUrl ? (
        isPfpCard ? (
          <div class="absolute inset-0 flex items-center justify-center overflow-hidden z-0">
            <!-- Ambient blurred backdrop -->
            <img
              src={animatedMediaUrl}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 w-full h-full object-cover blur-lg scale-125 opacity-40 select-none"
              loading="lazy"
            />
            <!-- Sharp centered animated avatar preview -->
            <div class="relative z-1 aspect-square h-full max-h-full py-2 flex items-center justify-center">
              <img
                src={animatedMediaUrl}
                alt={preset.title}
                class="h-full w-auto aspect-square object-cover rounded-2xl shadow-2xl border border-white/20"
                loading="lazy"
              />
            </div>
          </div>
        ) : (
          <img
            src={animatedMediaUrl}
            alt={preset.title}
            class="absolute inset-0 w-full h-full object-cover z-0 animated-loop-img select-none"
            loading="lazy"
          />
        )
      ) : staticMediaUrl ? (
        isPfpCard ? (
          <div class="absolute inset-0 flex items-center justify-center overflow-hidden z-0">
            <!-- Ambient blurred backdrop -->
            <img
              src={staticMediaUrl}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 w-full h-full object-cover blur-lg scale-125 opacity-40 select-none"
              loading="lazy"
            />
            <!-- Sharp centered static avatar preview -->
            <div class="relative z-1 aspect-square h-full max-h-full py-2 flex items-center justify-center">
              <img
                src={staticMediaUrl}
                alt={preset.title}
                class="h-full w-auto aspect-square object-cover rounded-2xl shadow-2xl border border-white/20"
                loading="lazy"
              />
            </div>
          </div>
        ) : (
          <img
            src={staticMediaUrl}
            alt={preset.title}
            class="absolute inset-0 w-full h-full object-cover z-0"
            loading="lazy"
          />
        )
      ) : null}

      <!-- Background SVG Pattern Layer -->
      <div class="absolute inset-0 opacity-25 pointer-events-none z-1" style={`background-image: radial-gradient(${preset.glowHex} 1px, transparent 1px); background-size: 16px 16px;`}></div>

      <!-- Atmospheric Motion Effect Layer (CSS / Canvas) -->
      <div
        class="asset-motion-layer absolute inset-0 pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity z-2"
        data-motion={preset.motionConfig.type}
      >
        <!-- Light sweep / shimmer beam -->
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
      </div>

      <!-- Center Thematic Subject (ONLY for pure procedural 2D role icons) -->
      {isPure2d && (
        <div class="absolute inset-0 flex items-center justify-center p-4 z-3">
          <div class="relative flex flex-col items-center">
            <span
              class="text-4xl sm:text-5xl filter drop-shadow-[0_4px_12px_rgba(0,0,0,0.6)] transform group-hover:scale-110 group-hover:-translate-y-1 transition-transform duration-300"
              role="img"
              aria-label={preset.title}
            >
              {preset.visualTheme.primaryIcon}
            </span>
            <div
              class="w-16 h-1 rounded-full mt-2 opacity-60 blur-xs"
              style={`background-color: ${preset.glowHex}; box-shadow: 0 0 16px ${preset.accentHex};`}
            ></div>
          </div>
        </div>
      )}

      <!-- Safe Zone Guide Overlay (Active on hover/toggle) -->
      <div class="safe-zone-overlay absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-200 border-2 border-dashed border-[#99C2FF]/60 z-10">
        <!-- Top 48px Header Margin (Discord Server / Profile Banner Safe Margin) -->
        <div class="absolute top-0 left-0 right-0 h-4 bg-amber-500/20 border-b border-amber-400/40 text-[9px] font-mono text-amber-200 flex items-center px-1.5 font-bold">
          48px Safe Margin
        </div>
        <!-- Bottom-Left Avatar Cutout indicator -->
        <div class="absolute -bottom-3 left-3 w-10 h-10 rounded-full border-2 border-[#FF84BA] bg-black/50 text-[8px] font-mono text-[#FF84BA] flex items-center justify-center text-center leading-tight">
          PFP
        </div>
      </div>
    </div>

    <!-- Quick Badges Overlay -->
    <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none z-20">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md text-white border border-white/10 uppercase tracking-wider">
          {preset.categoryLabel.split(' ')[0]}
        </span>
        {isAnimated ? (
          <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded-md bg-[#FF84BA]/90 text-black flex items-center gap-0.5 shadow-xs">
            <span>⚡</span>
            <span>{isPfpCard ? 'Animated PFP' : 'Animated WebP'}</span>
          </span>
        ) : visualMediaUrl ? (
          <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded-md bg-[#0D9488]/80 backdrop-blur-md text-white border border-[#0D9488]/40 flex items-center gap-0.5">
            <span>{isPfpCard ? '👤' : '🎬'}</span>
            <span>{isPfpCard ? 'Discord PFP' : 'Cinematic'}</span>
          </span>
        ) : (
          <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded-md bg-[#5865F2]/80 backdrop-blur-md text-white border border-[#5865F2]/40 flex items-center gap-0.5">
            <span>🎨</span>
            <span>2D Icon</span>
          </span>
        )}
        {preset.isStaffPick && (
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-md bg-[#FF84BA]/90 text-black font-extrabold shadow-xs">
            ★ Staff Pick
          </span>
        )}
      </div>

      <!-- Animated Loop Indicator -->
      <div class="flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-mono text-[#99C2FF] border border-[#99C2FF]/30">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0D9488] animate-pulse"></span>
        <span>Loop</span>
      </div>
    </div>

    <!-- Matching PFP Circular Preview Floating In Corner -->
    <div
      class="absolute bottom-2.5 right-2.5 w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-white dark:border-[#263454] shadow-lg overflow-hidden z-20 flex items-center justify-center text-lg transition-transform group-hover:scale-110"
      style={`background: ${preset.visualTheme.gradient};`}
      title="Matching Profile Picture"
    >
      {preset.pfpImageUrl ? (
        <img
          src={preset.pfpImageUrl}
          alt={`${preset.title} Avatar`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      ) : preset.animatedWebpUrl ? (
        <img
          src={preset.animatedWebpUrl}
          alt={`${preset.title} Avatar`}
          class="w-full h-full object-cover"
          style={`object-position: ${preset.focalPoint.pfp.x}% ${preset.focalPoint.pfp.y}%; transform: scale(${preset.focalPoint.pfp.zoom});`}
          loading="lazy"
        />
      ) : preset.imageUrl ? (
        <img
          src={preset.imageUrl}
          alt={`${preset.title} Avatar`}
          class="w-full h-full object-cover"
          style={`object-position: ${preset.focalPoint.pfp.x}% ${preset.focalPoint.pfp.y}%; transform: scale(${preset.focalPoint.pfp.zoom});`}
          loading="lazy"
        />
      ) : (
        <span class="filter drop-shadow-sm text-sm">{preset.visualTheme.primaryIcon}</span>
      )}
    </div>
  </div>

  <!-- Card Body & Metadata -->
  <div class="p-4 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-start justify-between gap-2 mb-1.5">
        <h3 class="font-bold text-sm text-[#192538] dark:text-[#FFEFE3] leading-snug line-clamp-1 group-hover:text-[#FF84BA] transition-colors">
          {preset.title}
        </h3>
      </div>
      <p class="text-xs text-[#6B7A90] dark:text-[#99C2FF] line-clamp-2 leading-relaxed mb-3">
        {preset.description}
      </p>

      <!-- Tags & Discord Match Swatch -->
      <div class="flex items-center justify-between gap-2 pt-2 border-t border-[#E0DBD0]/60 dark:border-[#263454]/60 text-[11px] mb-3 font-mono">
        <div class="flex items-center gap-1.5">
          <span class="text-[#6B7A90] dark:text-[#8494A7]">Profile Hex:</span>
          <button
            type="button"
            class="copy-hex-btn inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-[#FAF8F5] dark:bg-[#182036] hover:bg-[#FF84BA]/20 border border-[#E0DBD0] dark:border-[#263454] text-[#192538] dark:text-[#FFEFE3] cursor-pointer transition-colors"
            data-hex={preset.profileThemeHex}
            title="Click to copy Discord profile color hex"
          >
            <span class="w-2.5 h-2.5 rounded-full border border-white/40" style={`background-color: ${preset.profileThemeHex};`}></span>
            <span class="font-bold">{preset.profileThemeHex}</span>
          </button>
        </div>

        <div class="text-[10px] font-bold text-[#6B7A90] dark:text-[#8494A7] capitalize">
          {preset.mood}
        </div>
      </div>
    </div>

    <!-- Action Buttons with Multi-Format Download Options -->
    <div class="relative pt-1">
      <div class="grid grid-cols-2 gap-2">
        <button
          type="button"
          class="customize-btn btn-primary w-full py-1.5 px-2 rounded-lg text-xs font-bold text-center flex items-center justify-center gap-1.5 cursor-pointer shadow-xs hover:shadow-md transition-all"
          data-preset-id={preset.id}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Customize</span>
        </button>

        <!-- Split Download Button with Format Dropdown Trigger -->
        <div class="relative flex items-stretch rounded-lg shadow-xs">
          <button
            type="button"
            class="card-direct-download-btn btn-secondary flex-1 py-1.5 px-2 rounded-l-lg text-xs font-semibold text-center border border-r-0 border-[#E0DBD0] dark:border-[#263454] text-[#192538] dark:text-[#CBD5E1] hover:text-[#FF84BA] dark:hover:text-[#FF84BA] flex items-center justify-center gap-1 cursor-pointer transition-colors"
            data-preset-id={preset.id}
            data-default-url={animatedMediaUrl || staticMediaUrl || ''}
            data-filename={`${preset.slug}.${isAnimated ? 'webp' : 'png'}`}
            title="Download Default Format"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="truncate">{isAnimated ? 'WebP' : isPfpCard ? 'PFP' : 'Download'}</span>
          </button>

          <button
            type="button"
            class="card-format-dropdown-trigger py-1.5 px-1.5 rounded-r-lg border border-[#E0DBD0] dark:border-[#263454] bg-[#FAF8F5] dark:bg-[#161F2E] text-[#6B7A90] dark:text-[#8494A7] hover:text-[#FF84BA] dark:hover:text-[#FF84BA] hover:bg-[#FF84BA]/10 cursor-pointer transition-colors flex items-center justify-center"
            aria-label="More download format options"
            title="Choose Download Format (WebP, GIF, MP4, PNG)"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Format Selection Dropdown Menu (Popover) -->
      <div class="card-format-menu hidden absolute right-0 bottom-full mb-2 w-52 p-1.5 rounded-xl border border-[#E0DBD0] dark:border-[#263454] bg-white/95 dark:bg-[#121827]/95 backdrop-blur-xl shadow-2xl z-40 space-y-1 text-xs">
        <div class="px-2 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#6B7A90] dark:text-[#8494A7] border-b border-[#E0DBD0]/60 dark:border-[#263454]/60 flex items-center justify-between">
          <span>Download Formats</span>
          <span class="text-[#0D9488]">Nitro-Safe</span>
        </div>

        {animatedMediaUrl && (
          <button
            type="button"
            class="format-download-opt w-full px-2 py-1.5 rounded-lg flex items-center justify-between text-left hover:bg-[#FF84BA]/15 hover:text-[#FF84BA] text-[#192538] dark:text-[#FFEFE3] transition-colors cursor-pointer"
            data-url={animatedMediaUrl}
            data-filename={`${preset.slug}.webp`}
          >
            <span class="flex items-center gap-1.5 font-medium">
              <span>⚡</span>
              <span>Animated WebP</span>
            </span>
            <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">Banner</span>
          </button>
        )}

        {gifMediaUrl && (
          <button
            type="button"
            class="format-download-opt w-full px-2 py-1.5 rounded-lg flex items-center justify-between text-left hover:bg-[#FFDF82]/20 hover:text-[#FFDF82] text-[#192538] dark:text-[#FFEFE3] transition-colors cursor-pointer"
            data-url={gifMediaUrl}
            data-filename={`${preset.slug}.gif`}
          >
            <span class="flex items-center gap-1.5 font-medium">
              <span>🎞️</span>
              <span>Discord GIF</span>
            </span>
            <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">GIF</span>
          </button>
        )}

        {videoMediaUrl && (
          <button
            type="button"
            class="format-download-opt w-full px-2 py-1.5 rounded-lg flex items-center justify-between text-left hover:bg-[#99C2FF]/20 hover:text-[#99C2FF] text-[#192538] dark:text-[#FFEFE3] transition-colors cursor-pointer"
            data-url={videoMediaUrl}
            data-filename={`${preset.slug}.mp4`}
          >
            <span class="flex items-center gap-1.5 font-medium">
              <span>📹</span>
              <span>Full Video HD</span>
            </span>
            <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">MP4</span>
          </button>
        )}

        {preset.pfpImageUrl && (
          <button
            type="button"
            class="format-download-opt w-full px-2 py-1.5 rounded-lg flex items-center justify-between text-left hover:bg-[#FF84BA]/15 hover:text-[#FF84BA] text-[#192538] dark:text-[#FFEFE3] transition-colors cursor-pointer"
            data-url={preset.pfpImageUrl}
            data-filename={`${preset.slug}-pfp.webp`}
          >
            <span class="flex items-center gap-1.5 font-medium">
              <span>👤</span>
              <span>Avatar PFP</span>
            </span>
            <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">1:1 WebP</span>
          </button>
        )}

        <button
          type="button"
          class="format-download-opt format-download-png w-full px-2 py-1.5 rounded-lg flex items-center justify-between text-left hover:bg-slate-100 dark:hover:bg-slate-800 text-[#192538] dark:text-[#FFEFE3] transition-colors cursor-pointer"
          data-preset-id={preset.id}
          data-filename={`${preset.slug}.png`}
        >
          <span class="flex items-center gap-1.5 font-medium">
            <span>🖼️</span>
            <span>Static PNG</span>
          </span>
          <span class="text-[10px] font-mono text-[#6B7A90] dark:text-[#8494A7]">Snapshot</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupAssetCardDropdowns() {
    // Toggle dropdown popover
    document.querySelectorAll('.card-format-dropdown-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = trigger.closest('.asset-card');
        if (!card) return;
        const menu = card.querySelector('.card-format-menu');
        if (!menu) return;

        // Close any other open menus
        document.querySelectorAll('.card-format-menu').forEach(m => {
          if (m !== menu) m.classList.add('hidden');
        });

        menu.classList.toggle('hidden');
      });
    });

    // Close menus on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.card-format-dropdown-trigger') && !target.closest('.card-format-menu')) {
        document.querySelectorAll('.card-format-menu').forEach(menu => {
          menu.classList.add('hidden');
        });
      }
    });

    // Handle direct download button
    document.querySelectorAll('.card-direct-download-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const url = btn.getAttribute('data-default-url');
        const filename = btn.getAttribute('data-filename') || 'asset.webp';
        if (url) {
          triggerFileDownload(url, filename);
        }
      });
    });

    // Handle format option clicks inside menu
    document.querySelectorAll('.format-download-opt').forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = opt.closest('.card-format-menu');
        menu?.classList.add('hidden');

        const url = opt.getAttribute('data-url');
        const filename = opt.getAttribute('data-filename') || 'asset.webp';
        if (url) {
          triggerFileDownload(url, filename);
        } else if (opt.classList.contains('format-download-png')) {
          const card = opt.closest('.asset-card') as HTMLElement;
          const imgUrl = card?.getAttribute('data-image-url') || card?.getAttribute('data-animated-url');
          if (imgUrl) {
            triggerFileDownload(imgUrl, filename);
          }
        }
      });
    });

    function triggerFileDownload(url: string, filename: string) {
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.target = '_blank';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  }

  setupAssetCardDropdowns();
  document.addEventListener('astro:page-load', setupAssetCardDropdowns);
</script>
