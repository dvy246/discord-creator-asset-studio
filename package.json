{
  "name": "discord-creator-asset-studio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:og": "node scripts/generate-og.mjs",
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/verify-rules.ts && astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node scripts/verify-seo-onpage.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=discord-creator-asset-studio --force --commit-dirty=true && node scripts/indexnow.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "border-beam": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
